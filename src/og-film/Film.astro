---
// One link-preview film at its real size, 1200 by 630. Only `astro dev` serves this page (astro.config.mjs),
// at /og-film/<scene>/. Opened in a browser it plays on a loop. With ?capture, it holds still and
// scripts/og-film.ts calls window.film.seek(t) for each frame and screenshots it.
import { Font } from 'astro:assets';
import '../styles/global.css';
import { SCENES, scene, yearTicks, BOX, W, H, FROM, AS_OF } from './scenes.ts';

export function getStaticPaths() {
  return SCENES.map((s) => ({ params: { scene: s } }));
}

const s = scene(Astro.params.scene!);
const ticks = s.ticks ?? yearTicks(s.front[0], s.front[1]);
const total = s.total?.toLocaleString('en-US') ?? '';
const box = s.box ?? BOX;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Film: {s.id}</title>
    <Font cssVariable="--font-serif" preload={[{ weight: '400', style: 'normal' }, { weight: '400', style: 'italic' }]} />
    <Font cssVariable="--font-sans" preload={[{ weight: '400' }, { weight: '500' }]} />
    <Font cssVariable="--font-mono" preload={[{ weight: '400' }]} />
  </head>
  <body>
    <div
      class="stage"
      data-scene={s.id}
      data-x0={s.front[0]}
      data-x1={s.front[1]}
      data-from={Date.parse(FROM)}
      data-to={Date.parse(AS_OF)}
      data-starts={JSON.stringify(s.starts.map((x) => Math.round(x * 10) / 10))}
      data-stops={s.stops ? JSON.stringify(s.stops.map((p) => [Math.round(p.x * 10) / 10, p.label])) : undefined}
      data-rank={s.rank ? JSON.stringify(s.rank) : undefined}
    >
      <h1 set:html={s.title} style={s.titleSize ? `font-size:${s.titleSize}px` : undefined} />
      <p class="sub" style={s.subTop ? `top:${s.subTop}px;max-width:1072px` : undefined}>{s.subtitle}</p>
      {
        s.total !== undefined && (
          <div class="count" data-count>
            <span class="n">
              <span class="sizer" aria-hidden="true">{total}</span>
              <span class="val" data-n>{total}</span>
            </span>
            <span class="u">{s.unit}</span>
          </div>
        )
      }
      <svg class="chart" width={W} height={H} viewBox={`0 0 ${W} ${H}`}>
        <defs>
          <clipPath id="front"><rect data-front-clip x="0" y="0" width={W} height={H}></rect></clipPath>
          {s.defs && <Fragment set:html={s.defs} />}
        </defs>
        <g class="grid">
          {ticks.map((t) => <line x1={t.x} x2={t.x} y1={box.y0 - 6} y2={box.y1} />)}
        </g>
        <g class="ticks">
          {ticks.map((t) => <text x={t.x + 6} y={box.y1 + 24}>{t.label}</text>)}
        </g>
        {s.fixed && <g class="fixed" set:html={s.fixed} />}
        <g data-data>
          <g clip-path="url(#front)" set:html={s.reveal} />
          <g data-dots set:html={s.dots} />
        </g>
        <g data-end set:html={s.end} />
        <g data-cursor opacity="0">
          <line data-cursor-line x1="0" x2="0" y1={box.y0 - 10} y2={box.y1}></line>
          <text data-cursor-text x="0" y={box.y0 - 18} text-anchor="middle"></text>
        </g>
      </svg>
      <footer>
        <span class="word">Benchmark Almanac</span>
        <ul class="legend">
          {
            s.legend.map((l) => (
              <li>
                {l.shape ? (
                  <svg width="12" height="12" viewBox="0 0 10 10" style={`color:${l.color};fill:currentColor`} set:html={l.shape} />
                ) : l.line ? (
                  <b class="line" style={`background:${l.color}`} />
                ) : (
                  <i style={`background:${l.color}`} />
                )}
                {l.label}
              </li>
            ))
          }
        </ul>
      </footer>
    </div>

    <script>
      // The film's clock. 8 seconds at 30 frames a second, made to loop: it opens on the finished chart (the
      // poster), fades the data out, draws it again from January 2023 while the counter counts, then settles
      // on the finished chart once more, so the last frame leads straight into the first.
      const DURATION = 8;
      const HOLD = 1.4; // the finished chart
      const FADE = 0.4; // the data fades out
      const DRAW = 4.6; // the front sweeps from 2023 to today
      const SETTLE = 0.5; // the cursor leaves, the labels arrive
      const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

      const stage = document.querySelector<HTMLElement>('.stage')!;
      const num = (k: string) => Number(stage.dataset[k]);
      const [x0, x1, from, to] = [num('x0'), num('x1'), num('from'), num('to')];
      const starts: number[] = JSON.parse(stage.dataset.starts!);
      const clip = stage.querySelector<SVGRectElement>('[data-front-clip]')!;
      const data = stage.querySelector<SVGGElement>('[data-data]')!;
      const end = stage.querySelector<SVGGElement>('[data-end]')!;
      const cursor = stage.querySelector<SVGGElement>('[data-cursor]')!;
      const cline = stage.querySelector<SVGLineElement>('[data-cursor-line]')!;
      const ctext = stage.querySelector<SVGTextElement>('[data-cursor-text]')!;
      const count = stage.querySelector<HTMLElement>('[data-count]');
      const n = stage.querySelector<HTMLElement>('[data-n]');
      // a scene whose axis is not time names each point the cursor passes ("6 months", "10 labs")
      const stops: [number, string][] | null = stage.dataset.stops ? JSON.parse(stage.dataset.stops) : null;
      // circles grow their radius; other marks (the reporting scene's shapes) scale about their center
      const dots = [...stage.querySelectorAll<SVGGraphicsElement>('[data-dots] [data-x]')].map((c) => ({
        c,
        x: Number(c.dataset.x),
        r: Number(c.dataset.r),
        cx: Number(c.dataset.cx),
        cy: Number(c.dataset.cy),
        circle: c.tagName === 'circle',
      }));

      const clamp = (v: number) => Math.max(0, Math.min(1, v));
      // The front leaves at a brisk pace and slows into the present. Most benchmarks and models arrived in
      // 2025 and 2026, so the film spends its time where the chart is busy, not on an empty 2023.
      const sweep = (k: number) => 1 - (1 - k) ** 1.8;
      const out = (k: number) => 1 - (1 - k) ** 3;
      // a small overshoot, after the site's --spring, for a dot arriving
      const pop = (k: number) => (k <= 0 ? 0 : k >= 1 ? 1 : 1 + 2.2 * (k - 1) ** 3 + 1.2 * (k - 1) ** 2);
      const passed = (fx: number) => {
        let lo = 0;
        let hi = starts.length;
        while (lo < hi) {
          const m = (lo + hi) >> 1;
          if (starts[m] <= fx) lo = m + 1;
          else hi = m;
        }
        return lo;
      };

      function seek(t: number) {
        t = ((t % DURATION) + DURATION) % DURATION;
        let f = 1; // how far the front has come, 0 to 1
        let dataO = 1;
        let endO = 1;
        let cursorO = 0;
        let countO = 1;
        let counted = starts.length;
        const a = HOLD;
        const b = a + FADE;
        const c = b + DRAW;
        const d = c + SETTLE;
        if (t >= a && t < b) {
          dataO = endO = countO = 1 - out((t - a) / FADE);
        } else if (t >= b && t < c) {
          f = sweep((t - b) / DRAW);
          endO = 0;
          cursorO = out(clamp((t - b) / 0.2));
          counted = -1;
        } else if (t >= c && t < d) {
          const k = out((t - c) / SETTLE);
          endO = k;
          cursorO = 1 - k;
        }
        const fx = x0 + f * (x1 - x0);
        clip.setAttribute('width', String(f >= 1 ? 1200 : fx));
        data.setAttribute('opacity', dataO.toFixed(3));
        end.setAttribute('opacity', endO.toFixed(3));
        cursor.setAttribute('opacity', cursorO.toFixed(3));
        if (count && n) {
          count.style.opacity = countO.toFixed(3);
          n.textContent = (counted < 0 ? passed(fx) : counted).toLocaleString('en-US');
        }
        for (const p of dots) {
          const k = pop(clamp((fx - p.x) / 16));
          if (p.circle) p.c.setAttribute('r', (p.r * k).toFixed(2));
          else if (k === 1) p.c.removeAttribute('transform');
          else p.c.setAttribute('transform', `translate(${p.cx} ${p.cy}) scale(${k.toFixed(3)}) translate(${-p.cx} ${-p.cy})`);
        }
        cline.setAttribute('x1', fx.toFixed(1));
        cline.setAttribute('x2', fx.toFixed(1));
        ctext.setAttribute('x', Math.max(x0 + 40, Math.min(x1 - 40, fx)).toFixed(1));
        if (stops) {
          let label = stops[0][1];
          for (const [sx, l] of stops) if (sx <= fx + 0.5) label = l;
          ctext.textContent = label;
        } else {
          const at = new Date(from + f * (to - from));
          ctext.textContent = `${MONTHS[at.getUTCMonth()]} ${at.getUTCFullYear()}`;
        }
      }

      // ---- rank mode (the build scene): the weights shift, then the ranking glides into its new order ----
      type RankFilm = { states: { caption: string; shares: number[]; rank: number[]; value: number[] }[]; rows: number; max: number };
      const rank = stage.dataset.rank ? rankFilm(JSON.parse(stage.dataset.rank) as RankFilm) : null;
      function rankFilm(R: RankFilm) {
        const RDUR = 10;
        const MORPH = 0.6; // the weight bar moves
        const GLIDE = 0.6; // then the rows move, and their values count
        const n = R.states.length;
        // each visit: when it starts, from which weighting, to which. The film ends where it started.
        const visits = n >= 3 ? [1.6, 4.5, 7.4].map((t, i) => ({ t, a: i, b: (i + 1) % 3 })) : n === 2 ? [2, 6].map((t, i) => ({ t, a: i, b: (i + 1) % 2 })) : [];
        const X0 = 64;
        const BW = 1072;
        const TOP = 322;
        const ROW = 41;
        const BAR0 = X0 + 360;
        const BARW = 1136 - 96 - BAR0;
        const segs = [...stage.querySelectorAll<SVGGElement>('[data-seg]')].map((g) => ({ rects: [...g.querySelectorAll('rect')], text: g.querySelector('text')! }));
        const rows = [...stage.querySelectorAll<SVGGElement>('[data-row]')].map((g) => ({
          g,
          rk: g.querySelector<SVGTextElement>('.rk')!,
          bar: g.querySelector<SVGRectElement>('rect')!,
          val: g.querySelector<SVGTextElement>('.val')!,
        }));
        const cap = stage.querySelector<SVGTextElement>('[data-cap]')!;
        const lerp = (a: number, b: number, k: number) => a + (b - a) * k;
        const ease = (k: number) => (k < 0.5 ? 4 * k * k * k : 1 - (-2 * k + 2) ** 3 / 2);
        function at(t: number) {
          // where the weights and the rows are at time t: a weighting, or partway from one to the next
          let w = { a: 0, b: 0, k: 0 };
          let r = { a: 0, b: 0, k: 0 };
          let capK = 1;
          let capText = R.states[0].caption;
          for (const v of visits) {
            if (t >= v.t) {
              const kw = clamp((t - v.t) / MORPH);
              const kr = clamp((t - v.t - MORPH) / GLIDE);
              w = { a: v.a, b: v.b, k: ease(kw) };
              r = { a: v.a, b: v.b, k: ease(kr) };
              capText = kw < 0.5 ? R.states[v.a].caption : R.states[v.b].caption;
              capK = Math.abs(kw - 0.5) * 2;
            }
          }
          return { w, r, capK, capText };
        }
        function seek(t: number) {
          t = ((t % RDUR) + RDUR) % RDUR;
          const { w, r, capK, capText } = at(t);
          cap.textContent = capText;
          cap.setAttribute('opacity', capK.toFixed(3));
          let x = X0;
          segs.forEach((s, i) => {
            const share = lerp(R.states[w.a].shares[i], R.states[w.b].shares[i], w.k);
            const width = Math.max(0, share * BW - 3);
            for (const rect of s.rects) {
              rect.setAttribute('x', x.toFixed(1));
              rect.setAttribute('width', width.toFixed(1));
            }
            s.text.setAttribute('x', (x + 9).toFixed(1));
            // the whole name when it fits, else as much as fits with an ellipsis, else nothing
            const full = s.text.dataset.full ?? '';
            const ws: number[] = s.text.dataset.w ? JSON.parse(s.text.dataset.w) : [];
            const room = width - 18;
            let label = '';
            if (ws.length && ws[ws.length - 1] <= room) label = full;
            else for (let k = ws.length - 1; k >= 3; k--) if (ws[k - 1] + Number(s.text.dataset.dots) <= room) { label = `${full.slice(0, k).trimEnd()}…`; break; }
            if (s.text.textContent !== label) s.text.textContent = label;
            x += share * BW;
          });
          rows.forEach((row, j) => {
            const ra = R.states[r.a].rank[j];
            const rb = R.states[r.b].rank[j];
            const place = lerp(Math.min(ra, R.rows), Math.min(rb, R.rows), r.k);
            const seen = lerp(ra < R.rows ? 1 : 0, rb < R.rows ? 1 : 0, r.k);
            const v = lerp(R.states[r.a].value[j], R.states[r.b].value[j], r.k);
            const width = Math.max(2, (v / R.max) * BARW);
            row.g.setAttribute('transform', `translate(0 ${(TOP + place * ROW).toFixed(1)})`);
            row.g.setAttribute('opacity', seen.toFixed(3));
            row.rk.textContent = String(Math.round(r.k < 0.5 ? ra : rb) + 1);
            row.bar.setAttribute('width', width.toFixed(1));
            row.val.setAttribute('x', (BAR0 + width + 10).toFixed(1));
            row.val.textContent = v.toFixed(1);
          });
        }
        return { seek, duration: RDUR };
      }

      const ready = (async () => {
        await document.fonts.ready;
        // a leader's name longer than its column loses letters to an ellipsis, measured in the real font
        for (const el of stage.querySelectorAll<SVGTextElement>('text[data-w]')) {
          const max = Number(el.dataset.w);
          const full = el.textContent ?? '';
          for (let k = full.length; k > 4 && el.getComputedTextLength() > max; k--) el.textContent = `${full.slice(0, k - 1).trimEnd()}…`;
        }
        // the build scene names a weight segment only when its name fits inside it
        for (const el of stage.querySelectorAll<SVGTextElement>('text.seg')) {
          const full = el.dataset.full ?? '';
          el.textContent = full;
          el.dataset.w = JSON.stringify(Array.from({ length: full.length }, (_, k) => Math.ceil(el.getSubStringLength(0, k + 1))));
          el.dataset.dots = String(Math.ceil(el.getComputedTextLength() / Math.max(1, full.length)) + 2);
        }
        rank?.seek(0);
        return [...document.fonts].filter((f) => f.status === 'loaded').map((f) => f.family.replace(/["']/g, ''));
      })();

      const run = rank ?? { seek, duration: DURATION };
      Object.assign(window, { film: { duration: run.duration, fps: 30, poster: 0, seek: run.seek, ready } });
      run.seek(0);
      if (!location.search.includes('capture')) {
        const t0 = performance.now();
        const tick = (now: number) => {
          run.seek((now - t0) / 1000);
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    </script>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    background: #ffffff;
  }
  /* the site reserves a scrollbar's width on every page (global.css). The film has no scrollbar, and an
     edge-to-edge scene such as the ridge must reach the right edge */
  html {
    scrollbar-gutter: auto;
  }
  /* astro dev adds its toolbar to every page; the film must not show it */
  astro-dev-toolbar {
    display: none !important;
  }
  .stage {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    -webkit-font-smoothing: antialiased;
  }
  .stage h1 {
    position: absolute;
    left: 64px;
    top: 50px;
    max-width: 880px;
    margin: 0;
    font: 400 56px/1.04 var(--serif);
    letter-spacing: -0.015em;
  }
  .stage h1 em {
    font-style: italic;
  }
  .stage .sub {
    position: absolute;
    left: 64px;
    top: 124px;
    max-width: 820px;
    margin: 0;
    font: 400 19px/1.35 var(--sans);
    color: var(--ink-3);
  }
  .stage .count {
    position: absolute;
    right: 64px;
    top: 50px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }
  .stage .count .n {
    display: grid;
    justify-items: end;
    font: 400 44px/1 var(--sans);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }
  /* the final number holds the width, so the counter never pushes anything while it counts */
  .stage .count .n > * {
    grid-area: 1 / 1;
  }
  .stage .count .sizer {
    visibility: hidden;
  }
  .stage .count .u {
    font: 400 15px/1 var(--sans);
    color: var(--ink-3);
  }
  .stage .chart {
    position: absolute;
    inset: 0;
  }
  .stage .grid line {
    stroke: var(--grid);
    stroke-width: 1;
  }
  .stage .ticks text,
  .stage .ytick {
    font: 400 13px var(--mono);
    fill: var(--ink-4);
  }
  .stage [data-cursor-line] {
    stroke: var(--ink-3);
    stroke-width: 1;
  }
  .stage [data-cursor-text] {
    font: 500 14px var(--mono);
    fill: var(--ink-2);
  }
  .stage .lab {
    font: 400 16px var(--sans);
    fill: var(--ink-2);
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 5px;
    stroke-linejoin: round;
  }
  .stage .lab.lead {
    font-weight: 500;
    fill: var(--ink);
  }
  .stage .lab .v {
    font: 400 14px var(--mono);
    fill: var(--ink-3);
  }
  .stage .row {
    font: 400 15px var(--sans);
    fill: var(--ink-2);
  }
  .stage .who {
    font: 500 15px var(--sans);
    fill: var(--ink);
  }
  .stage .base {
    stroke: var(--line);
    stroke-width: 1;
  }
  .stage footer {
    position: absolute;
    left: 64px;
    right: 64px;
    bottom: 34px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
  }
  .stage .word {
    font: 400 23px/1 var(--serif);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .stage .legend {
    display: flex;
    flex-wrap: nowrap;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    font: 400 14px/1 var(--sans);
    color: var(--ink-2);
    white-space: nowrap;
  }
  .stage .legend li {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .stage .legend i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .stage .legend b.line {
    width: 18px;
    height: 3px;
    border-radius: 2px;
    align-self: center;
  }
  /* the pace scene: share axis, and the share and year at each line's end */
  .stage .hgrid {
    stroke: var(--grid);
    stroke-width: 1;
  }
  .stage .fixed .base {
    stroke: var(--line);
    stroke-width: 1;
  }
  .stage .pv {
    font: 500 26px var(--mono);
    fill: var(--ink-3);
    letter-spacing: -0.02em;
  }
  .stage .pv.lead {
    fill: var(--ink);
  }
  .stage .pv .py {
    font: 400 17px var(--sans);
    fill: var(--ink-3);
    letter-spacing: 0;
  }
  /* the build scene: the weight bar, its caption, and the ranking */
  .stage .cap {
    font: 500 14px var(--mono);
    fill: var(--ink-2);
  }
  .stage .seg {
    font: 500 14px var(--sans);
    fill: var(--ink);
  }
  .stage .rk {
    font: 400 15px var(--mono);
    fill: var(--ink-3);
  }
  .stage .nm {
    font: 500 19px var(--sans);
    fill: var(--ink);
  }
  .stage .val {
    font: 500 17px var(--mono);
    fill: var(--ink-2);
  }
  /* the reporting scene: the page's beeswarm, its area colors and its labels, larger for a small preview */
  .stage .a-knowledge { color: var(--area-knowledge); }
  .stage .a-reasoning { color: var(--area-reasoning); }
  .stage .a-code { color: var(--area-code); }
  .stage .a-agents { color: var(--area-agents); }
  .stage .a-work { color: var(--area-work); }
  .stage .a-multimodal { color: var(--area-multimodal); }
  .stage .a-safety { color: var(--area-safety); }
  .stage .a-other { color: var(--area-other); }
  .stage use {
    fill: currentColor;
  }
  .stage .rp-axl {
    stroke: var(--line);
    stroke-width: 1;
  }
  .stage .rp-tk {
    font: 400 13px var(--mono);
    fill: var(--ink-4);
  }
  .stage .rp-at {
    font: 400 14px var(--sans);
    fill: var(--ink-3);
  }
  .stage .rp-br,
  .stage .rp-ld {
    fill: none;
    stroke: var(--ink-4);
    stroke-width: 1;
  }
  .stage .rp-nb {
    font: 600 16px var(--mono);
    fill: var(--ink);
  }
  .stage .rp-ns {
    font: 400 15px var(--sans);
    fill: var(--ink-2);
  }
  .stage .rp-lb {
    font: 500 15px var(--sans);
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .stage .rp-lbn {
    font: 400 13px var(--mono);
    fill: var(--ink-3);
  }
</style>
