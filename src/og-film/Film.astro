---
// One link-preview film at its real size, 1200 by 630. Only `astro dev` serves this page (astro.config.mjs),
// at /og-film/<scene>/. Opened in a browser it plays on a loop. With ?capture, it holds still and
// scripts/og-film.ts calls window.film.seek(t) for each frame and screenshots it.
import { Font } from 'astro:assets';
import '../styles/global.css';
import { SCENES, scene, yearTicks, BOX, W, H, FROM, AS_OF } from './scenes.ts';

export function getStaticPaths() {
  return SCENES.map((s) => ({ params: { scene: s } }));
}

const s = scene(Astro.params.scene!);
const ticks = yearTicks(s.front[0], s.front[1]);
const total = s.total.toLocaleString('en-US');
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Film: {s.id}</title>
    <Font cssVariable="--font-serif" preload={[{ weight: '400', style: 'normal' }, { weight: '400', style: 'italic' }]} />
    <Font cssVariable="--font-sans" preload={[{ weight: '400' }, { weight: '500' }]} />
    <Font cssVariable="--font-mono" preload={[{ weight: '400' }]} />
  </head>
  <body>
    <div
      class="stage"
      data-scene={s.id}
      data-x0={s.front[0]}
      data-x1={s.front[1]}
      data-from={Date.parse(FROM)}
      data-to={Date.parse(AS_OF)}
      data-starts={JSON.stringify(s.starts.map((x) => Math.round(x * 10) / 10))}
    >
      <h1 set:html={s.title} />
      <p class="sub">{s.subtitle}</p>
      <div class="count" data-count>
        <span class="n"><span class="sizer" aria-hidden="true">{total}</span><span class="val" data-n>{total}</span></span>
        <span class="u">{s.unit}</span>
      </div>
      <svg class="chart" width={W} height={H} viewBox={`0 0 ${W} ${H}`}>
        <defs>
          <clipPath id="front"><rect data-front-clip x="0" y="0" width={W} height={H}></rect></clipPath>
        </defs>
        <g class="grid">
          {ticks.map((t) => <line x1={t.x} x2={t.x} y1={BOX.y0 - 6} y2={BOX.y1} />)}
        </g>
        <g class="ticks">
          {ticks.map((t) => <text x={t.x + 6} y={BOX.y1 + 24}>{t.label}</text>)}
        </g>
        <g data-data>
          <g clip-path="url(#front)" set:html={s.reveal} />
          <g data-dots set:html={s.dots} />
        </g>
        <g data-end set:html={s.end} />
        <g data-cursor opacity="0">
          <line data-cursor-line x1="0" x2="0" y1={BOX.y0 - 10} y2={BOX.y1}></line>
          <text data-cursor-text x="0" y={BOX.y0 - 18} text-anchor="middle"></text>
        </g>
      </svg>
      <footer>
        <span class="word">Benchmark Almanac</span>
        <ul class="legend">
          {
            s.legend.map((l) => (
              <li>
                {l.shape ? (
                  <svg width="12" height="12" viewBox="0 0 10 10" style={`color:${l.color};fill:currentColor`} set:html={l.shape} />
                ) : (
                  <i style={`background:${l.color}`} />
                )}
                {l.label}
              </li>
            ))
          }
        </ul>
      </footer>
    </div>

    <script>
      // The film's clock. 8 seconds at 30 frames a second, made to loop: it opens on the finished chart (the
      // poster), fades the data out, draws it again from January 2023 while the counter counts, then settles
      // on the finished chart once more, so the last frame leads straight into the first.
      const DURATION = 8;
      const HOLD = 1.4; // the finished chart
      const FADE = 0.4; // the data fades out
      const DRAW = 4.6; // the front sweeps from 2023 to today
      const SETTLE = 0.5; // the cursor leaves, the labels arrive
      const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

      const stage = document.querySelector<HTMLElement>('.stage')!;
      const num = (k: string) => Number(stage.dataset[k]);
      const [x0, x1, from, to] = [num('x0'), num('x1'), num('from'), num('to')];
      const starts: number[] = JSON.parse(stage.dataset.starts!);
      const clip = stage.querySelector<SVGRectElement>('[data-front-clip]')!;
      const data = stage.querySelector<SVGGElement>('[data-data]')!;
      const end = stage.querySelector<SVGGElement>('[data-end]')!;
      const cursor = stage.querySelector<SVGGElement>('[data-cursor]')!;
      const cline = stage.querySelector<SVGLineElement>('[data-cursor-line]')!;
      const ctext = stage.querySelector<SVGTextElement>('[data-cursor-text]')!;
      const count = stage.querySelector<HTMLElement>('[data-count]')!;
      const n = stage.querySelector<HTMLElement>('[data-n]')!;
      const dots = [...stage.querySelectorAll<SVGCircleElement>('[data-dots] circle')].map((c) => ({ c, x: Number(c.dataset.x), r: Number(c.dataset.r) }));

      const clamp = (v: number) => Math.max(0, Math.min(1, v));
      // The front leaves at a brisk pace and slows into the present. Most benchmarks and models arrived in
      // 2025 and 2026, so the film spends its time where the chart is busy, not on an empty 2023.
      const sweep = (k: number) => 1 - (1 - k) ** 1.8;
      const out = (k: number) => 1 - (1 - k) ** 3;
      // a small overshoot, after the site's --spring, for a dot arriving
      const pop = (k: number) => (k <= 0 ? 0 : k >= 1 ? 1 : 1 + 2.2 * (k - 1) ** 3 + 1.2 * (k - 1) ** 2);
      const passed = (fx: number) => {
        let lo = 0;
        let hi = starts.length;
        while (lo < hi) {
          const m = (lo + hi) >> 1;
          if (starts[m] <= fx) lo = m + 1;
          else hi = m;
        }
        return lo;
      };

      function seek(t: number) {
        t = ((t % DURATION) + DURATION) % DURATION;
        let f = 1; // how far the front has come, 0 to 1
        let dataO = 1;
        let endO = 1;
        let cursorO = 0;
        let countO = 1;
        let counted = starts.length;
        const a = HOLD;
        const b = a + FADE;
        const c = b + DRAW;
        const d = c + SETTLE;
        if (t >= a && t < b) {
          dataO = endO = countO = 1 - out((t - a) / FADE);
        } else if (t >= b && t < c) {
          f = sweep((t - b) / DRAW);
          endO = 0;
          cursorO = out(clamp((t - b) / 0.2));
          counted = -1;
        } else if (t >= c && t < d) {
          const k = out((t - c) / SETTLE);
          endO = k;
          cursorO = 1 - k;
        }
        const fx = x0 + f * (x1 - x0);
        clip.setAttribute('width', String(f >= 1 ? 1200 : fx));
        data.setAttribute('opacity', dataO.toFixed(3));
        end.setAttribute('opacity', endO.toFixed(3));
        cursor.setAttribute('opacity', cursorO.toFixed(3));
        count.style.opacity = countO.toFixed(3);
        n.textContent = (counted < 0 ? passed(fx) : counted).toLocaleString('en-US');
        for (const p of dots) p.c.setAttribute('r', (p.r * pop(clamp((fx - p.x) / 16))).toFixed(2));
        cline.setAttribute('x1', fx.toFixed(1));
        cline.setAttribute('x2', fx.toFixed(1));
        ctext.setAttribute('x', Math.max(x0 + 32, Math.min(x1 - 32, fx)).toFixed(1));
        const at = new Date(from + f * (to - from));
        ctext.textContent = `${MONTHS[at.getUTCMonth()]} ${at.getUTCFullYear()}`;
      }

      const ready = (async () => {
        await document.fonts.ready;
        // a leader's name longer than its column loses letters to an ellipsis, measured in the real font
        for (const el of stage.querySelectorAll<SVGTextElement>('text[data-w]')) {
          const max = Number(el.dataset.w);
          const full = el.textContent ?? '';
          for (let k = full.length; k > 4 && el.getComputedTextLength() > max; k--) el.textContent = `${full.slice(0, k - 1).trimEnd()}…`;
        }
        return [...document.fonts].filter((f) => f.status === 'loaded').map((f) => f.family.replace(/["']/g, ''));
      })();
      Object.assign(window, { film: { duration: DURATION, fps: 30, poster: 0, seek, ready } });
      seek(0);
      if (!location.search.includes('capture')) {
        const t0 = performance.now();
        const tick = (now: number) => {
          seek((now - t0) / 1000);
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    </script>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    background: #ffffff;
  }
  /* astro dev adds its toolbar to every page; the film must not show it */
  astro-dev-toolbar {
    display: none !important;
  }
  .stage {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    -webkit-font-smoothing: antialiased;
  }
  .stage h1 {
    position: absolute;
    left: 64px;
    top: 50px;
    max-width: 880px;
    margin: 0;
    font: 400 56px/1.04 var(--serif);
    letter-spacing: -0.015em;
  }
  .stage h1 em {
    font-style: italic;
  }
  .stage .sub {
    position: absolute;
    left: 64px;
    top: 124px;
    max-width: 820px;
    margin: 0;
    font: 400 19px/1.35 var(--sans);
    color: var(--ink-3);
  }
  .stage .count {
    position: absolute;
    right: 64px;
    top: 50px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }
  .stage .count .n {
    display: grid;
    justify-items: end;
    font: 400 44px/1 var(--sans);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }
  /* the final number holds the width, so the counter never pushes anything while it counts */
  .stage .count .n > * {
    grid-area: 1 / 1;
  }
  .stage .count .sizer {
    visibility: hidden;
  }
  .stage .count .u {
    font: 400 15px/1 var(--sans);
    color: var(--ink-3);
  }
  .stage .chart {
    position: absolute;
    inset: 0;
  }
  .stage .grid line {
    stroke: var(--grid);
    stroke-width: 1;
  }
  .stage .ticks text,
  .stage .ytick {
    font: 400 13px var(--mono);
    fill: var(--ink-4);
  }
  .stage [data-cursor-line] {
    stroke: var(--ink-3);
    stroke-width: 1;
  }
  .stage [data-cursor-text] {
    font: 500 14px var(--mono);
    fill: var(--ink-2);
  }
  .stage .lab {
    font: 400 16px var(--sans);
    fill: var(--ink-2);
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 5px;
    stroke-linejoin: round;
  }
  .stage .lab.lead {
    font-weight: 500;
    fill: var(--ink);
  }
  .stage .lab .v {
    font: 400 14px var(--mono);
    fill: var(--ink-3);
  }
  .stage .row {
    font: 400 15px var(--sans);
    fill: var(--ink-2);
  }
  .stage .who {
    font: 500 15px var(--sans);
    fill: var(--ink);
  }
  .stage .base {
    stroke: var(--line);
    stroke-width: 1;
  }
  .stage footer {
    position: absolute;
    left: 64px;
    right: 64px;
    bottom: 34px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
  }
  .stage .word {
    font: 400 23px/1 var(--serif);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .stage .legend {
    display: flex;
    flex-wrap: nowrap;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    font: 400 14px/1 var(--sans);
    color: var(--ink-2);
    white-space: nowrap;
  }
  .stage .legend li {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .stage .legend i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
</style>
