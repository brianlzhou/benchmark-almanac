---
// A small step line of the best score over time, for a page's masthead. Percentages use the full 0 to 100
// range, so a benchmark near the top looks near the top. Other units use their own range.
interface Props {
  points: { date: string; value: number }[];
  unit?: string;
  better?: 'higher' | 'lower';
  width?: number;
  height?: number;
  color?: string;
  label?: string;
}
const { points, unit = '%', better = 'higher', width = 120, height = 26, color = 'var(--ink-2)', label } = Astro.props;
const pts = [...points].sort((a, b) => a.date.localeCompare(b.date));
const t = (d: string) => Date.parse(d);
const t0 = pts.length ? t(pts[0].date) : 0;
const t1 = pts.length ? Math.max(t(pts.at(-1)!.date), t0 + 1) : 1;
const vs = pts.map((p) => p.value);
const lo = unit === '%' ? 0 : Math.min(...vs);
const hi = unit === '%' ? 100 : Math.max(...vs, lo + 1e-9);
const pad = 3;
const x = (d: string) => pad + ((t(d) - t0) / (t1 - t0)) * (width - 2 * pad);
const yRaw = (v: number) => pad + (1 - (v - lo) / (hi - lo)) * (height - 2 * pad);
const y = (v: number) => (better === 'lower' ? height - yRaw(v) : yRaw(v));
let d = '';
pts.forEach((p, i) => {
  d += i === 0 ? `M${x(p.date).toFixed(1)} ${y(p.value).toFixed(1)}` : `H${x(p.date).toFixed(1)}V${y(p.value).toFixed(1)}`;
});
const last = pts.at(-1);
---

{
  pts.length >= 2 && (
    <svg class="spark" width={width} height={height} viewBox={`0 0 ${width} ${height}`} role="img" aria-label={label ?? 'Best score over time'}>
      {unit === '%' && <line x1={pad} x2={width - pad} y1={y(100)} y2={y(100)} class="spark-top" />}
      <path d={d} fill="none" stroke={color} stroke-width="1.5" stroke-linejoin="round" />
      {last && <circle cx={x(last.date)} cy={y(last.value)} r="2.75" fill={color} />}
    </svg>
  )
}

<style>
  .spark {
    display: inline-block;
    overflow: visible;
    vertical-align: middle;
  }
  .spark-top {
    stroke: var(--grid);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }
</style>
