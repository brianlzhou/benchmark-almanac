---
// Share of time at number one, as one bar split by lab (the FT's proportional stacked bar). Each block's
// share is printed inside it when it fits. The key below repeats the names in block order.
import LabMark from './LabMark.astro';
import { labById } from '../lib/data.ts';
import { labColor, onLabColor } from '../lib/palette.ts';

interface Props {
  shares: { lab: string; share: number; count?: number }[];
  /** What a block measures, for its tooltip. */
  what?: string;
}
const { shares, what = 'Share of time at number one' } = Astro.props;
const shown = shares.filter((s) => s.share >= 0.005);
const pct = (v: number) => `${Math.round(v * 100)}%`;
const label = (s: { share: number; count?: number }) => (s.count !== undefined ? String(s.count) : pct(s.share));
---

<figure class="cs">
  <div class="bar" role="img" aria-label={shown.map((s) => `${labById.get(s.lab)?.name ?? 'Other labs'} ${label(s)}`).join(', ')}>
    {
      shown.map((s) => (
        <span
          class="blk"
          style={`flex:${s.share};background:${labColor(s.lab)};color:${onLabColor(s.lab)}`}
          data-tv={label(s)}
          data-tn={labById.get(s.lab)?.name ?? 'Other labs'}
          data-ts={what}
        >
          {s.share >= 0.06 && <span class="in num">{label(s)}</span>}
        </span>
      ))
    }
  </div>
  <div class="key">
    {
      shown.map((s) => (
        <span class="tag">
          {s.lab === 'other' || !labById.has(s.lab) ? (
            <svg width="12" height="12" aria-hidden="true">
              <rect width="12" height="12" rx="3" fill={labColor(s.lab)} />
            </svg>
          ) : (
            <LabMark lab={s.lab} size={14} />
          )}
          {labById.get(s.lab)?.name ?? 'Other labs'}
          <span class="muted num">{label(s)}</span>
        </span>
      ))
    }
  </div>
</figure>

<style>
  .cs {
    margin: 0;
  }
  .bar {
    display: flex;
    gap: 2px;
    height: 28px;
  }
  .blk {
    min-width: 2px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .in {
    padding-left: 8px;
    font-size: 12.5px;
    font-weight: 600;
    white-space: nowrap;
  }
  .key {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-top: 14px;
  }
</style>
