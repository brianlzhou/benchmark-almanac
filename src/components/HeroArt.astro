---
// The drawing behind the home page title: one thin line per benchmark, its best score from 2023 to today.
// Lines climb from the left and flatten near the top as benchmarks saturate. Color is the benchmark's area,
// so hovering an area chip in the hero can bring its lines forward. Drawn once at build time.
import { benchmarks, AS_OF } from '../lib/data.ts';
import { leaderRows } from '../lib/leaders.ts';
import { areaOf } from '../lib/taxonomy.ts';

const W = 1440;
const H = 420;
const FROM = Date.parse('2023-01-01');
const TO = Date.parse(AS_OF);
const x = (d: string) => Math.max(0, Math.min(W, ((Date.parse(d) - FROM) / (TO - FROM)) * W));
const y = (v: number) => H - 8 - (Math.max(0, Math.min(100, v)) / 100) * (H - 24);

const rows = leaderRows(
  benchmarks.map((b) => b.id),
  'all',
  5000,
);
const bench = new Map(benchmarks.map((b) => [b.id, b]));
// only benchmarks that arrived after the start of 2023, so each line begins where its benchmark did and the
// left edge is not a wall of older tests
const lines = rows
  .map((r) => {
    const steps = r.reigns.flatMap((g) => g.steps).sort((a, b) => a.date.localeCompare(b.date));
    if (steps.length < 2 || steps[0].date < '2023-01-01' || bench.get(r.benchmark)?.better === 'lower') return null;
    const end = r.replacedBy?.date && r.replacedBy.date < r.lastTested ? r.replacedBy.date : r.lastTested;
    const pts = steps.map((s) => [x(s.date), y(s.value)] as const);
    const ex = x(end);
    if (ex > pts.at(-1)![0] + 1) pts.push([ex, pts.at(-1)![1]]);
    // a smoothed step: each rise eases in and out over the gap to the next score
    let d = `M${pts[0][0].toFixed(0)} ${pts[0][1].toFixed(0)}`;
    for (let i = 1; i < pts.length; i++) {
      const [x0, y0] = pts[i - 1];
      const [x1, y1] = pts[i];
      if (Math.abs(y1 - y0) < 0.5) {
        d += `H${x1.toFixed(0)}`;
        continue;
      }
      const m = (x0 + x1) / 2;
      d += `C${m.toFixed(0)} ${y0.toFixed(0)} ${m.toFixed(0)} ${y1.toFixed(0)} ${x1.toFixed(0)} ${y1.toFixed(0)}`;
    }
    const b = bench.get(r.benchmark)!;
    return { d, area: areaOf(b.category), id: b.id, name: b.name, best: `${Math.round(steps.at(-1)!.value * 10) / 10}%` };
  })
  .filter((l) => !!l);
---

<svg class="hero-art" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="hero-fade-y" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0"></stop>
      <stop offset="0.3" stop-color="#fff" stop-opacity="0.35"></stop>
      <stop offset="0.6" stop-color="#fff" stop-opacity="0.9"></stop>
      <stop offset="0.86" stop-color="#fff" stop-opacity="0.9"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
    </linearGradient>
    <linearGradient id="hero-fade-x" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity="0"></stop>
      <stop offset="0.12" stop-color="#fff" stop-opacity="1"></stop>
      <stop offset="0.88" stop-color="#fff" stop-opacity="1"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
    </linearGradient>
    <mask id="hero-fade-xm" maskContentUnits="userSpaceOnUse">
      <rect width={W} height={H} fill="url(#hero-fade-x)"></rect>
    </mask>
    <mask id="hero-fade" maskContentUnits="userSpaceOnUse">
      <rect width={W} height={H} fill="url(#hero-fade-y)" mask="url(#hero-fade-xm)"></rect>
    </mask>
  </defs>
  <g mask="url(#hero-fade)" fill="none" stroke-width="1.1" stroke-linejoin="round">
    {lines.map((l) => <path d={l.d} data-a={l.area} data-b={l.id} data-n={l.name} data-v={l.best} />)}
  </g>
</svg>
<div class="hero-pick" aria-hidden="true"><b></b><span></span></div>

<script>
  import '../scripts/hero-art.ts';
</script>

<style is:global>
  .hero-art {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: max(100vw, 1100px);
    max-width: 1680px;
    height: 100%;
    transform: translateX(-50%);
    pointer-events: none;
    z-index: 0;
  }
  .hero-art path {
    vector-effect: non-scaling-stroke;
    stroke: var(--ink-4);
    stroke-opacity: 0.38;
    transition:
      stroke-opacity 140ms ease,
      stroke 140ms ease;
  }
  .hero-art path.on {
    stroke-opacity: 1;
    stroke-width: 2.2;
  }
  .hero.picking .hero-art path:not(.on) {
    stroke-opacity: 0.16;
  }
  .hero.picking {
    cursor: pointer;
  }
  /* the name of the line under the pointer */
  .hero-pick {
    position: absolute;
    z-index: 3;
    display: none;
    gap: 8px;
    align-items: baseline;
    padding: 6px 10px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    box-shadow: 0 8px 24px -12px rgb(0 0 0 / 0.3);
    font-size: 13px;
    white-space: nowrap;
    pointer-events: none;
  }
  .hero.picking .hero-pick {
    display: flex;
  }
  .hero-pick b {
    font-weight: 500;
  }
  .hero-pick span {
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .hero-art path[data-a='knowledge'] { stroke: var(--area-knowledge); }
  .hero-art path[data-a='reasoning'] { stroke: var(--area-reasoning); }
  .hero-art path[data-a='code'] { stroke: var(--area-code); }
  .hero-art path[data-a='agents'] { stroke: var(--area-agents); }
  .hero-art path[data-a='work'] { stroke: var(--area-work); }
  .hero-art path[data-a='multimodal'] { stroke: var(--area-multimodal); }
  .hero-art path[data-a='safety'] { stroke: var(--area-safety); }
  @media (prefers-reduced-motion: no-preference) {
    .hero-art g {
      animation: hero-rise 1200ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
</style>
