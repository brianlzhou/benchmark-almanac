---
// A benchmark's top five, small enough for a grid: the name as a link, then five rows of mark, model,
// value and a thin bar in the lab's color.
import type { BenchSummary } from '../lib/data.ts';
import ModelName from './ModelName.astro';
import { modelById, fromName } from '../lib/data.ts';
import { labColor } from '../lib/palette.ts';
import { score as fmt } from '../lib/format.ts';

interface Props {
  s: BenchSummary;
  n?: number;
}
const { s, n = 5 } = Astro.props;
const unit = s.b.unit ?? '%';
const max = unit === '%' ? 100 : Math.max(...s.board.slice(0, n).map((x) => x.value));
---

<article class="mb">
  <h3><a href={`/benchmarks/${s.b.id}/`}>{s.b.name}</a></h3>
  <p class="d">{s.b.description ?? ''}</p>
  <ol>
    {
      s.board.slice(0, n).map((x) => (
        <li>
          <ModelName id={x.model} size={15} />
          <span class="v num">{fmt(x.value, unit)}</span>
          <span class="t">
            <span style={`width:${Math.max(1, (x.value / max) * 100)}%;background:${labColor(modelById.get(x.model)?.lab)}`} />
          </span>
        </li>
      ))
    }
  </ol>
  <p class="src">{s.boardSource === 'leaderboard' ? 'Official leaderboard' : s.boardSource === 'epoch' ? 'Epoch AI runs' : s.boardSource === 'collected' ? `${s.board[0] ? fromName(s.board[0]) : 'Another board'}, via Epoch AI` : s.boardSource === 'claim' ? 'Claims Epoch AI collected' : 'As labs report it'}</p>
</article>

<style>
  .mb {
    min-width: 0;
  }
  h3 {
    font-size: 22px;
    line-height: 1.15;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--ink-4);
  }
  .d {
    margin-top: 6px;
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--ink-3);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.9em;
  }
  ol {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 11px;
  }
  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 12px;
    align-items: center;
    font-size: 14px;
  }
  .v {
    font-weight: 500;
  }
  .t {
    grid-column: 1 / -1;
    height: 4px;
    margin-top: 6px;
    border-radius: 2px;
    background: var(--panel);
  }
  .t span {
    display: block;
    height: 100%;
    border-radius: 2px;
  }
  .src {
    margin-top: 12px;
    font-size: 12.5px;
    color: var(--ink-3);
  }
</style>
