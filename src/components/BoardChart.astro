---
// A chart a benchmark's own leaderboard draws from more than its headline score, such as Realtime-Bench's
// latency against pass^3, redrawn from the numbers the importer reads (scripts/leaderboards/types.ts, `chart`).
// Each point is one run. The step line is the Pareto frontier: the runs no other run beats on both axes. Runs on
// the frontier are labeled. Entries that are not in our model list are gray. It renders at a desktop and a phone
// width, so text keeps its size on both.
import type { BoardChart, ChartAxis } from '../lib/data.ts';
import { leaderboardScores, unlistedScores, modelById } from '../lib/data.ts';
import { labColor } from '../lib/palette.ts';
import { linear, niceTicks, niceMax } from '../lib/scale.ts';
import type { Score } from '../lib/types.ts';

interface Props {
  benchmark: string;
  chart: BoardChart;
  label: string;
}
const { benchmark, chart, label } = Astro.props;

// an axis is the headline score, the run's cost or output tokens, or one of the board's other numbers
const valueOf = (s: Score, a: ChartAxis) =>
  a.key === 'score' ? s.value : a.key === 'cost' ? (s.cost ?? undefined) : a.key === 'tokens' ? (s.tokens ?? undefined) : s.metrics?.[a.key];
interface Pt {
  key: string;
  name: string;
  setting: string | null;
  lab?: string;
  listed: boolean;
  x: number;
  y: number;
  front: boolean;
}
const pts: Pt[] = [...leaderboardScores, ...unlistedScores]
  .filter((s) => s.benchmark === benchmark)
  .flatMap((s, i) => {
    const x = valueOf(s, chart.x);
    const y = valueOf(s, chart.y);
    if (x === undefined || y === undefined || !Number.isFinite(x) || !Number.isFinite(y)) return [];
    // a log axis has no place for zero or below
    if ((chart.x.log && x <= 0) || (chart.y.log && y <= 0)) return [];
    const m = s.model ? modelById.get(s.model) : undefined;
    return [{ key: `p${i}`, name: m?.name ?? s.name ?? s.model, setting: s.setting ?? null, lab: m?.lab, listed: !!m, x, y, front: false }];
  });

// the frontier: walking from the best x, keep each run that beats every run with a better x
const ox = chart.x.better === 'higher' ? -1 : 1;
const oy = chart.y.better === 'lower' ? -1 : 1;
const frontier: Pt[] = [];
for (const p of [...pts].sort((a, b) => ox * (a.x - b.x) || oy * (b.y - a.y))) {
  if (!frontier.length || oy * p.y > oy * frontier.at(-1)!.y) {
    p.front = true;
    frontier.push(p);
  }
}

const fmtAxis = (v: number, a: ChartAxis) => {
  const abs = Math.abs(v);
  const n =
    abs >= 1e6
      ? `${+(v / 1e6).toFixed(1)}M`
      : abs >= 1e4
        ? `${+(v / 1e3).toFixed(0)}K`
        : abs >= 100 || Number.isInteger(v)
          ? Math.round(v).toLocaleString('en-US')
          : abs >= 10
            ? v.toFixed(1).replace(/\.0$/, '')
            : abs >= 0.01
              ? String(+v.toFixed(2))
              : String(+v.toPrecision(1));
  return a.unit === '%' ? `${n}%` : a.unit === '$' || a.unit === 'usd' ? `$${n}` : a.unit ? `${n} ${a.unit}` : n;
};
const axisTitle = (a: ChartAxis) => `${a.unit && a.unit !== '%' ? `${a.label} (${a.unit === 'usd' ? '$' : a.unit})` : a.label}${a.log ? ', log scale' : ''}`;
const runName = (p: Pt) => `${p.name}${p.setting ? ` (${p.setting})` : ''}`;

/**
 * An axis's range and ticks. A log axis runs from the decade below the smallest value to the one above the largest.
 * A linear axis starts at 0 when the values sit near it, and otherwise just below the smallest value, so a rating
 * from 1,100 to 1,400 fills the chart. A percentage axis stops at 100.
 */
function axisOf(vals: number[], a: ChartAxis): { lo: number; hi: number; ticks: number[]; log: boolean } {
  if (!vals.length) return { lo: 0, hi: 1, ticks: [0, 1], log: false };
  const min = Math.min(...vals);
  const max = Math.max(...vals);
  if (a.log) {
    const lo = 10 ** Math.floor(Math.log10(min));
    const hi = 10 ** Math.ceil(Math.log10(max === min ? max * 10 : max));
    const ticks: number[] = [];
    for (let d = lo; d <= hi * 1.0001; d *= 10) ticks.push(d);
    // a single decade gets its 2 and 5 marks too
    if (ticks.length <= 2) for (const m of [2, 5]) if (lo * m < hi) ticks.push(lo * m);
    return { lo, hi, ticks: ticks.sort((p, q) => p - q), log: true };
  }
  const span = max - Math.min(0, min);
  const fromZero = min >= 0 && min < 0.4 * max;
  const floor = fromZero ? 0 : min - span * 0.08;
  let hi = niceMax(max + (fromZero ? 0 : span * 0.04));
  if (a.unit === '%' && max <= 100) hi = Math.min(100, hi);
  const raw = niceTicks(floor, hi, 5);
  const lo = fromZero ? 0 : Math.min(raw[0], floor);
  return { lo, hi, ticks: raw.filter((t) => t >= lo && t <= hi), log: false };
}
const ax = axisOf(pts.map((p) => p.x), chart.x);
const ay = axisOf(pts.map((p) => p.y), chart.y);
const xTicks = ax.ticks;
const yTicks = ay.ticks;
const scaleOf = (a: typeof ax, range: [number, number]) => {
  if (!a.log) return linear([a.lo, a.hi], range);
  const l = linear([Math.log10(a.lo), Math.log10(a.hi)], range);
  return (v: number) => l(Math.log10(v));
};

const sizes = [
  { key: 'wide', w: 760, h: 380, pad: { l: 56, r: 28, t: 18, b: 52 }, font: 12 },
  { key: 'narrow', w: 380, h: 300, pad: { l: 44, r: 14, t: 14, b: 46 }, font: 11 },
].map((z) => {
  const X = scaleOf(ax, [z.pad.l, z.w - z.pad.r]);
  const Y = scaleOf(ay, [z.h - z.pad.b, z.pad.t]);
  // the frontier as a step line: across at each run's level, then up or down to the next
  let d = '';
  frontier.forEach((p, i) => {
    d += i === 0 ? `M${X(p.x).toFixed(1)},${Y(p.y).toFixed(1)}` : `H${X(p.x).toFixed(1)}V${Y(p.y).toFixed(1)}`;
  });
  // labels on frontier runs, flipped to the left near the right edge, and nudged apart when two would touch
  const labels: { p: Pt; x: number; y: number; anchor: 'start' | 'end'; x0: number; x1: number }[] = [];
  for (const p of [...frontier].sort((a, b) => b.y - a.y)) {
    const px = X(p.x);
    const anchor = px > z.w * 0.62 ? 'end' : 'start';
    const x = anchor === 'start' ? px + 9 : px - 9;
    // the label's span from an average glyph width, so two labels that would touch are found by their text
    const w = runName(p).length * z.font * 0.56;
    const x0 = anchor === 'start' ? x : x - w;
    const x1 = x0 + w;
    // below the plot's top before the overlap check, so a label pushed down from the top edge is checked where it lands
    let ly = Math.max(z.pad.t + z.font, Y(p.y) - 9);
    while (labels.some((l) => Math.abs(l.y - ly) < z.font + 2 && l.x0 < x1 + 6 && x0 < l.x1 + 6)) ly += z.font + 3;
    // above the x axis
    ly = Math.min(ly, z.h - z.pad.b - 4);
    labels.push({ p, x, y: ly, anchor, x0, x1 });
  }
  return { ...z, X, Y, d, labels };
});
---

{
  pts.length >= 4 && (
    <figure class="bc" aria-label={label}>
      {sizes.map((z) => (
        <svg class:list={['bc-svg', z.key === 'wide' ? 'only-wide' : 'only-narrow']} viewBox={`0 0 ${z.w} ${z.h}`} role="img" aria-label={label} style={`--fs:${z.font}px`}>
          {yTicks.map((t) => (
            <g>
              <line class="grid" x1={z.pad.l} x2={z.w - z.pad.r} y1={z.Y(t)} y2={z.Y(t)} />
              <text class="tick" x={z.pad.l - 8} y={z.Y(t) + 4} text-anchor="end">{fmtAxis(t, chart.y).replace(/ \S+$/, '')}</text>
            </g>
          ))}
          {xTicks.map((t) => (
            <text class="tick" x={z.X(t)} y={z.h - z.pad.b + 18} text-anchor="middle">{fmtAxis(t, chart.x).replace(/ \S+$/, '')}</text>
          ))}
          <text class="axis" x={(z.pad.l + z.w - z.pad.r) / 2} y={z.h - 10} text-anchor="middle">{`${axisTitle(chart.x)}${chart.x.better === 'lower' ? ', lower is better' : ''}`}</text>
          <text class="axis" transform={`translate(13 ${(z.pad.t + z.h - z.pad.b) / 2}) rotate(-90)`} text-anchor="middle">{axisTitle(chart.y)}</text>
          <path class="front" d={z.d} />
          {[...pts]
            .sort((a, b) => Number(a.front) - Number(b.front))
            .map((p) => (
              <g class:list={['pt', { on: p.front }]}>
                <title>{`${runName(p)}: ${chart.y.label} ${fmtAxis(p.y, chart.y)}, ${chart.x.label.toLowerCase()} ${fmtAxis(p.x, chart.x)}${p.listed ? '' : '. Not in our model list'}`}</title>
                <circle class="dotm" cx={z.X(p.x)} cy={z.Y(p.y)} r={p.front ? 5.5 : 4.5} fill={p.listed ? labColor(p.lab) : 'var(--ink-4)'} />
                <circle cx={z.X(p.x)} cy={z.Y(p.y)} r="11" class="hit" />
              </g>
            ))}
          {z.labels.map((l) => (
            <text class="lab" x={l.x} y={l.y} text-anchor={l.anchor}>{runName(l.p)}</text>
          ))}
        </svg>
      ))}
    </figure>
  )
}

<style>
  .bc {
    margin: 0;
  }
  .bc-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-size: var(--fs);
  }
  /* one render per width: this rule outranks the site's .only-wide and .only-narrow, so it repeats them */
  .bc-svg.only-narrow {
    display: none;
  }
  @media (max-width: 720px) {
    .bc-svg.only-wide {
      display: none;
    }
    .bc-svg.only-narrow {
      display: block;
    }
  }
  .grid {
    stroke: var(--line);
    stroke-width: 1;
  }
  .tick {
    fill: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .axis {
    fill: var(--ink-2);
    font-weight: 500;
  }
  .front {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .dotm {
    stroke: var(--bg);
    stroke-width: 2;
    paint-order: stroke;
  }
  .pt:not(.on) .dotm {
    opacity: 0.55;
  }
  .hit {
    fill: transparent;
  }
  .lab {
    fill: var(--ink);
    font-weight: 500;
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 3px;
    stroke-linejoin: round;
  }
</style>
