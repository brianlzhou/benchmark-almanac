---
// How fast a new benchmark spreads: every line starts on the day a lab first named the benchmark, and climbs a step
// each time another lab names it. All of them share one start, so their shapes compare directly. The fastest to
// reach ten labs are drawn in their area color and named at their line ends, the two most widely named in ink, and
// the rest stay faint. It renders twice, at a desktop and a phone width, so text keeps its size on both.
import type { SpreadLine } from '../lib/reporting.ts';
import { textW } from '../lib/reporting-graphics.ts';
import { fullDate } from '../lib/format.ts';

interface Props {
  lines: SpreadLine[];
  /** How many of the fastest to the goal to draw in color. */
  fast?: number;
  /** The count of labs that marks "spread": ten of all labs, or all five frontier labs. */
  goal?: number;
  /** The goal in a few words, for labels: "ten labs", "all five". */
  goalText?: string;
}
const { lines, fast = 5, goal = 10, goalText = 'ten labs' } = Astro.props;
const reach = (l: SpreadLine) => (l.days.length >= goal ? l.days[goal - 1] : null);

const f1 = (n: number) => (Math.round(n * 10) / 10).toString();
const MONTH = 365.25 / 12;
const maxEnd = Math.max(...lines.map((l) => l.end));
const months = Math.ceil(maxEnd / MONTH / 3) * 3;
// up to a dozen labs get a tick each; dozens get one every ten
const most = Math.max(...lines.map((l) => l.days.length));
const maxLabs = most <= 12 ? most : Math.ceil(most / 10) * 10;
const yTicks = most <= 12 ? Array.from({ length: most + 1 }, (_, i) => i) : [0, 10, 20, 30, 40, 50].filter((n) => n <= maxLabs);

const fastest = lines
  .filter((l) => reach(l) != null)
  .sort((a, b) => reach(a)! - reach(b)! || a.name.localeCompare(b.name))
  .slice(0, fast);
// When the goal is every lab there is (the frontier labs), reaching it ends the story: lines stop there, and their
// names sit above that finish line in the order they crossed it, or in a column beside it on a phone. Only lines
// that crossed it get a name then, so the widest of the rest stay faint too.
const finish = goal >= most;
const widest = finish ? [] : lines.filter((l) => !fastest.includes(l)).slice(0, 2);
const on = new Set([...fastest, ...widest]);
const kind = (l: SpreadLine) => (fastest.includes(l) ? 'fast' : widest.includes(l) ? 'wide' : 'faint');
const lead = fastest[0];
// the fastest one's label carries its pace; a phone's narrow column keeps just the name
function endText(l: SpreadLine, narrow: boolean) {
  return l === lead && !narrow ? `${l.name}, ${goalText} in ${reach(l)} days` : l.name;
}

const ZONES = [
  { key: 'wide', w: 1120, h: 430, l: 34, r: 196, t: 14, b: 46, font: 12, every: 3, columns: false },
  { key: 'narrow', w: 358, h: 360, l: 26, r: 122, t: 14, b: 42, font: 11, every: 6, columns: true },
];

const stop = (l: SpreadLine) => (finish && reach(l) != null ? reach(l)! : l.end);

const views = ZONES.map((z0) => {
  const X = (days: number) => z0.l + (days / (months * MONTH)) * (z0.w - z0.l - z0.r);
  type L = { l: SpreadLine; ex: number; ey: number; x: number; y: number; w: number; text: string; col: boolean; slot: number };
  const placed: L[] = [];
  let rail = 0;
  if (finish) {
    const items = [...on]
      .filter((x) => reach(x) != null)
      .map((l) => {
        const text = endText(l, z0.columns);
        return { l, ex: X(reach(l)!), w: textW(text, z0.font), text };
      })
      .sort((a, b) => a.ex - b.ex);
    const minX = z0.l - 20;
    const maxX = z0.w - 2;
    const total = items.reduce((sum, it) => sum + it.w + 12, -12);
    if (!z0.columns && total <= maxX - minX) {
      // one rail above the finish line, in crossing order, pushed apart: the leaders slant but never cross
      const xs: number[] = [];
      items.forEach((it, i) => (xs[i] = Math.max(it.ex - it.w / 2, i ? xs[i - 1] + items[i - 1].w + 12 : minX)));
      for (let i = items.length - 1; i >= 0; i--) {
        const lim = i < items.length - 1 ? xs[i + 1] - 12 : maxX;
        if (xs[i] + items[i].w > lim) xs[i] = lim - items[i].w;
      }
      items.forEach((it, i) => placed.push({ ...it, ey: 0, x: xs[i], y: 0, col: false, slot: 0 }));
      rail = 1;
    } else
      // a column at the right: the crossing nearest the column takes the top place, so the leaders nest
      [...items]
        .sort((a, b) => b.ex - a.ex)
        .forEach((it, i) => placed.push({ ...it, ey: 0, x: z0.w - z0.r + 6, y: 0, col: true, slot: i }));
  }
  const z = { ...z0, t: z0.t + rail * (z0.font + 30) };
  const Y = (n: number) => z.h - z.b - (n / maxLabs) * (z.h - z.t - z.b);
  for (const e of placed) {
    e.ey = Y(goal);
    e.y = e.col ? Y(goal) + 4 + e.slot * (z.font + 4) : Y(goal) - 34;
  }
  const path = (l: SpreadLine) => {
    let d = `M${f1(X(0))},${f1(Y(1))}`;
    for (let k = 1; k < l.days.length && l.days[k] <= stop(l); k++) d += `H${f1(X(l.days[k]))}V${f1(Y(k + 1))}`;
    return `${d}H${f1(X(stop(l)))}`;
  };
  if (!finish) {
    // at the line's end on a wide screen, in a column at the right on a phone, pushed apart to never touch
    const ends: L[] = [...on]
      .map((l) => {
        const ex = X(l.end);
        const ey = Y(l.days.length);
        const text = endText(l, z.columns);
        return { l, ex, ey, x: z.columns ? z.w - z.r + 6 : ex + 6, y: ey + 4, w: textW(text, z.font), text, col: z.columns, slot: 0 };
      })
      .sort((a, b) => a.ey - b.ey);
    for (const e of ends) {
      const clash = () => placed.some((p) => e.x < p.x + p.w + 4 && p.x < e.x + e.w + 4 && Math.abs(p.y - e.y) < z.font + 3);
      // capped, so no layout can stall the page render
      for (let k = 0; k < 2000 && clash(); k++) e.y += 1;
      placed.push(e);
    }
  }
  const ticks: number[] = [];
  for (let mth = 0; mth <= months; mth += z.every) ticks.push(mth);
  return { z, X, Y, path, ends: placed, ticks };
});

const tipFor = (l: SpreadLine) => ({
  'data-tv': l.name,
  'data-tn': `${l.days.length} labs in ${l.end} days`,
  'data-ts': `${reach(l) != null ? `${goalText.replace(/^./, (c) => c.toUpperCase())} by day ${reach(l)}. ` : ''}First named ${fullDate(l.first)}`,
});
const ordered = [...lines].sort((a, b) => Number(on.has(a)) - Number(on.has(b)));
const label = `${lines.length} benchmarks released since 2025, each lined up on the day a lab first named it. ${fastest.map((l) => `${l.name} reached ${goalText} in ${reach(l)} days.`).join(' ')}`;
const mlabel = (m: number) => String(m);
---

<div class="rp-spread">
  {
    views.map(({ z, X, Y, path, ends, ticks }) => (
      <svg class={`only-${z.key}`} viewBox={`0 0 ${z.w} ${z.h}`} role={z.key === 'wide' ? 'group' : 'img'} aria-label={label} style={`--f:${z.font}px`} data-rove={z.key === 'wide' ? '' : undefined}>
        {yTicks.map((n) => (
          <g>
            <line class="g" x1={z.l} x2={z.w - z.r} y1={f1(Y(n))} y2={f1(Y(n))} />
            <text class="t num" x={z.l - 6} y={f1(Y(n) + 4)} text-anchor="end">
              {n}
            </text>
          </g>
        ))}
        {ticks.map((m) => (
          <text class="t num" x={f1(X(m * MONTH))} y={z.h - z.b + 18} text-anchor={m === 0 ? 'start' : 'middle'}>
            {mlabel(m)}
          </text>
        ))}
        <text class="t" x={z.l} y={z.h - 6}>
          Months since a lab first named it
        </text>
        {ordered.map((l, i) => (
          <g class={`rp-sl rp-${kind(l)}`} data-l={i} tabindex={z.key === 'wide' ? (l === lead ? 0 : -1) : undefined} {...(z.key === 'wide' ? tipFor(l) : {})}>
            <path class="hitl" d={path(l)} />
            <path class={`ln a-${l.area}`} d={path(l)} />
          </g>
        ))}
        {(finish ? fastest : lead ? [lead] : []).map((l) => (
          <g class="rp-ann">
            <circle class={`a-${l.area}`} cx={f1(X(reach(l)!))} cy={f1(Y(goal))} r="4" />
          </g>
        ))}
        {ends.map((e) => (
          <g class="rp-se">
            {finish && !e.col ? (
              <line x1={f1(e.ex)} y1={f1(e.ey - 5)} x2={f1(Math.min(Math.max(e.ex, e.x + 4), e.x + e.w - 4))} y2={f1(e.y + 3)} />
            ) : Math.abs(e.y - 4 - e.ey) > 3 || e.col ? (
              <line x1={f1(e.ex + 2)} y1={f1(e.ey)} x2={f1(e.x - 3)} y2={f1(e.y - 4)} />
            ) : null}
            <text x={f1(e.x)} y={f1(e.y)} class={kind(e.l) === 'fast' ? 'on' : ''}>
              {e.text}
            </text>
          </g>
        ))}
      </svg>
    ))
  }
</div>

<style>
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  svg.only-narrow {
    display: none;
  }
  @media (max-width: 720px) {
    svg.only-wide {
      display: none;
    }
    svg.only-narrow {
      display: block;
    }
  }
  .g {
    stroke: var(--grid);
    stroke-width: 1;
  }
  .t {
    font: 11px var(--mono);
    fill: var(--ink-3);
  }
  .rp-sl {
    outline: none;
  }
  .hitl {
    fill: none;
    stroke: transparent;
    stroke-width: 10;
  }
  .ln {
    fill: none;
    stroke-linejoin: round;
    transition: opacity 140ms ease;
  }
  .rp-faint .ln {
    stroke: var(--ink-4);
    stroke-width: 1.2;
    opacity: 0.45;
  }
  .rp-wide .ln {
    stroke: var(--ink-2);
    stroke-width: 2;
  }
  .rp-fast .ln {
    stroke: currentColor;
    stroke-width: 2.6;
  }
  .rp-sl:hover .ln,
  .rp-sl:focus-visible .ln {
    stroke-width: 3;
    opacity: 1;
  }
  .rp-sl.rp-faint:hover .ln,
  .rp-sl.rp-faint:focus-visible .ln {
    stroke: var(--ink);
  }
  .rp-ann circle {
    fill: currentColor;
    stroke: var(--bg);
    stroke-width: 2;
  }
  .rp-ann text,
  .rp-se text {
    font-size: var(--f);
    fill: var(--ink-2);
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .rp-ann text {
    font-weight: 600;
    fill: var(--ink);
  }
  .rp-se text.on {
    fill: var(--ink);
    font-weight: 500;
  }
  .rp-se line {
    stroke: var(--ink-4);
    stroke-width: 1;
  }
</style>
