---
// What model cards measure: for each half-year, the share of headline benchmarks in each area, stacked to
// 100%. Areas carry a legend and direct labels at the right edge where the band is tall enough.
import { cards, benchById } from '../lib/data.ts';
import type { Card } from '../lib/types.ts';
import { AREAS, areaOf } from '../lib/taxonomy.ts';
import { linear } from '../lib/scale.ts';

interface Props {
  lab?: string;
  height?: number;
}
const { lab, height = 380 } = Astro.props;
const src: Card[] = lab ? cards.filter((c) => c.lab === lab) : cards;
const half = (d: string) => `${d.slice(0, 4)}-${Number(d.slice(5, 7)) <= 6 ? 'H1' : 'H2'}`;
const buckets = [...new Set(src.map((c) => half(c.date)))].sort();
const order = AREAS.map((a) => a.id);
const share = buckets.map((k) => {
  const counts = new Map<string, number>(order.map((a) => [a, 0]));
  let n = 0;
  for (const c of src.filter((c) => half(c.date) === k))
    for (const r of c.results) {
      const a = areaOf(benchById.get(r.benchmark)?.category);
      counts.set(a, (counts.get(a) ?? 0) + 1);
      n++;
    }
  return { k, n, v: order.map((a) => (n ? (counts.get(a) ?? 0) / n : 0)) };
});
const used = order.filter((_, i) => share.some((s) => s.v[i] > 0));
const sizes = [
  { key: 'wide', w: 1120, h: height, font: 12.5, label: true },
  { key: 'narrow', w: 380, h: Math.round(height * 0.75), font: 11, label: false },
];
const pad = { l: 40, r: 150, t: 8, b: 30 };
const name = (id: string) => AREAS.find((a) => a.id === id)!.name;
const labelOf = (k: string) => (k.endsWith('H1') ? k.slice(0, 4) : '');

function shape(w: number, h: number, label: boolean) {
  const r = label ? pad.r : 12;
  const x = linear([0, Math.max(1, share.length - 1)], [pad.l, w - r]);
  const y = linear([0, 1], [h - pad.b, pad.t]);
  const layers = order.map((a, i) => {
    const lo = share.map((s) => s.v.slice(0, i).reduce((p, q) => p + q, 0));
    const hi = lo.map((v, j) => v + share[j].v[i]);
    const top = hi.map((v, j) => `${x(j)},${y(v)}`).join(' L');
    const bottom = lo.map((v, j) => `${x(j)},${y(v)}`).reverse().join(' L');
    const last = share.length - 1;
    return { a, d: `M${top} L${bottom} Z`, mid: y((lo[last] + hi[last]) / 2), thick: (hi[last] - lo[last]) * (h - pad.t - pad.b), endX: x(last) };
  });
  return { x, y, layers };
}
---

<figure class="as">
  <div class="key">
    {
      used.map((a) => (
        <span class="tag">
          <svg width="12" height="12" aria-hidden="true">
            <rect width="12" height="12" rx="3" fill={`var(--area-${a})`} />
          </svg>
          {name(a)}
        </span>
      ))
    }
  </div>
  {
    sizes.map(({ key, w, h, font, label }) => {
      const { x, y, layers } = shape(w, h, label);
      return (
        <svg class={`only-${key}`} viewBox={`0 0 ${w} ${h}`} role="img" aria-label="Share of model card benchmarks by area over time" style={`--f:${font}px`}>
          {[0, 0.25, 0.5, 0.75, 1].map((v) => (
            <text x={pad.l - 8} y={y(v) + 4} class="tick" text-anchor="end">
              {Math.round(v * 100)}%
            </text>
          ))}
          {layers.map((l) => (
            <path d={l.d} fill={`var(--area-${l.a})`} class="layer" />
          ))}
          {share.map((s, j) => (
            <g>
              {labelOf(s.k) && (
                <text x={x(j)} y={h - 8} class="tick" text-anchor="middle">
                  {labelOf(s.k)}
                </text>
              )}
              <rect
                x={x(j) - (x(1) - x(0)) / 2}
                y={pad.t}
                width={x(1) - x(0)}
                height={h - pad.t - pad.b}
                class="hit"
                data-tn={`${s.k.slice(0, 4)}, ${s.k.endsWith('H1') ? 'first half' : 'second half'}`}
                data-ts={order
                  .map((a, i) => ({ a, v: s.v[i] }))
                  .filter((z) => z.v >= 0.01)
                  .sort((p, q) => q.v - p.v)
                  .map((z) => `${name(z.a)} ${Math.round(z.v * 100)}%`)
                  .join('. ')}
                data-tv={`${s.n} benchmark mentions`}
              />
            </g>
          ))}
          {label &&
            layers
              .filter((l) => l.thick >= 16)
              .map((l) => (
                <text x={l.endX + 10} y={l.mid + 4} class="end">
                  {name(l.a)}
                </text>
              ))}
        </svg>
      );
    })
  }
</figure>

<style>
  .as {
    margin: 0;
  }
  .key {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-bottom: 14px;
  }
  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .layer {
    stroke: var(--bg);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .tick {
    font: 400 var(--f) / 1 var(--mono);
    fill: var(--ink-3);
  }
  .end {
    font: 400 var(--f) / 1 var(--sans);
    fill: var(--ink-2);
  }
  .hit {
    fill: transparent;
  }
  .hit:hover {
    fill: rgb(255 255 255 / 0.18);
  }
</style>
