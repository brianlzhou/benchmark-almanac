---
// An arena's categories in one switch: a list of every category with its leader, and the top ten of the one
// picked, each with how far the model moved from its overall rank. "Show all" adds the rest of that category's
// board. On a phone the list becomes a menu. The URL keeps the choice (?cat=coding). The ratings come from
// src/lib/arena-categories.ts.
import ModelName from './ModelName.astro';
import LabMark from './LabMark.astro';
import { modelById } from '../lib/data.ts';
import { CAT_GROUPS, CAT_NOTE, inlineName, type CatGroup, type CatView } from '../lib/arena-categories.ts';
import { score as fmt } from '../lib/format.ts';
import type { Score } from '../lib/types.ts';

interface Props {
  views: CatView[];
  /** The page's overall board, best first: ranks there are what the arrows compare against. */
  overall: Score[];
  unit: string;
  arena: string;
}
const { views, overall, unit, arena } = Astro.props;
const TOP = 10;
const overallRank = new Map(overall.map((x, i) => [x.model, i + 1]));
const groups = CAT_GROUPS.map((g) => ({ g, vs: views.filter((v) => v.group === g) })).filter((x) => x.vs.length);
const first = views[0].key;
const count = (n: number, one: string, many = `${one}s`) => `${n.toLocaleString('en-US')} ${n === 1 ? one : many}`;
const and = (xs: string[]) => (xs.length < 3 ? xs.join(' and ') : `${xs.slice(0, -1).join(', ')} and ${xs.at(-1)}`);
const nameOf = (id: string) => modelById.get(id)?.name ?? id;
// the categories proper, and the other ways Arena ranks the same votes (ties left out, factuality weighted)
const ranked = views.filter((v) => v.group !== 'Method');
const methods = views.filter((v) => v.group === 'Method');
// one view needs no switch: Search Arena has only its factuality weighted ranking
const single = views.length === 1;
const title = ranked.length ? 'Rankings by category' : methods.length === 1 && methods[0].key === 'factuality' ? 'Ranked with factuality weighted in' : 'Another way to rank';
// the finding: who leads the most categories (methods aside, since they rank the same votes another way)
const leads = new Map<string, CatView[]>();
for (const v of ranked) leads.set(v.board[0].model, [...(leads.get(v.board[0].model) ?? []), v]);
const byLead = [...leads].sort((a, b) => b[1].length - a[1].length);
const [top, topVs] = byLead[0] ?? [];
const finding = !top
  ? ''
  : leads.size === 1
    ? `${nameOf(top)} leads ${ranked.length === 2 ? 'both' : 'every one of them'}.`
    : ranked.length === 2
      ? `${nameOf(top)} leads ${inlineName(topVs![0])} and ${nameOf(byLead[1][0])} leads ${inlineName(byLead[1][1][0])}.`
      : leads.size === 2
        ? `${nameOf(top)} leads ${topVs!.length} of them, and ${nameOf(byLead[1][0])} leads the other ${byLead[1][1].length === 1 ? 'one' : byLead[1][1].length}.`
        : `${nameOf(top)} leads ${topVs!.length} of them, and ${count(leads.size - 1, 'other model')} lead the rest.`;
const listed =
  ranked.length <= 3 ? `: ${and(ranked.map(inlineName))}. Each is rated on the votes for one kind of prompt.` : `, each rated on the votes for one kind of prompt, such as ${and(ranked.slice(0, 3).map(inlineName))}.`;
const GROUP_NAME: Record<CatGroup, string> = { Task: 'Tasks', Language: 'Languages', Industry: 'Industries', Method: 'Other ways to rank' };
const METHOD_PHRASE: Record<string, string> = { factuality: 'with factuality weighted in', exclude_ties: 'with ties left out' };
const ARROWS = 'Arrows show how far a model moved from its overall rank among the models we track.';
// The rows past the top ten wait behind "Show all", since Text alone has about 9,000 of them. Each model's name
// and mark is rendered once, in a template the script copies from, so the added rows look like the first ten. A
// row is [the model's place in that template, score as shown, overall rank or 0].
const restModels = [...new Set(views.flatMap((v) => v.board.slice(TOP).map((x) => x.model)))];
const at = new Map(restModels.map((id, i) => [id, i]));
const rest = (v: CatView) => JSON.stringify(v.board.slice(TOP).map((x) => [at.get(x.model), fmt(x.value, unit), overallRank.get(x.model) ?? 0])).replace(/</g, '\\u003c');
---

<section class="views cats" data-cats>
  <div class="sh">
    <h2>{title}</h2>
    {
      ranked.length > 0 ? (
        <p>
          We read {count(ranked.length, 'category', 'categories')} from {arena}{listed} One vote counts in every category its prompt fits. {finding}
          {methods.length > 0 && ` The list ends with ${methods.length === 1 ? 'another way' : methods.length === 2 ? 'two other ways' : `${methods.length} other ways`} ${arena} ranks the same votes.`} {ARROWS}
        </p>
      ) : (
        <p>
          We also read {arena}’s ranking of the same battles {and(methods.map((v) => METHOD_PHRASE[v.key] ?? v.name.toLowerCase()))}.
          {methods.length === 1 && CAT_NOTE[methods[0].key] && ` ${CAT_NOTE[methods[0].key]}`} {nameOf(methods[0].board[0].model)} leads it. {ARROWS}
        </p>
      )
    }
  </div>
  <div class:list={['cg', { single }]}>
    {!single && (
      <label class="cpick">
        <span>Category</span>
        <select data-cat-select>
          {
            groups.map(({ g, vs }) => (
              <optgroup label={GROUP_NAME[g]}>
                {vs.map((v) => (
                  <option value={v.key} selected={v.key === first}>
                    {v.name}
                  </option>
                ))}
              </optgroup>
            ))
          }
        </select>
      </label>
    )}
    {!single && (
      <nav class="cl" aria-label="Categories">
        {
          groups.map(({ g, vs }) => (
            <div class="cgp">
              {groups.length > 1 && <h3>{GROUP_NAME[g]}</h3>}
              {vs.map((v) => {
                const lead = modelById.get(v.board[0].model);
                return (
                  <button type="button" data-cat={v.key} aria-pressed={v.key === first ? 'true' : 'false'}>
                    <span class="cn">{v.name}</span>
                    <span class="cw">
                      <LabMark lab={lead?.lab} size={13} />
                      <span>{lead?.name ?? v.board[0].model}</span>
                    </span>
                  </button>
                );
              })}
            </div>
          ))
        }
      </nav>
    )}
    <div class="cp">
      {
        views.map((v) => (
          <div class="cv" data-cat-view={v.key} hidden={v.key !== first}>
            {!single && <h3>{v.name}</h3>}
            <p class="cd">
              {!single && CAT_NOTE[v.key] && `${CAT_NOTE[v.key]} `}
              {count(v.board.length, 'model')} we track {v.board.length === 1 ? 'has' : 'have'} a rating here.
            </p>
            <ol>
              {v.board.slice(0, TOP).map((x, i) => {
                const was = overallRank.get(x.model);
                const move = was ? was - (i + 1) : 0;
                return (
                  <li>
                    <span class="rk num">{i + 1}</span>
                    <ModelName id={x.model} size={15} />
                    <span class:list={['mv', 'num', { up: move > 0, down: move < 0 }]} title={was ? `Number ${was} overall` : 'No overall rating'}>
                      {move > 0 ? `↑${move}` : move < 0 ? `↓${-move}` : ''}
                    </span>
                    <span class="v num">{fmt(x.value, unit)}</span>
                  </li>
                );
              })}
            </ol>
            {v.board.length > TOP && (
              <>
                <script is:inline type="application/json" data-cat-rest set:html={rest(v)} />
                <button type="button" class="more-rows" data-cat-more>
                  Show all {v.board.length.toLocaleString('en-US')}
                </button>
              </>
            )}
          </div>
        ))
      }
    </div>
  </div>
  {
    restModels.length > 0 && (
      <template data-cat-models>
        {restModels.map((id) => (
          <span>
            <ModelName id={id} size={15} />
          </span>
        ))}
      </template>
    )
  }
  <script>
    for (const sec of document.querySelectorAll<HTMLElement>('[data-cats]')) {
      // "Show all": copy a top-ten row for each model past the first ten, with that model's name and mark
      const tpl = sec.querySelector<HTMLTemplateElement>('[data-cat-models]');
      const marks = tpl ? [...tpl.content.children].map((m) => m.firstElementChild!) : [];
      for (const btn of sec.querySelectorAll<HTMLButtonElement>('[data-cat-more]')) {
        btn.addEventListener('click', () => {
          const view = btn.closest<HTMLElement>('[data-cat-view]')!;
          const ol = view.querySelector('ol')!;
          const proto = ol.querySelector('li')!;
          const rows = JSON.parse(view.querySelector('[data-cat-rest]')!.textContent!) as [number, string, number][];
          const start = ol.children.length;
          const frag = document.createDocumentFragment();
          rows.forEach(([m, score, was], i) => {
            const rank = start + i + 1;
            const li = proto.cloneNode(true) as HTMLElement;
            li.querySelector('.rk')!.textContent = String(rank);
            const mark = marks[m];
            if (mark) li.querySelector('.mn')!.replaceWith(mark.cloneNode(true));
            const mv = li.querySelector<HTMLElement>('.mv')!;
            const move = was ? was - rank : 0;
            mv.textContent = move > 0 ? `↑${move}` : move < 0 ? `↓${-move}` : '';
            mv.classList.toggle('up', move > 0);
            mv.classList.toggle('down', move < 0);
            mv.title = was ? `Number ${was} overall` : 'No overall rating';
            li.querySelector('.v')!.textContent = score;
            frag.append(li);
          });
          ol.append(frag);
          btn.hidden = true;
          view.dataset.open = '';
        });
      }
      // the list and the phone menu pick the same view, and the URL keeps it
      const sel = sec.querySelector<HTMLSelectElement>('[data-cat-select]');
      if (!sel) continue;
      const show = (key: string, push = true) => {
        if (!sec.querySelector(`[data-cat-view="${CSS.escape(key)}"]`)) return;
        for (const v of sec.querySelectorAll<HTMLElement>('[data-cat-view]')) v.hidden = v.dataset.catView !== key;
        for (const b of sec.querySelectorAll<HTMLButtonElement>('[data-cat]')) b.setAttribute('aria-pressed', String(b.dataset.cat === key));
        sel.value = key;
        if (push) {
          const u = new URL(location.href);
          u.searchParams.set('cat', key);
          history.replaceState(history.state, '', u);
        }
      };
      for (const b of sec.querySelectorAll<HTMLButtonElement>('[data-cat]')) b.addEventListener('click', () => show(b.dataset.cat!));
      sel.addEventListener('change', () => show(sel.value));
      const q = new URLSearchParams(location.search).get('cat');
      if (q) show(q, false);
    }
  </script>
</section>

<style>
  .cg {
    display: grid;
    grid-template-columns: minmax(260px, 340px) minmax(0, 1fr);
    gap: 40px 56px;
    align-items: start;
  }
  .cg.single {
    grid-template-columns: minmax(0, 1fr);
    max-width: 760px;
  }
  .cpick {
    display: none;
  }
  .cl {
    display: grid;
    gap: 22px;
  }
  /* the list can be twice as tall as the top ten, so the top ten stays in view while you scroll the list. A
     whole board is taller than the screen, so it scrolls with the page. */
  .cp {
    position: sticky;
    top: calc(var(--bar-h) + 24px);
  }
  .cp:has(> [data-open]:not([hidden])) {
    position: static;
  }
  .cgp {
    display: grid;
    gap: 2px;
  }
  .cgp h3 {
    font: 500 13px/1.3 var(--sans);
    color: var(--ink-3);
    margin: 0 0 4px 10px;
  }
  .cl button {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, auto);
    gap: 12px;
    align-items: center;
    text-align: left;
    font: inherit;
    font-size: 14px;
    color: var(--ink-2);
    background: none;
    border: 0;
    border-radius: 7px;
    padding: 7px 10px;
    cursor: pointer;
  }
  .cl button:hover {
    background: var(--hover);
  }
  .cl button[aria-pressed='true'] {
    background: var(--panel);
    color: var(--ink);
  }
  .cl button[aria-pressed='true'] .cn {
    font-weight: 500;
  }
  .cn {
    min-width: 0;
  }
  .cw {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    max-width: 200px;
    color: var(--ink-3);
    font-size: 12.5px;
  }
  .cw span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cv h3 {
    font-size: 22px;
    line-height: 1.15;
  }
  .cd {
    margin-top: 6px;
    color: var(--ink-3);
    font-size: 13.5px;
    max-width: 70ch;
  }
  .cv ol {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .cv li {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) 48px auto;
    gap: 12px;
    align-items: center;
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
    font-size: 14.5px;
  }
  .rk {
    color: var(--ink-3);
  }
  .mv {
    color: var(--ink-3);
    font-size: 13px;
    text-align: right;
  }
  .mv.up,
  .mv.down {
    color: var(--ink-2);
  }
  .v {
    font-weight: 500;
    text-align: right;
    min-width: 56px;
  }
  @media (max-width: 860px) {
    .cg {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    .cp {
      position: static;
    }
    .cl {
      display: none;
    }
    .cpick {
      display: grid;
      gap: 6px;
      font-size: 13px;
      color: var(--ink-3);
      max-width: 360px;
    }
    .cpick select {
      font: inherit;
      font-size: 15px;
      color: var(--ink);
      background: var(--panel);
      border: 0;
      border-radius: 8px;
      padding: 10px 12px;
    }
  }
</style>
