---
// A ranked leaderboard as horizontal bars: rank, the lab's mark and the model, a bar in the lab's color
// from a zero baseline, and the value at its tip. Bars are 14 px with air between rows.
import type { Score } from '../lib/types.ts';
import ModelName from './ModelName.astro';
import { modelById, sourceLabel, isClaim, isRerun, entryLabel, LEADERBOARDS, intervalName } from '../lib/data.ts';
import { labColor, agentTint } from '../lib/palette.ts';
import { score as fmt, monthYear } from '../lib/format.ts';
import { niceMax, ratingFloor } from '../lib/scale.ts';
import { frontierAttrs } from '../lib/frontier.ts';

interface Props {
  scores: Score[];
  unit?: string;
  limit?: number;
  highlight?: string;
  better?: 'higher' | 'lower';
  /** Draw every row, with the ones past the limit behind a "Show all" button. */
  all?: boolean;
}
const { scores, unit = '%', limit = 15, highlight, better = 'higher', all = false } = Astro.props;
const rows = all ? scores : scores.slice(0, limit);
const more = all && scores.length > limit + 2;
// keep the highlighted model visible even when it ranks below the cut
const hi = highlight ? scores.findIndex((s) => s.model === highlight) : -1;
const what = scores.some((s) => !s.model) ? 'entries' : 'models';
const extra = hi >= limit && !all ? scores[hi] : undefined;
const rated = (unit === 'elo' || unit === 'rating') && better !== 'lower';
const top = Math.max(...scores.map((s) => s.value), 1e-9);
const max = unit === '%' && better !== 'lower' ? 100 : rated ? top : niceMax(top);
// a rating has no true zero, so its bars start a little below the lowest rating on the board
const lo = rated ? ratingFloor(scores.map((s) => s.value)) : 0;
const pctW = (v: number) => Math.max(0.6, ((Math.min(max, Math.max(lo, v)) - lo) / (max - lo)) * 100);
const w = (v: number) => `${pctW(v)}%`;
// a whisker for each score whose board publishes an interval; the board's switch hides them
const whisker = (s: Score) => {
  const a = s.info?.low;
  const b = s.info?.high;
  if (a === undefined || b === undefined || !(b > a)) return undefined;
  return { left: pctW(a), width: Math.max(0.3, pctW(b) - pctW(a)), past: Math.max(0, pctW(b) - pctW(s.value)), text: `${(intervalName(s.benchmark) ?? 'interval').replace(/^./, (c) => c.toUpperCase())}: ${fmt(a, unit)} to ${fmt(b, unit)}` };
};
const src = (s: Score) => sourceLabel(s);
// an agent system is drawn in a pale tint of its model's lab, and a blend in gray: their scores are shown, never
// credited to the model's lab
const lab = (s: Score) => (s.system ? undefined : modelById.get(s.model)?.lab);
const fill = (s: Score) => (!s.system ? labColor(lab(s)) : (s.info?.models?.length ?? 0) > 1 ? labColor(undefined) : agentTint(modelById.get(s.model)?.lab));
const mark = (s: Score) => (s.info?.verified && LEADERBOARDS[s.benchmark]?.verified ? `Verified: ${LEADERBOARDS[s.benchmark].verified}` : undefined);
---

{lo > 0 && <p class="bb-base">Bars start at {lo.toLocaleString('en-US')}.</p>}
<ol class="bb" data-bb>
  {
    rows.map((s, i) => (
      <li {...frontierAttrs(s.model)} class:list={{ hi: !!s.model && s.model === highlight, later: more && i >= limit }}>
        <span class="rk num">{i + 1}</span>
        <span class="who">
          <ModelName id={s.model} setting={s.setting} name={s.name} system={s.system} models={s.info?.models} verified={mark(s)} />
        </span>
        <span class="track" data-tv={fmt(s.value, unit)} data-tn={`${entryLabel(s)}${s.setting && s.setting !== 'unknown' ? ` (${s.setting})` : ''}`} data-ts={`${src(s)}${s.date ? `, ${monthYear(s.date)}` : ''}${whisker(s) ? `\n\n${whisker(s)!.text}` : ''}`} style={whisker(s) ? `--past:${whisker(s)!.past.toFixed(2)}%` : undefined}>
          <span class:list={['fill', { claim: isClaim(s), rerun: isRerun(s) }]} style={`width:${w(s.value)};background-color:${fill(s)}`} />
          {whisker(s) && <span class="wk" style={`left:${whisker(s)!.left.toFixed(2)}%;width:${whisker(s)!.width.toFixed(2)}%`} aria-hidden="true" />}
          <span class="val num">{fmt(s.value, unit)}</span>
        </span>
      </li>
    ))
  }
  {
    extra && (
      <>
        <li class="gap" aria-hidden="true">
          <span />
        </li>
        <li class="hi">
          <span class="rk num">{hi + 1}</span>
          <span class="who">
            <ModelName id={extra.model} setting={extra.setting} />
          </span>
          <span class="track">
            <span class:list={['fill', { claim: isClaim(extra), rerun: isRerun(extra) }]} style={`width:${w(extra.value)};background-color:${labColor(modelById.get(extra.model)?.lab)}`} />
            <span class="val num">{fmt(extra.value, unit)}</span>
          </span>
        </li>
      </>
    )
  }
</ol>
{
  more && (
    <button type="button" class="bb-more" data-bb-more aria-expanded="false" data-dl-skip>
      Show all {scores.length} {what}
    </button>
  )
}

<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-bb-more]')) {
    const list = b.previousElementSibling as HTMLElement;
    const label = b.textContent!.trim();
    b.addEventListener('click', () => {
      const open = list.classList.toggle('open');
      b.setAttribute('aria-expanded', String(open));
      b.textContent = open ? 'Show fewer' : label;
      if (!open) list.scrollIntoView({ block: 'nearest' });
    });
  }
</script>

<style>
  .bb-base {
    margin: -8px 0 10px;
    font-size: 13px;
    color: var(--ink-3);
  }
  .bb:not(.open) .later {
    display: none;
  }
  .bb-more {
    margin-top: 12px;
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    color: var(--ink-2);
    font: 500 13.5px/1 var(--sans);
    cursor: pointer;
  }
  .bb-more:hover {
    background: var(--panel);
    color: var(--ink);
  }
  .bb {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: auto minmax(160px, 300px) 1fr;
    column-gap: 16px;
  }
  li {
    display: contents;
  }
  li > * {
    padding: 7px 0;
  }
  .rk {
    color: var(--ink-3);
    font-size: 13px;
    text-align: right;
    min-width: 2ch;
    align-self: center;
  }
  .who {
    min-width: 0;
    display: flex;
    align-items: center;
    font-size: 14.5px;
  }
  .track {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  /* the board's interval: a thin line with caps across the bar, and the value moved past its end */
  .wk {
    position: absolute;
    top: 50%;
    height: 10px;
    transform: translateY(-50%);
    border-left: 1.5px solid var(--ink);
    border-right: 1.5px solid var(--ink);
    opacity: 0.8;
    pointer-events: none;
  }
  .wk::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1.5px;
    background: var(--ink);
    transform: translateY(-50%);
  }
  .track:has(.wk) .val {
    margin-left: var(--past, 0%);
  }
  :global(.wk-off) .wk {
    display: none;
  }
  :global(.wk-off) .track .val {
    margin-left: 0;
  }
  .fill {
    height: 14px;
    border-radius: 0 4px 4px 0;
    flex: none;
    max-width: calc(100% - 64px);
  }
  /* a lab's own number: the lab color under diagonal stripes of the page color. --pat tells a downloaded chart */
  .fill.claim {
    background-image: repeating-linear-gradient(135deg, transparent 0 3px, color-mix(in srgb, var(--bg) 62%, transparent) 3px 5.5px);
    --pat: stripes;
  }
  /* an independent rerun (Epoch AI's, or another board's): dots instead of stripes */
  .fill.rerun {
    background-image: radial-gradient(circle, color-mix(in srgb, var(--bg) 70%, transparent) 1.1px, transparent 1.5px);
    background-size: 4px 4px;
    --pat: dots;
  }
  .val {
    font-size: 13.5px;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .hi .who,
  .hi .val {
    font-weight: 600;
    color: var(--ink);
  }
  .hi .rk {
    color: var(--ink);
  }
  .gap span {
    grid-column: 1 / -1;
    height: 10px;
    border-left: 1px dashed var(--ink-4);
    margin-left: 1ch;
  }
  @media (max-width: 720px) {
    .bb {
      grid-template-columns: auto 1fr;
    }
    .track {
      grid-column: 2;
      padding-top: 0;
      padding-bottom: 12px;
    }
    .who {
      padding-bottom: 4px;
    }
  }
</style>
