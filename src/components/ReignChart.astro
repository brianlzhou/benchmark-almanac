---
// Who held number one. One row per benchmark on a shared time axis. The filled step shape rises with the
// best score so far, so its height shows how good the leader was, and each stretch takes the color of
// the lab whose model held the top spot. The model's name and lab mark sit under the stretch it held.
// Once the clock stops (the benchmark passed 85%, or no newer model was tested, often because a new version
// replaced it) the rest of the row fades, and a mark says which happened. A new version alone does not stop
// the old one's clock: its race goes on while people still test it.
//
// Versions of one test share a row: each version holds the strip from its release until the next one
// comes out, a dark tick marks each hand-over, and the version names sit under the strip. A button under
// the name opens one row per version, with the full history of each.
import type { ReignRow } from '../lib/reigns.ts';
import { reignDays, clockStop } from '../lib/reigns.ts';
import LabMark from './LabMark.astro';
import { benchById, modelById, labById, AS_OF, LEADERBOARDS } from '../lib/data.ts';
import { labColor } from '../lib/palette.ts';
import { yearFrac, monthYear, score as fmt } from '../lib/format.ts';
import { timeTicks, yearLines } from '../lib/scale.ts';
import { LEVEL_BY_ID } from '../lib/taxonomy.ts';
import { featuredIds } from '../lib/routes.ts';

interface Props {
  rows: ReignRow[];
  /** Names for rows that are not benchmarks (the capability index). */
  names?: Record<string, { name: string; href?: string }>;
  from?: string;
  /** Open each version's own row under a family's shared row from the start. */
  open?: boolean;
  /** Head each run of rows with its difficulty level. Off when rows follow another order, such as report counts. */
  levels?: boolean;
}
const { rows: input, names = {}, from = '2023-01-01', open = false, levels = true } = Astro.props;
const rows = input
  .map((r) => ({ ...r, reigns: r.reigns.filter((g) => g.end > from).map((g) => (g.start < from ? { ...g, start: from, steps: [g.steps.filter((s) => s.date <= from).at(-1) ?? g.steps[0], ...g.steps.filter((s) => s.date > from)] } : g)) }))
  .filter((r) => r.reigns.length);
const t0 = yearFrac(from) - 0.02;
const t1 = yearFrac(AS_OF) + 0.02;
const X = (d: string) => ((yearFrac(d) - t0) / (t1 - t0)) * 1000;
const pct = (d: string) => `${Math.max(0, Math.min(100, ((yearFrac(d) - t0) / (t1 - t0)) * 100)).toFixed(2)}%`;
const H = 40;
const name = (id: string) => modelById.get(id)?.name ?? id;
const labs = [...new Set(rows.flatMap((r) => r.reigns.map((g) => g.lab ?? 'other')))];
const mixed = new Set(rows.map((r) => r.source)).size > 1;
const ticks = timeTicks(t0, t1, 10);
const gridAt = ticks.map((t) => pct(t.date));
const grid = `--yl:${yearLines(gridAt)};--yc:${yearLines(gridAt, 'var(--bg)')}`;
const ORIGIN = {
  leaderboard: 'From the benchmark’s own leaderboard',
  epoch: 'From an Epoch AI run',
  collected: 'From another leaderboard, via Epoch AI',
  card: 'From a lab’s own report',
  claim: 'From a claim Epoch AI collected',
} as const;
// a page can hold several charts, and a chart can show twice (one per score switch): ids stay unique
const g = globalThis as { __reignChart?: number };
const uid = (g.__reignChart = (g.__reignChart ?? 0) + 1);

// "Terminal-Bench 4.0" after "Terminal-Bench 3.0" reads as "4.0"
const shorten = (next: string, cur: string) => {
  const a = next.split(' ');
  const b = cur.split(' ');
  let i = 0;
  while (i < a.length - 1 && a[i] === b[i]) i++;
  const rest = a.slice(i).join(' ');
  const pre = next.match(/^(.*?)[- ]?(\d[\w.]*)$/);
  const prc = cur.match(/^(.*?)[- ]?(\d[\w.]*)$/);
  if (pre && prc && pre[1] === prc[1]) return pre[2];
  if (pre && pre[1] === cur) return pre[2];
  return rest;
};

interface Part {
  d: string;
  fill: string;
  tv: string;
  tn: string;
  ts: string;
  start: string;
  lab?: string;
  fits: boolean;
  last: boolean;
}
interface Mark {
  left: string;
  cls: string;
  tv: string;
  tn: string;
  ts: string;
}
interface View {
  key: string;
  nm: string;
  href?: string;
  level?: string;
  sub: string[];
  /** a family's shared row: the button that opens one row per version */
  toggle?: { id: string; n: number };
  /** a version's own row, hidden under its family's row until opened */
  of?: string;
  first: number;
  parts: Part[];
  fades: { x: number; w: number }[];
  marks: Mark[];
  ticks: { left: string; tv: string; tn: string; ts: string }[];
  /** dated question refreshes that kept the benchmark one record (LiveBench) */
  refreshes: { left: string; tv: string; tn: string; ts: string }[];
  labels: { left: string; text: string; lab?: string; minor: boolean }[];
  /** `wide`: shown only where the strip is wide enough (a phone strip is about 340 px) */
  versions: { left: string; text: string; now: boolean; wide: boolean }[];
  now: { lab?: string; model: string; value: string };
}

/** The filled step shape of each reign, cut off at `until` (the day the next version came out). */
function shape(r: ReignRow, until = '9999-12-31', version?: string): Part[] {
  const [d0, d1] = r.domain;
  const y = (v: number) => H - Math.max(1.5, ((v - d0) / (d1 - d0 || 1)) * H);
  const gs = r.reigns.filter((x) => x.start < until);
  return gs.map((x, i) => {
    const end = x.end < until ? x.end : until;
    const x0 = Math.max(0, X(x.start));
    const x1 = Math.min(1000, X(end));
    const steps = x.steps.filter((s, j) => j === 0 || s.date < until);
    let d = `M${x0.toFixed(1)},${H}`;
    steps.forEach((s, j) => {
      const sx = j === 0 ? x0 : Math.max(x0, X(s.date));
      d += `L${sx.toFixed(1)},${y(s.value).toFixed(1)}`;
      const nx = j + 1 < steps.length ? Math.max(x0, X(steps[j + 1].date)) : x1;
      d += `L${nx.toFixed(1)},${y(s.value).toFixed(1)}`;
    });
    d += `L${x1.toFixed(1)},${H}Z`;
    const top = steps.at(-1)!;
    const m = Math.max(1, Math.round(reignDays({ start: x.start, end }) / 30.4));
    // a board a third party runs goes by its runner's name
    const host = top.from === 'leaderboard' ? LEADERBOARDS[r.benchmark]?.host : undefined;
    const origin = top.from && r.source !== top.from ? ` ${host ? `From ${host}’s leaderboard` : ORIGIN[top.from]}.` : '';
    return {
      d,
      fill: labColor(x.lab),
      tv: r.unit === 'index' ? top.value.toFixed(1) : fmt(top.value, r.unit),
      tn: name(x.model),
      ts: `Number one${version ? ` on ${version}` : ''} from ${monthYear(x.start)}${end >= AS_OF ? ' to now' : ` to ${monthYear(end)}`}, ${m} ${m === 1 ? 'month' : 'months'}.${origin}`,
      start: x.start,
      lab: x.lab,
      // a label fits when its stretch is wide enough on a desktop strip of about 640 px
      fits: ((x1 - x0) / 1000) * 640 >= name(x.model).length * 6.6 + 30,
      last: i === gs.length - 1,
    };
  });
}

/** Why and when a row's clock stopped, as the line under its name and the mark on its strip. */
function stopOf(r: ReignRow) {
  const stop = clockStop(r);
  if (!stop) return null;
  const b = benchById.get(r.benchmark);
  const next = r.replacedBy ? benchById.get(r.replacedBy.benchmark) : undefined;
  const nextName = next?.name ?? '';
  // "OSWorld 2.0 (Aug 2026)" after "OSWorld 2.0" would shorten to "(Aug 2026)"; the version label reads better
  const cut = shorten(nextName, b?.name ?? '');
  const shortNext = /^[^\p{L}\p{N}]/u.test(cut) ? (next?.version ?? nextName) : cut;
  const text =
    stop.why === 'closed' ? `Passed 85% in ${monthYear(stop.date)}, by ${name(r.closedOut!.model)}` : stop.why === 'replaced' ? `Replaced by ${shortNext}, ${monthYear(stop.date)}` : `Not tested since ${monthYear(stop.date)}`;
  const tip =
    stop.why === 'closed'
      ? { tv: fmt(r.closedOut!.value, r.unit), tn: `Closed out by ${name(r.closedOut!.model)}`, ts: `${monthYear(stop.date)}. We stop counting time at number one here.` }
      : stop.why === 'replaced'
        ? { tv: nextName, tn: 'Replaced by a new version', ts: `People stopped testing it around ${monthYear(stop.date)}, when the new version came out. We stop counting here.` }
        : { tv: monthYear(stop.date), tn: 'No newer model tested', ts: 'No score has come in since, so we stop counting here.' };
  return { ...stop, text, mark: { left: pct(stop.date), cls: stop.why, ...tip } };
}

const nowOf = (r: ReignRow) => {
  const g = r.reigns.at(-1)!;
  const v = g.steps.at(-1)!.value;
  return { lab: g.lab, model: g.model, value: r.unit === 'index' ? v.toFixed(1) : fmt(v, r.unit) };
};
const leaders = (n: number) => `${n} ${n === 1 ? 'leader' : 'leaders'}`;

// only where the row has a strip: a refresh before its first score would hang over empty space
const refreshesOf = (id: string, since: string, until = '9999-12-31') =>
  (benchById.get(id)?.refreshes ?? [])
    .filter((x) => x.date > from && x.date > since && x.date < until && x.date <= AS_OF)
    .map((x) => ({ left: pct(x.date), tv: 'Questions refreshed', tn: monthYear(x.date), ts: x.label }));

function single(r: ReignRow, of?: string): View {
  const b = benchById.get(r.benchmark);
  const given = names[`${r.benchmark}|${r.source}`] ?? names[r.benchmark];
  const parts = shape(r);
  const stop = stopOf(r);
  const xs = stop ? Math.max(0, X(stop.date)) : 1000;
  return {
    key: `${r.benchmark}|${r.source}`,
    nm: given?.name ?? b?.name ?? r.benchmark,
    href: given ? given.href : b ? `/benchmarks/${b.id}/` : undefined,
    level: b?.level ?? undefined,
    sub: [...(r.source === 'card' && mixed && !given ? ['Lab claims'] : []), stop ? stop.text : leaders(r.reigns.length)],
    of,
    first: Math.max(0, X(r.reigns[0].start)),
    parts,
    fades: stop && xs < 1000 ? [{ x: xs, w: 1000 - xs }] : [],
    marks: stop ? [stop.mark] : [],
    ticks: [],
    refreshes: refreshesOf(r.benchmark, r.reigns[0].start),
    labels: parts.filter((p) => p.fits).map((p) => ({ left: pct(p.start), text: p.tn, lab: p.lab, minor: !p.last })),
    versions: [],
    now: nowOf(r),
  };
}

/** One row for every version of a test, oldest first. */
function family(rs: ReignRow[], id: string): View {
  const k = rs.length;
  const bs = rs.map((r) => benchById.get(r.benchmark)!);
  const newest = bs[k - 1];
  const release = (i: number) => (bs[i].released ? `${bs[i].released!.slice(0, 7)}-01` : rs[i].reigns[0].start);
  // each version holds the strip until the next version came out
  const until = rs.map((r, i) => (i < k - 1 ? (r.replacedBy?.date ?? release(i + 1)) : '9999-12-31'));
  const each = rs.map((r, i) => shape(r, until[i], bs[i].name));
  const parts = each.flat();
  // a version with no score before the next one came out holds no part of the strip: no tick, no name
  const live = rs.map((_, i) => i).filter((i) => each[i].length > 0);
  const fades: View['fades'] = [];
  const marks: Mark[] = [];
  rs.forEach((r, i) => {
    const stop = stopOf(r);
    if (!stop) return;
    if (i === k - 1) {
      const xs = Math.max(0, X(stop.date));
      if (xs < 1000) fades.push({ x: xs, w: 1000 - xs });
      marks.push(stop.mark);
    } else if (stop.why !== 'replaced' && stop.date < until[i]) {
      // an older version that passed 85%, or that nobody tested, before the next one came out
      const x0 = Math.max(0, X(stop.date));
      fades.push({ x: x0, w: Math.max(0, Math.min(1000, X(until[i])) - x0) });
      marks.push(stop.mark);
    }
  });
  // the version names under the strip: newest first, and an older name gives way when they would collide
  // a version named by its year ("2025") would read as the time axis, so it keeps its full name
  const label = (i: number) => {
    const v = bs[i].version;
    const t = v && !(i === 0 && /^original$/i.test(v)) ? v : i === 0 ? bs[0].name : shorten(bs[i].name, bs[i - 1].name);
    return /^\d{4}$/.test(t) ? bs[i].name : t;
  };
  const at = rs.map((r, i) => (i === live[0] ? r.reigns[0].start : release(i)));
  const versions: View['versions'] = [];
  let room = Infinity;
  let roomPhone = Infinity;
  for (const i of [...live].reverse()) {
    const w = label(i).length * 6.4 + 12;
    const px = (Math.max(0, X(at[i])) / 1000) * 640;
    const pxPhone = (Math.max(0, X(at[i])) / 1000) * 340;
    const newest = i === live.at(-1);
    if (!newest && px + w > room) continue;
    const phone = newest || pxPhone + w <= roomPhone;
    versions.unshift({ left: `min(${pct(at[i])}, calc(100% - ${Math.round(w)}px))`, text: label(i), now: i === k - 1, wide: !phone });
    room = px - 4;
    if (phone) roomPhone = pxPhone - 4;
  }
  const stop = stopOf(rs[k - 1]);
  return {
    key: `${newest.id}|family`,
    nm: newest.name,
    href: `/benchmarks/${newest.id}/`,
    level: newest.level ?? undefined,
    sub: [stop ? stop.text : leaders(rs.reduce((n, r) => n + r.reigns.length, 0))],
    toggle: { id, n: k },
    first: Math.max(0, X(rs[live[0] ?? 0].reigns[0].start)),
    parts,
    fades,
    marks,
    ticks: live.slice(1).map((i, j) => ({ left: pct(at[i]), tv: bs[i].name, tn: 'New version', ts: `${monthYear(at[i])}. Before this, the row is ${bs[live[j]].name}.` })),
    refreshes: rs.flatMap((r, i) => refreshesOf(r.benchmark, r.reigns[0].start, until[i])),
    labels: [],
    versions,
    now: nowOf(rs[k - 1]),
  };
}

// versions of one test sit next to each other in the rows (see leaderRows): gather them
const groups: ReignRow[][] = [];
for (const r of rows) {
  const fam = benchById.get(r.benchmark)?.family;
  const last = groups.at(-1);
  const prev = last?.at(-1);
  if (fam && prev && prev.source === r.source && benchById.get(prev.benchmark)?.family === fam && !last!.some((x) => x.benchmark === r.benchmark)) last!.push(r);
  else groups.push([r]);
}
const views: View[] = groups.flatMap((rs, i) => {
  if (rs.length === 1) return [single(rs[0])];
  const id = `rc${uid}-${i}`;
  return [family(rs, id), ...rs.map((r) => single(r, id))];
});
const levelsShown = new Set(views.filter((v) => !v.of).map((v) => v.level));
---

<figure class="rc">
  <div class="key">
    {
      labs.map((l) => (
        <span class="tag">
          <svg width="12" height="12" aria-hidden="true">
            <rect width="12" height="12" rx="3" fill={labColor(l)} />
          </svg>
          {labById.get(l)?.name ?? 'Other labs'}
        </span>
      ))
    }
  </div>
  <div class="rows">
    {
      views.map((v, i) => {
        const prevLevel = views.slice(0, i).filter((x) => !x.of).at(-1)?.level;
        const heading = levels && !v.of && v.level && v.level !== prevLevel && levelsShown.size > 1 ? LEVEL_BY_ID.get(v.level) : undefined;
        return (
          <>
            {heading && (
              <div class="group">
                <span>{heading.name}</span>
                <span class="gw">{heading.who}</span>
              </div>
            )}
            <div class:list={['row', { fam: !!v.toggle, ver: !!v.of }]} data-of={v.of} hidden={v.of && !open ? true : undefined}>
              <div class="who">
                {v.href ? <a href={v.href}>{v.nm}</a> : <span>{v.nm}</span>}
                <span class="sub">
                  {v.toggle && (
                    <button type="button" class="vt" data-vt={v.toggle.id} aria-expanded={open ? 'true' : 'false'}>
                      <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                        <path d="M3.5 2l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      {v.toggle.n} versions
                    </button>
                  )}
                  {v.sub.map((s) => (
                    <span>{s}</span>
                  ))}
                </span>
              </div>
              <div class="plot" style={grid}>
                <svg class="strip" viewBox={`0 0 1000 ${H}`} preserveAspectRatio="none" aria-label={`${v.nm}: number one over time`} role="img">
                  <rect class="track" x={v.first} y="0" width={1000 - v.first} height={H} />
                  {v.parts.map((p) => (
                    <path d={p.d} fill={p.fill} class="seg" data-tv={p.tv} data-tn={p.tn} data-ts={p.ts} />
                  ))}
                  {v.fades.map((f) => (
                    <rect class="after" x={f.x} y="0" width={f.w} height={H} />
                  ))}
                </svg>
                {v.refreshes.map((t) => (
                  <span class="rf" style={`left:${t.left}`} data-tv={t.tv} data-tn={t.tn} data-ts={t.ts} />
                ))}
                {v.ticks.map((t) => (
                  <span class="vb" style={`left:${t.left}`} data-tv={t.tv} data-tn={t.tn} data-ts={t.ts} />
                ))}
                {v.marks.map((m) => (
                  <span class:list={['stop', m.cls]} style={`left:${m.left}`} data-tv={m.tv} data-tn={m.tn} data-ts={m.ts} />
                ))}
                <div class="labels" aria-hidden="true">
                  {v.labels.map((l) => (
                    <span class:list={['lbl', { minor: l.minor }]} style={`left:${l.left}`}>
                      <LabMark lab={l.lab} size={12} />
                      {l.text}
                    </span>
                  ))}
                  {v.versions.map((l) => (
                    <span class:list={['vl', { cur: l.now, wide: l.wide }]} style={`left:${l.left}`}>
                      {l.text}
                    </span>
                  ))}
                </div>
              </div>
              <div class="now">
                <LabMark lab={v.now.lab} size={15} />
                <span class="nn">{featuredIds.has(v.now.model) ? <a href={`/models/${v.now.model}/`}>{name(v.now.model)}</a> : name(v.now.model)}</span>
                <b class="num">{v.now.value}</b>
              </div>
            </div>
          </>
        );
      })
    }
    <div class="row axis" aria-hidden="true">
      <div class="who" />
      <div class="plot">
        {
          ticks.map((t) => (
            <span class="yr" style={`left:${pct(t.date)}`}>
              {t.label}
            </span>
          ))
        }
      </div>
      <div class="now" />
    </div>
  </div>
</figure>

<script>
  // a family's button opens and closes one row per version
  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest?.<HTMLButtonElement>('.rc [data-vt]');
    if (!b) return;
    const open = b.getAttribute('aria-expanded') !== 'true';
    b.setAttribute('aria-expanded', String(open));
    for (const row of document.querySelectorAll<HTMLElement>(`[data-of="${b.dataset.vt}"]`)) row.hidden = !open;
  });
</script>

<style>
  .rc {
    margin: 0;
  }
  .key {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-bottom: 18px;
  }
  .rows {
    display: grid;
    gap: 2px;
  }
  .group {
    display: flex;
    gap: 12px;
    align-items: baseline;
    margin: 22px 0 8px;
    font-size: 13px;
    font-weight: 600;
  }
  .group:first-child {
    margin-top: 0;
  }
  .gw {
    font-weight: 400;
    color: var(--ink-3);
  }
  .row {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr) 210px;
    gap: 18px;
    align-items: start;
  }
  .who {
    padding-top: 8px;
    min-width: 0;
  }
  /* a long benchmark name wraps onto a second line rather than losing its end */
  .who a,
  .who > span:first-child {
    display: block;
    font-weight: 500;
    font-size: 14px;
    line-height: 1.25;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .who a:hover {
    text-decoration: underline;
    text-decoration-color: var(--ink-4);
  }
  .sub {
    display: flex;
    flex-wrap: wrap;
    gap: 0 10px;
    margin-top: 2px;
    font-size: 12px;
    color: var(--ink-3);
  }
  /* a close-out names its model, so the line can run long: it wraps instead of running into the strip */
  .sub > span {
    white-space: normal;
  }
  .plot {
    position: relative;
    padding-bottom: 22px;
    isolation: isolate;
  }
  /* year gridlines: gray on the empty page, and a white cut through the colored shapes */
  .plot::before,
  .plot::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 40px;
    pointer-events: none;
  }
  .plot::before {
    background: var(--yl);
    z-index: -1;
  }
  .plot::after {
    background: var(--yc);
    opacity: 0.7;
  }
  .strip {
    display: block;
    width: 100%;
    height: 40px;
  }
  .track {
    fill: var(--grid);
  }
  .seg {
    stroke: var(--bg);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: miter;
  }
  .seg:hover {
    filter: brightness(1.08);
  }
  .after {
    fill: var(--fade);
    opacity: var(--fade-o);
    pointer-events: none;
  }
  .stop {
    position: absolute;
    top: 0;
    height: 40px;
    width: 14px;
    margin-left: -7px;
    /* above a version's hand-over tick, when a version closed out the month it came out */
    z-index: 2;
  }
  .stop::before {
    content: '';
    position: absolute;
    left: 6.5px;
    top: 0;
    bottom: 0;
    border-left: 1px dashed var(--ink-3);
  }
  .stop.closed::after {
    content: '';
    position: absolute;
    left: 2px;
    top: -5px;
    width: 10px;
    height: 10px;
    rotate: 45deg;
    background: var(--ink);
    box-shadow: 0 0 0 2px var(--bg);
  }
  .labels {
    position: absolute;
    left: 0;
    right: 0;
    top: 44px;
    height: 16px;
  }
  .lbl {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 5px;
