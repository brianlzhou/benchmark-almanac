---
// Who held number one. One row per benchmark on a shared time axis. The filled step shape rises with the
// best score so far, so its height shows how good the leader was, and each stretch takes the colour of
// the lab whose model held the top spot. The model's name and lab mark sit under the stretch it held.
// Once the clock stops (the benchmark passed 85%, a new version replaced it, or no newer model was
// tested) the rest of the row fades, and a mark says which of the three happened.
import type { ReignRow } from '../lib/reigns.ts';
import { reignDays, clockStop } from '../lib/reigns.ts';
import LabMark from './LabMark.astro';
import { benchById, modelById, labById, AS_OF } from '../lib/data.ts';
import { labColor } from '../lib/palette.ts';
import { yearFrac, monthYear, score as fmt } from '../lib/format.ts';
import { timeTicks, yearLines } from '../lib/scale.ts';
import { LEVEL_BY_ID } from '../lib/taxonomy.ts';
import { featuredIds } from '../lib/routes.ts';

interface Props {
  rows: ReignRow[];
  /** Names for rows that are not benchmarks (the capability index). */
  names?: Record<string, { name: string; href?: string }>;
  from?: string;
}
const { rows: input, names = {}, from = '2023-01-01' } = Astro.props;
const rows = input
  .map((r) => ({ ...r, reigns: r.reigns.filter((g) => g.end > from).map((g) => (g.start < from ? { ...g, start: from, steps: [g.steps.filter((s) => s.date <= from).at(-1) ?? g.steps[0], ...g.steps.filter((s) => s.date > from)] } : g)) }))
  .filter((r) => r.reigns.length);
const t0 = yearFrac(from) - 0.02;
const t1 = yearFrac(AS_OF) + 0.02;
const X = (d: string) => ((yearFrac(d) - t0) / (t1 - t0)) * 1000;
const pct = (d: string) => `${Math.max(0, Math.min(100, ((yearFrac(d) - t0) / (t1 - t0)) * 100)).toFixed(2)}%`;
const H = 40;
const months = (g: { start: string; end: string }) => Math.max(1, Math.round(reignDays(g) / 30.4));
const name = (id: string) => modelById.get(id)?.name ?? id;
const labs = [...new Set(rows.flatMap((r) => r.reigns.map((g) => g.lab ?? 'other')))];
const mixed = new Set(rows.map((r) => r.source)).size > 1;
const ticks = timeTicks(t0, t1, 10);
const gridAt = ticks.map((t) => pct(t.date));
const grid = `--yl:${yearLines(gridAt)};--yc:${yearLines(gridAt, 'var(--bg)')}`;
// "Terminal-Bench 4.0" after "Terminal-Bench 3.0" reads as "4.0"
const shorten = (next: string, cur: string) => {
  const a = next.split(' ');
  const b = cur.split(' ');
  let i = 0;
  while (i < a.length - 1 && a[i] === b[i]) i++;
  const rest = a.slice(i).join(' ');
  const pre = next.match(/^(.*?)[- ]?(\d[\w.]*)$/);
  const prc = cur.match(/^(.*?)[- ]?(\d[\w.]*)$/);
  if (pre && prc && pre[1] === prc[1]) return pre[2];
  if (pre && pre[1] === cur) return pre[2];
  return rest;
};

function shape(r: ReignRow) {
  const [d0, d1] = r.domain;
  const y = (v: number) => H - Math.max(1.5, ((v - d0) / (d1 - d0 || 1)) * H);
  return r.reigns.map((g, i) => {
    const x0 = Math.max(0, X(g.start));
    const x1 = Math.min(1000, X(g.end));
    let d = `M${x0.toFixed(1)},${H}`;
    g.steps.forEach((s, j) => {
      const sx = j === 0 ? x0 : Math.max(x0, X(s.date));
      d += `L${sx.toFixed(1)},${y(s.value).toFixed(1)}`;
      const nx = j + 1 < g.steps.length ? Math.max(x0, X(g.steps[j + 1].date)) : x1;
      d += `L${nx.toFixed(1)},${y(s.value).toFixed(1)}`;
    });
    d += `L${x1.toFixed(1)},${H}Z`;
    const best = g.steps.at(-1)!.value;
    return {
      g,
      d,
      best,
      last: i === r.reigns.length - 1,
      // a label fits when its stretch is wide enough on a desktop strip of about 640 px
      fits: ((x1 - x0) / 1000) * 640 >= name(g.model).length * 6.6 + 30,
    };
  });
}
---

<figure class="rc">
  <div class="key">
    {
      labs.map((l) => (
        <span class="tag">
          <svg width="12" height="12" aria-hidden="true">
            <rect width="12" height="12" rx="3" fill={labColor(l)} />
          </svg>
          {labById.get(l)?.name ?? 'Other labs'}
        </span>
      ))
    }
  </div>
  <div class="rows">
    {
      rows.map((r, i) => {
        const b = benchById.get(r.benchmark);
        const prevLevel = i > 0 ? benchById.get(rows[i - 1].benchmark)?.level : undefined;
        const heading = b?.level && b.level !== prevLevel && rows.some((x) => benchById.get(x.benchmark)?.level !== b.level) ? LEVEL_BY_ID.get(b.level) : undefined;
        const given = names[`${r.benchmark}|${r.source}`] ?? names[r.benchmark];
        const nm = given?.name ?? b?.name ?? r.benchmark;
        const href = given ? given.href : b ? `/benchmarks/${b.id}/` : undefined;
        const parts = shape(r);
        const now = r.reigns.at(-1)!;
        const unit = r.unit;
        const first = r.reigns[0].start;
        const stop = clockStop(r);
        const xs = stop ? Math.max(0, X(stop.date)) : 1000;
        const nextName = r.replacedBy ? (benchById.get(r.replacedBy.benchmark)?.name ?? '') : '';
        // "OSWorld 2.0 (Aug 2026)" after "OSWorld 2.0" would shorten to "(Aug 2026)"; the version label reads better
        const cut = shorten(nextName, b?.name ?? '');
        const shortNext = /^[^\p{L}\p{N}]/u.test(cut) ? (benchById.get(r.replacedBy?.benchmark ?? '')?.version ?? nextName) : cut;
        const stopText = !stop
          ? ''
          : stop.why === 'closed'
            ? `Passed 85% in ${monthYear(stop.date)}`
            : stop.why === 'replaced'
              ? `Replaced by ${shortNext}, ${monthYear(stop.date)}`
              : `Not tested since ${monthYear(stop.date)}`;
        const stopTip = !stop
          ? undefined
          : stop.why === 'closed'
            ? { tv: fmt(r.closedOut!.value, unit), tn: `Closed out by ${name(r.closedOut!.model)}`, ts: `${monthYear(stop.date)}. Time after this does not count toward the share at number one.` }
            : stop.why === 'replaced'
              ? { tv: nextName, tn: 'Replaced by a new version', ts: `${monthYear(stop.date)}. Time after this does not count.` }
              : { tv: monthYear(stop.date), tn: 'No newer model tested', ts: 'Later models have no score here, so time after this does not count.' };
        return (
          <>
          {heading && (
            <div class="group">
              <span>{heading.name}</span>
              <span class="gw">{heading.who}</span>
            </div>
          )}
          <div class="row">
            <div class="who">
              {href ? <a href={href}>{nm}</a> : <span>{nm}</span>}
              <span class="sub">
                {r.source === 'card' && mixed && !given && <span>Lab claims</span>}
                {stopText ? (
                  <span>{stopText}</span>
                ) : (
                  <span>
                    {r.reigns.length} {r.reigns.length === 1 ? 'leader' : 'leaders'}
                  </span>
                )}
              </span>
            </div>
            <div class="plot" style={grid}>
              <svg class="strip" viewBox={`0 0 1000 ${H}`} preserveAspectRatio="none" aria-label={`${nm}: number one over time`} role="img">
                <rect class="track" x={Math.max(0, X(first))} y="0" width={1000 - Math.max(0, X(first))} height={H} />
                {parts.map((p) => (
                  <path
                    d={p.d}
                    fill={labColor(p.g.lab)}
                    class="seg"
                    data-tv={unit === 'index' ? p.best.toFixed(1) : fmt(p.best, unit)}
                    data-tn={name(p.g.model)}
                    data-ts={`Number one from ${monthYear(p.g.start)}${p.last ? ' to now' : ` to ${monthYear(p.g.end)}`}, ${months(p.g)} ${months(p.g) === 1 ? 'month' : 'months'}`}
                  />
                ))}
                {stop && xs < 1000 && <rect class="after" x={xs} y="0" width={1000 - xs} height={H} />}
              </svg>
              {stop && stopTip && (
                <span class:list={['stop', stop.why]} style={`left:${pct(stop.date)}`} data-tv={stopTip.tv} data-tn={stopTip.tn} data-ts={stopTip.ts} />
              )}
              <div class="labels" aria-hidden="true">
                {parts
                  .filter((p) => p.fits)
                  .map((p) => (
                    <span class:list={['lbl', { minor: !p.last }]} style={`left:${pct(p.g.start)}`}>
                      <LabMark lab={p.g.lab} size={12} />
                      {name(p.g.model)}
                    </span>
                  ))}
              </div>
            </div>
            <div class="now">
              <LabMark lab={now.lab} size={15} />
              <span class="nn">
                {featuredIds.has(now.model) ? <a href={`/models/${now.model}/`}>{name(now.model)}</a> : name(now.model)}
              </span>
              <b class="num">{unit === 'index' ? now.steps.at(-1)!.value.toFixed(1) : fmt(now.steps.at(-1)!.value, unit)}</b>
            </div>
          </div>
          </>
        );
      })
    }
    <div class="row axis" aria-hidden="true">
      <div class="who" />
      <div class="plot">
        {
          ticks.map((t) => (
            <span class="yr" style={`left:${pct(t.date)}`}>
              {t.label}
            </span>
          ))
        }
      </div>
      <div class="now" />
    </div>
  </div>
</figure>

<style>
  .rc {
    margin: 0;
  }
  .key {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-bottom: 18px;
  }
  .rows {
    display: grid;
    gap: 2px;
  }
  .group {
    display: flex;
    gap: 12px;
    align-items: baseline;
    margin: 22px 0 8px;
    font-size: 13px;
    font-weight: 600;
  }
  .group:first-child {
    margin-top: 0;
  }
  .gw {
    font-weight: 400;
    color: var(--ink-3);
  }
  .row {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr) 210px;
    gap: 18px;
    align-items: start;
  }
  .who {
    padding-top: 8px;
    min-width: 0;
  }
  .who a,
  .who > span:first-child {
    display: block;
    font-weight: 500;
    font-size: 14px;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .who a:hover {
    text-decoration: underline;
    text-decoration-color: var(--ink-4);
  }
  .sub {
    display: flex;
    flex-wrap: wrap;
    gap: 0 10px;
    margin-top: 2px;
    font-size: 12px;
    color: var(--ink-3);
  }
  .sub > span {
    white-space: nowrap;
  }
  .plot {
    position: relative;
    padding-bottom: 22px;
    isolation: isolate;
  }
  /* year gridlines: grey on the empty page, and a white cut through the coloured shapes */
  .plot::before,
  .plot::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 40px;
    pointer-events: none;
  }
  .plot::before {
    background: var(--yl);
    z-index: -1;
  }
  .plot::after {
    background: var(--yc);
    opacity: 0.7;
  }
  .strip {
    display: block;
    width: 100%;
    height: 40px;
  }
  .track {
    fill: var(--grid);
  }
  .seg {
    stroke: var(--bg);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: miter;
  }
  .seg:hover {
    filter: brightness(1.08);
  }
  .after {
    fill: var(--bg);
    opacity: 0.62;
    pointer-events: none;
  }
  .stop {
    position: absolute;
    top: 0;
    height: 40px;
    width: 14px;
    margin-left: -7px;
  }
  .stop::before {
    content: '';
    position: absolute;
    left: 6.5px;
    top: 0;
    bottom: 0;
    border-left: 1px dashed var(--ink-3);
  }
  .stop.closed::after {
    content: '';
    position: absolute;
    left: 2px;
    top: -5px;
    width: 10px;
    height: 10px;
    rotate: 45deg;
    background: var(--ink);
    box-shadow: 0 0 0 2px var(--bg);
  }
  .labels {
    position: absolute;
    left: 0;
    right: 0;
    top: 44px;
    height: 16px;
  }
  .lbl {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11.5px;
    line-height: 16px;
    color: var(--ink-2);
    white-space: nowrap;
    padding-left: 2px;
  }
  .now {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 12px;
    font-size: 13.5px;
    min-width: 0;
  }
  .nn {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .nn a {
    text-decoration: none;
  }
  .now b {
    margin-left: auto;
    font-weight: 500;
  }
  .axis .plot {
    height: 22px;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .axis .plot::before,
  .axis .plot::after {
    display: none;
  }
  .yr {
    position: absolute;
    top: 7px;
    translate: -50% 0;
    font: 400 12px/1 var(--mono);
    color: var(--ink-3);
  }
  .yr::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -8px;
    height: 5px;
    border-left: 1px solid var(--ink-4);
  }
  @media (max-width: 900px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
    .who {
      display: flex;
      align-items: baseline;
      gap: 10px;
      padding-top: 14px;
    }
    .now {
      padding-top: 0;
      order: 3;
      font-size: 12.5px;
    }
    .labels {
      display: none;
    }
    .plot {
      padding-bottom: 6px;
    }
    .axis .who,
    .axis .now {
      display: none;
    }
  }
</style>
