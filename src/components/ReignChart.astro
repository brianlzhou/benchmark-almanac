---
// Who held number one. One row per benchmark on a shared time axis. The filled step shape rises with the
// best score so far, so its height shows how good the leader was, and each stretch takes the colour of
// the lab whose model held the top spot. The model's name and lab mark sit under the stretch it held.
import type { ReignRow } from '../lib/reigns.ts';
import { reignDays } from '../lib/reigns.ts';
import LabMark from './LabMark.astro';
import { benchById, modelById, labById, AS_OF } from '../lib/data.ts';
import { labColor } from '../lib/palette.ts';
import { yearFrac, monthYear, score as fmt } from '../lib/format.ts';
import { yearTicks } from '../lib/scale.ts';
import { LEVEL_BY_ID } from '../lib/taxonomy.ts';
import { featuredIds } from '../lib/routes.ts';

interface Props {
  rows: ReignRow[];
  /** Names for rows that are not benchmarks (the capability index). */
  names?: Record<string, { name: string; href?: string }>;
  from?: string;
}
const { rows, names = {}, from } = Astro.props;
const starts = rows.flatMap((r) => r.reigns.map((g) => g.start));
const t0 = yearFrac(from ?? starts.sort()[0] ?? '2023-01-01') - 0.04;
const t1 = yearFrac(AS_OF) + 0.02;
const X = (d: string) => ((yearFrac(d) - t0) / (t1 - t0)) * 1000;
const pct = (d: string) => `${Math.max(0, Math.min(100, ((yearFrac(d) - t0) / (t1 - t0)) * 100)).toFixed(2)}%`;
const H = 40;
const months = (g: { start: string; end: string }) => Math.max(1, Math.round(reignDays(g) / 30.4));
const name = (id: string) => modelById.get(id)?.name ?? id;
const labs = [...new Set(rows.flatMap((r) => r.reigns.map((g) => g.lab ?? 'other')))];

function shape(r: ReignRow) {
  const [d0, d1] = r.domain;
  const y = (v: number) => H - Math.max(1.5, ((v - d0) / (d1 - d0 || 1)) * H);
  return r.reigns.map((g, i) => {
    const x0 = Math.max(0, X(g.start));
    const x1 = Math.min(1000, X(g.end));
    let d = `M${x0.toFixed(1)},${H}`;
    g.steps.forEach((s, j) => {
      const sx = j === 0 ? x0 : Math.max(x0, X(s.date));
      d += `L${sx.toFixed(1)},${y(s.value).toFixed(1)}`;
      const nx = j + 1 < g.steps.length ? Math.max(x0, X(g.steps[j + 1].date)) : x1;
      d += `L${nx.toFixed(1)},${y(s.value).toFixed(1)}`;
    });
    d += `L${x1.toFixed(1)},${H}Z`;
    const best = g.steps.at(-1)!.value;
    return {
      g,
      d,
      best,
      last: i === r.reigns.length - 1,
      // a label fits when its stretch is wide enough on a desktop strip of about 640 px
      fits: ((x1 - x0) / 1000) * 640 >= name(g.model).length * 6.6 + 30,
    };
  });
}
---

<figure class="rc">
  <div class="key">
    {
      labs.map((l) => (
        <span class="tag">
          <svg width="12" height="12" aria-hidden="true">
            <rect width="12" height="12" rx="3" fill={labColor(l)} />
          </svg>
          {labById.get(l)?.name ?? 'Other labs'}
        </span>
      ))
    }
  </div>
  <div class="rows">
    {
      rows.map((r) => {
        const b = benchById.get(r.benchmark);
        const nm = names[r.benchmark]?.name ?? b?.name ?? r.benchmark;
        const href = names[r.benchmark]?.href ?? (b ? `/benchmarks/${b.id}/` : undefined);
        const lvl = b?.level ? LEVEL_BY_ID.get(b.level)?.name : undefined;
        const parts = shape(r);
        const now = r.reigns.at(-1)!;
        const unit = r.unit;
        const first = r.reigns[0].start;
        return (
          <div class="row">
            <div class="who">
              {href ? <a href={href}>{nm}</a> : <span>{nm}</span>}
              <span class="sub">
                {lvl && <span>{lvl}</span>}
                <span>
                  {r.reigns.length} {r.reigns.length === 1 ? 'leader' : 'leaders'}
                </span>
              </span>
            </div>
            <div class="plot">
              <svg viewBox={`0 0 1000 ${H}`} preserveAspectRatio="none" aria-label={`${nm}: number one over time`} role="img">
                <rect class="track" x={Math.max(0, X(first))} y="0" width={1000 - Math.max(0, X(first))} height={H} />
                {parts.map((p) => (
                  <path
                    d={p.d}
                    fill={labColor(p.g.lab)}
                    class="seg"
                    data-tv={unit === 'index' ? p.best.toFixed(1) : fmt(p.best, unit)}
                    data-tn={name(p.g.model)}
                    data-ts={`Number one from ${monthYear(p.g.start)}${p.last ? ' to now' : ` to ${monthYear(p.g.end)}`}, ${months(p.g)} ${months(p.g) === 1 ? 'month' : 'months'}`}
                  />
                ))}
              </svg>
              <div class="labels" aria-hidden="true">
                {parts
                  .filter((p) => p.fits)
                  .map((p) => (
                    <span class:list={['lbl', { minor: !p.last }]} style={`left:${pct(p.g.start)}`}>
                      <LabMark lab={p.g.lab} size={12} />
                      {name(p.g.model)}
                    </span>
                  ))}
              </div>
            </div>
            <div class="now">
              <LabMark lab={now.lab} size={15} />
              <span class="nn">
                {featuredIds.has(now.model) ? <a href={`/models/${now.model}/`}>{name(now.model)}</a> : name(now.model)}
              </span>
              <b class="num">{unit === 'index' ? now.steps.at(-1)!.value.toFixed(1) : fmt(now.steps.at(-1)!.value, unit)}</b>
            </div>
          </div>
        );
      })
    }
    <div class="row axis" aria-hidden="true">
      <div class="who" />
      <div class="plot">
        {
          yearTicks(t0, t1, 10).map((y) => (
            <span class="yr" style={`left:${pct(`${y}-01-01`)}`}>
              {y}
            </span>
          ))
        }
      </div>
      <div class="now" />
    </div>
  </div>
</figure>

<style>
  .rc {
    margin: 0;
  }
  .key {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-bottom: 18px;
  }
  .rows {
    display: grid;
    gap: 2px;
  }
  .row {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr) 210px;
    gap: 18px;
    align-items: start;
  }
  .who {
    padding-top: 8px;
    min-width: 0;
  }
  .who a,
  .who > span:first-child {
    display: block;
    font-weight: 500;
    font-size: 14px;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .who a:hover {
    text-decoration: underline;
    text-decoration-color: var(--ink-4);
  }
  .sub {
    display: flex;
    gap: 10px;
    margin-top: 2px;
    font-size: 12px;
    color: var(--ink-3);
  }
  .plot {
    position: relative;
    padding-bottom: 22px;
  }
  svg {
    display: block;
    width: 100%;
    height: 40px;
  }
  .track {
    fill: var(--grid);
  }
  .seg {
    stroke: var(--bg);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: miter;
  }
  .seg:hover {
    filter: brightness(1.08);
  }
  .labels {
    position: absolute;
    left: 0;
    right: 0;
    top: 44px;
    height: 16px;
  }
  .lbl {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11.5px;
    line-height: 16px;
    color: var(--ink-2);
    white-space: nowrap;
    padding-left: 2px;
  }
  .now {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 12px;
    font-size: 13.5px;
    min-width: 0;
  }
  .nn {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .nn a {
    text-decoration: none;
  }
  .now b {
    margin-left: auto;
    font-weight: 500;
  }
  .axis .plot {
    height: 18px;
    padding: 0;
  }
  .yr {
    position: absolute;
    translate: -50% 0;
    font: 400 12px/1 var(--mono);
    color: var(--ink-3);
  }
  @media (max-width: 900px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
    .who {
      display: flex;
      align-items: baseline;
      gap: 10px;
      padding-top: 14px;
    }
    .now {
      padding-top: 0;
      order: 3;
      margin-top: -16px;
      font-size: 12.5px;
    }
    .lbl.minor {
      display: none;
    }
    .axis .who,
    .axis .now {
      display: none;
    }
  }
</style>
