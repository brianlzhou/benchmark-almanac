---
// Values over time, after Epoch AI's charts: one dot per model in its lab's colour, an optional step line
// for the best value so far, direct labels on chosen points, optional interval whiskers, and dashed
// reference lines. Filled dots are independent runs. Rings are numbers a lab reports about itself.
// It renders twice, at a desktop and a phone width, so text keeps its size on both.
import { modelById } from '../lib/data.ts';
import { labColor } from '../lib/palette.ts';
import { linear, niceTicks, yearTicks } from '../lib/scale.ts';
import { yearFrac, score as fmt, monthYear } from '../lib/format.ts';

export interface Pt {
  date: string;
  value: number;
  model: string;
  source: 'leaderboard' | 'epoch' | 'card';
  setting?: string | null;
  harness?: string | null;
  low?: number | null;
  high?: number | null;
}

interface Props {
  points: Pt[];
  frontier?: { date: string; value: number; model: string }[];
  unit?: string;
  label: string;
  /** Fixed y range; computed from the data when left out. */
  domain?: [number, number];
  refs?: { v: number; label: string }[];
  /** Models to draw in colour; the rest go grey and quiet. */
  highlight?: string[];
  /** Points to label when there is no frontier. */
  labelIds?: string[];
  better?: 'higher' | 'lower';
  legend?: boolean;
  height?: number;
  sourceNote?: { leaderboard: string; epoch: string; card: string };
}
const {
  points,
  frontier = [],
  unit = '%',
  label,
  domain,
  refs = [],
  highlight,
  labelIds,
  legend = true,
  height = 440,
  sourceNote = { leaderboard: 'On the benchmark’s own leaderboard', epoch: 'Run or collected by Epoch AI', card: 'Reported by the lab in its model card' },
} = Astro.props;

const log = unit === 'minutes';
const pts = points.filter((p) => !log || p.value > 0).map((p) => ({ ...p, t: yearFrac(p.date), lab: modelById.get(p.model)?.lab }));
const hl = highlight ? new Set(highlight) : undefined;
// grey points first, so coloured ones sit on top
pts.sort((a, b) => Number(hl ? hl.has(a.model) : 0) - Number(hl ? hl.has(b.model) : 0));

const sizes = [
  { key: 'wide', w: 1120, h: height, labels: 7, font: 12.5, ticks: 10 },
  { key: 'narrow', w: 380, h: Math.round(height * 0.7), labels: 2, font: 11, ticks: 5 },
];
const pad = { l: 46, r: 16, t: 18, b: 34 };

const tMin = Math.min(...pts.map((p) => p.t));
const tMax = Math.max(...pts.map((p) => p.t));
const t0 = Math.floor(tMin * 2) / 2 - 0.15;
const t1 = tMax + 0.2;

let [y0, y1] = domain ?? [0, 100];
if (!domain) {
  const vs = pts.flatMap((p) => [p.value, p.low ?? p.value, p.high ?? p.value]);
  y0 = Math.min(...vs);
  y1 = Math.max(...vs);
  if (log) {
    y0 = 10 ** Math.floor(Math.log10(y0));
    y1 = 10 ** Math.ceil(Math.log10(y1));
  } else {
    const t = niceTicks(y0, y1, 5);
    const step = t.length > 1 ? t[1] - t[0] : 1;
    y0 = t[0] > y0 ? t[0] - step : t[0];
    y1 = t.at(-1)! < y1 ? t.at(-1)! + step : t.at(-1)!;
  }
}
const yTicks = log
  ? Array.from({ length: Math.round(Math.log10(y1 / y0)) + 1 }, (_, i) => y0 * 10 ** i)
  : unit === '%' && y0 === 0 && y1 === 100
    ? [0, 20, 40, 60, 80, 100]
    : niceTicks(y0, y1, 5);
const yFmt = (v: number) => (unit === '%' ? `${v}%` : unit === 'index' ? String(v) : fmt(v, unit));
const vFmt = (v: number) => (unit === 'index' ? v.toFixed(1) : fmt(v, unit));

const hasCard = pts.some((p) => p.source === 'card');
const hasBoard = pts.some((p) => p.source === 'leaderboard');
const hasEpoch = pts.some((p) => p.source === 'epoch');
const name = (id: string) => modelById.get(id)?.name ?? id;

function layout(w: number, h: number, nLabels: number) {
  const x = linear([t0, t1], [pad.l, w - pad.r]);
  const yl = log ? (v: number) => Math.log10(v) : (v: number) => v;
  const y = linear([yl(y0), yl(y1)], [h - pad.b, pad.t]);
  const Y = (v: number) => y(yl(Math.min(y1, Math.max(y0, v))));
  let d = '';
  frontier.forEach((p, i) => {
    const px = x(yearFrac(p.date));
    const py = Y(p.value);
    d += i === 0 ? `M${px},${py}` : `H${px}V${py}`;
  });
  if (frontier.length) d += `H${x(t1) - 2}`;
  // labels: newest first, skipping any that would sit on a label already placed
  const pool = labelIds
    ? pts.filter((p) => labelIds.includes(p.model)).sort((a, b) => b.t - a.t)
    : frontier.slice().reverse().map((p) => ({ ...p, t: yearFrac(p.date) }));
  const lab: { model: string; x: number; y: number }[] = [];
  for (const p of pool) {
    if (lab.length >= nLabels) break;
    const px = x(p.t);
    const py = Y(p.value);
    if (lab.some((l) => Math.abs(l.y - py) < 16 && Math.abs(l.x - px) < 150)) continue;
    lab.push({ model: p.model, x: px, y: py });
  }
  return { x, Y, d, lab };
}
---

{
  pts.length === 0 ? (
    <p class="empty">No dated values yet.</p>
  ) : (
    <figure class="sc">
      {legend && (
        <div class="key">
          {hasBoard && (
            <span class="tag">
              <svg width="12" height="12" aria-hidden="true">
                <rect x="2" y="2" width="8" height="8" rx="1.5" fill="var(--ink-3)" />
              </svg>
              {sourceNote.leaderboard}
            </span>
          )}
          {hasEpoch && (
            <span class="tag">
              <svg width="12" height="12" aria-hidden="true">
                <circle cx="6" cy="6" r="4.5" fill="var(--ink-3)" />
              </svg>
              {sourceNote.epoch}
            </span>
          )}
          {hasCard && (
            <span class="tag">
              <svg width="12" height="12" aria-hidden="true">
                <circle cx="6" cy="6" r="4" fill="none" stroke="var(--ink-3)" stroke-width="1.6" />
              </svg>
              {sourceNote.card}
            </span>
          )}
          {frontier.length > 1 && (
            <span class="tag">
              <svg width="18" height="12" aria-hidden="true">
                <path d="M1 9H8V3H17" fill="none" stroke="var(--ink-2)" stroke-width="1.6" />
              </svg>
              Best so far
            </span>
          )}
        </div>
      )}
      {sizes.map(({ key, w, h, labels, font, ticks }) => {
        const { x, Y, d, lab } = layout(w, h, labels);
        return (
          <svg class={`only-${key}`} viewBox={`0 0 ${w} ${h}`} role="img" aria-label={label} style={`--f:${font}px`}>
            {yTicks.map((v) => (
              <g>
                <line x1={pad.l} x2={w - pad.r} y1={Y(v)} y2={Y(v)} class="grid" />
                <text x={pad.l - 8} y={Y(v) + 4} class="tick" text-anchor="end">
                  {yFmt(v)}
                </text>
              </g>
            ))}
            {yearTicks(t0, t1, ticks).map((yr) => (
              <g>
                <line x1={x(yr)} x2={x(yr)} y1={pad.t} y2={h - pad.b} class="vgrid" />
                <line x1={x(yr)} x2={x(yr)} y1={h - pad.b} y2={h - pad.b + 5} class="axis" />
                <text x={x(yr)} y={h - 10} class="tick" text-anchor="middle">
                  {yr}
                </text>
              </g>
            ))}
            <line x1={pad.l} x2={w - pad.r} y1={h - pad.b} y2={h - pad.b} class="axis" />
            {refs
              .filter((r) => r.v >= y0 && r.v <= y1)
              .map((r) => (
                <g>
                  <line x1={pad.l} x2={w - pad.r} y1={Y(r.v)} y2={Y(r.v)} class="ref" />
                  <text x={pad.l + 6} y={Y(r.v) - 6} class="ref-l">
                    {r.label}
                  </text>
                </g>
              ))}
            {d && <path d={d} class="front" />}
            {pts.map((p) => {
              const on = !hl || hl.has(p.model);
              const c = on ? labColor(p.lab) : 'var(--ink-4)';
              const cx = x(p.t);
              const cy = Y(p.value);
              // the desktop render carries the tooltip; phones use the table view instead
              const tip =
                key === 'wide'
                  ? {
                      'data-tv': vFmt(p.value),
                      'data-tn': `${name(p.model)}${p.setting && p.setting !== 'unknown' ? ` (${p.setting})` : ''}`,
                      'data-ts': `${monthYear(p.date)}. ${p.source === 'leaderboard' ? 'Official leaderboard' : p.source === 'epoch' ? 'Epoch AI data' : 'Lab model card'}${p.harness ? `, ${p.harness}` : ''}${p.low != null && p.high != null ? `. 90% interval ${vFmt(p.low)} to ${vFmt(p.high)}` : ''}`,
                    }
                  : {};
              return (
                <g class:list={{ dim: !on, pt: key === 'wide' }} {...tip}>
                  {p.low != null && p.high != null && <line x1={cx} x2={cx} y1={Y(p.low)} y2={Y(p.high)} stroke={c} class="ci" />}
                  {p.source === 'leaderboard' ? (
                    <rect x={cx - 4} y={cy - 4} width="8" height="8" rx="1.5" fill={c} />
                  ) : p.source === 'epoch' ? (
                    <circle cx={cx} cy={cy} r={on && hl ? 5 : 4} fill={c} />
                  ) : (
                    <circle cx={cx} cy={cy} r="3.6" fill="var(--bg)" stroke={c} stroke-width="1.7" />
                  )}
                  {key === 'wide' && <circle cx={cx} cy={cy} r="9" class="hit" />}
                </g>
              );
            })}
            {lab.map((l) => (
              <text x={l.x - 9} y={l.y + 4} class="lab" text-anchor="end">
                {name(l.model)}
              </text>
            ))}
          </svg>
        );
      })}
    </figure>
  )
}

<style>
  .sc {
    margin: 0;
  }
  .key {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin-bottom: 14px;
  }
  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .grid {
    stroke: var(--grid);
    stroke-width: 1;
  }
  .vgrid {
    stroke: var(--grid);
    stroke-width: 1;
    opacity: 0.7;
  }
  .axis {
    stroke: var(--ink-4);
    stroke-width: 1;
  }
  .tick {
    font: 400 var(--f) / 1 var(--mono);
    fill: var(--ink-3);
  }
  .ref {
    stroke: var(--ink-4);
    stroke-width: 1;
    stroke-dasharray: 4 4;
  }
  .ref-l {
    font: 400 var(--f) / 1 var(--sans);
    fill: var(--ink-3);
  }
  .front {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }
  .ci {
    stroke-width: 1.4;
    opacity: 0.45;
  }
  .dim {
    opacity: 0.45;
  }
  .lab {
    font: 500 var(--f) / 1 var(--sans);
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .hit {
    fill: transparent;
  }
  .pt:hover .hit {
    stroke: var(--ink);
    stroke-width: 1.2;
  }
  .lab {
    pointer-events: none;
  }
  .empty {
    color: var(--ink-3);
  }
</style>
