---
// A benchmark's scores over time: every score from Epoch AI and from lab cards, the best score so far,
// and the reference lines that matter for that benchmark.
import type { BenchSummary } from '../lib/data.ts';
import { epochScores, cardScores, SATURATED } from '../lib/data.ts';
import TimeScatter, { type Pt } from './TimeScatter.astro';

interface Props {
  s: BenchSummary;
}
const { s } = Astro.props;
const b = s.b;
const unit = b.unit ?? '%';
const points: Pt[] = [...epochScores.filter((x) => x.benchmark === b.id), ...cardScores.filter((x) => x.benchmark === b.id && x.unit === unit)]
  .filter((x) => x.date)
  .map((x) => ({ date: x.date!, value: x.value, model: x.model, source: x.source, setting: x.setting, harness: x.harness }));

const refs: { v: number; label: string }[] = [];
if (unit === '%') {
  if (b.better !== 'lower') refs.push({ v: SATURATED, label: 'Near the ceiling (85%)' });
  if (b.epoch?.random) refs.push({ v: b.epoch.random, label: 'Random guessing' });
  if (b.epoch?.ceiling && b.epoch.ceiling < 100) refs.push({ v: b.epoch.ceiling, label: 'Highest possible score' });
}
const frontier = s.frontier.filter((p) => points.some((q) => q.model === p.model));
---

<TimeScatter
  points={points}
  frontier={frontier}
  unit={unit}
  label={`${b.name} scores over time`}
  domain={unit === '%' ? [0, 100] : undefined}
  refs={refs}
  better={b.better}
/>
