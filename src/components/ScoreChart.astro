---
// A benchmark's scores over time: every score from its leaderboard, Epoch AI's runs, boards and claims Epoch AI
// collected, and lab cards, the best score so far, and the reference lines that matter for that benchmark.
import type { BenchSummary, EntryView, FrontierPoint } from '../lib/data.ts';
import { epochScores, collectedScores, cardScores, leaderboardScores, SATURATED, LEADERBOARDS, inEntryView } from '../lib/data.ts';
import TimeScatter, { type Pt } from './TimeScatter.astro';
import ChartDownload from './ChartDownload.astro';
import { sourcesCredit, SOURCE_CREDIT, EPOCH_CREDIT } from '../lib/credits.ts';
import { benchDeck, benchAxis } from '../lib/figure-text.ts';

interface Props {
  s: BenchSummary;
  /**
   * The benchmark page's Entries switch. The standard-harness view keeps only the official board's runs in a
   * standard harness, and draws its own best-so-far line. Other sources stay: Epoch AI runs every model in one
   * harness, and lab claims are marked as claims.
   */
  entries?: EntryView;
}
const { s, entries = 'models' } = Astro.props;
const b = s.b;
const unit = b.unit ?? '%';
const points: Pt[] = [
  ...leaderboardScores.filter((x) => x.benchmark === b.id && inEntryView(x, entries === 'same' ? 'same' : 'models')),
  ...epochScores.filter((x) => x.benchmark === b.id),
  ...collectedScores.filter((x) => x.benchmark === b.id),
  ...cardScores.filter((x) => x.benchmark === b.id && x.unit === unit),
]
  .filter((x) => x.date)
  .map((x) => ({ date: x.date!, value: x.value, model: x.model, source: x.source, via: x.via, from: x.from, setting: x.setting, harness: x.harness, benchmark: x.benchmark, ...(x.info?.source ? { info: { source: x.info.source } } : {}) }));

const refs: { v: number; label: string }[] = [];
if (unit === '%') {
  if (b.better !== 'lower') refs.push({ v: SATURATED, label: 'Near the ceiling (85%)' });
  if (b.epoch?.random) refs.push({ v: b.epoch.random, label: 'Random guessing' });
  if (b.epoch?.ceiling && b.epoch.ceiling < 100) refs.push({ v: b.epoch.ceiling, label: 'Highest possible score' });
}
// the best score so far: the summary's own line, or for the standard-harness view one drawn from its points the same
// way (percent scores only, highest first on a tie, a lab's claim within 0 to 100)
const sign = b.better === 'lower' ? -1 : 1;
const ownFrontier = (): FrontierPoint[] => {
  if (unit !== '%') return [];
  const out: FrontierPoint[] = [];
  const keep = points.filter((p) => p.source !== 'card' || (p.value > 0 && p.value <= 100));
  for (const p of [...keep].sort((x, y) => x.date.localeCompare(y.date) || sign * (y.value - x.value)))
    if (!out.length || sign * p.value > sign * out.at(-1)!.value) out.push({ date: p.date, value: p.value, model: p.model, source: p.source, via: p.via, from: p.from });
  return out;
};
const frontier = entries === 'same' ? ownFrontier() : s.frontier.filter((p) => points.some((q) => q.model === p.model));
const host = LEADERBOARDS[b.id]?.host;
// other sources whose runs the board adds, such as Kaggle Benchmarks, named beside it
const alsoNames = Object.values(LEADERBOARDS[b.id]?.sources ?? {}).map((o) => o.name);
const also = alsoNames.length ? ` (with ${alsoNames.join(' and ')} runs)` : '';
// a copied board and a collected claim both come through Epoch AI; the legend tells them apart
const credit = sourcesCredit(
  points.map((p) => ({ source: p.source === 'collected' && p.via !== 'board' ? 'claim' : p.source })),
  { ...SOURCE_CREDIT, leaderboard: `${host ? `${host}’s leaderboard` : `official ${b.name} leaderboard`}${also}`, collected: `other boards, via ${EPOCH_CREDIT}` },
);
const kinds = [
  points.some((p) => p.source === 'leaderboard') && `${host ? `${host}’s leaderboard` : 'the official leaderboard'}${also}`,
  points.some((p) => p.source === 'epoch') && 'Epoch AI’s own runs',
  points.some((p) => p.source === 'collected') && 'boards and claims Epoch AI collected',
  points.some((p) => p.source === 'card') && 'labs’ model cards',
].filter((x): x is string => Boolean(x));
const counts = `Every dated score we have, one mark each, from ${kinds.length < 3 ? kinds.join(' and ') : `${kinds.slice(0, -1).join(', ')} and ${kinds.at(-1)}`}. A model tested at several settings appears more than once. The step line is the best score so far.`;
---

<ChartDownload
  subject={b.name}
  credit={credit}
  name="scores-over-time"
  deck={benchDeck(b)}
  yAxis={benchAxis(b)}
  xAxis="Date: the date the board or Epoch AI gives a run, else the model’s release, and the card’s date for lab claims"
  counts={counts}
  leaves="Scores with no date, and lab numbers reported in a different unit."
>
<TimeScatter
  points={points}
  frontier={frontier}
  unit={unit}
  label={`${b.name} scores over time`}
  domain={unit === '%' ? [0, 100] : undefined}
  refs={refs}
  marks={b.refreshes}
  better={b.better}
  sourceNote={LEADERBOARDS[b.id]?.host ? { leaderboard: `On ${LEADERBOARDS[b.id].host}’s leaderboard` } : LEADERBOARDS[b.id]?.static === 'paper' ? { leaderboard: 'In the benchmark’s paper' } : {}}
/>
</ChartDownload>
