---
// A model's card: who made it and when, its Epoch Capabilities Index with a strip that places it among
// every scored model, and three headline results with their ranks. Hairline frame, no fills.
import LabMark from './LabMark.astro';
import { modelSummary, headlineResults, eciValues, labById } from '../lib/data.ts';
import { labColor } from '../lib/palette.ts';
import { monthYear, score as fmt } from '../lib/format.ts';
import { featuredIds } from '../lib/routes.ts';

interface Props {
  id: string;
  hero?: boolean;
}
const { id, hero = false } = Astro.props;
const ms = modelSummary(id);
const m = ms.m;
const lab = m.lab ? labById.get(m.lab) : undefined;
const color = labColor(m.lab);
const heads = headlineResults(id, 3);
const lo = eciValues[0] ?? 0;
const hi = eciValues.at(-1) ?? 1;
const at = (v: number) => `${Math.min(100, Math.max(0, ((v - lo) / (hi - lo)) * 100)).toFixed(2)}%`;
const href = !hero && featuredIds.has(id) ? `/models/${id}/` : undefined;
const Tag = href ? 'a' : 'div';
const TIER: Record<string, string> = { flagship: 'Flagship', mid: 'Mid-size', small: 'Small', 'open-weights': 'Open model' };
---

<Tag class:list={['mc', { hero }]} href={href} style={`--c:${color}`}>
  <div class="top">
    <span class="lab"><LabMark lab={m.lab} size={hero ? 22 : 18} />{lab?.name ?? 'Unknown lab'}</span>
    {m.released && <span class="date mono">{monthYear(m.released)}</span>}
  </div>
  <div class="name">
    <h3>{m.name}</h3>
    <p class="sub">
      {m.version && <span>{m.version} snapshot</span>}
      {m.weights && <span>{m.weights === 'open' ? 'Open weights' : 'Closed weights'}</span>}
      {m.tier && <span>{TIER[m.tier]}</span>}
    </p>
  </div>
  {
    ms.eci ? (
      <div class="eci">
        <div class="eci-row">
          <span class="eci-v">{ms.eci.eci.toFixed(1)}</span>
          <span class="eci-r num">
            #{ms.eciRank} <span class="muted">of {eciValues.length}</span>
          </span>
        </div>
        <div class="eci-l">Epoch Capabilities Index</div>
        <div class="rug" aria-hidden="true">
          {ms.eci.low != null && ms.eci.high != null && <b class="ci" style={`left:${at(ms.eci.low)};width:calc(${at(ms.eci.high)} - ${at(ms.eci.low)})`} />}
          <b class="me" style={`left:${at(ms.eci.eci)}`} />
        </div>
      </div>
    ) : (
      <div class="eci none">
        <div class="eci-l">No Epoch Capabilities Index score yet</div>
      </div>
    )
  }
  {
    heads.length > 0 && (
      <ul class="hl">
        {heads.map((r) => (
          <li>
            <span class="hb">{r.benchmark.name}</span>
            <span class="hv num">{fmt(r.score.value, '%')}</span>
            <span class="hr num">
              #{r.rank}
              <span class="muted">/{r.of}</span>
            </span>
            <span class="track">
              <span style={`width:${Math.max(1, r.score.value)}%`} />
            </span>
          </li>
        ))}
      </ul>
    )
  }
</Tag>

<style>
  .mc {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 20px 20px 22px;
    border-radius: 14px;
    box-shadow: inset 0 0 0 1px var(--line);
    background: var(--bg);
    color: inherit;
    text-decoration: none;
    min-width: 0;
    transition: box-shadow 140ms ease, transform 140ms ease;
  }
  a.mc:hover {
    box-shadow: inset 0 0 0 1px var(--ink-4), 0 10px 30px rgb(0 0 0 / 0.06);
    transform: translateY(-1px);
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    color: var(--ink-2);
  }
  .lab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
  }
  .date {
    color: var(--ink-3);
    white-space: nowrap;
  }
  h3 {
    font-size: 26px;
    line-height: 1.08;
  }
  .sub {
    margin-top: 6px;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 14px;
    font-size: 13px;
    color: var(--ink-3);
  }
  .eci-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .eci-v {
    font-size: 36px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .eci-r {
    font-size: 15px;
    font-weight: 500;
  }
  .eci-l {
    margin-top: 6px;
    font-size: 12.5px;
    color: var(--ink-3);
  }
  .none .eci-l {
    margin-top: 0;
  }
  .rug {
    position: relative;
    height: 18px;
    margin-top: 12px;
  }
  .rug {
    background: url(/eci-rug.svg) 0 5px / 100% 8px no-repeat;
  }
  .rug .ci {
    position: absolute;
    top: 8px;
    height: 2px;
    background: var(--c);
    opacity: 0.5;
    border-radius: 1px;
  }
  .rug .me {
    position: absolute;
    top: 2px;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 2px var(--bg);
  }
  .hl {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .hl li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    column-gap: 10px;
    align-items: baseline;
    font-size: 13px;
  }
  .hb {
    color: var(--ink-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hv {
    font-weight: 500;
  }
  .hr {
    text-align: right;
    color: var(--ink-2);
    white-space: nowrap;
    min-width: 4.4em;
  }
  .track {
    grid-column: 1 / -1;
    height: 4px;
    margin-top: 6px;
    border-radius: 2px;
    background: var(--panel);
  }
  .track span {
    display: block;
    height: 100%;
    border-radius: 2px;
    background: var(--c);
  }
  .hero {
    padding: 26px 26px 28px;
  }
  .hero h3 {
    font-size: 34px;
  }
  .hero .eci-v {
    font-size: 48px;
  }
</style>
