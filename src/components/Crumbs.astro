---
// The trail above a page title: where this page sits, each step a link up.
interface Props {
  items: { href: string; label: string }[];
}
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {
      items.map((it) => (
        <li>
          <a href={it.href}>{it.label}</a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 0;
    margin: 0 0 14px;
    padding: 0;
    list-style: none;
    font-size: 13.5px;
    color: var(--ink-3);
  }
  .crumbs li + li::before {
    content: '/';
    margin: 0 8px;
    color: var(--ink-4);
  }
  .crumbs a {
    color: inherit;
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
