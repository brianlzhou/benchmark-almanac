---
// A 16px icon for an outside link on a benchmark page: the GitHub mark for a GitHub repository, otherwise a
// plain line icon for code, a paper, a dataset, a leaderboard or a website. The GitHub mark is Octicons'
// mark-github (MIT).
interface Props {
  kind: 'github' | 'code' | 'paper' | 'dataset' | 'leaderboard' | 'site';
}
const { kind } = Astro.props;
---

<svg class="li-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
  {
    kind === 'github' ? (
      <path
        fill="currentColor"
        d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
      />
    ) : (
      <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        {kind === 'code' && <path d="M5.5 4.5 2 8l3.5 3.5M10.5 4.5 14 8l-3.5 3.5" />}
        {kind === 'paper' && <path d="M4 1.75h5.25L12.5 5v9.25H4zM9.25 1.75V5h3.25M6.25 8.25h4M6.25 11h4" />}
        {kind === 'dataset' && (
          <>
            <ellipse cx="8" cy="3.75" rx="5" ry="2" />
            <path d="M3 3.75v8.5c0 1.1 2.24 2 5 2s5-.9 5-2v-8.5M3 8c0 1.1 2.24 2 5 2s5-.9 5-2" />
          </>
        )}
        {kind === 'leaderboard' && <path d="M1.75 14.25h12.5M2.75 14.25V9.5h3.5M6.25 14.25V5h3.5v9.25M9.75 11h3.5v3.25" />}
        {kind === 'site' && (
          <>
            <circle cx="8" cy="8" r="6.25" />
            <path d="M1.75 8h12.5M8 1.75c1.7 1.85 2.55 3.9 2.55 6.25S9.7 12.4 8 14.25C6.3 12.4 5.45 10.35 5.45 8S6.3 3.6 8 1.75Z" />
          </>
        )}
      </g>
    )
  }
</svg>
