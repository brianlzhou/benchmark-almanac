---
// The abstract of a benchmark's own paper, under the page's own description: the authors' text as a
// quotation, with the paper, its host and its license under it.
// Abstracts come from scripts/abstracts.ts, which keeps only open licenses.
import abstractsJson from '../../data/abstracts.json';
import type { PaperAbstract } from '../lib/types.ts';

interface Props {
  id: string;
}
const a = (abstractsJson as Record<string, PaperAbstract>)[Astro.props.id];
const license = a?.license === 'CC0 1.0' ? 'CC0' : a?.license;
---

{
  a && (
    <figure class="aw">
      <p class="aw-h">In the authors’ words</p>
      <blockquote cite={a.url}>
        <p>{a.text}</p>
      </blockquote>
      <figcaption>
        Abstract of <a href={a.url}>{a.title}</a> ({a.ref}, {license})
      </figcaption>
    </figure>
  )
}

<style>
  .aw {
    margin: 28px 0 0;
    max-width: 68ch;
  }
  .aw-h {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-3);
  }
  /* the opening quotation mark hangs in the margin, so the text keeps a straight left edge */
  .aw blockquote {
    position: relative;
    margin: 8px 0 0;
    font: 400 17px/1.6 var(--serif);
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }
  .aw blockquote::before {
    content: '“';
    position: absolute;
    left: -0.5em;
    top: 0;
    color: var(--ink-4);
  }
  .aw figcaption {
    margin-top: 12px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-3);
    overflow-wrap: anywhere;
  }
  .aw figcaption a {
    color: var(--ink-2);
  }
  @media (max-width: 720px) {
    .aw blockquote {
      font-size: 16px;
    }
  }
</style>
