---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { benchmarks, AS_OF, featuredModels, labs } from '../lib/data.ts';
import { humanDate } from '../lib/format.ts';
import { AREAS } from '../lib/taxonomy.ts';
import FootRidge from '../components/FootRidge.astro';
import AreaMark from '../components/AreaMark.astro';
import SearchBox from '../components/SearchBox.astro';
import SeoHead, { type Film } from '../components/SeoHead.astro';
import { SITE_DESCRIPTION } from '../lib/site.ts';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  /** The link-preview film and poster (public/og/): the footer ridge unless the page says otherwise. */
  film?: Film;
  /** The page's breadcrumb trail, for search engines (BreadcrumbList). */
  crumbs?: { href: string; label: string }[];
  /** Structured data for the page (schema.org), beside the breadcrumbs. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}
const {
  title,
  description = SITE_DESCRIPTION,
  film,
  crumbs,
  jsonLd,
  noindex,
} = Astro.props;
const fullTitle = title ? `${title} | Benchmark Almanac` : 'Benchmark Almanac: AI benchmarks and who leads them';
const path = Astro.url.pathname;
// Three tracks: the tests we track, who does well on them, and what labs say about their own models. Pages about
// the catalog itself sit in the More menu at the right, beside Submit. A link marked fold moves into More on
// mid-size screens, so the row never crowds, and the whole row folds into the menu button on small ones. A link
// marked fold: 'menu' sits in More at every width, because the row has no room for it under the page's width cap.
const NAV: { id: string; label: string; links: { href: string; label: string; fold?: boolean | 'menu' }[] }[] = [
  {
    id: 'track',
    label: 'What we track',
    links: [
      { href: '/benchmarks/', label: 'Benchmarks' },
      { href: '/arenas/', label: 'Arenas' },
    ],
  },
  {
    id: 'lead',
    label: 'Who leads',
    links: [
      { href: '/leaders/', label: 'Leaders' },
      { href: '/models/', label: 'Models' },
      { href: '/compare/', label: 'Compare', fold: 'menu' },
      { href: '/labs/', label: 'Labs' },
      { href: '/build/', label: 'Build an index', fold: true },
    ],
  },
  {
    id: 'say',
    label: 'What labs report',
    links: [
      { href: '/cards/', label: 'Model cards', fold: true },
      { href: '/reporting/', label: 'Reporting', fold: true },
    ],
  },
];
const MORE = [
  { href: '/new/', label: 'New this month' },
  { href: '/audits/', label: 'Audits' },
  { href: '/sources/', label: 'Sources' },
  { href: '/contribute/', label: 'Contribute' },
];
// the same links in one list, for the footer
const NAV_LINKS = NAV.flatMap((g) => g.links);
const FOLDS = NAV_LINKS.filter((n) => n.fold);
const current = (href: string) => path.startsWith(href) || (href === '/benchmarks/' && path.startsWith('/categories/'));
const moreOn = MORE.some((n) => current(n.href));
const foldOn = FOLDS.some((n) => current(n.href));
const foldMenuOn = FOLDS.some((n) => n.fold === 'menu' && current(n.href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <SeoHead title={title} description={description} film={film} crumbs={crumbs} jsonLd={jsonLd} noindex={noindex} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0f10" media="(prefers-color-scheme: dark)" />
    <Font cssVariable="--font-serif" preload={[{ weight: '400', style: 'normal' }]} />
    <Font cssVariable="--font-sans" preload={[{ weight: '400' }, { weight: '500' }]} />
    <Font cssVariable="--font-mono" />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="bar">
      <div class="page bar-in">
        <a class="word" href="/" aria-label="Benchmark Almanac, home">Benchmark Almanac</a>
        <button class="menu-b" type="button" popovertarget="menu" aria-label="Menu">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.5"></path></svg>
        </button>
        <nav aria-label="Main" id="menu" popover>
          {
            NAV.map((g) => (
              <div class={`ng ng-${g.id}`} role="group" aria-label={g.label}>
                {g.links.map((n) => (
                  <a href={n.href} class:list={{ fold: n.fold, 'fold-m': n.fold === 'menu' }} aria-current={current(n.href) ? 'page' : undefined}>
                    {n.label}
                  </a>
                ))}
              </div>
            ))
          }
          <div class="ng ng-work" role="group" aria-label="About the catalog">
            <button class="more-b" type="button" popovertarget="more" aria-haspopup="true" data-on={moreOn || undefined} data-fold-on={foldOn || undefined} data-fold-menu-on={foldMenuOn || undefined}>
              More
              <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
            </button>
            <div class="more-p" id="more" popover>
              {
                FOLDS.map((n) => (
                  <a href={n.href} class:list={['fold-c', { 'fold-cm': n.fold === 'menu' }]} aria-current={current(n.href) ? 'page' : undefined}>
                    {n.label}
                  </a>
                ))
              }
              {
                MORE.map((n, i) => (
                  <a href={n.href} class:list={{ first: i === 0 }} aria-current={current(n.href) ? 'page' : undefined}>
                    {n.label}
                  </a>
                ))
              }
            </div>
            <a href="/submit/" class="cta" aria-current={current('/submit/') ? 'page' : undefined}>Submit</a>
          </div>
        </nav>
        <div class="bar-end">
          <div class="bar-s" data-bar-search>
            <button class="find-b" type="button" aria-label="Search" aria-expanded="false" aria-controls="bar-find" data-find-open>
              <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><circle cx="8" cy="8" r="5.75" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M12.5 12.5L16 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
            </button>
            <div class="find-p" id="bar-find">
              <SearchBox id="bar-list" size="compact" placeholder="Search" label="Site" />
              <button class="find-x" type="button" aria-label="Close search" data-find-close>
                <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
              </button>
            </div>
          </div>
          <button class="theme" type="button" aria-label="Switch light or dark theme" data-theme-toggle>
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor"></path></svg>
          </button>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="foot">
      <FootRidge />
      <div class="page foot-in">
        <div class="foot-brand">
          <a class="word" href="/">Benchmark Almanac</a>
          <p>AI benchmarks, who leads them, and which ones labs still report.</p>
          <p class="foot-n">
            {benchmarks.length.toLocaleString('en-US')} benchmarks, {featuredModels.length.toLocaleString('en-US')} models and {labs.length} labs. Data as of {humanDate(AS_OF)}.
          </p>
          <a class="foot-submit" href="/submit/">
            Submit a benchmark
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 6h7M6.5 3l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </a>
        </div>
        <div class="foot-cols">
          <div>
            <h2>Explore</h2>
            <ul>
              {[...NAV_LINKS.filter((n) => !n.fold), { href: '/compare/', label: 'Compare models' }, { href: '/cards/', label: 'Model cards' }, { href: '/reporting/', label: 'What labs report' }, { href: '/build/', label: 'Build your own index' }, { href: '/new/', label: 'New this month' }, { href: '/audits/', label: 'Audits' }, { href: '/contribute/', label: 'Contribute' }]
                .filter((n, i, xs) => xs.findIndex((y) => y.href === n.href) === i)
                .map((n) => (
                  <li><a href={n.href}>{n.label}</a></li>
                ))}
            </ul>
          </div>
          <div>
            <h2>Areas</h2>
            <ul>
              {AREAS.filter((a) => a.id !== 'other').map((a) => (
                <li><a href={`/benchmarks/?area=a:${a.id}`}><AreaMark area={a.id} size={9} />{a.name}</a></li>
              ))}
            </ul>
          </div>
          <div>
            <h2>Method</h2>
            <ul>
              <li><a href="/methodology/">How we compare scores</a></li>
              <li><a href="/claims/">Lab claims next to leaderboards</a></li>
              <li><a href="/about/#cataloged">What gets cataloged</a></li>
              <li><a href="/about/#data">Where the scores come from</a></li>
              <li><a href="/about/#labels">In use, fading, dropped</a></li>
              <li><a href="/about/#versions">Versions</a></li>
              <li><a href="/about/#leaders">Who held number one</a></li>
              <li><a href="/about/#finding">Finding new benchmarks</a></li>
              <li><a href="/audits/#rules">Known issues</a></li>
              <li><a href="/sources/">Sources</a></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="page foot-base">
        <p>Scores from Epoch AI and Arena are under CC BY 4.0, and scores from other leaderboards are under each board’s own terms.</p>
        <p><a href="/about/#credits">Credits</a></p>
      </div>
    </footer>
    <div id="tip" role="tooltip"></div>
    <script>
      import '../scripts/tips.ts';
      import '../scripts/search-boot.ts';
      import { wireSortAll } from '../scripts/sort.ts';
      wireSortAll();
      // a link to another site opens in a new tab, so the almanac stays open behind it. One listener covers
      // every link, including the ones search and the hover cards add later.
      document.addEventListener(
        'click',
        (e) => {
          const a = (e.target as Element | null)?.closest?.<HTMLAnchorElement>('a[href]');
          if (!a || a.target || a.hasAttribute('download') || !/^https?:$/.test(a.protocol) || a.origin === location.origin) return;
          a.target = '_blank';
          a.rel = 'noopener';
        },
        true,
      );
      // the More menu opens in the top layer, so it is placed under its button by hand: right edges aligned
      const moreB = document.querySelector<HTMLElement>('.more-b');
      const moreP = document.getElementById('more');
      moreP?.addEventListener('beforetoggle', (e) => {
        if ((e as ToggleEvent).newState !== 'open' || !moreB) return;
        const r = moreB.getBoundingClientRect();
        moreP.style.top = `${Math.round(r.bottom + 8)}px`;
        moreP.style.right = `${Math.max(12, Math.round(document.documentElement.clientWidth - r.right))}px`;
      });
      moreP?.addEventListener('toggle', (e) => moreB?.setAttribute('aria-expanded', String((e as ToggleEvent).newState === 'open')));
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try {
          localStorage.setItem('theme', root.dataset.theme);
        } catch {}
      });
    </script>
  </body>
</html>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
  }
  /* the height comes from --bar-h in global.css, which sticky rows below the header also use */
  .bar-in {
    position: relative;
    display: flex;
    align-items: center;
    gap: 36px;
    height: var(--bar-h);
  }
  .word {
    font: 400 21px/1 var(--serif);
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }
  /* The row, from widest to narrowest (measured with a 15px scrollbar, and at least 25px to spare):
       1260px and up: every link but Compare, More, Submit, search and theme, with tighter spacing below 1440px.
         Compare sits at the top of More at every width: with it the row runs 27px over even at the 1240px cap.
       960 to 1259px: Compare, Build an index, Model cards and Reporting move into the More menu
       below 960px: the whole row folds into the menu button
     The name keeps its place at every step. */
  nav {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1 0 auto;
  }
  /* A group is one track: its links share a tint, and the current page sits raised on it, so the tracks read
     as separate sets without a rule between them. */
  .ng {
    --seg-on: var(--bg);
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .ng-track,
  .ng-lead,
  .ng-say {
    padding: 3px;
    border-radius: 11px;
    background: var(--panel);
  }
  nav a {
    font-size: 14px;
    color: var(--ink-3);
    text-decoration: none;
    padding: 6px 11px;
    border-radius: 8px;
    white-space: nowrap;
  }
  nav a:hover {
    color: var(--ink);
  }
  .ng-track a[aria-current='page'],
  .ng-lead a[aria-current='page'],
  .ng-say a[aria-current='page'] {
    color: var(--ink);
    background: var(--seg-on);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06), 0 0 0 1px var(--line);
  }
  /* pages about the catalog: a quiet More menu at the right, with Submit as the one button */
  .ng-work {
    margin-left: auto;
    gap: 6px;
  }
  .more-b {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 9px;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--ink-3);
    font: 400 13.5px/1.2 var(--sans);
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 140ms ease, color 140ms ease;
  }
  .more-b:hover,
  .more-b[aria-expanded='true'] {
    color: var(--ink);
    background: var(--panel);
  }
  .more-b[data-on] {
    color: var(--ink);
  }
  .more-b svg {
    color: var(--ink-4);
    transition: rotate 140ms ease;
  }
  .more-b[aria-expanded='true'] svg {
    rotate: 180deg;
  }
  /* the open menu, in the style of the site's dropdowns. The script places it under the button. */
  .more-p {
    position: fixed;
    inset: auto;
    margin: 0;
    flex-direction: column;
    gap: 2px;
    min-width: 188px;
    padding: 6px;
    border: 0;
    border-radius: 12px;
    background: var(--bg);
    color: var(--ink);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.14), 0 0 0 1px var(--line);
  }
  .more-p:popover-open {
    display: flex;
    animation: find-in 140ms ease-out;
  }
  .more-p a {
    padding: 8px 10px;
    border-radius: 7px;
    color: var(--ink-2);
  }
  .more-p a:hover,
  .more-p a:focus-visible {
    color: var(--ink);
    background: var(--hover);
  }
  .more-p a[aria-current='page'] {
    color: var(--ink);
    font-weight: 500;
  }
  /* the links that live in the row on wide screens show in the menu only on mid-size ones */
  .more-p .fold-c {
    display: none;
  }
  /* Compare lives in the menu at every desktop width, set apart from the pages about the catalog by a space */
  nav a.fold-m {
    display: none;
  }
  .more-p .fold-cm {
    display: block;
  }
  .more-p .first {
    margin-top: 8px;
  }
  .more-b[data-fold-menu-on] {
    color: var(--ink);
  }
  .ng-work a.cta {
    font-size: 13.5px;
    padding: 5px 13px;
    border-radius: 999px;
    color: var(--ink-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .ng-work a.cta:hover,
  .ng-work a.cta[aria-current='page'] {
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--ink-4);
  }
  @media (max-width: 1439px) {
    .bar-in {
      gap: 24px;
    }
    nav {
      gap: 8px;
    }
    nav a {
      padding: 6px 9px;
    }
  }
  @media (max-width: 1259px) {
    nav a.fold,
    .ng-say {
      display: none;
    }
    .more-p .fold-c {
      display: block;
    }
    /* a space, not a rule, sets the folded links apart from the pages about the catalog */
    .more-p .first {
      margin-top: 8px;
    }
    .more-b[data-fold-on] {
      color: var(--ink);
    }
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .ng {
      --seg-on: #2a2a2f;
    }
  }
  :global(:root[data-theme='dark']) .ng {
    --seg-on: #2a2a2f;
  }
  .menu-b {
    display: none;
  }
  nav[popover] {
    display: flex;
    position: static;
    inset: auto;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    width: auto;
    height: auto;
    overflow: visible;
  }
  .bar-end {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .theme,
  .menu-b,
  .find-b,
  .find-x {
    border: 0;
    background: none;
    color: var(--ink-3);
    padding: 8px;
    border-radius: 8px;
    cursor: pointer;
  }
  .theme:hover,
  .menu-b:hover,
  .find-b:hover,
  .find-x:hover {
    color: var(--ink);
    background: var(--panel);
  }
  /* The header search is an icon that opens a field over the bar. The row holds the links at every width,
     and the page width caps the row at 1240px, so a standing field no longer fits beside them. */
  .bar-s {
    flex: none;
    transition: opacity 160ms ease, visibility 160ms;
  }
  /* a page with its own big box shows the header search only once that one scrolls away */
  :global(html.js:has([data-search-main])) .bar-s:not(.main-gone) {
    visibility: hidden;
    opacity: 0;
  }
  .find-p :global(.search) {
    flex: 1;
    min-width: 0;
  }
  .find-b,
  .find-x {
    display: block;
  }
  /* the icon needs a script, so without one the table's own search box stands in */
  :global(html:not(.js)) .bar-s {
    display: none;
  }
  /* the open field covers the links, from the end of the name to the right edge */
  .find-p {
    display: none;
    align-items: center;
    gap: 6px;
    position: absolute;
    z-index: 1;
    inset: 0 var(--gutter) 0 calc(var(--gutter) + 218px);
    background: var(--bg);
  }
  .bar-s.finding .find-p {
    display: flex;
    animation: find-in 160ms ease-out;
  }
  /* the open field is wide, so its suggestions line up under it */
  .find-p :global(.search [role='listbox']) {
    left: 0;
    width: auto;
  }
  @keyframes find-in {
    from {
      opacity: 0;
      transform: translateY(-3px);
    }
  }
  @keyframes find-fade {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bar-s.finding .find-p {
      animation-name: find-fade;
    }
  }
  /* the footer: a stippled ridge of the catalog, then the brand and three columns of links */
  .foot {
    margin-top: 40px;
    overflow-x: clip;
    font-size: 14px;
    color: var(--ink-2);
  }
  .foot-in {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 2fr);
    gap: 40px;
    padding-top: 44px;
    padding-bottom: 56px;
  }
  .foot-brand {
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .foot-brand .word {
    font-size: 24px;
  }
  .foot-brand p {
    margin: 0;
    max-width: 34ch;
    line-height: 1.5;
  }
  .foot-n {
    color: var(--ink-3);
    font-size: 13px;
  }
  .foot-submit {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    padding: 9px 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
  }
  .foot-submit:hover {
    background: var(--panel);
  }
  .foot-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }
  .foot-cols h2 {
    margin: 0 0 14px;
    font: 400 17px/1.2 var(--serif);
    color: var(--ink);
  }
  .foot-cols ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .foot-cols a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink-2);
    text-decoration: none;
  }
  .foot-cols a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--ink-4);
    text-underline-offset: 3px;
  }
  .foot-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 8px;
    padding-bottom: 40px;
    font-size: 12.5px;
    color: var(--ink-3);
  }
  .foot-base p {
    margin: 0;
  }
  .foot-base a {
    color: inherit;
  }
  @media (max-width: 860px) {
    .foot-in {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
  }
  @media (max-width: 560px) {
    .foot-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* the short row needs about 920px with a scrollbar. Below 960px the nav folds into the menu button */
  @media (max-width: 959px) {
    .bar-in {
      gap: 8px;
    }
