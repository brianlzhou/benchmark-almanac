---
import { ECI_DECK, ECI_AXIS, SRI_DECK, RELEASE_AXIS, POOL_NOTES, CLOCK_NOTE } from '../../lib/figure-text.ts';
import ChartDownload from '../../components/ChartDownload.astro';
import { sourcesCredit, POOL_CREDIT } from '../../lib/credits.ts';
import Base from '../../layouts/Base.astro';
import ReignChart from '../../components/ReignChart.astro';
import CrownShare from '../../components/CrownShare.astro';
import LabMark from '../../components/LabMark.astro';
import { benchmarks, benchSummary, labById, modelById, benchById } from '../../lib/data.ts';
import { labShares, closeOuts, closeOutShares } from '../../lib/reigns.ts';
import ModelName from '../../components/ModelName.astro';
import Crumbs from '../../components/Crumbs.astro';
import AreaMark from '../../components/AreaMark.astro';
import { isNewest, familySize } from '../../lib/counts.ts';
import { leaderRows } from '../../lib/leaders.ts';
import { AREA_BY_ID, CATEGORY_NAMES, LEVELS, SUBCATEGORIES, SCORING_BY_ID, LEVEL_BY_ID, areaOf, levelIndex } from '../../lib/taxonomy.ts';
import { labColor } from '../../lib/palette.ts';
import { score as fmt, monthYear, lowerLabel } from '../../lib/format.ts';
import { AS_OF, monthsBetween } from '../../lib/data.ts';

export function getStaticPaths() {
  return [...new Set(benchmarks.map((b) => b.category ?? 'other'))].map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const cat = category!;
const name = CATEGORY_NAMES[cat] ?? cat;
const area = AREA_BY_ID.get(areaOf(cat))!;
const all = benchmarks.filter((b) => (b.category ?? 'other') === cat).map((b) => benchSummary(b.id));
all.sort((a, b) => b.cites.length + b.nScores - (a.cites.length + a.nScores) || a.b.name.localeCompare(b.b.name));
const ids = all.map((s) => s.b.id);
// counts fold a benchmark's versions into one, like the Benchmarks table
const tests = all.filter((s) => isNewest(s.b));
// every version counts (src/lib/counts.ts). A count that links to the Benchmarks table counts the way the table
// does: each matching row with all of its versions.
const asRows = (f: (s: (typeof tests)[number]) => boolean) => tests.filter(f).reduce((n, s) => n + familySize(s.b), 0);

// three ways, as on /leaders/: each benchmark from the one source its page leads with (the default, so these
// charts agree with the benchmark pages), every independent run, and every score with claims included
const POOL_VIEWS = [
  { src: 'headline' as const, label: 'One source per benchmark', share: 'Share of contested time at number one', note: 'Each benchmark counts from the one source its own page leads with: its official leaderboard when that is current, else Epoch AI’s own runs, else labs’ own numbers. We date independent runs by the model’s release and lab reports by when they came out.' },
  { src: 'independent' as const, label: 'All independent runs', share: 'Share of contested time at number one, independent runs only', note: 'Every independent run: each benchmark’s own leaderboard, Epoch AI’s runs and boards Epoch AI copied, dated by the model’s release. We leave out benchmarks that only labs report.' },
  { src: 'all' as const, label: 'Include claimed scores', share: 'Share of contested time at number one, claimed scores included', note: 'Every score, including labs’ own numbers and claims Epoch AI collected from reports and papers. Labs pick their own settings, so a claim can beat an independent run of the same model.' },
].map((v) => {
  const rows = leaderRows(ids, v.src);
  return { ...v, rows, shares: labShares(rows), closed: closeOuts(rows), closedBy: closeOutShares(rows) };
});
const poolList = POOL_VIEWS.filter((v, k) => k === 0 || v.rows.length > 0);
const main = POOL_VIEWS[0].rows;
const switchable = main.length > 0 && poolList.length > 1;
const shares = POOL_VIEWS[0].shares;
const top = shares[0];
const lower = lowerLabel(name);
// within two points, the runner-up shares the headline: one or two long reigns can decide a thin area
const pct = (x: { share: number }) => Math.round(x.share * 100);
const labName = (x: { lab: string }) => labById.get(x.lab)?.name ?? 'Other labs';
const second = shares[1];
const headline = !top || shares.length < 2
  ? `Who held number one in ${lower}`
  : pct(top) - pct(second) <= 2
    ? `${labName(top)} and ${labName(second)} held the top ${lower} score about equally, ${pct(top)}% and ${pct(second)}% of the contested time`
    : `${labName(top)} held the top ${lower} score ${pct(top)}% of the contested time`;

const span = monthsBetween('2023-01', AS_OF);
const monthsHeld = top ? Math.round(top.share * span) : 0;
const levels = LEVELS.map((l) => ({ l, xs: all.filter((s) => s.b.level === l.id) })).filter((x) => x.xs.length);
const unrated = all.filter((s) => !s.b.level);
const subs = (SUBCATEGORIES[cat] ?? []).map((sc) => ({ sc, xs: all.filter((s) => s.b.subcategory === sc.id) })).filter((x) => x.xs.length);
const unsorted = all.filter((s) => !s.b.subcategory || !(SUBCATEGORIES[cat] ?? []).some((sc) => sc.id === s.b.subcategory));
const STATUS: Record<string, string> = { 'in use': 'In use', fading: 'Fading', dropped: 'Dropped', 'system cards': 'System cards only', 'not in cards': 'Not in cards' };
const ladderTitle = levels.length > 1 ? `From ${lowerLabel(levels[0].l.name)} to ${lowerLabel(levels.at(-1)!.l.name)} level` : 'How hard the tests are';
const trail = [{ href: '/benchmarks/', label: 'Benchmarks' }, { href: `/benchmarks/?area=a:${area.id}`, label: area.name }];
---

<Base title={name} description={`${name} benchmarks by difficulty and kind, and who held the top score on each over time.`} crumbs={trail}>
  <div class="page">
    <header class="head">
      <Crumbs items={trail} />
      <h1 class="with-amark"><AreaMark area={area.id} size={20} />{name}</h1>
      <p class="lede">
        We track <a href={`/benchmarks/?area=c:${cat}`}>{all.length} {all.length === 1 ? 'benchmark' : 'benchmarks'}</a> in {lowerLabel(name)}.
        {levels.length > 1 && ` They run from ${lowerLabel(levels[0].l.name)} level to ${lowerLabel(levels.at(-1)!.l.name)} level.`}
      </p>
      <div class="facts">
        <a href={`/benchmarks/?area=c:${cat}&status=in-use`}><b>{asRows((s) => s.status === 'in use')}</b> in use</a>
        <span><b>{all.filter((s) => (s.best?.value ?? 0) >= 85 && (s.b.unit ?? '%') === '%').length}</b> past 85%</span>
        <a href={`/benchmarks/?area=c:${cat}&code=yes`}><b>{asRows((s) => !!s.b.links?.repo)}</b> with public code</a>
      </div>
    </header>

    {
      main.length > 0 && (
        <section class:list={[switchable && 'pools']}>
          <div class="sh-row">
            <div class="sh">
              <h2>{headline}</h2>
              <p>
                {top && shares.length > 1 && `That's about ${monthsHeld} of the ${span} months since January 2023, averaged over the benchmarks below. `}
                The easiest benchmarks are at the top. Versions of one test share a row, with a dark tick at each new version. We stop the clock, and fade the rest of the row, when the best score passes 85%, or at the newest score if 45 days go by without another. In between, the leader’s clock runs for at most 45 days at a time without a score from another lab.
              </p>
            </div>
            {switchable && (
              <div class="seg" role="radiogroup" aria-label="Scores from">
                {poolList.map((v, k) => (
                  <label>
                    <input type="radio" name="pool" value={v.src} checked={k === 0} />
                    {v.label}
                  </label>
                ))}
                <script is:inline>
                  // before the charts below paint: a link with ?pool= picks that pool, so nothing jumps
                  (function () {
                    var box = document.currentScript.parentElement;
                    var q = new URLSearchParams(location.search).get('pool');
                    var pick = (q === 'independent' || q === 'all') && box.querySelector('input[name="pool"][value="' + q + '"]');
                    if (pick) pick.checked = true;
                    box.addEventListener('change', function (e) {
                      var u = new URL(location.href);
                      if (e.target.value === 'headline') u.searchParams.delete('pool');
                      else u.searchParams.set('pool', e.target.value);
                      history.replaceState(history.state, '', u);
                    });
                  })();
                </script>
              </div>
            )}
          </div>
          {poolList.map((v) => (
            <div class={`pool-${v.src}`}>
              <ChartDownload credit={sourcesCredit(v.rows)} name={`number-one-${v.src}`} deckFrom="@lede" counts={`One row per benchmark in this category. Each colored stretch is the model with the best score at the time. ${POOL_NOTES[v.src].counts}`} leaves={POOL_NOTES[v.src].leaves}>
                <ReignChart rows={v.rows} />
              </ChartDownload>
              <div class="share">
                <h3>{v.share}</h3>
                <ChartDownload credit={POOL_CREDIT[v.src]} name={`time-at-number-one-${v.src}`} deck="Each lab’s share of the days its models held number one on this category’s benchmarks." counts={`${CLOCK_NOTE} ${POOL_NOTES[v.src].counts}`} leaves={POOL_NOTES[v.src].leaves}>
                  <CrownShare shares={v.shares} />
                </ChartDownload>
              </div>
              {v.closed.length > 0 && (
                <div class="share">
                  <h3>
                    Closed out: {v.closed.length} {v.closed.length === 1 ? 'benchmark' : 'benchmarks'} passed 85%
                  </h3>
                  <ChartDownload credit={POOL_CREDIT[v.src]} name={`closed-out-${v.src}`} deck="Close-outs by lab: a close-out goes to the model that first took a benchmark past 85%." counts={POOL_NOTES[v.src].counts} leaves="Benchmarks nobody has taken past 85%.">
                    <CrownShare shares={v.closedBy} what="Benchmarks closed out since 2023" />
                  </ChartDownload>
                  <ul class="closed">
                    {v.closed.map((c) => (
                      <li>
                        <span class="muted num">{monthYear(c.date)}</span>
                        <a href={`/benchmarks/${c.benchmark}/`}>{benchById.get(c.benchmark)?.name}</a>
                        <ModelName id={c.model} size={14} />
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              <p class="src">{v.note}</p>
            </div>
          ))}
        </section>
      )
    }

    {
      levels.length > 0 && (
        <section>
          <div class="sh">
            <h2>{ladderTitle}</h2>
            <p>Grouped by who could solve the tasks, from things most adults can do to open research problems. The bar under each name is its best score.</p>
          </div>
          <div class="ladder" style={`--n:${levels.length}`}>
            {levels.map(({ l, xs }) => (
              <div class="rung">
                <h3>{l.name}</h3>
                <p class="who">{l.who}</p>
                <ul>
                  {xs.map((s) => {
                    const pctUnit = (s.b.unit ?? '%') === '%' && s.b.better !== 'lower';
                    const lead = s.best ? modelById.get(s.best.model) : undefined;
                    return (
                      <li>
                        <a href={`/benchmarks/${s.b.id}/`}>
                          {s.b.name}
                          {s.b.format === 'proof' && <span class="fmt">proofs</span>}
                        </a>
                        {s.best && pctUnit ? (
                          <span class="bar" data-tv={fmt(s.best.value, '%')} data-tn={lead?.name} data-ts="Best score">
                            <span style={`width:${Math.max(1, s.best.value)}%;background:${labColor(lead?.lab)}`} />
                          </span>
                        ) : (
                          <span class="bar empty" />
                        )}
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))}
          </div>
          {unrated.length > 0 && <p class="src">Another {unrated.length} {unrated.length === 1 ? 'has' : 'have'} no level. Levels don’t apply to arenas, safety evaluations or composite indices.</p>}
        </section>
      )
    }

    <section>
      <div class="sh">
        <h2>By kind</h2>
      </div>
      {
        [...subs, ...(unsorted.length ? [{ sc: { id: 'unsorted', name: 'Not yet sorted' }, xs: unsorted }] : [])].map(({ sc, xs }) => (
          <div class="kind">
            <h3>{sc.name}</h3>
            <div class="table-wrap">
              <table class="t" data-sort>
                <thead>
                  <tr><th>Benchmark</th><th data-first="asc">Level</th><th>Scored</th><th class="r">Best score</th><th>Status</th></tr>
                </thead>
                <tbody>
                  {xs.map((s) => {
                    const lead = s.best ? modelById.get(s.best.model) : undefined;
                    return (
                      <tr>
                        <td class="nm">
                          <a href={`/benchmarks/${s.b.id}/`}>{s.b.name}</a>
                          {s.b.description && <span class="desc">{s.b.description}</span>}
                        </td>
                        <td class="muted nowrap" data-v={s.b.level ? String(levelIndex(s.b.level)) : undefined}>{s.b.level ? LEVEL_BY_ID.get(s.b.level)?.name : ''}</td>
                        <td class="muted nowrap">{s.b.scoring ? SCORING_BY_ID.get(s.b.scoring)?.name : ''}</td>
                        <td class="r nowrap" data-v={s.best && (s.b.unit ?? '%') === '%' ? String(s.best.value) : undefined}>
                          {s.best && lead && (
                            <span class="best">
                              <LabMark lab={lead.lab} size={14} />
                              {fmt(s.best.value, s.b.unit ?? '%')}
                            </span>
                          )}
                        </td>
                        <td class="nowrap">
                          <span class:list={['tag', `status-${s.status.replace(/ /g, '-')}`]}>
                            <span class="dot" />
                            {STATUS[s.status]}
                          </span>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        ))
      }
    </section>
  </div>
</Base>

<style>
  .share {
    margin-top: 40px;
  }
  .share h3,
  .kind h3,
  .rung h3 {
    font-size: 20px;
    margin-bottom: 12px;
  }
  .closed {
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
    display: grid;
    gap: 8px;
    font-size: 14px;
  }
  .closed li {
    display: grid;
    grid-template-columns: 90px minmax(0, 1fr) minmax(0, 1fr);
    gap: 16px;
    align-items: center;
  }
  .closed a {
    text-decoration: none;
  }
  .src {
    margin-top: 14px;
    font-size: 13px;
    color: var(--ink-3);
  }
  .ladder {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 28px;
  }
  .rung h3 {
    margin-bottom: 4px;
  }
  .who {
    font-size: 12.5px;
    color: var(--ink-3);
    min-height: 3.4em;
    line-height: 1.4;
  }
  .rung ul {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
    display: grid;
    gap: 12px;
  }
  .rung li a {
    display: block;
    font-size: 13.5px;
    text-decoration: none;
    line-height: 1.3;
  }
  .rung li a:hover {
    text-decoration: underline;
    text-decoration-color: var(--ink-4);
  }
  .fmt {
    margin-left: 6px;
    font-size: 11.5px;
    color: var(--ink-3);
  }
  .bar {
    display: block;
    height: 4px;
    margin-top: 5px;
    border-radius: 2px;
    background: var(--panel);
  }
  .bar span {
    display: block;
    height: 100%;
    border-radius: 2px;
  }
  .bar.empty {
    background: repeating-linear-gradient(90deg, var(--line) 0 4px, transparent 4px 8px);
  }
  .kind + .kind {
    margin-top: 44px;
  }
  .nm a {
    font-weight: 500;
  }
  .desc {
    display: block;
    margin-top: 3px;
    color: var(--ink-3);
    font-size: 13px;
    max-width: 58ch;
  }
  .best {
    display: inline-flex;
    gap: 7px;
    align-items: center;
  }
  .nowrap {
    white-space: nowrap;
  }
  @media (max-width: 900px) {
    .ladder {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
