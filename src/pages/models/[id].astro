---
import { ECI_DECK, ECI_AXIS, SRI_DECK, RELEASE_AXIS, POOL_NOTES, CLOCK_NOTE } from '../../lib/figure-text.ts';
import ChartDownload from '../../components/ChartDownload.astro';
import { creditLine, ECI_CREDIT } from '../../lib/credits.ts';
import Base from '../../layouts/Base.astro';
import ModelCard from '../../components/ModelCard.astro';
import LabMark from '../../components/LabMark.astro';
import TimeScatter, { type Pt } from '../../components/TimeScatter.astro';
import { featuredModels, modelSummary, models, eciByModel, cards, systemCards, benchById, sourceLabel } from '../../lib/data.ts';
import { AREAS, areaOf, SECTION_NAMES, SECTION_ORDER } from '../../lib/taxonomy.ts';
import { modelLine } from '../../lib/findings.ts';
import { fullDate, score as fmt, shortNum, humanDate } from '../../lib/format.ts';
import { labColor } from '../../lib/palette.ts';
import Crumbs from '../../components/Crumbs.astro';
import ClaimTable from '../../components/ClaimTable.astro';
import { selfReported } from '../../lib/self-reported.ts';
import { claimsForModel } from '../../lib/claims.ts';
import { rivalOf } from '../../lib/compare-data.ts';

export function getStaticPaths() {
  return featuredModels.map((m) => ({ params: { id: m.id } }));
}

const { id } = Astro.params;
const ms = modelSummary(id!);
const m = ms.m;
const color = labColor(m.lab);
const byArea = AREAS.map((a) => ({
  a,
  rows: ms.results.filter((r) => areaOf(r.benchmark.category) === a.id).sort((x, y) => x.rank / x.of - y.rank / y.of || y.of - x.of),
})).filter((g) => g.rows.length);
const firsts = ms.results.filter((r) => r.rank === 1 && r.of >= 5).length;
const top3 = ms.results.filter((r) => r.rank <= 3 && r.of >= 5).length;

// the lab's models on the index, this one in front
const labPts: Pt[] = ms.eci
  ? models
      .filter((x) => eciByModel.has(x.id) && x.released)
      .map((x) => ({ date: x.released!, value: eciByModel.get(x.id)!.eci, model: x.id, source: 'epoch' as const }))
  : [];
const labIds = models.filter((x) => x.lab === m.lab).map((x) => x.id);
const myCards = cards.filter((c) => c.model === m.id);
// its system cards, with results grouped by the section they sit in
const myDocs = systemCards
  .filter((d) => d.model === m.id)
  .map((d) => {
    const groups = new Map<string, typeof d.results>();
    for (const r of d.results) groups.set(r.section ?? 'other', [...(groups.get(r.section ?? 'other') ?? []), r]);
    const ordered = [...groups.entries()].sort(([a], [b]) => (SECTION_ORDER.indexOf(a) + 99) % 99 - ((SECTION_ORDER.indexOf(b) + 99) % 99));
    const inLaunch = new Set(myCards.filter((c) => c.id === d.release).flatMap((c) => c.results.map((r) => r.benchmark)));
    return { d, groups: ordered, extra: d.results.filter((r) => !inLaunch.has(r.benchmark)).length };
  });
const sr = selfReported.get(m.id);
const srGap = sr && ms.eci ? sr.value - ms.eci.eci : undefined;
const srHead = !sr
  ? ''
  : srGap === undefined
    ? `Its lab's numbers put it at ${sr.value.toFixed(1)}, number ${sr.rank} of ${selfReported.size}`
    : Math.abs(srGap) < 1
      ? `Its lab's numbers put it at ${sr.value.toFixed(1)}, in line with its ECI`
      : `Its lab's numbers put it at ${sr.value.toFixed(1)}, ${Math.abs(srGap).toFixed(1)} points ${srGap > 0 ? 'above' : 'below'} its ECI`;
const myClaims = claimsForModel(m.id);
// the Compare link pairs it with a model from another lab, from the same months, that shares the most benchmarks
const rival = rivalOf(m.id);
const trail = [{ href: '/models/', label: 'Models' }, ...(ms.lab ? [{ href: `/labs/${ms.lab.id}/`, label: ms.lab.name }] : [])];
// The page's headline finding, then what the page holds. Without a finding, modelLine gives only the name.
const finding = modelLine(ms);
const metaDescription = `${finding === m.name ? `${m.name}${ms.lab ? ` from ${ms.lab.name}` : ''}` : finding}. ${finding === m.name ? `Its scores on ${ms.results.length.toLocaleString('en-US')} ${ms.results.length === 1 ? 'benchmark' : 'benchmarks'}` : 'Its scores'}, its rank on each leaderboard${ms.eciRank ? `, its place on the Epoch Capabilities Index` : ''}, and what its model cards report.`;
---

<Base title={m.name} description={metaDescription} film="index" crumbs={trail}>
  <div class="page">
    <header class="head split">
      <div>
        <Crumbs items={trail} />
        <h1>{m.name}{m.version && <span class="ver"> {m.version}</span>}</h1>
        <p class="lede">{modelLine(ms)}.</p>
        <div class="facts">
          {ms.lab && <a class="lab" href={`/labs/${ms.lab.id}/`}><LabMark lab={ms.lab.id} size={16} />{ms.lab.name}</a>}
          {m.released && <span>Released <b>{humanDate(m.released)}</b></span>}
          {m.family && <span>Family <b>{m.family}</b></span>}
          {m.card && <a href={m.card}>The lab's model card</a>}
          {rival && <a href={`/compare/?m=${m.id},${rival}`}>Compare with others</a>}
        </div>
        <div class="stats mini">
          <div class="stat">
            <div class="v">{ms.results.length}</div>
            <div class="l">Benchmarks with a score</div>
          </div>
          <div class="stat">
            <div class="v">{firsts}</div>
            <div class="l">Ranked first, out of five or more models</div>
          </div>
          <div class="stat">
            <div class="v">{top3}</div>
            <div class="l">In the top three</div>
          </div>
        </div>
      </div>
      <ModelCard id={m.id} hero />
    </header>

    {
      byArea.length > 0 && (
        <section>
          <div class="sh">
            <h2>Where it ranks</h2>
            <p>Its best score on each benchmark, and where that ranks among every model with a score there. We rank each model once, at its best setting.</p>
          </div>
          {byArea.map(({ a, rows }) => (
            <div class="area">
              <h3>{a.name}</h3>
              <div class="table-wrap">
                <table class="t ranks" data-sort>
                  <thead>
                    <tr><th>Benchmark</th><th class="r">Score</th><th class="bar-h" /><th class="r">Rank</th><th>Source</th></tr>
                  </thead>
                  <tbody>
                    {rows.map((r) => {
                      const unit = r.benchmark.unit ?? '%';
                      return (
                        <tr>
                          <td><a href={`/benchmarks/${r.benchmark.id}/`}>{r.benchmark.name}</a></td>
                          <td class="r">{fmt(r.score.value, unit)}</td>
                          <td class="bar-c">
                            {unit === '%' && <span class="mini-bar"><span style={`width:${Math.max(1, r.score.value)}%;background:${color}`} /></span>}
                          </td>
                          <td class="r nowrap">{r.rank === 1 ? <b>#1</b> : `#${r.rank}`} <span class="muted">of {r.of}</span></td>
                          <td class="muted nowrap">{sourceLabel(r.score)}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </div>
          ))}
        </section>
      )
    }

    {
      sr && (
        <section>
          <div class="sh">
            <h2>{srHead}</h2>
            <p>
              The Self-Reported Index fits one score to the {sr.n} capability results {ms.lab?.name ?? 'the lab'} reported for this model, on the scale of the Epoch Capabilities Index. Labs choose which benchmarks to show and how to run them, so read it as the lab's claim, not an independent measurement. The 90% interval runs from {sr.low.toFixed(1)} to {sr.high.toFixed(1)}. <a href="/methodology/#self-reported">How we compute it</a>.
            </p>
          </div>
          <ul class="chips">
            {sr.scores.map((x) => (
              <li>
                <a href={`/benchmarks/${x.benchmark}/`}>{benchById.get(x.benchmark)?.name ?? x.benchmark}</a>
                <span class="sc">{shortNum(x.value)}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      myClaims.length > 0 && (
        <section>
          <div class="sh">
            <h2>{myClaims.length === 1 ? "Its lab's number next to a leaderboard" : `Its lab's numbers next to ${myClaims.length} leaderboards`}</h2>
            <p>Where the benchmark's own leaderboard, or Epoch AI's run, also has this model. Gaps mostly come from different harnesses, effort levels and task subsets. <a href="/claims/">Every pair</a>.</p>
          </div>
          <ClaimTable pairs={myClaims} model={false} />
        </section>
      )
    }

    {
      labPts.length > 0 && (
        <section>
          <div class="sh">
            <h2>{ms.lab?.name ?? 'The lab'}'s models over time</h2>
            <p>{ms.lab?.name}'s models in color, against every other model on the Epoch Capabilities Index, by release date.</p>
          </div>
          <ChartDownload credit={creditLine([ECI_CREDIT])} deck={`${ms.lab?.name ?? 'The lab'}’s models in color, against every other model on the index. ${ECI_DECK}`} yAxis={ECI_AXIS} xAxis={RELEASE_AXIS} counts="Every model with a Capabilities Index score, at its release date." leaves="Models Epoch AI hasn’t scored.">
          <TimeScatter points={labPts} unit="index" label={`${ms.lab?.name} models on the Epoch Capabilities Index`} highlight={labIds} labelIds={[m.id, ...labIds.filter((x) => x !== m.id)]} legend={false} height={400} />
          </ChartDownload>
        </section>
      )
    }

    {
      myCards.length > 0 && (
        <section>
          <div class="sh">
            <h2>{myCards.length === 1 ? 'Its launch post' : 'Its launch posts'}</h2>
            <p>The benchmarks the lab chose to headline, with the scores it gave.</p>
          </div>
          {myCards.map((c) => (
            <article class="card-doc">
              <div class="cd-h">
                <a href={c.url ?? '#'}>{c.title ?? `${m.name} model card`}</a>
                <span class="muted num">{fullDate(c.date)}</span>
              </div>
              <ul class="chips">
                {c.results.map((r) => (
                  <li>
                    <a href={`/benchmarks/${r.benchmark}/`}>{r.as_written ?? r.benchmark}</a>
                    {r.score !== null && <span class="sc">{shortNum(r.score)}</span>}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </section>
      )
    }

    {
      myDocs.length > 0 && (
        <section>
          <div class="sh">
            <h2>{myDocs.length === 1 ? 'Its system card' : 'Its system cards'}</h2>
            <p>
              Every result in the longer documents the lab published with it.
              {myDocs[0].extra > 0 && ` ${myDocs[0].extra} of them ${myDocs[0].extra === 1 ? "isn't" : "aren't"} in the launch post.`}
            </p>
          </div>
          {myDocs.map(({ d, groups }) => (
            <article class="card-doc">
              <div class="cd-h">
                <a href={d.url ?? '#'}>{d.title ?? `${m.name} ${d.doc ?? 'system card'}`}</a>
                <span class="muted num">{fullDate(d.date)}</span>
              </div>
              {groups.map(([sec, rs]) => (
                <div class="sec">
                  <h3>{SECTION_NAMES[sec] ?? sec}</h3>
                  <ul class="chips">
                    {rs.map((r) => (
                      <li>
                        <a href={`/benchmarks/${r.benchmark}/`}>{benchById.get(r.benchmark)?.name ?? r.benchmark}</a>
                        {r.score !== null && <span class="sc">{shortNum(r.score)}</span>}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </article>
          ))}
        </section>
      )
    }
  </div>
</Base>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    gap: 56px;
    align-items: start;
  }
  .ver {
    color: var(--ink-3);
  }
  .lab {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
  }
  .mini {
    margin-top: 40px;
    grid-template-columns: repeat(3, 1fr);
  }
  .area + .area {
    margin-top: 48px;
  }
  .area h3 {
    font-size: 21px;
    margin-bottom: 14px;
  }
  .ranks td:first-child {
    width: 40%;
  }
  .bar-c {
    width: 28%;
  }
  .mini-bar {
    display: block;
    height: 6px;
    border-radius: 3px;
    background: var(--panel);
  }
  .mini-bar span {
    display: block;
    height: 100%;
    border-radius: 3px;
  }
  .nowrap {
    white-space: nowrap;
  }
  .card-doc + .card-doc {
    margin-top: 32px;
  }
  .cd-h {
    display: flex;
    gap: 16px;
    justify-content: space-between;
    flex-wrap: wrap;
    font-weight: 500;
  }
  .sec {
    margin-top: 18px;
  }
  .sec h3 {
    font: 500 12.5px/1.2 var(--sans);
    color: var(--ink-3);
    margin: 0;
  }
  .sec .chips {
    margin-top: 8px;
  }
  /* each benchmark sits in its own soft tile, with its score in mono, so long lists stay easy to scan */
  .chips {
    list-style: none;
    padding: 0;
    margin: 10px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chips li {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    min-width: 0;
    padding: 5px 9px;
    border-radius: 7px;
    background: var(--panel);
    font-size: 13.5px;
    line-height: 1.3;
  }
  .chips a {
    color: var(--ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .chips a:hover {
    text-decoration: underline;
  }
  .chips .sc {
    font: 400 12px var(--mono);
    color: var(--ink-3);
  }
  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .bar-h,
    .bar-c {
      display: none;
    }
  }
</style>
