---
import { evalAttrs } from '../../lib/eval-kind.ts';
import { ECI_DECK, ECI_AXIS, SRI_DECK, RELEASE_AXIS, POOL_NOTES, CLOCK_NOTE } from '../../lib/figure-text.ts';
import ChartDownload from '../../components/ChartDownload.astro';
import { creditLine, ECI_CREDIT } from '../../lib/credits.ts';
import Base from '../../layouts/Base.astro';
import ModelCard from '../../components/ModelCard.astro';
import LabMark from '../../components/LabMark.astro';
import TimeScatter, { type Pt } from '../../components/TimeScatter.astro';
import { featuredModels, modelSummary, models, eciByModel, cards, systemCards, benchById, sourceLabel, isClaim, systemScores, leaderboardScores, entryLabel } from '../../lib/data.ts';
import { AREAS, areaOf, SECTION_NAMES, SECTION_ORDER } from '../../lib/taxonomy.ts';
import { modelLine } from '../../lib/findings.ts';
import { fullDate, score as fmt, shortNum, humanDate } from '../../lib/format.ts';
import { labColor } from '../../lib/palette.ts';
import Crumbs from '../../components/Crumbs.astro';
import ClaimTable from '../../components/ClaimTable.astro';
import { selfReported } from '../../lib/self-reported.ts';
import { claimsForModel } from '../../lib/claims.ts';
import { rivalOf } from '../../lib/compare-data.ts';
import HeldLanes from '../../components/model/HeldLanes.astro';
import Rivals from '../../components/model/Rivals.astro';
import CostTable from '../../components/model/CostTable.astro';
import Coverage from '../../components/model/Coverage.astro';
import { eciThenNow } from '../../lib/model-insights.ts';

export function getStaticPaths() {
  return featuredModels.map((m) => ({ params: { id: m.id } }));
}

const { id } = Astro.params;
const ms = modelSummary(id!);
const m = ms.m;
const color = labColor(m.lab);
const byArea = AREAS.map((a) => ({
  a,
  // ranked rows first by place, then lab numbers ranked among labs' numbers, then unranked lab numbers
  rows: ms.results.filter((r) => areaOf(r.benchmark.category) === a.id).sort((x, y) => (x.among === 'none' ? 1 : 0) - (y.among === 'none' ? 1 : 0) || (x.among ? 1 : 0) - (y.among ? 1 : 0) || (x.of ? x.rank / x.of : 1) - (y.of ? y.rank / y.of : 1) || y.of - x.of),
})).filter((g) => g.rows.length);
const firsts = ms.results.filter((r) => !r.among && r.rank === 1 && r.of >= 5).length;
const top3 = ms.results.filter((r) => !r.among && r.rank >= 1 && r.rank <= 3 && r.of >= 5).length;

// the lab's models on the index, this one in front
const labPts: Pt[] = ms.eci
  ? models
      .filter((x) => eciByModel.has(x.id) && x.released)
      .map((x) => ({ date: x.released!, value: eciByModel.get(x.id)!.eci, model: x.id, source: 'epoch' as const }))
  : [];
const labIds = models.filter((x) => x.lab === m.lab).map((x) => x.id);
const myCards = cards.filter((c) => c.model === m.id);
// its system cards, with results grouped by the section they sit in
const myDocs = systemCards
  .filter((d) => d.model === m.id)
  .map((d) => {
    const groups = new Map<string, typeof d.results>();
    for (const r of d.results) groups.set(r.section ?? 'other', [...(groups.get(r.section ?? 'other') ?? []), r]);
    const ordered = [...groups.entries()].sort(([a], [b]) => (SECTION_ORDER.indexOf(a) + 99) % 99 - ((SECTION_ORDER.indexOf(b) + 99) % 99));
    const inLaunch = new Set(myCards.filter((c) => c.id === d.release).flatMap((c) => c.results.map((r) => r.benchmark)));
    return { d, groups: ordered, extra: d.results.filter((r) => !inLaunch.has(r.benchmark)).length };
  });
// boards that list this model inside an agent or product: the agent's score, beside the model's own on that board
const better = (bid: string) => (benchById.get(bid)?.better === 'lower' ? -1 : 1);
const bestOf = <T extends { value: number }>(xs: T[], bid: string) => xs.reduce<T | undefined>((a, x) => (!a || better(bid) * x.value > better(bid) * a.value ? x : a), undefined);
const agentRows = [...Map.groupBy(systemScores.filter((x) => x.model === m.id || x.info?.models?.includes(m.id)), (x) => `${x.benchmark}|${entryLabel(x)}`).values()]
  .map((xs) => {
    const top = bestOf(xs, xs[0].benchmark)!;
    const own = bestOf(leaderboardScores.filter((x) => x.model === m.id && x.benchmark === top.benchmark), top.benchmark);
    return { top, own, b: benchById.get(top.benchmark)! };
  })
  .filter((r) => r.b)
  .sort((x, y) => x.b.name.localeCompare(y.b.name) || better(y.top.benchmark) * (y.top.value - x.top.value));
const sr = selfReported.get(m.id);
const srGap = sr && ms.eci ? sr.value - ms.eci.eci : undefined;
const srHead = !sr
  ? ''
  : srGap === undefined
    ? `Its lab's numbers put it at ${sr.value.toFixed(1)}, number ${sr.rank} of ${selfReported.size}`
    : Math.abs(srGap) < 1
      ? `Its lab's numbers put it at ${sr.value.toFixed(1)}, in line with its ECI`
      : `Its lab's numbers put it at ${sr.value.toFixed(1)}, ${Math.abs(srGap).toFixed(1)} points ${srGap > 0 ? 'above' : 'below'} its ECI`;
const myClaims = claimsForModel(m.id);
// the Compare link pairs it with a model from another lab, from the same months, that shares the most benchmarks
const rival = rivalOf(m.id);
const trail = [{ href: '/models/', label: 'Models' }, ...(ms.lab ? [{ href: `/labs/${ms.lab.id}/`, label: ms.lab.name }] : [])];
// The page's headline finding, then what the page holds. Without a finding, modelLine gives only the name.
const finding = modelLine(ms);
// where it stood on the index the day it came out, against today
const ord = (n: number) => `${n}${n % 100 >= 11 && n % 100 <= 13 ? 'th' : ['th', 'st', 'nd', 'rd'][n % 10] ?? 'th'}`;
const tn = eciThenNow(m.id);
const eciLine = !tn
  ? ''
  : tn.then === 1
    ? `When ${m.name} came out, no model released before it scored higher on Epoch AI's Capabilities Index. ${tn.now === 1 ? 'None has since.' : `Today it ranks ${ord(tn.now)} of ${tn.nowOf}.`}`
    : `When ${m.name} came out, it ranked ${ord(tn.then)} of the ${tn.thenOf} models on Epoch AI's Capabilities Index released by then. Today it ranks ${ord(tn.now)} of ${tn.nowOf}.`;
const metaDescription = `${finding === m.name ? `${m.name}${ms.lab ? ` from ${ms.lab.name}` : ''}` : finding}. ${finding === m.name ? `Its scores on ${ms.results.length.toLocaleString('en-US')} ${ms.results.length === 1 ? 'benchmark' : 'benchmarks'}` : 'Its scores'}, its rank on each leaderboard${ms.eciRank ? `, its place on the Epoch Capabilities Index` : ''}, and what its model cards report.`;
---

<Base title={m.name} searchTitle={`${m.name} benchmarks: scores on ${ms.results.length.toLocaleString('en-US')} ${ms.results.length === 1 ? 'test' : 'tests'}`} description={metaDescription} film="index" crumbs={trail} cite={{ title: `${m.name} benchmark scores` }}>
  <div class="page">
    <header class="head split">
      <div>
        <Crumbs items={trail} />
        <h1>{m.name}{m.version && <span class="ver"> {m.version}</span>}</h1>
        <p class="lede">{modelLine(ms)}.</p>
        <div class="facts">
          {ms.lab && <a class="lab" href={`/labs/${ms.lab.id}/`}><LabMark lab={ms.lab.id} size={16} />{ms.lab.name}</a>}
          {m.released && <span>Released <b>{humanDate(m.released)}</b></span>}
          {m.family && <span>Family <b>{m.family}</b></span>}
          {m.card && <a href={m.card}>The lab's model card</a>}
          {rival && <a rel="nofollow" href={`/compare/?m=${m.id},${rival}`}>Compare with others</a>}
        </div>
        <div class="stats mini">
          <div class="stat">
            <div class="v">{ms.results.length}</div>
            <div class="l">Benchmarks with a score</div>
          </div>
          <div class="stat">
            <div class="v">{firsts}</div>
            <div class="l">Ranked first, out of five or more models</div>
          </div>
          <div class="stat">
            <div class="v">{top3}</div>
            <div class="l">In the top three</div>
          </div>
        </div>
      </div>
      <ModelCard id={m.id} hero />
    </header>

    <HeldLanes id={m.id} />

    <Rivals id={m.id} />

    {
      byArea.length > 0 && (
        <section>
          <div class="sh">
            <h2>Where it ranks</h2>
            <p>Its best score on each benchmark, and where that ranks among every model with a score there. We rank each model once, at its best setting.</p>
          </div>
          {byArea.map(({ a, rows }) => (
            <div class="area">
              <h3>{a.name}</h3>
              <div class="table-wrap">
                <table class="t ranks" data-sort>
                  <thead>
                    <tr><th>Benchmark</th><th class="r">Score</th><th class="bar-h" /><th class="r">Rank</th><th>Source</th></tr>
                  </thead>
                  <tbody>
                    {rows.map((r) => {
                      const unit = r.benchmark.unit ?? '%';
                      return (
                        <tr {...evalAttrs(r.benchmark)}>
                          <td><a href={`/benchmarks/${r.benchmark.id}/${isClaim(r.score) ? '?pool=all' : ''}`}>{r.benchmark.name}</a></td>
                          <td class="r">{fmt(r.score.value, unit)}</td>
                          <td class="bar-c">
                            {unit === '%' && <span class="mini-bar"><span style={`width:${Math.max(1, r.score.value)}%;background:${color}`} /></span>}
                          </td>
                          <td class="r nowrap">
                            {r.among === 'none' ? (
                              <span class="muted" data-tn="Not ranked" data-ts="A lab's own number. Independent runs of this benchmark haven't scored this model yet, so it isn't ranked against them.">Not ranked</span>
                            ) : r.among === 'claims' ? (
                              <>#{r.rank} <span class="muted">of {r.of} lab {r.of === 1 ? 'number' : 'numbers'}</span></>
                            ) : (
                              <>{r.rank === 1 ? <b>#1</b> : `#${r.rank}`} <span class="muted">of {r.of}</span></>
                            )}
                          </td>
                          <td class="muted nowrap">{sourceLabel(r.score)}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </div>
          ))}
        </section>
      )
    }

    <CostTable id={m.id} />

    {
      agentRows.length > 0 && (
        <section>
          <div class="sh">
            <h2>Inside agents</h2>
            <p>
              Boards that list {m.name} inside an agent or product, such as {entryLabel(agentRows[0].top)}. Those scores belong to the agent, so we don't count them as the model's own. Its own score on the same board is beside each one.
            </p>
          </div>
          <div class="table-wrap">
            <table class="t" data-sort>
              <thead>
                <tr><th>Benchmark</th><th>Entry</th><th class="r">Agent's score</th><th class="r">Its own score</th></tr>
              </thead>
              <tbody>
                {agentRows.map(({ top, own, b }) => (
                  <tr>
                    <td><a href={`/benchmarks/${b.id}/`}>{b.name}</a></td>
                    <td>{entryLabel(top)}</td>
                    <td class="r">{fmt(top.value, b.unit ?? '%')}</td>
                    <td class="r muted">{own ? fmt(own.value, b.unit ?? '%') : ''}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    {
      sr && (
        <section>
          <div class="sh">
            <h2>{srHead}</h2>
            <p>
              The Self-Reported Index fits one score to the {sr.n} capability results {ms.lab?.name ?? 'the lab'} reported for this model, on the scale of the Epoch Capabilities Index. Labs choose which benchmarks to show and how to run them, so read it as the lab's claim, not an independent measurement. The 90% interval runs from {sr.low.toFixed(1)} to {sr.high.toFixed(1)}. <a href="/methodology/#self-reported">How we compute it</a>.
            </p>
          </div>
          <ul class="chips">
            {sr.scores.map((x) => (
              <li>
                <a href={`/benchmarks/${x.benchmark}/?pool=all`}>{benchById.get(x.benchmark)?.name ?? x.benchmark}</a>
                <span class="sc">{shortNum(x.value)}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <Coverage id={m.id} />

    {
      myClaims.length > 0 && (
        <section>
          <div class="sh">
            <h2>{myClaims.length === 1 ? "Its lab's number next to a leaderboard" : `Its lab's numbers next to ${myClaims.length} leaderboards`}</h2>
            <p>Where the benchmark's own leaderboard, or Epoch AI's run, also has this model. Gaps mostly come from different harnesses, effort levels and task subsets. <a href="/claims/">Every pair</a>.</p>
          </div>
          <ClaimTable pairs={myClaims} model={false} />
        </section>
      )
    }

    {
      labPts.length > 0 && (
        <section>
          <div class="sh">
            <h2>{ms.lab?.name ?? 'The lab'}'s models over time</h2>
            <p>{eciLine || `${ms.lab?.name}'s models in color, against every other model on the Epoch Capabilities Index, by release date.`}</p>
          </div>
          <ChartDownload credit={creditLine([ECI_CREDIT])} deck={`${ms.lab?.name ?? 'The lab'}’s models in color, against every other model on the index. ${ECI_DECK}`} yAxis={ECI_AXIS} xAxis={RELEASE_AXIS} counts="Every model with a Capabilities Index score, at its release date." leaves="Models Epoch AI hasn’t scored.">
          <TimeScatter points={labPts} unit="index" label={`${ms.lab?.name} models on the Epoch Capabilities Index`} highlight={labIds} labelIds={[m.id, ...labIds.filter((x) => x !== m.id)]} legend={false} height={400} />
          </ChartDownload>
        </section>
      )
    }

    {
      myCards.length > 0 && (
        <section>
          <div class="sh">
            <h2>{myCards.length === 1 ? 'Its launch post' : 'Its launch posts'}</h2>
            <p>The benchmarks the lab chose to headline, with the scores it gave.</p>
          </div>
          {myCards.map((c) => (
            <article class="card-doc">
              <div class="cd-h">
                <a href={c.url ?? '#'}>{c.title ?? `${m.name} model card`}</a>
                <span class="muted num">{fullDate(c.date)}</span>
              </div>
              <ul class="chips">
                {c.results.map((r) => (
                  <li>
                    <a href={`/benchmarks/${r.benchmark}/?pool=all`}>{r.as_written ?? r.benchmark}</a>
                    {r.score !== null && <span class="sc">{shortNum(r.score)}</span>}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </section>
      )
    }

    {
      myDocs.length > 0 && (
        <section>
          <div class="sh">
            <h2>{myDocs.length === 1 ? 'Its system card' : 'Its system cards'}</h2>
            <p>
              Every result in the longer documents the lab published with it.
              {myDocs[0].extra > 0 && ` ${myDocs[0].extra} of them ${myDocs[0].extra === 1 ? "isn't" : "aren't"} in the launch post.`}
            </p>
          </div>
          {myDocs.map(({ d, groups }) => (
            <article class="card-doc">
              <div class="cd-h">
                <a href={d.url ?? '#'}>{d.title ?? `${m.name} ${d.doc ?? 'system card'}`}</a>
                <span class="muted num">{fullDate(d.date)}</span>
              </div>
              {groups.map(([sec, rs]) => (
                <div class="sec">
                  <h3>{SECTION_NAMES[sec] ?? sec}</h3>
                  <ul class="chips">
                    {rs.map((r) => (
                      <li>
                        <a href={`/benchmarks/${r.benchmark}/?pool=all`}>{benchById.get(r.benchmark)?.name ?? r.benchmark}</a>
                        {r.score !== null && <span class="sc">{shortNum(r.score)}</span>}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </article>
          ))}
        </section>
      )
    }
  </div>
</Base>

<script>
  // "Show all": the rows past the first few wait hidden in their section
  for (const b of document.querySelectorAll<HTMLButtonElement>('button[data-reveal]')) {
    b.addEventListener('click', () => {
      for (const r of b.closest('section')!.querySelectorAll<HTMLElement>('[data-reveal-row]')) r.hidden = false;
      b.hidden = true;
    });
  }
</script>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    gap: 56px;
    align-items: start;
  }
  .ver {
    color: var(--ink-3);
  }
  .lab {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
  }
  .mini {
    margin-top: 40px;
    grid-template-columns: repeat(3, 1fr);
  }
  .area + .area {
    margin-top: 48px;
  }
  .area h3 {
    font-size: 21px;
    margin-bottom: 14px;
  }
  .ranks td:first-child {
    width: 40%;
  }
  .bar-c {
    width: 28%;
  }
  .mini-bar {
    display: block;
    height: 6px;
    border-radius: 3px;
    background: var(--panel);
  }
  .mini-bar span {
    display: block;
    height: 100%;
    border-radius: 3px;
  }
  .nowrap {
    white-space: nowrap;
  }
  .card-doc + .card-doc {
    margin-top: 32px;
  }
  .cd-h {
    display: flex;
    gap: 16px;
    justify-content: space-between;
    flex-wrap: wrap;
    font-weight: 500;
  }
  .sec {
    margin-top: 18px;
  }
  .sec h3 {
    font: 500 12.5px/1.2 var(--sans);
    color: var(--ink-3);
    margin: 0;
  }
  .sec .chips {
    margin-top: 8px;
  }
  /* each benchmark sits in its own soft tile, with its score in mono, so long lists stay easy to scan */
  .chips {
    list-style: none;
    padding: 0;
    margin: 10px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chips li {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    min-width: 0;
    padding: 5px 9px;
    border-radius: 7px;
    background: var(--panel);
    font-size: 13.5px;
    line-height: 1.3;
  }
  .chips a {
    color: var(--ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .chips a:hover {
    text-decoration: underline;
  }
  .chips .sc {
    font: 400 12px var(--mono);
    color: var(--ink-3);
  }
  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .bar-h,
    .bar-c {
      display: none;
    }
  }
</style>
