---
import { ECI_DECK, ECI_AXIS, SRI_DECK, RELEASE_AXIS, POOL_NOTES, CLOCK_NOTE } from '../../lib/figure-text.ts';
import ChartDownload from '../../components/ChartDownload.astro';
import { creditLine, ECI_CREDIT, LAB_CARDS } from '../../lib/credits.ts';
import Base from '../../layouts/Base.astro';
import ModelCard from '../../components/ModelCard.astro';
import ModelName from '../../components/ModelName.astro';
import TimeScatter, { type Pt } from '../../components/TimeScatter.astro';
import Dropdown, { type Option } from '../../components/Dropdown.astro';
import { featuredModels, eciByModel, eciOrder, modelById, modelSummary, labById, labs, EPOCH_SOURCE } from '../../lib/data.ts';
import { monthYear } from '../../lib/format.ts';
import { selfReported, SR_FIT } from '../../lib/self-reported.ts';

const eciPts: Pt[] = eciOrder
  .map((id) => ({ id, m: modelById.get(id)!, e: eciByModel.get(id)! }))
  .filter((x) => x.m.released)
  .map((x) => ({ date: x.m.released!, value: x.e.eci, model: x.id, source: 'epoch' as const, low: x.e.low, high: x.e.high }));
const byDate = eciPts.slice().sort((a, b) => a.date.localeCompare(b.date));
const frontier: { date: string; value: number; model: string }[] = [];
for (const p of byDate) if (!frontier.length || p.value > frontier.at(-1)!.value) frontier.push(p);

const srPts: Pt[] = [...selfReported.entries()]
  .filter(([id]) => modelById.get(id)?.released)
  .map(([id, s]) => ({ date: modelById.get(id)!.released!, value: s.value, model: id, source: 'card' as const, low: s.low, high: s.high }));
const srFrontier: { date: string; value: number; model: string }[] = [];
for (const p of srPts.slice().sort((a, b) => a.date.localeCompare(b.date))) if (!srFrontier.length || p.value > srFrontier.at(-1)!.value) srFrontier.push(p);
const srOnly = [...selfReported.keys()].filter((id) => !eciByModel.has(id)).length;

const top = eciOrder.slice(0, 24);
const rows = featuredModels
  .map((m) => ({ m, s: modelSummary(m.id) }))
  .sort((a, b) => (b.s.eci?.eci ?? -1) - (a.s.eci?.eci ?? -1) || (b.m.released ?? '').localeCompare(a.m.released ?? ''));
const labOptions = labs.filter((l) => rows.some((r) => r.m.lab === l.id)).sort((a, b) => a.name.localeCompare(b.name));
const open = featuredModels.filter((m) => m.weights === 'open').length;
const labDropdown: Option[] = [{ value: '', label: 'All labs' }, ...labOptions.map((l) => ({ value: l.id, label: l.name, count: rows.filter((r) => r.m.lab === l.id).length }))];
const weightOptions: Option[] = [
  { value: '', label: 'Open and closed' },
  { value: 'open', label: 'Open weights', count: rows.filter((r) => r.m.weights === 'open').length },
  { value: 'closed', label: 'Closed weights', count: rows.filter((r) => r.m.weights === 'closed').length },
];
---

<Base title="Models" description="Every model with scores here, ranked by the Epoch Capabilities Index, with a Self-Reported Index from each lab's own numbers." film="index">
  <div class="page">
    <header class="head">
      <h1>Models</h1>
      <p class="lede">
        We list every model we have scores for and rank them by Epoch AI's Capabilities Index. We use each lab's own name for a model, and add a snapshot label when a lab shipped several versions under one name.
      </p>
      <div class="facts">
        <span><b>{featuredModels.length}</b> models</span>
        <span><b>{eciByModel.size}</b> with an ECI score</span>
        <span><b>{selfReported.size}</b> with a Self-Reported Index</span>
        <span><b>{open}</b> with open weights</span>
      </div>
    </header>

    <section>
      <div class="sh">
        <h2>The frontier keeps moving</h2>
        <p>Epoch Capabilities Index by release date. The thin vertical bars are 90% intervals, and the step line is the best score so far.</p>
      </div>
      <ChartDownload credit={creditLine([ECI_CREDIT])} quiet deck={`${ECI_DECK} The thin vertical bars are 90% intervals, and the step line is the best score so far.`} yAxis={ECI_AXIS} xAxis={RELEASE_AXIS} counts="Every model with an Epoch Capabilities Index score, at its release date." leaves="Models Epoch AI hasn’t scored.">
        <TimeScatter points={eciPts} frontier={frontier} unit="index" label="Epoch Capabilities Index over time" legend={false} height={460} />
      </ChartDownload>
      <p class="src">Source: <a href={EPOCH_SOURCE.url}>{EPOCH_SOURCE.name}</a>, {EPOCH_SOURCE.license}.</p>
    </section>

    <section>
      <div class="sh">
        <h2>The labs' own numbers place {srOnly} more models</h2>
        <p>
          The Self-Reported Index puts each model on the ECI's scale using only the scores its lab published, so it covers new releases before independent runs arrive. Labs choose what to report and how to run it, so treat it as a claim. It agrees with the ECI at r = {SR_FIT.pearson.toFixed(2)} across the {SR_FIT.overlap} models that have both. Rings mark numbers labs report about themselves, and the bars are 90% intervals. <a href="/methodology/#self-reported">How we compute it</a>.
        </p>
      </div>
      <ChartDownload credit={creditLine([`${LAB_CARDS}, placed on the Epoch Capabilities Index scale by Benchmark Almanac`])} deck={`${SRI_DECK} Rings mark numbers labs report about themselves, and the bars are 90% intervals.`} yAxis="Self-Reported Index, on the Epoch Capabilities Index scale" xAxis={RELEASE_AXIS} counts="Models whose labs published enough scores to place them, using the same item response model as the Epoch Capabilities Index." leaves="Leaderboard and Epoch AI scores, and models with too few lab-reported scores.">
        <TimeScatter points={srPts} frontier={srFrontier} unit="index" label="Self-Reported Index over time" legend={false} height={460} />
      </ChartDownload>
    </section>

    <section>
      <div class="sh">
        <h2>The 24 highest-ranked models</h2>
        <p>The dot on each strip is the model's place among all {eciByModel.size} index scores. For the three benchmarks, we favor ones labs headlined in the last year that are still under 85%.</p>
      </div>
      <div class="grid">
        {top.map((id) => <ModelCard id={id} />)}
      </div>
    </section>

    <section>
      <div class="sh">
        <h2>Every model</h2>
      </div>
      <div class="filters" data-filter="models">
        <input class="field grow" type="search" placeholder="Search models" aria-label="Search models" data-q />
        <Dropdown filterKey="lab" label="Lab" options={labDropdown} search />
        <Dropdown filterKey="weights" label="Weights" options={weightOptions} />
        <span class="count muted" data-count>{rows.length} models</span>
      </div>
      <div class="table-wrap">
        <table class="t mt" data-rows data-sort>
          <thead>
            <tr><th>Model</th><th>Lab</th><th>Released</th><th>Weights</th><th class="r">ECI</th><th class="r">Self-reported</th><th class="r">Benchmarks</th></tr>
          </thead>
          <tbody>
            {rows.map(({ m, s }) => (
              <tr data-lab={m.lab ?? ''} data-weights={m.weights ?? ''} data-text={(m.aliases ?? []).join(' ').toLowerCase() || undefined}>
                <td><ModelName id={m.id} /></td>
                <td class="muted">{labById.get(m.lab ?? '')?.name}</td>
                <td class="muted num nowrap">{monthYear(m.released)}</td>
                <td class="muted">{m.weights === 'open' ? 'Open' : m.weights === 'closed' ? 'Closed' : ''}</td>
                <td class="r">{s.eci ? s.eci.eci.toFixed(1) : ''}</td>
                <td class="r muted">{selfReported.get(m.id)?.value.toFixed(1) ?? ''}</td>
                <td class="r muted">{s.results.length}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Base>

<script>
  import { wireFilter } from '../../scripts/filter.ts';
  wireFilter('models');
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
  }
  .src {
    margin-top: 12px;
    font-size: 13px;
    color: var(--ink-3);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-bottom: 20px;
  }
  .grow {
    flex: 1 1 220px;
  }
  .count {
    font-size: 13px;
    margin-left: auto;
  }
  .nowrap {
    white-space: nowrap;
  }
  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  /* the model name carries its lab's mark, so the Lab column goes first on narrow windows */
  @media (max-width: 900px) {
    .mt th:nth-child(2),
    .mt td:nth-child(2) {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .mt th:nth-child(4),
    .mt td:nth-child(4),
    .mt th:nth-child(6),
    .mt td:nth-child(6) {
      display: none;
    }
  }
</style>
