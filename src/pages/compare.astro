---
// Compare: two to four models on every benchmark all of them have a score on. The data comes from
// compare-data.ts, the math and markup from compare.ts, so the server render and the page script draw the same
// thing. The server draws the default picks. A link with its own picks, sort, filters or view draws them once
// their files load.
import ChartDownload from '../components/ChartDownload.astro';
import { creditLine, EPOCH_CREDIT, LAB_CARDS } from '../lib/credits.ts';
import Base from '../layouts/Base.astro';
import { compareIndex, compareFile, defaultPicks } from '../lib/compare-data.ts';
import { compute, caption, chips, winsList, table, filterRow, legend, DEFAULT_STATE, MAX_PICKS, type ModelFile, type State } from '../lib/compare.ts';

const idx = compareIndex();
const ids = defaultPicks();
const files = ids.map((id) => compareFile(id)).filter((f): f is ModelFile => !!f);
const picks = files.map((f) => ({ id: f.id, name: f.name, lab: f.lab }));
const st: State = { m: ids, ...DEFAULT_STATE };
const res = compute(files, st);
const names = picks.map((p) => p.name);
---

<Base
  title="Compare models"
  description="Compare up to four AI models on every benchmark they've all been scored on."
>
  <div class="page cmp-root" data-cmp data-default={JSON.stringify(ids)}>
    <script is:inline>
      // Before the first paint: a link with its own picks, sort, filters or view hides the default view until its
      // files load, so the default never flashes in its place. The page script removes the mark once it has drawn.
      if (/[?&](m|src|sort|cited|labs|area|view)=/.test(location.search)) document.currentScript.parentElement.classList.add('cmp-wait');
    </script>
    <header class="head">
      <h1>Compare models</h1>
      <p class="lede">Pick up to four models to see how they stack up on every benchmark they've all been scored on.</p>
    </header>

    <section class="cmp-controls" data-wait>
      <div class="cmp-pick">
        <h2 class="sr" id="cmp-models">Models</h2>
        <div class="cmp-box">
          <ul class="cmp-chips" aria-labelledby="cmp-models" data-chips set:html={chips(picks, idx.labs).replace(/<button type="button" class="cmp-x"/g, '<button type="button" class="cmp-x" disabled')} />
          <input
            class="cmp-q"
            type="search"
            placeholder={picks.length ? 'Add another model' : 'Add a model'}
            hidden={picks.length >= MAX_PICKS}
            autocomplete="off"
            spellcheck="false"
            role="combobox"
            aria-expanded="false"
            aria-controls="cmp-list"
            aria-autocomplete="list"
            aria-label="Add a model"
            data-q
            disabled
          />
          <ul id="cmp-list" class="cmp-list" role="listbox" aria-label="Matching models" hidden data-list></ul>
        </div>
      </div>
      <div class="cmp-sw">
        <h2 class="cmp-label" id="cmp-src">Scores from</h2>
        <div class="seg cmp-seg" role="radiogroup" aria-labelledby="cmp-src">
          <label><input type="radio" name="cmp-src" value="ind" disabled />Independent runs</label>
          <label><input type="radio" name="cmp-src" value="lab" disabled />Labs' own numbers</label>
          <label><input type="radio" name="cmp-src" value="all" checked disabled />Both</label>
        </div>
      </div>
    </section>

    <section class="cmp-out" aria-live="polite" data-wait data-out>
      <div class="sh-row">
        <div class="sh">
          <h2>Who comes out ahead?</h2>
          <p data-sub>{caption(res, names, st)}</p>
        </div>
        <div class="seg cmp-view" role="radiogroup" aria-label="Show as" data-viewsw>
          <label><input type="radio" name="cmp-view" value="table" checked disabled />Table</label>
          <label><input type="radio" name="cmp-view" value="bars" disabled />Bars</label>
        </div>
      </div>
      <div class="cmp-winbox">
      <ChartDownload credit={creditLine(['official leaderboards', EPOCH_CREDIT, LAB_CARDS])} name="wins" counts="For each picked model, the benchmarks where it has the best score, among every benchmark all of them have scores on, from the sources picked under Scores from. A tie counts for each model in it." leaves="Benchmarks that any picked model hasn't been scored on.">
        <div data-wins set:html={winsList(res, picks, idx.labs)} />
      </ChartDownload>
      </div>
      <div class="cmp-tools" data-tools>
        <div class="cmp-filters" data-filters set:html={filterRow(res, st).replace(/<input /g, '<input disabled ')} />
      </div>
      <div class="cmp-empty" data-empty hidden>
        <p>No shared benchmark matches these filters.</p>
        <button type="button" class="cmp-small" data-reset>Clear the filters</button>
      </div>
      <ChartDownload credit={creditLine(['official leaderboards', EPOCH_CREDIT, LAB_CARDS])} name="bars" showWhen={'input[name="cmp-view"][value="bars"]:checked'} deckFrom="@lede" counts="Every benchmark all the picked models have scores on, from the sources picked under Scores from." leaves="Benchmarks that any picked model hasn't been scored on.">
        <div class="cmp-results" data-results set:html={table(res, picks, idx.labs, st, new Set())} />
        <p class="cmp-legend" data-legend set:html={legend(res, 'table')} />
      </ChartDownload>
      <div class="cmp-share">
        <button type="button" class="cmp-small" data-copy disabled>Copy link to this comparison</button>
        <span class="cmp-status" role="status" data-status></span>
      </div>
    </section>

    <div class="cmp-pop" id="cmp-pop-gap" popover>
      <p><b>Gap</b> is how far apart the best and worst picked models are on a test. A small gap means they're about even. A big one means the test tells them apart.</p>
      <p>It's in points for percentages (74.3 against 68.1 is 6.2) and in the test's own unit otherwise, such as Elo. To sort mixed units together, we count those as a share of the test's full range.</p>
    </div>
    <div class="cmp-pop" id="cmp-pop-labs" popover>
      <p><b>Labs</b> is how many labs report this benchmark in their launch posts and system cards, across the whole almanac. A high count means a widely used test.</p>
    </div>
    <div class="cmp-pop" id="cmp-pop-cited" popover>
      <p><b>Cited by</b> is how many of the picked models' own launch posts and system cards report this benchmark. At 0, every score in the row is an independent run.</p>
    </div>
  </div>
</Base>

<script>
  import { compute, caption, chips, winsList, table, barsView, detail, filterRow, legend, readState, writeState, esc, labMark, MAX_PICKS, DEFAULT_STATE, type ModelIndex, type ModelFile, type State, type Source, type Cited, type SortCol, type View, type ModelPick, type Result } from '../lib/compare.ts';

  const root = document.querySelector<HTMLElement>('[data-cmp]')!;
  const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const defaults: string[] = JSON.parse(root.dataset.default ?? '[]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const EASE = 'cubic-bezier(.2,.8,.2,1)';
  /** Rows that move or draw in, at most. */
  const ANIM_CAP = 120;

  const shown = () => root.classList.remove('cmp-wait');

  async function getJson<T>(url: string): Promise<T> {
    const r = await fetch(url);
    if (!r.ok) throw new Error(String(r.status));
    return r.json() as Promise<T>;
  }

  // ---- the info popovers: placed under the button that opened them ----------------------------------
  let invoker: HTMLElement | null = null;
  document.addEventListener(
    'click',
    (e) => {
      const b = (e.target as HTMLElement).closest?.<HTMLElement>('[popovertarget^="cmp-pop-"]');
      if (b) invoker = b;
    },
    true,
  );
  for (const pop of root.querySelectorAll<HTMLElement>('.cmp-pop')) {
    pop.addEventListener('beforetoggle', (e) => {
      if ((e as ToggleEvent).newState !== 'open' || !invoker) return;
      const r = invoker.getBoundingClientRect();
      // the body's width leaves out the scrollbar's gutter, which the root's width can include
      const vw = Math.min(document.documentElement.clientWidth, document.body.clientWidth);
      const w = Math.min(340, vw - 24);
      pop.style.width = `${w}px`;
      pop.style.top = `${Math.round(r.bottom + 8)}px`;
      pop.style.left = `${Math.round(Math.max(12, Math.min(vw - w - 12, r.left + r.width / 2 - w / 2)))}px`;
    });
    pop.addEventListener('toggle', (e) => invoker?.setAttribute('aria-expanded', String((e as ToggleEvent).newState === 'open')));
  }
  // a popover's place is fixed to the screen, so it closes when the page scrolls away from its button
  window.addEventListener(
    'scroll',
    () => {
      for (const pop of root.querySelectorAll<HTMLElement>('.cmp-pop:popover-open')) pop.hidePopover();
    },
    { passive: true },
  );

  async function main() {
    let idx: ModelIndex;
    try {
      idx = await getJson<ModelIndex>('/compare/models.json');
    } catch {
      shown();
      $('[data-status]').textContent = 'The model list did not load. Reload the page to try again.';
      return;
    }
    const byId = new Map(idx.models.map((m) => [m[0], m]));
    const fallback: State = { m: defaults.filter((id) => byId.has(id)), ...DEFAULT_STATE };
    let st = readState(location.search, fallback, (id) => byId.has(id));
    const cache = new Map<string, ModelFile>();
    const open = new Set<string>();
    let res: Result | null = null;
    let picks: ModelPick[] = [];
    let showAll = false;
    let drawn = false;
    let seq = 0;

    async function load(ids: string[]): Promise<boolean> {
      const need = ids.filter((id) => !cache.has(id));
      if (!need.length) return true;
      try {
        const got = await Promise.all(need.map((id) => getJson<ModelFile>(`/compare/m/${encodeURIComponent(id)}.json`)));
        for (const f of got) cache.set(f.id, f);
        return true;
      } catch {
        $('[data-status]').textContent = 'Some scores did not load. Reload the page to try again.';
        return false;
      }
    }

    const pickOf = (id: string): ModelPick => {
      const m = byId.get(id)!;
      return { id, name: m[1], lab: m[2] };
    };

    // ---- render ------------------------------------------------------------------------------------
    function renderPicks() {
      $('[data-chips]').innerHTML = chips(st.m.map(pickOf), idx.labs);
      const q = $<HTMLInputElement>('[data-q]');
      const full = st.m.length >= MAX_PICKS;
      // four picks fill the box: the field hides until a model comes out
      q.disabled = full;
      q.hidden = full;
      q.placeholder = st.m.length ? 'Add another model' : 'Add a model';
      for (const r of root.querySelectorAll<HTMLInputElement>('input[name="cmp-src"]')) r.checked = r.value === st.src;
      for (const r of root.querySelectorAll<HTMLInputElement>('input[name="cmp-view"]')) r.checked = r.value === st.view;
    }

    function renderOut(glide = false) {
      const files = st.m.map((id) => cache.get(id)).filter((f): f is ModelFile => !!f);
      if (files.length !== st.m.length) return;
      picks = files.map((f) => ({ id: f.id, name: f.name, lab: f.lab }));
      res = compute(files, st);
      const box = $('[data-results]');
      const before = glide && !reduce.matches ? positions(box) : null;
      for (const id of [...open]) if (!res.rows.some((r) => r.id === id)) open.delete(id);
      $('[data-sub]').textContent = caption(res, picks.map((p) => p.name), st);
      $('[data-wins]').innerHTML = winsList(res, picks, idx.labs);
      const has = res.shared > 0 && picks.length >= 2;
      $('[data-tools]').hidden = !has;
      $('[data-viewsw]').hidden = !has;
      $('[data-filters]').innerHTML = has ? filterRow(res, st) : '';
      $('[data-empty]').hidden = !(has && !res.rows.length);
      const firstBars = st.view === 'bars' && !drawn;
      box.innerHTML = st.view === 'bars' ? barsView(res, picks, idx.labs, st, showAll) : table(res, picks, idx.labs, st, open, showAll);
      $('[data-legend]').innerHTML = legend(res, st.view);
      $('[data-out]').removeAttribute('aria-busy');
      if (firstBars) {
        drawn = true;
        if (!reduce.matches) drawIn(box);
      } else if (before) play(box, before);
      else if (glide) fade(box);
      history.replaceState(null, '', writeState(st));
    }

    // a sort change: each row glides from where it was, and rows new to the view fade in
    const keyOf = (el: HTMLElement) => el.dataset.id ?? `d:${el.dataset.det}`;
    const movers = (box: HTMLElement) => box.querySelectorAll<HTMLElement>('tbody > tr:not([hidden]), .cmp-blist > li:not([hidden])');
    function positions(box: HTMLElement): Map<string, number> {
      const out = new Map<string, number>();
      const els = movers(box);
      for (let i = 0; i < els.length && i < ANIM_CAP; i++) out.set(keyOf(els[i]), els[i].getBoundingClientRect().top);
      return out;
    }
    function play(box: HTMLElement, before: Map<string, number>) {
      const els = movers(box);
      for (let i = 0; i < els.length && i < ANIM_CAP; i++) {
        const el = els[i];
        const was = before.get(keyOf(el));
        const dy = was === undefined ? 0 : was - el.getBoundingClientRect().top;
        if (was === undefined) el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 200, easing: 'ease-out' });
        else if (Math.abs(dy) > 0.5) el.animate([{ transform: `translateY(${dy}px)` }, { transform: 'none' }], { duration: 360, easing: EASE });
      }
    }
    function fade(box: HTMLElement) {
      box.animate([{ opacity: 0.4 }, { opacity: 1 }], { duration: 140, easing: 'ease-out' });
    }
    // the Bars view draws in once, the first time it opens. Groups past the eighth start together.
    function drawIn(box: HTMLElement) {
      const groups = box.querySelectorAll<HTMLElement>('.cmp-blist > li:not([hidden])');
      for (let k = 0; k < groups.length && k < ANIM_CAP; k++) {
        const fills = groups[k].querySelectorAll<HTMLElement>('.cmp-bf');
        for (let i = 0; i < fills.length && i < 4; i++)
          fills[i].animate([{ transform: 'scaleX(0)' }, { transform: 'none' }], { duration: 900, delay: Math.min(k, 8) * 28, easing: EASE, fill: 'backwards' });
      }
    }

    async function update(glide = false) {
      const mine = ++seq;
      renderPicks();
      $('[data-out]').setAttribute('aria-busy', 'true');
      const ok = await load(st.m);
      if (mine !== seq) return;
      if (!ok) {
        $('[data-out]').removeAttribute('aria-busy');
        return;
      }
      renderOut(glide);
    }

    for (const el of root.querySelectorAll<HTMLInputElement | HTMLButtonElement>('[disabled]')) el.disabled = false;
    const own = location.search && writeState(st) !== writeState(fallback);
    if (own) await update();
    else {
      renderPicks();
      // the default view is already drawn. Its files load quietly, and the page keeps the result for row clicks.
      if (await load(st.m)) {
        const files = st.m.map((id) => cache.get(id)!);
        picks = files.map((f) => ({ id: f.id, name: f.name, lab: f.lab }));
        res = compute(files, st);
      }
    }
    shown();

    // ---- a row's bars --------------------------------------------------------------------------------
    function toggle(id: string) {
      const box = $('[data-results]');
      const tr = box.querySelector<HTMLElement>(`tr.cmp-row[data-id="${CSS.escape(id)}"]`);
      const row = res?.rows.find((r) => r.id === id);
      if (!tr || !row || !res) return;
      const btn = tr.querySelector<HTMLButtonElement>('[data-dis]')!;
      if (open.has(id)) {
        open.delete(id);
        tr.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        tr.nextElementSibling?.matches('.cmp-det') && tr.nextElementSibling.remove();
        return;
      }
      open.add(id);
      tr.classList.add('open');
      btn.setAttribute('aria-expanded', 'true');
      const det = document.createElement('tr');
      det.className = 'cmp-det';
      det.dataset.det = id;
      det.id = `cmp-d-${id}`;
      det.innerHTML = `<td colspan="${picks.length + 4}">${detail(row, picks, idx.labs, res)}</td>`;
      tr.after(det);
      if (!reduce.matches) {
        const inner = det.querySelector<HTMLElement>('.cmp-detin')!;
        const h = inner.offsetHeight;
        inner.animate(
          [
            { height: '0px', opacity: 0 },
            { height: `${h}px`, opacity: 1 },
          ],
          { duration: 360, easing: EASE },
        );
      }
    }

    // ---- picks, source, sort, filters, view ---------------------------------------------------------
    const q = $<HTMLInputElement>('[data-q]');
    function remove(id: string) {
      st = { ...st, m: st.m.filter((x) => x !== id), ...(st.sort === `m:${id}` ? { sort: 'labs' as SortCol, rev: false } : {}) };
      update();
      q.focus();
    }
    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const x = t.closest<HTMLButtonElement>('[data-x]');
      if (x) return remove(x.dataset.x!);
      const s = t.closest<HTMLButtonElement>('[data-sort]');
      if (s) {
        const col = s.dataset.sort as SortCol;
        st = st.sort === col ? { ...st, rev: !st.rev } : { ...st, sort: col, rev: false };
        update(true).then(() => $<HTMLButtonElement>(`[data-results] [data-sort="${CSS.escape(col)}"]`)?.focus());
        return;
      }
      const dis = t.closest<HTMLButtonElement>('[data-dis]');
      if (dis) return toggle(dis.dataset.dis!);
      const tr = t.closest<HTMLElement>('tr.cmp-row');
      if (tr && !t.closest('a,button,input')) return toggle(tr.dataset.id!);
      if (t.closest('[data-reset]')) {
        st = { ...st, cited: 'any', labs: 0, area: '' };
        update(true);
        return;
      }
      if (t.closest('[data-all]')) {
        showAll = true;
        const box = $('[data-results]');
        for (const el of box.querySelectorAll<HTMLElement>('.later')) el.hidden = false;
        box.querySelector('[data-all]')?.remove();
        return;
      }
      if (t.closest('[data-copy]')) copy();
      if (t.closest('.cmp-box') && !t.closest('a,button')) q.focus();
    });
    root.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'cmp-src') st = { ...st, src: t.value as Source };
      else if (t.name === 'cmp-cited') st = { ...st, cited: t.value as Cited };
      else if (t.name === 'cmp-labs') st = { ...st, labs: Number(t.value) };
      else if (t.name === 'cmp-area') st = { ...st, area: t.value };
      else if (t.name === 'cmp-view') st = { ...st, view: t.value as View };
      else return;
      const name = t.name;
      const value = t.value;
      update(true).then(() => root.querySelector<HTMLInputElement>(`input[name="${name}"][value="${CSS.escape(value)}"]`)?.focus());
    });

    // ---- the Bars view by keyboard: one tab stop, arrow keys move from bar to bar ---------------------
    root.addEventListener('keydown', (e) => {
      const bar = (e.target as HTMLElement).closest?.<HTMLElement>('.cmp-bb');
      if (!bar) return;
      const all = [...$('[data-results]').querySelectorAll<HTMLElement>('.cmp-blist > li:not([hidden]) .cmp-bb')];
      const i = all.indexOf(bar);
      const to = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? i - 1 : e.key === 'Home' ? 0 : e.key === 'End' ? all.length - 1 : -2;
      if (to === -2) return;
      e.preventDefault();
      const next = all[Math.max(0, Math.min(all.length - 1, to))];
      if (!next || next === bar) return;
      bar.tabIndex = -1;
      next.tabIndex = 0;
      next.focus();
    });

    // ---- search ------------------------------------------------------------------------------------
    const list = $<HTMLUListElement>('[data-list]');
    const norm = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
    const hay = idx.models.map((m) => ` ${norm(`${m[1]} ${idx.labs[m[2]]?.[0] ?? ''} ${m[0]}`)}`);
    let hits: number[] = [];
    let active = -1;
    const when = (d: string) => (d ? `${MONTHS[Number(d.slice(5, 7)) - 1] ?? ''} ${d.slice(0, 4)}`.trim() : '');
    function find() {
      const words = norm(q.value).split(' ').filter(Boolean);
      if (!words.length) return close();
      const taken = new Set(st.m);
      // the list is in ECI order, so the strongest matching models come first. Names that start with the words lead.
      const starts: number[] = [];
      const rest: number[] = [];
      for (let i = 0; i < hay.length && starts.length < 12; i++) {
        if (taken.has(idx.models[i][0]) || !words.every((w) => hay[i].includes(w))) continue;
        (hay[i].startsWith(` ${words[0]}`) ? starts : rest).push(i);
      }
      hits = [...starts, ...rest].slice(0, 12);
      active = hits.length ? 0 : -1;
      list.innerHTML = hits.length
        ? hits
            .map((i, k) => {
              const [, name, lab, rel, n] = idx.models[i];
              const meta = [idx.labs[lab]?.[0], when(rel), `${n.toLocaleString('en-US')} ${n === 1 ? 'benchmark' : 'benchmarks'}`].filter(Boolean).join(', ');
              return `<li role="option" id="cmp-o${k}" data-i="${i}" aria-selected="${k === active}">${labMark(idx.labs, lab)}<span class="cmp-oname">${esc(name)}</span><span class="cmp-ometa">${esc(meta)}</span></li>`;
            })
            .join('')
        : '<li class="cmp-none" role="presentation">No model with scores matches.</li>';
      list.hidden = false;
      q.setAttribute('aria-expanded', 'true');
      q.setAttribute('aria-activedescendant', active >= 0 ? `cmp-o${active}` : '');
    }
    function close() {
      list.hidden = true;
      hits = [];
      active = -1;
      q.setAttribute('aria-expanded', 'false');
      q.removeAttribute('aria-activedescendant');
    }
    function add(i: number) {
      if (st.m.length >= MAX_PICKS) return;
      st = { ...st, m: [...st.m, idx.models[i][0]] };
      q.value = '';
      close();
      update();
      if (st.m.length < MAX_PICKS) q.focus();
    }
    function move(d: number) {
      if (!hits.length) return;
      active = (active + d + hits.length) % hits.length;
      for (const li of list.querySelectorAll<HTMLElement>('[role="option"]')) li.setAttribute('aria-selected', String(li.id === `cmp-o${active}`));
      q.setAttribute('aria-activedescendant', `cmp-o${active}`);
      list.querySelector(`#cmp-o${active}`)?.scrollIntoView({ block: 'nearest' });
    }
    q.addEventListener('input', find);
    q.addEventListener('focus', () => q.value && find());
    q.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') (e.preventDefault(), move(1));
      else if (e.key === 'ArrowUp') (e.preventDefault(), move(-1));
      else if (e.key === 'Enter' && active >= 0) (e.preventDefault(), add(hits[active]));
      else if (e.key === 'Escape') close();
      else if (e.key === 'Backspace' && !q.value && st.m.length) remove(st.m.at(-1)!);
    });
    list.addEventListener('pointerdown', (e) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>('[data-i]');
      if (li) (e.preventDefault(), add(Number(li.dataset.i)));
    });
    q.addEventListener('blur', () => setTimeout(close, 120));

    // ---- share -------------------------------------------------------------------------------------
    async function copy() {
      const status = $('[data-status]');
      history.replaceState(null, '', writeState(st));
      try {
        await navigator.clipboard.writeText(location.href);
        status.textContent = 'Link copied.';
      } catch {
        status.textContent = 'Copy the link from the address bar. It holds this comparison.';
      }
      setTimeout(() => (status.textContent = ''), 4000);
