  }
  .bm-root .bm-x {
    width: 26px;
    height: 26px;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--ink-3);
    font-size: 17px;
    line-height: 1;
    cursor: pointer;
  }
  .bm-root .bm-x:hover:not(:disabled) {
    background: var(--panel);
    color: var(--ink);
  }
  .bm-root .bm-wrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
  }
  .bm-root .bm-wbox {
    flex: 1;
