---
// Build your own index: pick benchmarks and weights, see the ranking, and see how much it moves when the
// weights shift a little. The data comes from build-data.ts, the math and markup from build-index.ts, so the
// server render and the page script draw the same thing.
import ChartDownload from '../components/ChartDownload.astro';
import { creditLine, EPOCH_CREDIT, LAB_CARDS } from '../lib/credits.ts';
import Base from '../layouts/Base.astro';
import { buildPayload, MIN_MODELS } from '../lib/build-data.ts';
import { Matrix, compute, defaultNeed, caption, columns, bars, table, weightBar, chosen, type State } from '../lib/build-index.ts';

const p = buildPayload();
const mx = new Matrix(p);
const preset = p.presets[0];
const st: State = { b: preset.b.map((id) => ({ id, w: 50 })), src: 'all', need: defaultNeed(preset.b.length) };
const res = compute(mx, st);

// a finding for the explanation: how many of the default mix's top ten can move three places or more
const top10 = res.rows.slice(0, 10);
const movers = top10.filter((r) => r.hi - r.lo >= 3).length;
const why =
  top10.length >= 5
    ? movers === top10.length
      ? `In the default mix, every model in the top ${top10.length} can move three places or more when the weights shift.`
      : `In the default mix, ${movers} of the top ${top10.length} models can move three places or more when the weights shift.`
    : 'Small changes in the weights can reorder the top.';
const presetJson = JSON.stringify(p.presets.map((x) => ({ id: x.id, b: x.b })));
---

<Base
  title="Build your own index"
  description="Pick the benchmarks and weights for your own AI index, and see who comes out on top."
  film="build"
>
  <div class="page bm-root" data-bm data-presets={presetJson}>
    <header class="head">
      <h1>Build your own index</h1>
      <p class="lede">Every intelligence index is a weighted average of benchmark scores, and somebody picked the weights. Here, you pick them. See who comes out on top, and whether the ranking holds when the weights shift.</p>
    </header>

    <section class="bm-grid">
      <div class="bm-panel">
        <div class="bm-block">
          <h2 class="bm-label" id="bm-start">Start from</h2>
          <div class="bm-presets" role="group" aria-labelledby="bm-start">
            {
              p.presets.map((x, i) => (
                <button type="button" data-preset={x.id} aria-pressed={i === 0 ? 'true' : 'false'} disabled>
                  {x.name}
                </button>
              ))
            }
          </div>
          <p class="bm-how" data-how>{preset.how}</p>
        </div>

        <div class="bm-block">
          <h2 class="bm-label" id="bm-tests">Tests and weights</h2>
          <div class="bm-search">
            <input
              class="field"
              type="search"
              placeholder="Add a benchmark"
              autocomplete="off"
              spellcheck="false"
              role="combobox"
              aria-expanded="false"
              aria-controls="bm-list"
              aria-autocomplete="list"
              aria-label="Add a benchmark"
              data-q
              disabled
            />
            <ul id="bm-list" class="bm-list" role="listbox" aria-label="Matching benchmarks" hidden data-list></ul>
          </div>
          <p class="bm-hint">Pick from {p.benches.length.toLocaleString('en-US')} benchmarks with at least {MIN_MODELS} scored models.</p>
          <ol class="bm-picks" aria-labelledby="bm-tests" data-picks set:html={chosen(p, mx, st, res).replace(/<input /g, '<input disabled ').replace(/<button type="button" class="bm-x"/g, '<button type="button" class="bm-x" disabled')} />
          <div class="bm-wrow">
            <div data-wbar class="bm-wbox" set:html={weightBar(p, res)} />
            <button type="button" class="bm-small" data-equal disabled>Equal weights</button>
          </div>
          <p class="bm-empty" data-empty hidden></p>
        </div>

        <div class="bm-block">
          <h2 class="bm-label" id="bm-src">Scores from</h2>
          <div class="seg bm-srcseg" role="radiogroup" aria-labelledby="bm-src">
            <label><input type="radio" name="bm-src" value="ind" disabled />Independent runs</label>
            <label><input type="radio" name="bm-src" value="lab" disabled />Labs' own numbers</label>
            <label><input type="radio" name="bm-src" value="all" checked disabled />Both</label>
          </div>
          <p class="bm-how" data-src-how>We use independent runs where they exist and fill the gaps with labs' own numbers.</p>
        </div>

        <fieldset class="bm-block bm-need">
          <legend class="bm-label">A model needs scores on</legend>
          <label class="bm-radio">
            <input type="radio" name="bm-need" value="n" checked disabled />
            <span>at least <input class="field num bm-n" type="number" min="1" max={res.used.length} value={res.need} aria-label="Minimum number of tests" data-n disabled /> of the tests</span>
          </label>
          <label class="bm-radio"><input type="radio" name="bm-need" value="all" disabled /><span>every test</span></label>
          <p class="bm-how">Where a model skipped a test, we predict its score from its other results and how hard that test was.</p>
        </fieldset>

        <div class="bm-block bm-share">
          <button type="button" class="bm-small" data-copy disabled>Copy link to this index</button>
          <span class="bm-status" role="status" data-status></span>
        </div>
      </div>

      <div class="bm-out" aria-live="polite">
        <div class="sh">
          <h2>Who comes out on top?</h2>
          <p data-sub>{caption(p, res, st.src)}</p>
        </div>
        <ChartDownload credit={creditLine(['official leaderboards', EPOCH_CREDIT, LAB_CARDS])} name="index" context="build" yAxis="Index, 0 to 100, higher is better">
          <div class="only-wide bm-colbox" data-cols set:html={columns(p, res)} />
          <div class="only-narrow" data-bars set:html={bars(p, res)} />
        </ChartDownload>
        <div class="bm-tbox" data-table set:html={table(p, res)} />
      </div>
    </section>

    <section class="bm-why">
      <div class="sh">
        <h2>How much do the weights matter?</h2>
        <p>{why}</p>
      </div>
      <div class="bm-notes">
        <div>
          <h3>How it works</h3>
          <p>We put every test on a 0 to 100 scale. Percentages stay as they are. Elo and other units run from the lowest model to the highest, and tests where lower is better get flipped. A model's index is the weighted average.</p>
          <p>Where a model skipped a test, we predict that score from its other results and the test's difficulty, so skipping a hard test doesn't help and taking one doesn't hurt. Hover a model to see which of its scores are predicted.</p>
        </div>
        <div>
          <h3>Why weights matter</h3>
          <p>Two indexes built from the same scores can disagree on who's first, because the weights decide which tests count most. Published indexes change their weights between versions, and every change reorders some models.</p>
          <p>So we rerank every model under 400 weightings near yours, each weight moved up or down by as much as half. Rank range shows each model's best and worst place, and First is the share of those weightings it wins.</p>
        </div>
        <div>
          <h3>What it leaves out</h3>
          <p>Independent runs cover far fewer new models than labs' own posts, so the board starts with both. Switch to Independent runs to leave lab numbers out, though the newest models may drop off.</p>
          <p>Predictions assume a model's strengths carry across tests, so they miss a model that's strong at one thing and weak at another. Raise the minimum to lean on them less. And no average says how sure to be about any one score.</p>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  import { Matrix, compute, defaultNeed, caption, columns, bars, table, weightBar, chosen, readState, writeState, esc, AREA_NAMES, type Payload, type State, type Source } from '../lib/build-index.ts';

  const root = document.querySelector<HTMLElement>('[data-bm]')!;
  const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const presetIds: { id: string; b: string[] }[] = JSON.parse(root.dataset.presets ?? '[]');

  const SRC_HOW: Record<Source, string> = {
    ind: "Only official leaderboards and Epoch AI's runs.",
    lab: 'Only the numbers labs published about their own models.',
    all: "We use independent runs where they exist and fill the gaps with labs' own numbers.",
  };

  async function main() {
    let p: Payload;
    try {
      const r = await fetch('/build/matrix.json');
      if (!r.ok) throw new Error(String(r.status));
      p = await r.json();
    } catch {
      $('[data-status]').textContent = 'The scores did not load. Reload the page to try again.';
      return;
    }
    const mx = new Matrix(p);
    const presets = new Map(p.presets.map((x) => [x.id, x]));
    const first = p.presets[0];
    const fallback: State = { b: first.b.map((id) => ({ id, w: 50 })), src: 'all', need: defaultNeed(first.b.length) };
    let st = readState(location.search, fallback);
    st.b = st.b.filter((x, i, xs) => mx.benchIndex.has(x.id) && xs.findIndex((y) => y.id === x.id) === i);
    let presetId = location.search ? matchPreset() : first.id;
    // the preset a custom mix started from, named in place of its description
    let startedFrom: string | null = presetId;

    for (const el of root.querySelectorAll<HTMLInputElement | HTMLButtonElement>('[disabled]')) el.disabled = false;

    function matchPreset(): string | null {
      for (const x of presetIds) if (x.b.length === st.b.length && x.b.every((id, i) => st.b[i]?.id === id && st.b[i].w === 50)) return x.id;
      return null;
    }

    // ---- render ----------------------------------------------------------------------------------
    let res = compute(mx, st);
    function renderList() {
      $('[data-picks]').innerHTML = chosen(p, mx, st, res);
    }
    function renderShares() {
      const shares = new Map(res.used.map((u) => [u.id, u.share]));
      for (const li of root.querySelectorAll<HTMLElement>('.bm-pick')) {
        const s = shares.get(li.dataset.id!);
        li.querySelector('output')!.textContent = s !== undefined ? `${Math.round(s * 100)}%` : '';
      }
    }
    function renderOut() {
      $('[data-sub]').textContent = caption(p, res, st.src);
      $('[data-cols]').innerHTML = columns(p, res);
      $('[data-bars]').innerHTML = bars(p, res);
      $('[data-table]').innerHTML = table(p, res);
      $('[data-wbar]').innerHTML = weightBar(p, res);
      const empty = $('[data-empty]');
      const names = res.empty.map((id) => p.benches[mx.benchIndex.get(id)!][1]);
      empty.hidden = !names.length;
      empty.textContent = names.length ? `Left out, with no scores from this source: ${names.join(', ')}.` : '';
      const n = $<HTMLInputElement>('[data-n]');
      n.max = String(Math.max(1, res.used.length));
      if (st.need !== 'all') n.value = String(res.need);
      for (const b of root.querySelectorAll<HTMLButtonElement>('[data-preset]')) b.setAttribute('aria-pressed', String(b.dataset.preset === presetId));
      const how = $('[data-how]');
      if (presetId) {
        startedFrom = presetId;
        how.style.minHeight = '';
        how.textContent = presets.get(presetId)?.how ?? '';
      } else {
        // keep the description's height while the reader edits, so the weight list below doesn't jump mid-drag
        if (!how.style.minHeight) how.style.minHeight = `${how.offsetHeight}px`;
        const from = startedFrom ? presets.get(startedFrom)?.name : undefined;
        how.textContent = from ? `Your own mix, started from “${from}”.` : 'Your own mix.';
      }
      $('[data-src-how]').textContent = SRC_HOW[st.src];
      for (const r of root.querySelectorAll<HTMLInputElement>('input[name="bm-src"]')) r.checked = r.value === st.src;
      for (const r of root.querySelectorAll<HTMLInputElement>('input[name="bm-need"]')) r.checked = r.value === (st.need === 'all' ? 'all' : 'n');
      history.replaceState(null, '', writeState(st));
    }
    // recompute at most once a frame, so dragging a slider never blocks typing or scrolling
    let frame = 0;
    function update(list = false) {
      if (list) {
        res = compute(mx, st);
        renderList();
        renderOut();
        return;
      }
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        res = compute(mx, st);
        renderShares();
        renderOut();
      });
    }
    if (location.search) update(true);

    // ---- presets, weights, source, minimum ---------------------------------------------------------
    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const pb = t.closest<HTMLButtonElement>('[data-preset]');
      if (pb) {
        const x = presets.get(pb.dataset.preset!)!;
        presetId = x.id;
        st = { ...st, b: x.b.map((id) => ({ id, w: 50 })), need: st.need === 'all' ? 'all' : defaultNeed(x.b.length) };
        return update(true);
      }
      const xb = t.closest<HTMLButtonElement>('[data-x]');
      if (xb) {
        resize(st.b.length - 1);
        st.b.splice(Number(xb.dataset.x), 1);
        presetId = matchPreset();
        if (st.need !== 'all') st.need = Math.min(st.need, Math.max(1, st.b.length));
        update(true);
        ($('[data-q]') as HTMLInputElement).focus();
        return;
      }
      if (t.closest('[data-equal]')) {
        st.b = st.b.map((x) => ({ ...x, w: 50 }));
        presetId = matchPreset();
        return update(true);
      }
      const more = t.closest<HTMLButtonElement>('[data-more],[data-more-t]');
      if (more) {
        const box = more.parentElement!;
        for (const row of box.querySelectorAll<HTMLElement>('.later')) row.hidden = false;
        more.remove();
        return;
      }
      if (t.closest('[data-copy]')) copy();
    });
    root.addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.dataset.w !== undefined) {
        st.b[Number(t.dataset.w)].w = Number(t.value);
        presetId = matchPreset();
        update();
      } else if (t.dataset.n !== undefined) {
        const v = Math.round(Number(t.value));
        if (v >= 1) {
          st.need = v;
          update();
        }
      }
    });
    root.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'bm-src') {
        st.src = t.value as Source;
        update(true);
      } else if (t.name === 'bm-need') {
        st.need = t.value === 'all' ? 'all' : Math.max(1, Number($<HTMLInputElement>('[data-n]').value) || defaultNeed(st.b.length));
        update(true);
      }
    });

    // ---- search ------------------------------------------------------------------------------------
    const q = $<HTMLInputElement>('[data-q]');
    const list = $<HTMLUListElement>('[data-list]');
    const norm = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
    const names = p.benches.map((b) => norm(`${b[1]} ${b[0]}`));
    let hits: number[] = [];
    let active = -1;
    function find() {
      const words = norm(q.value).split(' ').filter(Boolean);
      if (!words.length) return close();
      const taken = new Set(st.b.map((x) => x.id));
      const n = (i: number) => mx.column(i, st.src).size;
      hits = names
        .map((s, i) => ({ i, s }))
        .filter((x) => !taken.has(p.benches[x.i][0]) && words.every((w) => x.s.includes(w)))
        .sort((a, b) => Number(b.s.startsWith(words[0])) - Number(a.s.startsWith(words[0])) || n(b.i) - n(a.i))
        .slice(0, 12)
        .map((x) => x.i);
      active = hits.length ? 0 : -1;
      list.innerHTML = hits.length
        ? hits
            .map((i, k) => {
              const [, name, area] = p.benches[i];
              const c = n(i);
              return `<li role="option" id="bm-o${k}" data-i="${i}" aria-selected="${k === active}"><span class="bm-adot" style="background:var(--area-${esc(area)})"></span><span class="bm-oname">${esc(name)}</span><span class="bm-ometa">${esc(AREA_NAMES[area] ?? area)}, ${c ? `${c} models` : 'no scores from this source'}</span></li>`;
            })
            .join('')
        : '<li class="bm-none" role="presentation">No benchmark with enough scores matches.</li>';
      list.hidden = false;
      q.setAttribute('aria-expanded', 'true');
      q.setAttribute('aria-activedescendant', active >= 0 ? `bm-o${active}` : '');
    }
    function close() {
      list.hidden = true;
      hits = [];
      active = -1;
      q.setAttribute('aria-expanded', 'false');
      q.removeAttribute('aria-activedescendant');
    }
    // a minimum still at its default follows the number of tests. One the reader set stays.
    function resize(k: number) {
      if (st.need !== 'all' && st.need === defaultNeed(st.b.length)) st.need = defaultNeed(k);
    }
    function add(i: number) {
      resize(st.b.length + 1);
      st.b.push({ id: p.benches[i][0], w: 50 });
      presetId = matchPreset();
      q.value = '';
      close();
      update(true);
    }
    function move(d: number) {
      if (!hits.length) return;
      active = (active + d + hits.length) % hits.length;
      for (const li of list.querySelectorAll<HTMLElement>('[role="option"]')) li.setAttribute('aria-selected', String(li.id === `bm-o${active}`));
      q.setAttribute('aria-activedescendant', `bm-o${active}`);
      list.querySelector(`#bm-o${active}`)?.scrollIntoView({ block: 'nearest' });
    }
    q.addEventListener('input', find);
    q.addEventListener('focus', () => q.value && find());
    q.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') (e.preventDefault(), move(1));
      else if (e.key === 'ArrowUp') (e.preventDefault(), move(-1));
      else if (e.key === 'Enter' && active >= 0) (e.preventDefault(), add(hits[active]));
      else if (e.key === 'Escape') close();
    });
    list.addEventListener('pointerdown', (e) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>('[data-i]');
      if (li) (e.preventDefault(), add(Number(li.dataset.i)));
    });
    q.addEventListener('blur', () => setTimeout(close, 120));

    // ---- share ---------------------------------------------------------------------------------------
    async function copy() {
      const status = $('[data-status]');
      try {
        await navigator.clipboard.writeText(location.href);
        status.textContent = 'Link copied.';
      } catch {
        status.textContent = 'Copy the link from the address bar. It holds this index.';
      }
      setTimeout(() => (status.textContent = ''), 4000);
    }
  }
  main();
</script>

<style is:global>
  /* a tool page: the controls sit right under the intro */
  .bm-root .head + section {
    margin-top: 4px;
  }
  .bm-root .bm-grid {
    display: grid;
    grid-template-columns: minmax(0, 380px) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }
  @media (max-width: 1040px) {
    .bm-root .bm-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
    }
  }
  .bm-root .bm-panel {
    display: flex;
    flex-direction: column;
    gap: 30px;
    min-width: 0;
  }
  .bm-root .bm-block {
    min-width: 0;
  }
  .bm-root fieldset.bm-block {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .bm-root .bm-label {
    font: 500 14px/1.3 var(--sans);
    letter-spacing: 0;
    color: var(--ink);
    margin: 0 0 10px;
    padding: 0;
  }
  .bm-root .bm-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .bm-root .bm-presets button {
    font: 500 13px/1.25 var(--sans);
    color: var(--ink-2);
    background: var(--panel);
    border: 0;
    border-radius: 999px;
    padding: 7px 12px;
    cursor: pointer;
    text-align: left;
    transition:
      background-color 140ms ease,
      color 140ms ease;
  }
  .bm-root .bm-presets button:hover:not(:disabled):not([aria-pressed='true']) {
    color: var(--ink);
  }
  .bm-root .bm-presets button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--bg);
  }
  .bm-root .bm-how,
  .bm-root .bm-hint,
  .bm-root .bm-empty {
    margin-top: 10px;
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--ink-3);
  }
  .bm-root .bm-search {
    position: relative;
  }
  .bm-root .bm-search .field {
    width: 100%;
    box-sizing: border-box;
  }
  .bm-root .bm-list {
    position: absolute;
    z-index: 30;
    left: 0;
    right: 0;
    top: calc(100% + 6px);
    margin: 0;
    padding: 6px;
    list-style: none;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.12);
    max-height: 320px;
    overflow-y: auto;
  }
  .bm-root .bm-list [role='option'] {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 9px;
    align-items: center;
    padding: 7px 8px;
    border-radius: 7px;
    cursor: pointer;
  }
  .bm-root .bm-list [aria-selected='true'] {
    background: var(--panel);
  }
  .bm-root .bm-oname {
    font-size: 14px;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .bm-root .bm-ometa {
    grid-column: 2;
    font-size: 12.5px;
    color: var(--ink-3);
  }
  .bm-root .bm-none {
    padding: 8px;
    font-size: 13.5px;
    color: var(--ink-3);
  }
  .bm-root .bm-adot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    flex: none;
