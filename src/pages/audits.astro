---
import Base from '../layouts/Base.astro';
import { audits, PROBLEMS, STATUSES, unresolved, type Problem } from '../lib/audits.ts';
import { benchById } from '../lib/data.ts';
import { humanDate, fullDate } from '../lib/format.ts';

const findings = audits.flatMap((audit) => audit.findings.map((finding) => ({ audit, finding })));
const open = unresolved(findings).length;
const benchCount = new Set(findings.map((f) => f.finding.benchmark)).size;
// problem kinds in the order of how often audits find them
const counts = new Map<Problem, number>();
for (const { finding } of findings) for (const p of finding.problems) counts.set(p, (counts.get(p) ?? 0) + 1);
const kinds = [...counts].sort((a, b) => b[1] - a[1] || PROBLEMS[a[0]].name.localeCompare(PROBLEMS[b[0]].name));
// the headline: the problem audits find most often
const plural = (name: string) => /s$/.test(name);
const top = kinds.filter(([, n]) => n === kinds[0]?.[1]).map(([p]) => PROBLEMS[p].name);
const headline = !kinds.length
  ? 'What the audits found'
  : top.length === 1
    ? `${top[0]} ${plural(top[0]) ? 'show' : 'shows'} up in ${kinds[0][1]} of ${findings.length} findings, more than any other problem`
    : `${top.slice(0, -1).join(', ')} and ${top.at(-1)!.toLowerCase()} show up most, in ${kinds[0][1]} of ${findings.length} findings each`;
// a finding's problems as one line of text: "Unclear tasks and broken grader"
const kindText = (ps: Problem[]) => {
  const names = ps.map((p, i) => (i === 0 ? PROBLEMS[p].name : PROBLEMS[p].name.toLowerCase()));
  return names.length < 2 ? (names[0] ?? '') : `${names.slice(0, -1).join(', ')} and ${names.at(-1)}`;
};
---

<Base title="Benchmark audits" description="Published reviews that found problems in benchmarks: broken graders, leaked answers, wrong labels and contamination, with each finding linked to its source.">
  <div class="page">
    <header class="head">
      <h1>Audits</h1>
      <p class="lede">
        These are published audits that found problems in benchmarks we track, like graders that reject right answers or answers that leak online. Each finding also shows up on its benchmark's page. Know of an audit we're missing? Let us know <a href="/submit/">here</a>.
      </p>
      <div class="facts">
        <span><b>{audits.length}</b> audits</span>
        <span><b>{findings.length}</b> findings on <b>{benchCount}</b> benchmarks</span>
        <span><b>{open}</b> not fixed in the benchmark itself</span>
        <a href="#rules">What we include</a>
      </div>
    </header>

    <section>
      <div class="sh">
        <h2>{headline}</h2>
        <p>Pick a kind of problem to see only those findings.</p>
      </div>
      <div class="ak" role="group" aria-label="Kind of problem">
        <button type="button" class="ak-b" aria-pressed="true" data-kind="">All <span class="num">{findings.length}</span></button>
        {kinds.map(([p, n]) => (
          <button type="button" class="ak-b hint" aria-pressed="false" data-kind={p} data-tn={PROBLEMS[p].name} data-ts={PROBLEMS[p].what}>
            {PROBLEMS[p].name} <span class="num">{n}</span>
          </button>
        ))}
      </div>
    </section>

    <section>
      <ol class="al">
        {audits.map((audit) => (
          <li class="al-a" data-kinds={audit.findings.flatMap((f) => f.problems).join(' ')}>
            <div class="al-when num">{fullDate(audit.date)}</div>
            <div class="al-body">
              <h3>
                <a href={audit.url}>{audit.title}</a>
              </h3>
              <p class="al-by">
                {`${audit.author}, ${audit.source === 'paper' ? 'a paper' : 'a write-up'}`}{audit.people && audit.people.length <= 3 && !audit.author.includes('et al.') && <span class="muted">{`, by ${audit.people.join(', ')}`}</span>}
              </p>
              <ul class="al-f">
                {audit.findings.map((f) => {
                  const b = benchById.get(f.benchmark);
                  const st = STATUSES[f.status];
                  return (
                    <li data-kinds={f.problems.join(' ')}>
                      <div class="al-top">
                        <a class="al-b" href={`/benchmarks/${f.benchmark}/#issues`}>{b?.name ?? f.benchmark}</a>
                        <span class:list={['al-st', st.tone]}>{st.name}</span>
                      </div>
                      <p class="al-k">{kindText(f.problems)}</p>
                      <p class="al-sum">{f.summary}</p>
                    </li>
                  );
                })}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section id="rules">
      <div class="sh">
        <h2>What we include</h2>
      </div>
      <div class="rules">
        <p>We list an audit once its author publishes how they did it, in a paper, a write-up or a repo with the fixes. A post or a newsletter line on its own isn't enough.</p>
        <p>We name who found each problem and quote their numbers as printed. If the benchmark's makers reply or fix it, we link that too.</p>
        <p>We don't change leaderboard scores because of an audit. Re-scored results often use a different harness or only the public tasks, so they stay in the finding's text.</p>
      </div>
      <p class="upd muted">Updated {humanDate(audits[0]?.date)}. To suggest an audit, <a href="/submit/">send a correction</a>.</p>
    </section>
  </div>
</Base>

<script>
  // one kind at a time: a finding shows when it has the kind, and an audit when any of its findings does
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.ak-b')];
  for (const b of buttons)
    b.addEventListener('click', () => {
      const kind = b.dataset.kind ?? '';
      for (const x of buttons) x.setAttribute('aria-pressed', String(x === b));
      for (const el of document.querySelectorAll<HTMLElement>('.al-a, .al-f > li')) el.hidden = !!kind && !(el.dataset.kinds ?? '').split(' ').includes(kind);
    });
</script>

<style>
  /* the kinds of problem, as plain text toggles: the chosen one in full ink, underlined */
  .ak {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
  }
  .ak-b {
    padding: 4px 0;
    border: 0;
    background: none;
    color: var(--ink-3);
    font: inherit;
    font-size: 15px;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 6px;
    transition: color 140ms ease, text-decoration-color 140ms ease;
  }
  .ak-b:hover {
    color: var(--ink);
  }
  .ak-b .num {
    margin-left: 3px;
    font: 400 13px/1 var(--mono);
    color: var(--ink-4);
  }
  .ak-b[aria-pressed='true'] {
    color: var(--ink);
    text-decoration-color: currentColor;
  }
  .al {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 56px;
  }
  .al-a {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 24px;
  }
  .al-when {
    padding-top: 6px;
    font: 400 13px/1.4 var(--mono);
    color: var(--ink-3);
  }
  .al-body h3 {
    font: 400 26px/1.2 var(--serif);
    text-wrap: balance;
    max-width: 36ch;
  }
  .al-body h3 a {
    text-decoration: none;
  }
  .al-body h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--ink-4);
    text-underline-offset: 4px;
  }
  .al-by {
    margin-top: 6px;
    color: var(--ink-3);
    font-size: 14.5px;
  }
  /* each finding is a short block of text, set apart by space alone */
  .al-f {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    gap: 26px;
    max-width: 72ch;
  }
  .al-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 16px;
  }
  .al-b {
    font-size: 16.5px;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }
  .al-b:hover {
    text-decoration: underline;
    text-decoration-color: var(--ink-4);
    text-underline-offset: 3px;
  }
  .al-st {
    margin-left: auto;
    font-size: 13.5px;
    color: var(--ink-3);
    white-space: nowrap;
  }
  .al-st.warn {
    color: var(--ink-2);
  }
  .al-st.bad {
    color: var(--ink);
    font-weight: 500;
  }
  .al-k {
    margin-top: 2px;
    font-size: 14px;
    color: var(--ink-3);
  }
  .al-sum {
    margin-top: 8px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .rules {
    display: grid;
    gap: 12px;
    max-width: 66ch;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .rules p {
    margin: 0;
  }
  .upd {
    margin-top: 18px;
    font-size: 14px;
  }
  @media (max-width: 720px) {
    .al-a {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
    }
    .al-body h3 {
      font-size: 23px;
    }
    .al-st {
      margin-left: 0;
    }
  }
</style>
