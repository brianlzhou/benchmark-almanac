---
import Base from '../../layouts/Base.astro';
import LabMark from '../../components/LabMark.astro';
import { allSummaries, benchmarks, modelById } from '../../lib/data.ts';
import { AREAS, CATEGORY_NAMES, LEVELS, LEVEL_BY_ID, SUB_BY_ID } from '../../lib/taxonomy.ts';

// scoring methods, grouped the way people ask: fixed answers, graders, arenas, real events
const METHOD_GROUP: Record<string, string> = {
  verified: 'fixed',
  'model-judged': 'graded',
  'expert-graded': 'graded',
  preference: 'arena',
  'head-to-head': 'arena',
  outcome: 'events',
};
import { score as fmt, monthYear } from '../../lib/format.ts';

const rows = allSummaries().sort((a, b) => b.cites.length - a.cites.length || b.nScores - a.nScores || a.b.name.localeCompare(b.b.name));
const count = (f: (s: (typeof rows)[number]) => boolean) => rows.filter(f).length;
const STATUS: Record<string, string> = { 'in use': 'In use', fading: 'Fading', dropped: 'Dropped', 'not in cards': 'Not in cards' };
const areaCounts = AREAS.map((a) => ({
  a,
  n: count((s) => s.area === a.id),
  cats: a.categories.filter((c) => rows.some((s) => s.b.category === c)),
})).filter((x) => x.n);
const methodCount = (g: string) => count((s) => METHOD_GROUP[s.b.scoring ?? ''] === g);
---

<Base title="Benchmarks" description="Every benchmark in the almanac: what it tests, its code, its status in lab model cards, and its best score.">
  <div class="page wide">
    <header class="head">
      <h1>Benchmarks</h1>
      <p class="lede">
        {benchmarks.length} benchmarks from lab model cards, Epoch AI's hub and public collections. Each has a page with its leaderboard, its scores over time, and the cards that report it. Arenas, where people vote between answers, <a href="/arenas/">work differently</a> and are marked as such.
      </p>
      <div class="facts">
        <span><b>{count((s) => s.status === 'in use')}</b> in use</span>
        <span><b>{count((s) => s.status === 'fading')}</b> fading</span>
        <span><b>{count((s) => s.status === 'dropped')}</b> dropped</span>
        <span><b>{count((s) => !!s.b.links?.repo)}</b> with public code</span>
      </div>
    </header>

    <nav class="areas" aria-label="Areas and categories">
      {
        areaCounts.map(({ a, n, cats }) => (
          <div class="area" style={`--a:var(--area-${a.id})`}>
            <a class="ah" href={`?area=${a.id}`} data-area-link={a.id}>
              <span class="sw" />
              <span class="an">{a.name}</span>
              <span class="ac num">{n}</span>
            </a>
            <div class="cats">
              {cats.map((c) => (
                <a href={`/categories/${c}/`}>{CATEGORY_NAMES[c] ?? c}</a>
              ))}
            </div>
          </div>
        ))
      }
    </nav>

    <div class="filters" data-filter="benchmarks">
      <div class="seg methods" role="radiogroup" aria-label="How it is scored">
        <label><input type="radio" name="method" value="" data-key="method" checked />All</label>
        <label title="An answer key, unit tests or a check of the final state"><input type="radio" name="method" value="fixed" data-key="method" />Checked automatically <span class="n">{methodCount('fixed')}</span></label>
        <label title="A model or human experts grade the output"><input type="radio" name="method" value="graded" data-key="method" />Graded <span class="n">{methodCount('graded')}</span></label>
        <label title="People vote between two answers, or models play each other"><input type="radio" name="method" value="arena" data-key="method" />Arenas <span class="n">{methodCount('arena')}</span></label>
        <label title="Predictions scored against what happens"><input type="radio" name="method" value="events" data-key="method" />Real events <span class="n">{methodCount('events')}</span></label>
      </div>
      <div class="break" />
      <input class="field grow" type="search" placeholder="Search benchmarks, labs or makers" aria-label="Search benchmarks" data-q />
      <select class="field" aria-label="Area" data-area>
        <option value="">All areas</option>
        {AREAS.map((a) => <option value={a.id}>{a.name}</option>)}
      </select>
      <select class="field" aria-label="Level" data-level>
        <option value="">Any level</option>
        {LEVELS.map((l) => <option value={l.id}>{l.name}</option>)}
      </select>
      <select class="field" aria-label="Status" data-status>
        <option value="">Any status</option>
        <option value="in-use">In use</option>
        <option value="fading">Fading</option>
        <option value="dropped">Dropped</option>
        <option value="not-in-cards">Not in model cards</option>
      </select>
      <select class="field" aria-label="Code" data-code>
        <option value="">With or without code</option>
        <option value="yes">Public code</option>
      </select>
      <span class="count muted" data-count>{rows.length} benchmarks</span>
    </div>

    <div class="table-wrap">
      <table class="t bt" data-rows>
        <thead>
          <tr>
            <th>Benchmark</th>
            <th>Kind</th>
            <th>Level</th>
            <th>Status</th>
            <th class="r">Best score</th>
            <th class="r">Cards</th>
            <th class="r">Models</th>
            <th>Released</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((s) => {
              const top = s.best ? modelById.get(s.best.model) : undefined;
              return (
                <tr
                  data-area={s.area}
                  data-level={s.b.level ?? ''}
                  data-method={METHOD_GROUP[s.b.scoring ?? ''] ?? ''}
                  data-status={s.status.replace(/ /g, '-')}
                  data-code={s.b.links?.repo ? 'yes' : ''}
                  data-text={[...(s.b.aliases ?? []), s.b.org].filter(Boolean).join(' ').toLowerCase() || undefined}
                >
                  <td class="nm">
                    <a href={`/benchmarks/${s.b.id}/`}>{s.b.name}</a>
                    {s.b.description && <span class="desc">{s.b.description}</span>}
                  </td>
                  <td class="muted kind">{(s.b.subcategory && SUB_BY_ID.get(s.b.subcategory)?.name) ?? CATEGORY_NAMES[s.b.category ?? 'other'] ?? 'Other'}</td>
                  <td class="muted nowrap">{s.b.level ? LEVEL_BY_ID.get(s.b.level)?.name : ''}</td>
                  <td class="nowrap">
                    <span class:list={['tag', `status-${s.status.replace(/ /g, '-')}`]}>
                      <span class="dot" />
                      <span class="sl">{STATUS[s.status]}</span>
                    </span>
                  </td>
                  <td class="r nowrap">
                    {s.best && top && (
                      <span class="best" title={top.name}>
                        <LabMark lab={top.lab} size={14} />
                        {fmt(s.best.value, s.b.unit ?? '%')}
                      </span>
                    )}
                  </td>
                  <td class="r">{s.cites.length || ''}</td>
                  <td class="r muted">{s.board.length || ''}</td>
                  <td class="muted num nowrap">{monthYear(s.b.released)}</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </div>
</Base>

<script>
  import { wireFilter } from '../../scripts/filter.ts';
  wireFilter('benchmarks');
  for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-area-link]')) {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const sel = document.querySelector<HTMLSelectElement>('[data-area]');
      if (!sel) return;
      sel.value = sel.value === a.dataset.areaLink ? '' : a.dataset.areaLink!;
      sel.dispatchEvent(new Event('change'));
    });
  }
</script>

<style>
  .areas {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin: 8px 0 28px;
  }
  .area {
    padding: 12px 14px 14px;
    border-radius: 10px;
    background: var(--panel);
  }
  .ah {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
  }
  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 12px;
    margin-top: 8px;
    padding-left: 20px;
  }
  .cats a {
    font-size: 13px;
    color: var(--ink-3);
    text-decoration: none;
  }
  .cats a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .methods .n {
    color: var(--ink-4);
    font-weight: 400;
    margin-left: 4px;
  }
  .break {
    flex-basis: 100%;
    height: 0;
  }
  .kind {
    min-width: 140px;
    font-size: 13.5px;
  }
  .sw {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--a);
    flex: none;
  }
  .an {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ac {
    color: var(--ink-3);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-bottom: 20px;
  }
  .grow {
    flex: 1 1 260px;
  }
  .count {
    font-size: 13px;
    margin-left: auto;
  }
  .nm a {
    font-weight: 500;
  }
  .desc {
    display: block;
    margin-top: 3px;
    color: var(--ink-3);
    font-size: 13px;
    line-height: 1.4;
    max-width: 62ch;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .best {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .nowrap {
    white-space: nowrap;
  }
  .bt td {
    padding-top: 11px;
    padding-bottom: 11px;
  }
  @media (max-width: 900px) {
    .areas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .bt th:nth-child(2),
    .bt td:nth-child(2),
    .bt th:nth-child(3),
    .bt td:nth-child(3),
    .bt th:nth-child(7),
    .bt td:nth-child(7),
    .bt th:nth-child(8),
    .bt td:nth-child(8) {
      display: none;
    }
    .methods {
      flex-wrap: wrap;
    }
    .sl {
      display: none;
    }
  }
</style>
