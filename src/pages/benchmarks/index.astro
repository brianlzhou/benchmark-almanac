---
import SortHead from '../../components/SortHead.astro';
import Base from '../../layouts/Base.astro';
import LabMark from '../../components/LabMark.astro';
import Dropdown, { type Option } from '../../components/Dropdown.astro';
import AreaMark from '../../components/AreaMark.astro';
import { allSummaries, benchmarks, modelById, monthsBetween, AS_OF, addedWindows, addedOptions } from '../../lib/data.ts';
import { AREAS, CATEGORY_NAMES, LEVELS, LEVEL_BY_ID, SUB_BY_ID, SUBCATEGORIES, areaOf, levelIndex } from '../../lib/taxonomy.ts';
import { score as fmt, monthYear, humanDate } from '../../lib/format.ts';
import { familyOf, nextVersion } from '../../lib/reigns.ts';

// where the newest score came from, for the Last added column's tooltip
const ADDED_FROM: Record<string, string> = { leaderboard: 'its leaderboard', epoch: 'Epoch AI', card: 'a model card' };

// scoring methods, grouped the way people ask: fixed answers, graders, arenas, real events
const METHOD_GROUP: Record<string, string> = {
  verified: 'fixed',
  'model-judged': 'graded',
  'expert-graded': 'graded',
  preference: 'arena',
  'head-to-head': 'arena',
  outcome: 'events',
};
const STATUS: Record<string, string> = { 'in use': 'In use', fading: 'Fading', dropped: 'Dropped', 'system cards': 'System cards only', 'not in cards': 'Not in cards' };
// the order a sort by status puts them in
const STATUS_RANK: Record<string, number> = { 'in use': 0, fading: 1, dropped: 2, 'system cards': 3, 'not in cards': 4 };

const all = allSummaries();
// one row per test: a versioned family shows its newest version and links the earlier ones
const newest = (id: string) => familyOf(id).at(-1);
const rows = all
  .filter((s) => !s.b.family || newest(s.b.id) === s.b.id)
  .sort((a, b) => b.cites.length - a.cites.length || b.docCites.length - a.docCites.length || b.nScores - a.nScores || a.b.name.localeCompare(b.b.name));
const inRows = (f: (s: (typeof rows)[number]) => boolean) => rows.filter(f).length;
const methodCount = (g: string) => inRows((s) => METHOD_GROUP[s.b.scoring ?? ''] === g);
const areaCounts = AREAS.map((a) => ({
  a,
  n: inRows((s) => s.area === a.id),
  cats: a.categories.filter((c) => rows.some((s) => s.b.category === c)),
})).filter((x) => x.n);

// the area filter nests three deep: area, category, kind
const areaOptions: Option[] = [{ value: '', label: 'All areas' }];
for (const { a, n, cats } of areaCounts) {
  areaOptions.push({ value: `a:${a.id}`, label: a.name, depth: 0, count: n });
  for (const c of cats) {
    areaOptions.push({ value: `c:${c}`, label: CATEGORY_NAMES[c] ?? c, depth: 1, count: inRows((s) => s.b.category === c) });
    for (const sc of SUBCATEGORIES[c] ?? []) {
      const k = inRows((s) => s.b.subcategory === sc.id);
      if (k) areaOptions.push({ value: `s:${sc.id}`, label: sc.name, depth: 2, count: k });
    }
  }
}
const levelOptions: Option[] = [{ value: '', label: 'Any level' }, ...LEVELS.map((l) => ({ value: l.id, label: l.name, count: inRows((s) => s.b.level === l.id) }))];
const statusOptions: Option[] = [
  { value: '', label: 'Any status' },
  { value: 'in-use', label: 'In use', count: inRows((s) => s.status === 'in use') },
  { value: 'fading', label: 'Fading', count: inRows((s) => s.status === 'fading') },
  { value: 'dropped', label: 'Dropped', count: inRows((s) => s.status === 'dropped') },
  { value: 'system-cards', label: 'Only in system cards', count: inRows((s) => s.status === 'system cards') },
  { value: 'not-in-cards', label: 'Not in model cards', count: inRows((s) => s.status === 'not in cards') },
];
const codeOptions: Option[] = [
  { value: '', label: 'With or without code' },
  { value: 'yes', label: 'Public code', count: inRows((s) => !!s.b.links?.repo) },
];
const byId = new Map(all.map((s) => [s.b.id, s]));
// a family's earlier versions, newest first, so reading down goes back in time
const earlier = (id: string) =>
  familyOf(id)
    .slice(0, -1)
    .map((v) => byId.get(v)!)
    .reverse();
const vlabel = (v: string) => (/^\d+$/.test(v) ? `v${v}` : v);
// The longest text of each column that cannot wrap, over every row and earlier version. A hidden row
// holds it under the header, so the table has its final column widths from the first paint (see filter.ts).
const everyRow = rows.flatMap((s) => [s, ...(s.b.family ? earlier(s.b.id) : [])]);
const longest = (xs: (string | undefined)[]) => xs.reduce<string>((a, x) => (x && x.length > a.length ? x : a), '');
const probe = {
  level: longest(everyRow.map((s) => (s.b.level ? LEVEL_BY_ID.get(s.b.level)?.name : undefined))),
  status: Object.keys(STATUS).filter((k) => everyRow.some((s) => s.status === k)).sort((a, b) => STATUS[b].length - STATUS[a].length)[0] ?? 'in use',
  released: longest(everyRow.map((s) => monthYear(s.b.released))),
  added: longest(everyRow.map((s) => monthYear(s.lastAdded?.date))),
};
const maxArea = Math.max(...areaCounts.map((x) => x.n));
---

<Base title="Benchmarks" description="Every benchmark we catalog, with what it tests, who made it, whether labs report it, and its best score.">
  <div class="page bx">
    <header class="head">
      <h1>Benchmarks</h1>
      <p class="lede">
        We track {rows.length.toLocaleString('en-US')} benchmarks, or {benchmarks.length.toLocaleString('en-US')} if you count each version. Open one to see its leaderboard, score history and the model cards that report it. Arenas, where people vote between answers, also have <a href="/arenas/">their own page</a>.
      </p>
      <div class="facts">
        <span><b>{inRows((s) => s.status === 'in use')}</b> in use</span>
        <span><b>{inRows((s) => s.status === 'fading')}</b> fading</span>
        <span><b>{inRows((s) => s.status === 'dropped')}</b> dropped</span>
        <span><b>{inRows((s) => !!s.b.links?.repo).toLocaleString('en-US')}</b> with public code</span>
        <span>Scores refreshed <b>{humanDate(AS_OF)}</b></span>
      </div>
    </header>

    <nav class="areas" aria-label="Areas">
      <ul class="aidx">
        {
          areaCounts.map(({ a, n }) => (
            <li style={`--a:var(--area-${a.id});--w:${(n / maxArea).toFixed(3)}`}>
              <a href={`?area=a:${a.id}`} data-area-link={`a:${a.id}`}>
                <AreaMark area={a.id} size={11} />
                <span class="an">{a.name}</span>
                <span class="ac num">{n.toLocaleString('en-US')}</span>
              </a>
              <span class="abar" aria-hidden="true" />
            </li>
          ))
        }
      </ul>
      {
        areaCounts.map(({ a, cats }) => (
          <p class="acats" data-cats-for={a.id} hidden>
            <span class="muted">{a.name}:</span>
            {cats.map((c) => (
              <a href={`/categories/${c}/`} data-cat={c} data-subs={(SUBCATEGORIES[c] ?? []).map((x) => x.id).join(' ') || undefined}>
                {CATEGORY_NAMES[c] ?? c}
              </a>
            ))}
          </p>
        ))
      }
    </nav>

    <div class="fbox" data-filter="benchmarks">
      <div class="seg methods" role="radiogroup" aria-label="How it is scored">
        <label><input type="radio" name="method" value="" data-key="method" checked />All</label>
        <label title="An answer key, unit tests or a check of the final state"><input type="radio" name="method" value="fixed" data-key="method" />Checked automatically <span class="n">{methodCount('fixed')}</span></label>
        <label title="A model or human experts grade the output"><input type="radio" name="method" value="graded" data-key="method" />Graded <span class="n">{methodCount('graded')}</span></label>
        <label title="People vote between two answers, or models play each other"><input type="radio" name="method" value="arena" data-key="method" />Arenas <span class="n">{methodCount('arena')}</span></label>
        <label title="Predictions scored against what happens"><input type="radio" name="method" value="events" data-key="method" />Real events <span class="n">{methodCount('events')}</span></label>
      </div>
      <div class="frow">
        <input class="field grow" type="search" placeholder="Search benchmarks, makers or models" aria-label="Search benchmarks" data-q />
        <button type="button" class="fbtn" aria-expanded="false" aria-controls="fpanel" data-fbtn>
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1.5 3.5h11M3.5 7h7M5.5 10.5h3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
          Filters<span class="fn" data-fn></span>
        </button>
        <div class="fpanel" id="fpanel">
          <Dropdown filterKey="area" label="Area" options={areaOptions} search wide />
          <Dropdown filterKey="level" label="Level" options={levelOptions} />
          <Dropdown filterKey="status" label="Status" options={statusOptions} />
          <Dropdown filterKey="added" label="Last added" options={addedOptions(rows)} />
          <Dropdown filterKey="code" label="Code" options={codeOptions} />
        </div>
        <span class="count muted" data-count title={`${benchmarks.length.toLocaleString('en-US')} counting each version`}>{rows.length.toLocaleString('en-US')} benchmarks</span>
      </div>

    <div class="table-wrap wide">
      <table class="t bt" data-rows data-sort>
        <thead>
          <tr>
            <SortHead>Benchmark</SortHead>
            <SortHead>Made by</SortHead>
            <SortHead>Kind</SortHead>
            <SortHead data-first="asc">Level</SortHead>
            <SortHead data-first="asc">Status</SortHead>
            <SortHead>Best score</SortHead>
            <SortHead class="r two" title="Launch posts that list it in their headline results">Launch<br />posts</SortHead>
            <SortHead class="r two" title="System cards, model cards and technical reports that report it">System<br />cards</SortHead>
            <SortHead>Released</SortHead>
            <SortHead title="When a model last got a score here, from any source">Last<br />added</SortHead>
          </tr>
          <tr data-probe aria-hidden="true">
            <td class="nm" />
            <td class="org" />
            <td class="muted kind" />
            <td class="muted nowrap">{probe.level}</td>
            <td class="nowrap">
              <span class:list={['tag', `status-${probe.status.replace(/ /g, '-')}`]}>
                <span class="dot" />
                <span class="sl">{STATUS[probe.status]}</span>
              </span>
            </td>
            <td class="best-c" />
            <td class="r" />
            <td class="r muted" />
            <td class="muted num nowrap">{probe.released}</td>
            <td class="muted num nowrap">{probe.added}</td>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((s, i) => {
              const top = s.best ? modelById.get(s.best.model) : undefined;
              const prev = s.b.family ? earlier(s.b.id) : [];
              const sub = s.b.subcategory ? SUB_BY_ID.get(s.b.subcategory) : undefined;
              const kind = sub?.name ?? CATEGORY_NAMES[s.b.category ?? 'other'] ?? 'Other';
              const group = prev.length ? s.b.family : undefined;
              return (
                <>
                  <tr
                    class:list={{ fam: !!group }}
                    data-later={i >= 150 ? '' : undefined}
                    data-group={group}
                    data-area={`a:${areaOf(s.b.category)} c:${s.b.category ?? 'other'}${s.b.subcategory ? ` s:${s.b.subcategory}` : ''}`}
                    data-level={s.b.level ?? ''}
                    data-method={METHOD_GROUP[s.b.scoring ?? ''] ?? ''}
                    data-status={s.status.replace(/ /g, '-')}
                    data-added={addedWindows(s)}
                    data-code={s.b.links?.repo ? 'yes' : ''}
                    data-text={[...(s.b.aliases ?? []), ...prev.map((p) => p.b.name)].join(' ').toLowerCase() || undefined}
                  >
                    <td class="nm">
                      <a href={`/benchmarks/${s.b.id}/`}>{s.b.name}</a>
                      {group && s.b.version && !s.b.name.includes(s.b.version) && <span class="vtag">{vlabel(s.b.version)}</span>}
                      {s.b.description && <span class="desc">{s.b.description}</span>}
                      {group && (
                        <button type="button" class="vt" data-toggle={group} aria-expanded="false" aria-controls={prev.map((p) => `v-${p.b.id}`).join(' ')}>
                          <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M3.5 2l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                          {prev.length} earlier {prev.length === 1 ? 'version' : 'versions'}
                          <span class="vlist">{prev.map((p) => vlabel(p.b.version ?? p.b.name)).join(', ')}</span>
                        </button>
                      )}
                    </td>
                    <td class="org">{s.b.org}</td>
                    <td class="muted kind">{kind}</td>
                    <td class="muted nowrap" data-v={s.b.level ? String(levelIndex(s.b.level)) : undefined}>{s.b.level ? LEVEL_BY_ID.get(s.b.level)?.name : ''}</td>
                    <td class="nowrap" data-v={String(STATUS_RANK[s.status] ?? 9)}>
                      <span class:list={['tag', `status-${s.status.replace(/ /g, '-')}`]}>
                        <span class="dot" />
                        <span class="sl">{STATUS[s.status]}</span>
                      </span>
                    </td>
                    <td class="best-c" data-v={s.best && (s.b.unit ?? '%') === '%' ? String(s.best.value) : undefined}>
                      {s.best && top && (
                        <span class="best">
                          <LabMark lab={top.lab} size={14} />
                          <span class="bm">{top.name}</span>
                          <b class="num">{fmt(s.best.value, s.b.unit ?? '%')}</b>
                        </span>
                      )}
                    </td>
                    <td class="r">{s.cites.length || ''}</td>
                    <td class="r muted">{s.docCites.length || ''}</td>
                    <td class="muted num nowrap">{monthYear(s.b.released)}</td>
                    <td class:list={['muted', 'num', 'nowrap', { stale: !!s.lastAdded && monthsBetween(s.lastAdded.date, AS_OF) >= 12 }]} data-v={s.lastAdded?.date} title={s.lastAdded ? `${modelById.get(s.lastAdded.model)?.name ?? s.lastAdded.model}, from ${ADDED_FROM[s.lastAdded.source]}` : undefined}>{monthYear(s.lastAdded?.date)}</td>
                  </tr>
                  {prev.map((p, i) => {
                    const ptop = p.best ? modelById.get(p.best.model) : undefined;
                    const next = nextVersion(p.b.id);
                    const pkind = (p.b.subcategory ? SUB_BY_ID.get(p.b.subcategory)?.name : undefined) ?? CATEGORY_NAMES[p.b.category ?? 'other'] ?? 'Other';
                    return (
                      <tr class:list={['ver', { last: i === prev.length - 1 }]} id={`v-${p.b.id}`} data-parent={group} hidden>
                        <td class="nm">
                          <span class="tree" aria-hidden="true" />
                          <a href={`/benchmarks/${p.b.id}/`}>{p.b.name}</a>
                          {p.b.version && !p.b.name.includes(p.b.version) && <span class="vtag">{vlabel(p.b.version)}</span>}
                          {next && <span class="desc">Replaced in {monthYear(next.date)}</span>}
                        </td>
                        <td class="org">{p.b.org !== s.b.org ? p.b.org : ''}</td>
                        <td class="muted kind">{pkind !== kind ? pkind : ''}</td>
                        <td class="muted nowrap">{p.b.level && p.b.level !== s.b.level ? LEVEL_BY_ID.get(p.b.level)?.name : ''}</td>
                        <td class="nowrap">
                          <span class:list={['tag', `status-${p.status.replace(/ /g, '-')}`]}>
                            <span class="dot" />
                            <span class="sl">{STATUS[p.status]}</span>
                          </span>
                        </td>
                        <td class="best-c">
                          {p.best && ptop && (
                            <span class="best">
                              <LabMark lab={ptop.lab} size={14} />
                              <span class="bm">{ptop.name}</span>
                              <b class="num">{fmt(p.best.value, p.b.unit ?? '%')}</b>
                            </span>
                          )}
                        </td>
                        <td class="r">{p.cites.length || ''}</td>
                        <td class="r muted">{p.docCites.length || ''}</td>
                        <td class="muted num nowrap">{monthYear(p.b.released)}</td>
                        <td class:list={['muted', 'num', 'nowrap', { stale: !!p.lastAdded && monthsBetween(p.lastAdded.date, AS_OF) >= 12 }]} data-v={p.lastAdded?.date} title={p.lastAdded ? `${modelById.get(p.lastAdded.model)?.name ?? p.lastAdded.model}, from ${ADDED_FROM[p.lastAdded.source]}` : undefined}>{monthYear(p.lastAdded?.date)}</td>
                      </tr>
                    );
                  })}
                </>
              );
            })
          }
        </tbody>
      </table>
    </div>
    </div>
  </div>
</Base>

<script>
  import { wireFilter } from '../../scripts/filter.ts';
  import { wirePeek } from '../../scripts/peek.ts';
  wireFilter('benchmarks');
  const peekTable = document.querySelector<HTMLTableElement>('table[data-rows]');
  if (peekTable) wirePeek(peekTable);
  // the area index sets the Area filter, marks the chosen area, and shows that area's categories
  const sel = document.querySelector<HTMLSelectElement>('select[data-area]');
  const areaLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-area-link]')];
  const catLines = [...document.querySelectorAll<HTMLElement>('[data-cats-for]')];
  const showArea = () => {
    const v = sel?.value ?? '';
    // a category or kind belongs to the area whose category line lists it
    const cat = v.startsWith('c:') ? v.slice(2) : v.startsWith('s:') ? [...document.querySelectorAll<HTMLElement>('[data-subs]')].find((c) => c.dataset.subs!.split(' ').includes(v.slice(2)))?.dataset.cat : undefined;
    const line = v.startsWith('a:') ? catLines.find((l) => l.dataset.catsFor === v.slice(2)) : cat ? catLines.find((l) => l.querySelector(`[data-cat="${cat}"]`)) : undefined;
    for (const l of catLines) l.hidden = l !== line;
    for (const a of areaLinks) a.setAttribute('aria-current', String(!!line && a.dataset.areaLink === `a:${line.dataset.catsFor}`));
    for (const c of document.querySelectorAll<HTMLAnchorElement>('[data-cat]')) c.toggleAttribute('data-on', !!cat && c.dataset.cat === cat);
  };
  for (const a of areaLinks) {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      if (!sel) return;
      sel.value = sel.value === a.dataset.areaLink ? '' : a.dataset.areaLink!;
      sel.dispatchEvent(new Event('change'));
      sel.dispatchEvent(new Event('sync'));
    });
  }
  sel?.addEventListener('change', showArea);
  showArea();

  // phones: the filters fold behind one button that counts the ones in use
  const box = document.querySelector<HTMLElement>('.fbox');
  const fbtn = document.querySelector<HTMLButtonElement>('[data-fbtn]');
  const fn = document.querySelector<HTMLElement>('[data-fn]');
  const selects = [...(box?.querySelectorAll<HTMLSelectElement>('.fpanel select') ?? [])];
  const countOn = () => {
    const n = selects.filter((x) => x.value).length;
    if (fn) fn.textContent = n ? ` (${n})` : '';
  };
  for (const x of selects) x.addEventListener('change', countOn);
  countOn();
  fbtn?.addEventListener('click', () => {
    const open = fbtn.getAttribute('aria-expanded') !== 'true';
    fbtn.setAttribute('aria-expanded', String(open));
    box?.classList.toggle('fopen', open);
  });
  // the table header sticks under the filter row, so the row's height sets where
  const frow = box?.querySelector<HTMLElement>('.frow');
  if (box && frow) new ResizeObserver(() => box.style.setProperty('--frow-h', `${frow.offsetHeight}px`)).observe(frow);
</script>

<style is:global>
  /* page styles, kept under .bx so they need no per-element scoping attributes on 2,000+ rows */
  /* the area index: eight areas set as type, each with its mark and a thin bar sized by its count */
  .bx .aidx {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 4px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bx .aidx li {
    display: grid;
    gap: 6px;
    padding: 8px 0 10px;
  }
  .bx .aidx a {
    display: flex;
    align-items: baseline;
    gap: 9px;
    text-decoration: none;
  }
  .bx .aidx .amark {
    align-self: center;
  }
  .bx .an {
    flex: 1;
    min-width: 0;
    font: 400 18px/1.2 var(--serif);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bx .ac {
    color: var(--ink-3);
    font: 400 12.5px var(--mono);
  }
  .bx .abar {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(to right, var(--a) calc(var(--w) * 100%), var(--grid) calc(var(--w) * 100%));
    transition: height 160ms ease;
  }
  .bx .aidx a:hover .an,
  .bx .aidx a[aria-current='true'] .an {
    text-decoration: underline;
    text-decoration-color: var(--a);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .bx .aidx li:has(a[aria-current='true']) .abar {
    height: 4px;
  }
  .bx .acats {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin: 10px 0 0;
    font-size: 14px;
  }
  .bx .acats[hidden] {
    display: none;
  }
  .bx .acats a {
    color: var(--ink-2);
  }
  .bx .acats a[data-on] {
    color: var(--ink);
    font-weight: 500;
  }
  /* filters: the scoring switch, then one row that stays under the header while the table scrolls */
  .bx .fbox {
    margin-top: 28px;
  }
  .bx .frow {
    position: sticky;
    top: var(--bar-h);
    z-index: 6;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin: 12px calc(-1 * var(--gutter)) 8px;
    padding: 8px var(--gutter);
    background: var(--bg);
    /* the table can be wider than the page, so the bar's background reaches both edges of the window. A
       border image paints it there without clipping the bar's dropdowns (a clip-path did) or widening the page. */
    border-image: linear-gradient(var(--bg), var(--bg)) fill 0 / 0 / 0 100vmax;
  }
  .bx .fpanel {
    display: contents;
  }
  .bx .fbtn {
    display: none;
  }
  .bx .methods .n {
    color: var(--ink-4);
    font-weight: 400;
    margin-left: 4px;
  }
  .bx .grow {
    flex: 1 1 240px;
  }
  .bx .count {
    font-size: 13px;
    margin-left: auto;
  }
  /* the column names stay in view under the filter row. clip, not auto: a scroll box would hold them in place */
  .bx .table-wrap {
    overflow-x: clip;
  }
  .bx .bt thead th {
    position: sticky;
    top: calc(var(--bar-h) + var(--frow-h, 60px));
    z-index: 5;
    padding-top: 6px;
    background: var(--bg);
    box-shadow: 0 1px 0 var(--line);
  }
  .bx .nm {
    min-width: 200px;
  }
  .bx .nm > a {
    font-weight: 500;
  }
  .bx .desc {
