---
import Base from '../../layouts/Base.astro';
import ScoreChart from '../../components/ScoreChart.astro';
import BarBoard from '../../components/BarBoard.astro';
import Columns from '../../components/Columns.astro';
import CardTicks from '../../components/CardTicks.astro';
import ReignChart from '../../components/ReignChart.astro';
import { reignRow } from '../../lib/reigns.ts';
import { leaderRows } from '../../lib/leaders.ts';
import { effortView, usd, costUnit } from '../../lib/effort.ts';
import EffortChart from '../../components/EffortChart.astro';
import { untested } from '../../lib/coverage.ts';
import { host, unreadWhy } from '../../lib/unread.ts';
import ModelName from '../../components/ModelName.astro';
import LabMark from '../../components/LabMark.astro';
import AuthorsWords from '../../components/AuthorsWords.astro';
import KnownIssues from '../../components/KnownIssues.astro';
import BoardChart from '../../components/BoardChart.astro';
import ChartDownload from '../../components/ChartDownload.astro';
import { creditLine, sourcesCredit, EPOCH_CREDIT, EPOCH_RUNS, LAB_CARDS } from '../../lib/credits.ts';
import { benchDeck, benchAxis } from '../../lib/figure-text.ts';
import { issuesByBenchmark, unresolved } from '../../lib/audits.ts';
import Crumbs from '../../components/Crumbs.astro';
import AreaMark from '../../components/AreaMark.astro';
import Spark from '../../components/Spark.astro';
import LinkIcon from '../../components/LinkIcon.astro';
import { makerParts } from '../../lib/makers.ts';
import { familyOf } from '../../lib/reigns.ts';
import { benchmarks, benchSummary, benchById, cards, AS_OF, modelById, LEADERBOARDS, allSummaries, eciOrder, labPages, leaderboardScores, unlistedScores, sourceLabel, fromName } from '../../lib/data.ts';
import { poolViews, aheadElsewhere, firstPast } from '../../lib/pools.ts';
import { AREA_BY_ID, CATEGORY_NAMES, SUB_BY_ID, LEVEL_BY_ID, SCORING_BY_ID, FORMAT_BY_ID, SECTION_NAMES, RANKED_BY_PEOPLE_OR_MATCHES } from '../../lib/taxonomy.ts';
import { leaderLine, lifeLine, setAsOf } from '../../lib/findings.ts';
import { monthYear, fullDate, humanDate, longMonthYear, proseDates, score as fmt, count, repoName, hostname, shortNum } from '../../lib/format.ts';
import githubJson from '../../../data/github.json';
import ClaimTable from '../../components/ClaimTable.astro';
import { claimsForBenchmark, claimStats } from '../../lib/claims.ts';
import type { ChangeKind } from '../../lib/types.ts';
import { SITE_NAME, CATALOG_ID } from '../../lib/site.ts';

export function getStaticPaths() {
  return benchmarks.map((b) => ({ params: { id: b.id } }));
}

setAsOf(AS_OF);
const { id } = Astro.params;
const s = benchSummary(id!);
const b = s.b;
const issues = issuesByBenchmark.get(b.id) ?? [];
// a chart the official leaderboard draws from more than its headline score (scripts/leaderboards/types.ts)
const boardChart = LEADERBOARDS[b.id]?.chart;
const boardChartRuns = boardChart
  ? [...leaderboardScores, ...unlistedScores]
      .filter((r) => r.benchmark === b.id)
      .map((r) => {
        const at = (k: string) => (k === 'score' ? r.value : k === 'cost' ? (r.cost ?? undefined) : k === 'tokens' ? (r.tokens ?? undefined) : r.metrics?.[k]);
        return { r, x: at(boardChart.x.key), y: at(boardChart.y.key) };
      })
      .filter((p): p is { r: (typeof p)['r']; x: number; y: number } => p.x !== undefined && p.y !== undefined && Number.isFinite(p.x) && Number.isFinite(p.y))
      .sort((p, q) => (boardChart.y.better === 'lower' ? p.y - q.y : q.y - p.y) || p.x - q.x)
  : [];
const chartNum = (v: number, unit?: string) => {
  const n = Math.abs(v) >= 1000 ? Math.round(v).toLocaleString('en-US') : String(Math.round(v * 100) / 100);
  return unit === '%' ? `${Math.round(v * 10) / 10}%` : unit === '$' || unit === 'usd' ? `$${n}` : unit ? `${n} ${unit}` : n;
};
const openIssues = unresolved(issues).length;
const myClaims = claimsForBenchmark(b.id);
const claimSum = claimStats(myClaims);
const CHANGE: Record<ChangeKind, string> = {
  regrade: 'Scores recomputed',
  grader: 'Grader changed',
  subset: 'Tasks changed',
  harness: 'Harness changed',
  scoring: 'Metric changed',
  questions: 'Questions corrected',
  policy: 'Leaderboard rules changed',
};
const changes = [...(b.changes ?? [])].reverse();
const changeDate = (d: string) => (d.length === 7 ? longMonthYear(`${d}-01`) : humanDate(d));
const unit = b.unit ?? '%';
const area = AREA_BY_ID.get(s.area)!;
const gh = (githubJson as Record<string, { stars?: number; archived?: boolean; license?: string | null; pushed?: string }>)[
  b.links?.repo ? repoName(b.links.repo) : ''
];
const STATUS: Record<string, string> = { 'in use': 'In use', fading: 'Fading', dropped: 'Dropped', 'system cards': 'Only in system cards', 'not in cards': 'Not in model cards' };
const WHY: Record<string, string> = { saturated: 'after it saturated', replaced: 'for a newer version', other: 'before it saturated' };
const succ = b.successor ? benchById.get(b.successor) : undefined;
const gap = untested(b.id);
const official = LEADERBOARDS[b.id];
// a board a third party runs, such as Vals AI's MATH-500 board, goes by its runner's name, not as the benchmark's own
const boardHost = official?.host;
const boardIs = boardHost ? `${boardHost}’s leaderboard` : 'the benchmark’s own leaderboard';
const SRC: Record<string, string> = { leaderboard: boardHost ? `on ${boardHost}’s leaderboard` : 'on its own leaderboard', epoch: 'in Epoch AI’s runs', collected: 'on a board Epoch AI copied', card: 'in lab cards', claim: 'in claims Epoch AI collected' };
const family = b.family ? benchmarks.filter((x) => x.family === b.family).sort((x, y) => (x.released ?? '').localeCompare(y.released ?? '')) : [];
const SHOW = 4;
// every run on the official board, by effort level and cost
const effort = effortView(b.id);
const runLabel = (r: { model: string; setting: string | null }) => `${modelById.get(r.model)?.name ?? r.model}${r.setting ? ` at ${r.setting}` : ''}`;
const costRatio = (k: number) => (Math.round(k) <= 2 ? 'about half the cost' : `${Math.round(k)} times cheaper`);
const effortRuns = effort ? [...effort.all].sort((x, y) => y.value - x.value) : [];
// The reign chart starts in 2023, or at the release month for a benchmark that came out later
const opened = b.released ? `${b.released.slice(0, 7)}-01` : '';
const reignFrom = opened > '2023-01-01' ? opened : '2023-01-01';
const reignRows = (['leaderboard', 'epoch', 'collected', 'card'] as const)
  .map((src) => reignRow(b.id, src))
  .filter((r): r is NonNullable<typeof r> => r !== null && r.reigns.some((g) => g.end > reignFrom));
const viaName = s.viaBoard[0] ? fromName(s.viaBoard[0]) : 'Another board';
const ROW_NAME: Record<string, string> = { leaderboard: boardHost ? `${boardHost} leaderboard` : 'Own leaderboard', epoch: 'Epoch AI runs', collected: `${viaName}, via Epoch AI`, card: 'Lab claims' };
const ROW_TEXT: Record<string, string> = {
  leaderboard: boardIs,
  epoch: 'Epoch AI’s runs',
  collected: `${viaName}, which Epoch AI copied`,
  card: 'what labs claim in their cards',
};
const reignNames = Object.fromEntries(reignRows.map((r) => [`${b.id}|${r.source}`, { name: ROW_NAME[r.source] }]));
// the pools the page can switch between: the source it leads with, every independent run, and claims too
const pools = poolViews(b.id, reignFrom);
const poolOn = pools.length > 1;
const ahead = aheadElsewhere(b.id, (v) => fmt(v, unit));
const past85 = firstPast(s, 85);
// where each pool's count of leaders comes from, for the chart's title
const POOL_WHERE: Record<string, string> = {
  headline: { leaderboard: boardHost ? `on ${boardHost}’s leaderboard` : 'on the official leaderboard', epoch: 'in Epoch AI’s runs', collected: `on ${viaName}`, card: 'in labs’ own numbers', claim: 'in collected claims' }[s.boardSource ?? 'card'] ?? '',
  independent: 'across all independent runs',
  all: 'with claims included',
};
// who each source's numbers come from, for the credit under each chart and in its downloaded file
const SRC_CREDIT: Record<string, string> = {
  leaderboard: boardHost ? `${boardHost}’s leaderboard` : `official ${b.name} leaderboard`,
  epoch: EPOCH_RUNS,
  collected: `${viaName}, via ${EPOCH_CREDIT}`,
  card: LAB_CARDS,
  claim: `claims collected by ${EPOCH_CREDIT}`,
};
// what a downloaded chart says about itself: the benchmark, its makers, what it tests and what the score is
const figDeck = benchDeck(b);
const figAxis = benchAxis(b);
const boardName = boardHost ? `${boardHost}’s leaderboard` : `the official ${b.name} leaderboard`;
const costNote = (per: 'task' | 'run') => `Cost is US dollars ${per === 'run' ? 'for the full run' : 'per task'}, as ${boardName} prices runs, so it compares only within this board.`;
const reignCounts = (rows: { source: string }[]) =>
  `One row for each source: ${listText(rows.map((r) => ROW_TEXT[r.source] ?? r.source))}. Each stretch is the model that held the best score at that time, colored by its lab. Lab claims count from the day the card came out, independent runs from the model’s release.`;
const boardCredit = (xs: { source?: string }[]) => creditLine([...new Set(xs.map((x) => x.source ?? 'card'))].map((k) => SRC_CREDIT[k]));
const listText = (xs: string[]) => (xs.length < 3 ? xs.join(' and ') : `${xs.slice(0, -1).join(', ')} and ${xs.at(-1)}`);
// all versions of the family, each handing over to the next
// each version's leader and close-out come from the source its own page leads with
const familyRows = family.length > 1 ? leaderRows(family.map((x) => x.id), 'headline', family.length) : [];
const familyStart = familyRows.map((r) => r.reigns[0].start).sort()[0] ?? '';
const familyFrom = familyStart > '2023-01-01' ? `${familyStart.slice(0, 7)}-01` : '2023-01-01';
const pred = benchmarks.filter((x) => x.successor === b.id);
const both = [s.leaderboardBoard, s.epochBoard, s.viaBoard, s.cardBoard, s.claimBoard].filter((x) => x.length).length > 1;
// the masthead: who leads now and since when, from the same source as the board below
const top = s.best ? modelById.get(s.best.model) : undefined;
const nowRow = s.boardSource ? reignRow(b.id, s.boardSource) : null;
const nowReign = nowRow?.reigns.at(-1);
const since = nowReign && s.best && nowReign.model === s.best.model ? nowReign.start : undefined;
// an entry the board ranks above every model we track (a fine-tune, agent system or product): named, never credited
const sign = b.better === 'lower' ? -1 : 1;
const topOther = s.shownSource === 'leaderboard' ? s.unlisted[0] : undefined;
// an arena whose only ratings come from labs' own posts: no leader, and a link to the live board
const arenaClaims = (s.shownSource === 'card' || s.shownSource === 'claim') && RANKED_BY_PEOPLE_OR_MATCHES.has(b.scoring ?? '');
const otherAhead = topOther && (!s.best || sign * topOther.value > sign * s.best.value) ? topOther : undefined;
const shownWhat = s.unlisted.length && s.shownSource === 'leaderboard' ? 'entries' : 'models';
const cat = b.category ?? 'other';
const catName = CATEGORY_NAMES[cat] ?? area.name;
// more in this category: one row per test (a family's newest version), in use first, then the most reported
const STATUS_ORDER: Record<string, number> = { 'in use': 0, fading: 1, 'system cards': 2, dropped: 3, 'not in cards': 4 };
const siblingsAll = allSummaries().filter((x) => (x.b.category ?? 'other') === cat && x.b.id !== b.id && (!b.family || x.b.family !== b.family) && (!x.b.family || familyOf(x.b.id).at(-1) === x.b.id));
const siblings = siblingsAll
  .slice()
  .sort((x, y) => (STATUS_ORDER[x.status] ?? 9) - (STATUS_ORDER[y.status] ?? 9) || y.cites.length - x.cites.length || y.nScores - x.nScores || x.b.name.localeCompare(y.b.name))
  .slice(0, 6);
type LinkKind = 'github' | 'code' | 'paper' | 'dataset' | 'leaderboard' | 'site';
const links = [
  b.links?.repo && {
    kind: /github\.com/.test(b.links.repo) ? 'github' : 'code',
    href: b.links.repo,
    label: /github\.com/.test(b.links.repo) ? repoName(b.links.repo) : 'Code',
    note: gh?.stars !== undefined ? `${gh.stars.toLocaleString('en-US')} stars` : hostname(b.links.repo).replace(/^github\.com$/, ''),
  },
  b.links?.paper && { kind: 'paper', href: b.links.paper, label: 'Paper', note: hostname(b.links.paper) },
  b.links?.dataset && { kind: 'dataset', href: b.links.dataset, label: 'Dataset', note: hostname(b.links.dataset) },
  b.links?.leaderboard && { kind: 'leaderboard', href: b.links.leaderboard, label: 'Leaderboard', note: hostname(b.links.leaderboard) },
  b.links?.site && { kind: 'site', href: b.links.site, label: hostname(b.links.site) },
].filter(Boolean) as { kind: LinkKind; href: string; label: string; note?: string }[];
// The strongest model with any score here, by its rank on the capability index (ECI). A benchmark that
// frontier models stopped running shows an older model here, well down the index.
const eciRank = new Map(eciOrder.map((m, i) => [m, i + 1]));
const strongest = [...new Set([...s.board, ...s.leaderboardBoard, ...s.epochBoard, ...s.cardBoard].map((x) => x.model))]
  .filter((m) => eciRank.has(m))
  .sort((x, y) => eciRank.get(x)! - eciRank.get(y)!)[0];
const strongestRank = strongest ? eciRank.get(strongest)! : 0;
const TASKS: Record<string, string> = { public: 'All public', 'public+private-holdout': 'Public, plus a private test set', private: 'Kept private' };
const level = b.level ? LEVEL_BY_ID.get(b.level) : undefined;
const scoring = b.scoring ? SCORING_BY_ID.get(b.scoring) : undefined;
const format = b.format ? FORMAT_BY_ID.get(b.format) : undefined;
const trail = [
  { href: '/benchmarks/', label: 'Benchmarks' },
  // Coding is both an area and its main category: one step, to the category page
  ...(catName === area.name ? [] : [{ href: `/benchmarks/?area=a:${s.area}`, label: area.name }]),
  { href: `/categories/${cat}/`, label: catName },
];
// search results and link previews lead with who is ahead, in the words of the leaderboard heading below, then
// what the benchmark tests
const metaLead = otherAhead ? `${otherAhead.name} tops the leaderboard with ${fmt(otherAhead.value, unit)}` : s.best ? leaderLine(s, gap?.last) : '';
const metaDescription = `${metaLead ? `${metaLead}. ` : ''}${b.description ?? `${b.name}: scores, leaderboard, and which model cards report it.`}`;
// schema.org Dataset, for Google Dataset Search: the benchmark's tasks, who made them, and where they live
const dataset = {
  '@type': 'Dataset',
  name: b.name,
  description: metaDescription,
  url: new URL(`/benchmarks/${b.id}/`, Astro.site).href,
  ...(b.org ? { creator: b.org.split(/\s*\+\s*/).map((name) => ({ '@type': 'Organization', name })) } : {}),
  ...(b.released ? { datePublished: b.released } : {}),
  ...(b.links?.paper ? { citation: b.links.paper } : {}),
  ...(() => {
    const same = [b.links?.site, b.links?.repo, b.links?.dataset, b.links?.leaderboard].filter((u): u is string => !!u);
    return same.length ? { sameAs: same } : {};
  })(),
  keywords: [...new Set(['AI benchmark', area.name, catName])],
  variableMeasured: { '@type': 'PropertyValue', name: 'Score', unitText: unit },
  includedInDataCatalog: { '@type': 'DataCatalog', '@id': new URL(`/${CATALOG_ID}`, Astro.site).href, name: SITE_NAME, url: new URL('/', Astro.site).href },
};
---

<Base title={b.name} description={metaDescription} crumbs={trail} jsonLd={dataset}>
  <div class:list={['page', poolOn && 'pools']}>
    <header class="head" style={`--a: var(--area-${s.area})`}>
      <Crumbs items={trail} />
      <h1 class="with-amark"><AreaMark area={s.area} size={20} />{b.name}</h1>
      <div class="mast">
        <div class="pool-headline">
          {otherAhead && (
            <span class="mast-lead">
              <ModelName id="" name={otherAhead.name} size={18} />
              <b class="num">{fmt(otherAhead.value, unit)}</b>
              <span class="muted">tops its leaderboard</span>
            </span>
          )}
          {s.best && top && (
            <span class="mast-lead">
              <ModelName id={s.best.model} size={18} />
              <b class="num">{fmt(s.best.value, unit)}</b>
              {otherAhead ? <span class="muted">leads the models we track</span> : since && <span class="muted">leads since {longMonthYear(since)}</span>}
            </span>
          )}
        </div>
        {pools.slice(1).map(
          (v) =>
            v.best && (
              <div class={`pool-${v.pool}`}>
                <span class="mast-lead">
                  <ModelName id={v.best.model} size={18} />
                  <b class="num">{fmt(v.best.value, unit)}</b>
                  <span class="muted">{v.since ? `leads since ${longMonthYear(v.since)}` : 'leads'}</span>
                </span>
              </div>
            ),
        )}
        {s.frontier.length >= 2 && <Spark points={s.frontier} unit={unit} better={b.better} color={`var(--area-${s.area})`} label={`Best score on ${b.name} over time`} />}
        <span class:list={['tag', `status-${s.status.replace(/ /g, '-')}`]}>
          <span class="dot" />
          <span class="sl">{STATUS[s.status]}</span>
        </span>
        {issues.length > 0 && (
          <a class="tag ki-flag" href="#issues">
            <svg width="13" height="13" viewBox="0 0 13 13" aria-hidden="true"><path d="M6.5 1.5l5.2 9.5H1.3z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" /><path d="M6.5 5.2v2.6M6.5 9.4v.1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /></svg>
            <span class="sl">{issues.length === 1 ? '1 known issue' : `${issues.length} known issues`}{openIssues === 0 ? ', fixed' : ''}</span>
          </a>
        )}
      </div>
      {
        poolOn && (
          <div class="pool-switch">
            <div class="seg" role="radiogroup" aria-label="Scores from">
              {pools.map((v, k) => (
                <label>
                  <input type="radio" name="pool" value={v.pool} checked={k === 0} />
                  {v.label}
                </label>
              ))}
            </div>
            <script is:inline>
              // before the page below paints: a link with ?pool= picks that pool, so nothing jumps
              (function () {
                var box = document.currentScript.parentElement;
                var q = new URLSearchParams(location.search).get('pool');
                var pick = (q === 'independent' || q === 'all') && box.querySelector('input[name="pool"][value="' + q + '"]');
                if (pick) pick.checked = true;
                box.addEventListener('change', function (e) {
                  var u = new URL(location.href);
                  if (e.target.value === 'headline') u.searchParams.delete('pool');
                  else u.searchParams.set('pool', e.target.value);
                  history.replaceState(history.state, '', u);
                });
              })();
            </script>
          </div>
        )
      }
      {
        ahead && (
          <div class="pool-headline">
            <p class="ahead">{ahead}</p>
          </div>
        )
      }
      {
        family.length > 1 && (
          <nav class="seg versions" aria-label="Versions">
            {family.map((v) => (
              <a href={`/benchmarks/${v.id}/`} aria-current={v.id === b.id ? 'page' : undefined}>
                {v.version ?? v.name}
                {v.released && <span class="vd"> {monthYear(v.released)}</span>}
              </a>
            ))}
          </nav>
        )
      }
      <div class="intro">
        <div class="prose">
          {b.description && <p class="lede">{proseDates(b.description)}</p>}
          {b.note && <p class="lede note">{proseDates(b.note)}</p>}
        </div>
        <div class="info">
          <dl class="kv">
            {b.org && (
              <div>
                <dt>Made by</dt>
                <dd>
                  {/* separator and name on one line: a line break between them renders as a space before the comma */}
                  {makerParts(b.org).map((p) => (
                    <>{p.sep}{p.lab && labPages.has(p.lab) ? <a class="mk" href={`/labs/${p.lab}/`}>{p.text}</a> : <a class="mk" href={`/benchmarks/?q=${encodeURIComponent(p.text.toLowerCase())}`} title={`Benchmarks made by ${p.text}`}>{p.text}</a>}</>
                  ))}
                </dd>
              </div>
            )}
            {b.released && (
              <div>
                <dt>Released</dt>
                <dd>{longMonthYear(b.released)}</dd>
              </div>
            )}
            {b.subcategory && SUB_BY_ID.get(b.subcategory) && (
              <div>
                <dt>Kind</dt>
                <dd>{SUB_BY_ID.get(b.subcategory)!.name}</dd>
              </div>
            )}
            {level && (
              <div>
                <dt>Level</dt>
                <dd><span class="hint" tabindex="0" data-tn={level.name} data-ts={level.who}>{level.name}</span></dd>
              </div>
            )}
            {scoring && (
              <div>
                <dt>Scored</dt>
                <dd><span class="hint" tabindex="0" data-tn={scoring.name} data-ts={scoring.how}>{scoring.name}</span></dd>
              </div>
            )}
            {format && (
              <div>
                <dt>Answers</dt>
                <dd>{format.note ? <span class="hint" tabindex="0" data-tn={format.name} data-ts={format.note}>{format.name}</span> : format.name}</dd>
              </div>
            )}
            {b.access && TASKS[b.access] && (
              <div>
                <dt>Tasks</dt>
                <dd>{TASKS[b.access]}</dd>
              </div>
            )}
          </dl>
          {
            (strongest || s.last || s.docCites.length > 0 || s.lastAdded || s.refreshed) && (
              <dl class="kv">
                {strongest && (
                  <div>
                    <dt>Strongest model tested</dt>
                    <dd class="st">
                      <ModelName id={strongest} size={15} />
                      <span class="muted">#{strongestRank} on the capability index</span>
                    </dd>
                  </div>
                )}
                {(s.last || s.docCites.length > 0) && (
                  <div>
                    <dt>{s.last ? 'Last in a launch post' : 'Last in a system card'}</dt>
                    <dd>
                      {longMonthYear(s.last ?? s.docCites.at(-1)!.card.date)}{s.why && <span class="muted">, dropped {WHY[s.why]}</span>}
                    </dd>
                  </div>
                )}
                {s.lastAdded && (
                  <div>
                    <dt>Last model added</dt>
                    <dd title={modelById.get(s.lastAdded.model)?.name ?? s.lastAdded.model}>{longMonthYear(s.lastAdded.date)}</dd>
                  </div>
                )}
                {s.refreshed && (
                  <div>
                    <dt>Scores refreshed</dt>
                    <dd>{humanDate(s.refreshed)}</dd>
                  </div>
                )}
              </dl>
            )
          }
          {
            links.length > 0 && (
              <ul class="links">
                {links.map((l) => (
                  <li>
                    <a href={l.href} rel="noopener">
                      <LinkIcon kind={l.kind} />
                      <span class="ll">{l.label}</span>
                      {l.note && <span class="muted">{l.note}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
        <div class="quote">
          <AuthorsWords id={b.id} />
        </div>
      </div>
    </header>

    <KnownIssues id={b.id} name={b.name} />

    {
      (s.shown.length > 0 || s.cites.length > 0 || s.docCites.length > 0) && (
        <div class="stats">
          {s.shown.length > 0 && (
            <div class="stat">
              <div class="v">{s.shown.length.toLocaleString('en-US')}</div>
              <div class="l">{shownWhat === 'entries' ? `Entries on ${boardHost ? `${boardHost}’s leaderboard` : 'its own leaderboard'}, ${count(s.board.length, 'model')} we track` : `${s.shown.length === 1 ? 'Model scored' : 'Models scored'} ${SRC[s.shownSource ?? 'card']}`}</div>
            </div>
          )}
          {s.cites.length > 0 && (
            <div class="stat">
              <div class="v">{s.cites.length}</div>
              <div class="l">{`${s.cites.length === 1 ? 'Launch post lists it' : 'Launch posts list it'}, from ${count(s.labs.length, 'lab')}`}</div>
            </div>
          )}
          {s.docCites.length > 0 && (
            <div class="stat">
              <div class="v">{s.docCites.length}</div>
              <div class="l">{`${s.docCites.length === 1 ? 'System card reports it' : 'System cards report it'}, from ${count(s.docLabs.length, 'lab')}`}</div>
            </div>
          )}
        </div>
      )
    }

    {
      s.shown.length === 0 && (
        <section class="none">
          <div class="sh">
            <h2>No scores here yet</h2>
            <p>
              {b.links?.leaderboard
                ? (unreadWhy(b.links.leaderboard) ?? `We have no scores for ${b.name} yet.`)
                : `No lab, leaderboard or Epoch AI run has reported a score for ${b.name} yet.`}
            </p>
          </div>
          {b.links?.leaderboard && (
            <a class="live" href={b.links.leaderboard}>
              See the live leaderboard on {host(b.links.leaderboard)}
              <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 8.5l5-5M4.5 3.5h4v4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
          )}
        </section>
      )
    }

    {
      s.shown.length > 0 && (
        <section class="views">
          <div class="sh-row">
            <div class="sh">
              <div class="pool-headline">
                <h2>{otherAhead ? `${otherAhead.name} tops the leaderboard with ${fmt(otherAhead.value, unit)}` : leaderLine(s, gap?.last)}</h2>
                <p>
                  {s.shownSource === 'leaderboard' ? (
                    <>
                      Best score per {shownWhat === 'entries' ? 'entry' : 'model'} from {boardHost ? <a href={official?.url}>{boardHost}’s leaderboard</a> : <>the benchmark's <a href={official?.url}>own leaderboard</a></>}, read on {humanDate(official?.retrieved)}. Where a model ran with several settings or harnesses, we keep its best.{effort && ' Every run is in the next chart.'}
                      {shownWhat === 'entries' && ` Names in gray aren't in our model list: fine-tunes, agent systems, products and older models. They don't count toward leaders.`}
                      {otherAhead && s.best && ` The best model we track is ${modelById.get(s.best.model)?.name ?? s.best.model}, at ${fmt(s.best.value, unit)}.`}
                    </>
                  ) : s.boardSource === 'epoch' ? (
                    'Best score per model from Epoch AI’s own runs. Where a model ran with several settings or harnesses, we keep its best.'
                  ) : s.boardSource === 'collected' ? (
                    `Best score per model from ${viaName}, as Epoch AI copied it. We don’t read that board ourselves yet. Where a model ran with several settings, we keep its best.`
                  ) : s.boardSource === 'claim' ? (
                    'Best score per model from claims Epoch AI collected out of labs’ reports and papers. Nobody independent has run this benchmark, so these show what was claimed, not who leads.'
                  ) : (
                    <>
                      Best score per model as labs report them in their own cards. Labs pick their own settings, so these compare less cleanly than independent runs.
                      {arenaClaims && (
                        <>
                          {' '}A rating ranks a model only against others rated in the same arena at the same time, so these don’t show who leads.{' '}
                          {unreadWhy(b.links?.leaderboard) ?? ''}{' '}
                          {b.links?.leaderboard && <a href={b.links.leaderboard}>See the live leaderboard on {host(b.links.leaderboard)}</a>}
                        </>
                      )}
                    </>
                  )}
                </p>
              </div>
              {pools.slice(1).map((v) => (
                <div class={`pool-${v.pool}`}>
                  <h2>{v.best ? `${modelById.get(v.best.model)?.name ?? v.best.model} leads with ${fmt(v.best.value, unit)}${v.pool === 'all' ? ', claims included' : ' across all independent runs'}` : 'No scores yet'}</h2>
                  <p>
                    {v.pool === 'independent'
                      ? `Best score per model across ${boardHost ? `${boardHost}’s leaderboard` : 'the official leaderboard'}, Epoch AI’s own runs and any board Epoch AI copied. Each bar and row names its source.`
                      : 'Best score per model from every source, including labs’ own numbers and claims Epoch AI collected from reports and papers. Labs pick their own settings, so a claim can beat an independent run of the same model.'}
                  </p>
                </div>
              ))}
            </div>
            <div class="seg" role="radiogroup" aria-label="View">
              <label><input type="radio" name="v-board" value="graph" checked />Bars</label>
              <label><input type="radio" name="v-board" value="table" />Table</label>
            </div>
          </div>
          <div class="pool-headline">
            {gap && (
              <div class="gap">
                <p>
                  The newest model with a score here came out in {longMonthYear(gap.last)}, and nobody has {s.boardSource === 'card' ? 'reported' : 'tested'} a newer one. Among the {gap.top} highest-ranked models on the capability index, these have no score yet:
                </p>
                <ul>
                  {gap.newer.slice(0, SHOW).map((m) => (
                    <li>
                      <ModelName id={m} size={15} />
                    </li>
                  ))}
                  {gap.missing.length > SHOW && <li class="more-n">and {gap.missing.length - SHOW} more</li>}
                </ul>
                {gap.claimed.length > 0 && <p class="claimed">{gap.claimed.length === 1 ? 'One of them reports a score in its own model card' : `${gap.claimed.length} of them report scores in their own model cards`}. We plot lab claims in the charts below.</p>}
              </div>
            )}
          </div>
          <div class="view-graph">
            <div class="pool-headline">
              <ChartDownload subject={b.name} credit={boardCredit(s.shown)} name="leaderboard" deck={figDeck} yAxis={figAxis} counts={`Each model’s best score ${POOL_WHERE.headline}, one bar per model.`} leaves="Other settings of the same model, which keep only their best score.">
                {b.better === 'lower' ? (
                  <BarBoard scores={s.shown} unit={unit} limit={15} better={b.better} all />
                ) : (
                  <>
                    <div class="only-wide"><Columns scores={s.shown} unit={unit} /></div>
                    <div class="only-narrow"><BarBoard scores={s.shown} unit={unit} limit={10} all /></div>
                  </>
                )}
              </ChartDownload>
            </div>
            {pools.slice(1).map((v) => (
              <div class={`pool-${v.pool}`}>
                <ChartDownload subject={b.name} credit={boardCredit(v.board)} name={`leaderboard-${v.pool}`} deck={figDeck} yAxis={figAxis} counts={`Each model’s best score ${POOL_WHERE[v.pool]}, one bar per model.`} leaves={v.pool === 'independent' ? 'Labs’ own numbers, and other settings of the same model.' : 'Other settings of the same model, which keep only their best score.'}>
                  {b.better === 'lower' ? (
                    <BarBoard scores={v.board} unit={unit} limit={15} better={b.better} all />
                  ) : (
                    <>
                      <div class="only-wide"><Columns scores={v.board} unit={unit} /></div>
                      <div class="only-narrow"><BarBoard scores={v.board} unit={unit} limit={10} all /></div>
                    </>
                  )}
                </ChartDownload>
              </div>
            ))}
          </div>
          <div class="view-table table-wrap">
            <div class="pool-headline">
              <table class="t" data-sort>
                <thead>
                  <tr><th>#</th><th>{shownWhat === 'entries' ? 'Entry' : 'Model'}</th><th class="r">Score</th><th>Setting</th><th>Date</th><th>Source</th></tr>
                </thead>
                <tbody>
                  {s.shown.map((x, i) => (
                    <tr>
                      <td class="rank">{i + 1}</td>
                      <td><ModelName id={x.model} name={x.name} /></td>
                      <td class="r">{fmt(x.value, unit)}</td>
                      <td class="muted">{[x.setting, x.harness].filter((v) => v && v !== 'unknown').join(', ')}</td>
                      <td class="muted num">{monthYear(x.date)}</td>
                      <td class="muted">{sourceLabel(x)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {pools.slice(1).map((v) => (
              <div class={`pool-${v.pool}`}>
                <table class="t" data-sort>
                  <thead>
                    <tr><th>#</th><th>Model</th><th class="r">Score</th><th>Setting</th><th>Date</th><th>Source</th></tr>
                  </thead>
                  <tbody>
                    {v.board.map((x, i) => (
                      <tr>
                        <td class="rank">{i + 1}</td>
                        <td><ModelName id={x.model} name={x.name} /></td>
                        <td class="r">{fmt(x.value, unit)}</td>
                        <td class="muted">{[x.setting, x.harness].filter((w) => w && w !== 'unknown').join(', ')}</td>
                        <td class="muted num">{monthYear(x.date)}</td>
                        <td class="muted">{sourceLabel(x)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ))}
          </div>
          {both && (
            <div class="pool-headline">
              <p class="also">
                {[
                  s.shownSource !== 'leaderboard' && s.leaderboardBoard.length + s.unlisted.length
                    ? `${boardHost ? `${boardHost}’s leaderboard` : "The benchmark's own leaderboard"} has ${s.unlisted.length ? `${count(s.leaderboardBoard.length + s.unlisted.length, 'entry', 'entries')}, ${s.leaderboardBoard.length} of them models we track` : count(s.leaderboardBoard.length, 'model')}.`
                    : '',
                  s.boardSource !== 'epoch' && s.epochBoard.length ? `Epoch AI has run ${count(s.epochBoard.length, 'model')}.` : '',
                  s.boardSource !== 'collected' && s.viaBoard.length ? `Epoch AI copied scores for ${count(s.viaBoard.length, 'model')} from ${viaName}.` : '',
                  s.boardSource !== 'card' && s.cardBoard.length ? `Labs report scores for ${count(s.cardBoard.length, 'model')} in their cards.` : '',
                  s.boardSource !== 'claim' && s.claimBoard.length ? `Epoch AI collected claims for ${count(s.claimBoard.length, 'model')} from labs’ reports and papers.` : '',
                ]
                  .filter(Boolean)
                  .join(' ')}{' '}
                {poolOn ? 'Switch the scores above to rank them together.' : 'We plot every source in the charts below.'}
              </p>
            </div>
          )}
        </section>
      )
    }

    {
      boardChart && boardChartRuns.length >= 4 && (
        <section class="views">
          <div class="sh-row">
            <div class="sh">
              <h2>{boardChart.title}</h2>
              <p>
                {boardChart.note && `${boardChart.note} `}
                The line joins the runs that no other run beats on both measures. We redrew this chart from the numbers on {boardHost ? <a href={LEADERBOARDS[b.id].url}>{boardHost}’s leaderboard</a> : <>the <a href={LEADERBOARDS[b.id].url}>official leaderboard</a></>}.
              </p>
            </div>
            <div class="seg" role="radiogroup" aria-label="View">
              <label><input type="radio" name="v-board" value="graph" checked />Chart</label>
              <label><input type="radio" name="v-board" value="table" />Table</label>
            </div>
          </div>
          <div class="view-graph">
            <ChartDownload subject={b.name} credit={creditLine([SRC_CREDIT.leaderboard])} quiet deck={`${figDeck} ${boardChart.x.unit === '$' || boardChart.x.key === 'cost' ? costNote(official?.costPer === 'run' ? 'run' : 'task') : ''}`} counts="The runs on the board that report both measures. The line joins the runs that no other run beats on both." leaves="Runs that report only one of the two measures.">
              <BoardChart benchmark={b.id} chart={boardChart} label={`${b.name}: ${boardChart.title}`} />
            </ChartDownload>
          </div>
          <div class="view-table table-wrap">
            <table class="t" data-sort>
              <thead>
                <tr><th>Model</th><th>Setting</th><th class="r">{boardChart.y.label}</th><th class="r">{boardChart.x.label}</th></tr>
              </thead>
              <tbody>
                {boardChartRuns.map(({ r, x, y }) => (
                  <tr>
                    <td>{r.model ? <ModelName id={r.model} /> : <span class="muted">{r.name}</span>}</td>
                    <td class="muted">{[r.setting, r.harness].filter(Boolean).join(', ')}</td>
                    <td class="r" data-v={String(y)}>{chartNum(y, boardChart.y.unit)}</td>
                    <td class="r muted" data-v={String(x)}>{chartNum(x, boardChart.x.unit)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    {
      effort && (
        <section class="views">
          <div class="sh-row">
            <div class="sh">
              <h2>
                {effort.mode === 'cost' && effort.top
                  ? effort.top.value >= Math.max(...effortRuns.map((r) => r.value))
                    ? `The best score, ${fmt(effort.top.value, unit)}, costs ${usd(effort.top.cost!)} ${costUnit(effort.costPer)}`
                    : `Of runs with a cost, the best scores ${fmt(effort.top.value, unit)} for ${usd(effort.top.cost!)} ${costUnit(effort.costPer)}`
                  : effort.gain !== undefined && effort.gain >= 1
                    ? `More effort adds a median ${Math.round(effort.gain)} ${unit === '%' ? 'points' : unit}`
                    : 'Scores at each effort level'}
              </h2>
              <p>
                {effort.mode === 'cost' ? (
                  <>
                    Runs on the cost frontier score higher than any run that's cheaper.
                    {effort.cheap && effort.top && ` ${runLabel(effort.cheap)} comes within ${(effort.top.value - effort.cheap.value).toFixed(1).replace(/\.0$/, '')}${unit === '%' ? ' points' : ''} of the best for ${usd(effort.cheap.cost!)} ${costUnit(effort.costPer)}, ${costRatio(effort.top.cost! / effort.cheap.cost!)}.`}
                    {' '}The costs are the leaderboard's own estimates, so compare them only within this benchmark.
                  </>
                ) : (
                  `Models the leaderboard ran at two or more effort levels. We don’t have enough cost data here to say what the extra effort costs.`
                )}
              </p>
            </div>
            <div class="seg" role="radiogroup" aria-label="View">
              <label><input type="radio" name="v-effort" value="graph" checked />Chart</label>
              <label><input type="radio" name="v-effort" value="table" />Table</label>
            </div>
          </div>
          <div class="view-graph">
            <ChartDownload
              subject={b.name}
              credit={creditLine([SRC_CREDIT.leaderboard])}
              deck={`${figDeck}${effort.mode === 'cost' ? ` ${costNote(effort.costPer)}` : ''}`}
              yAxis={effort.mode === 'cost' ? figAxis : undefined}
              xAxis={effort.mode === 'cost' ? undefined : figAxis}
              counts={effort.mode === 'cost' ? 'Runs on the leaderboard with a cost. The step line is the cost frontier: runs that score higher than any cheaper run.' : 'Models the leaderboard ran at two or more effort levels, one dot per level from lightest to darkest.'}
              leaves={effort.mode === 'cost' ? 'Runs without a cost.' : 'Models run at only one effort level.'}
            >
            <EffortChart view={effort} label={`${b.name}: scores by effort level${effort.mode === 'cost' ? (effort.costPer === 'run' ? ' and cost of the full run' : ' and cost per task') : ''}`} />
            </ChartDownload>
          </div>
          <div class="view-table table-wrap">
            <table class="t" data-sort>
              <thead>
                <tr><th>Model</th><th>Effort</th><th>Harness</th><th class="r">Score</th><th class="r">{effort.costPer === 'run' ? 'Cost of the full run' : 'Cost per task'}</th><th class="r">Output tokens</th></tr>
              </thead>
              <tbody>
                {effortRuns.map((r) => (
                  <tr>
                    <td><ModelName id={r.model} /></td>
                    <td class="muted">{r.setting ?? ''}</td>
                    <td class="muted">{r.harness ?? ''}</td>
                    <td class="r">{fmt(r.value, unit)}</td>
                    <td class="r muted">{r.cost !== null ? usd(r.cost) : ''}</td>
                    <td class="r muted">{r.tokens !== null ? r.tokens.toLocaleString('en-US') : ''}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    {
      reignRows.length > 0 && (
        <section>
          <div class="sh">
            <h2>
              {pools.map((v) => (
                <span class={`pool-${v.pool}`}>
                  {v.holders > 1
                    ? `${v.holders} models have held number one ${POOL_WHERE[v.pool]} since ${reignFrom === opened ? `its release in ${longMonthYear(opened)}` : '2023'}`
                    : 'Number one over time'}
                </span>
              ))}
            </h2>
            <p>
              Lab claims count from the day the card came out, independent runs from the model’s release.
              {reignRows.length > 1 && ` We draw one row each for ${listText(reignRows.map((r) => ROW_TEXT[r.source]))}.`}
            </p>
          </div>
          <ChartDownload subject={b.name} credit={sourcesCredit(reignRows, SRC_CREDIT)} name="number-one-over-time" deck={figDeck} counts={reignCounts(reignRows)} leaves="Models with no score here from these sources, and any score that never beat the best so far.">
            <ReignChart rows={reignRows} names={reignNames} from={reignFrom} />
          </ChartDownload>
        </section>
      )
    }

    {
      s.nScores > 0 && (
        <section>
          <div class="sh">
            <h2>{past85 ? `${past85.who[0].toUpperCase()}${past85.who.slice(1)} passed 85% in ${longMonthYear(past85.date)}` : 'Scores over time'}</h2>
            <p>All the scores we have, one dot each, so a model tested at several settings appears more than once.</p>
          </div>
          <ScoreChart s={s} />
        </section>
      )
    }

    <section>
      <div class="sh">
        <h2>{lifeLine(s)}</h2>
        <p>
          {s.cites.length > 0
            ? 'Launch posts from every lab that has listed it, one tick per post. Tall colored ticks include it, and short gray ones leave it out.'
            : `We read the headline results of ${cards.length} launch posts from ${new Set(cards.map((c) => c.lab)).size} labs, and none of them list this benchmark.${s.docCites.length ? ' Some system cards do, below.' : ''}`}
        </p>
      </div>
      {s.cites.length > 0 && <CardTicks citing={new Set(s.cites.map((c) => c.card.id))} labs={s.labs} />}
      {
        s.cites.length > 0 && (
          <div class="table-wrap cites">
            <table class="t" data-sort>
              <thead>
                <tr><th>Date</th><th>Launch post</th><th class="r">Score</th><th>As the post writes it</th></tr>
              </thead>
              <tbody>
                {s.cites.slice().reverse().map((c) => (
                  <tr>
                    <td class="muted num nowrap">{fullDate(c.card.date)}</td>
                    <td><a class="card-l" href={c.card.url ?? `/cards/#${c.card.id}`}><LabMark lab={c.card.lab} size={15} />{modelById.get(c.card.model)?.name}</a></td>
                    <td class="r">{c.score !== null ? shortNum(c.score) : ''}</td>
                    <td class="muted">{c.asWritten}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </section>

    {
      s.docCites.length > 0 && (
        <section>
          <div class="sh">
            <h2>
              {s.docCites.length === 1
                ? 'One system card reports it'
                : `${s.docCites.length} system cards report it, from ${count(s.docLabs.length, 'lab')}`}
            </h2>
            <p>
              Besides launch posts, we read the system cards, model cards and technical reports labs publish with a release. They report far more, including safety and frontier-risk tests.
            </p>
          </div>
          <div class="table-wrap cites">
            <table class="t" data-sort>
              <thead>
                <tr><th>Date</th><th>Document</th><th class="r">Score</th><th>As the document writes it</th><th>Section</th></tr>
              </thead>
              <tbody>
                {s.docCites.slice().reverse().map((c) => (
                  <tr>
                    <td class="muted num nowrap">{fullDate(c.card.date)}</td>
                    <td class="docc">
                      <a class="card-l" href={c.card.url ?? `/cards/#${c.card.id}`}>
                        <LabMark lab={c.card.lab} size={15} />
                        {modelById.get(c.card.model)?.name}
                      </a>
                      <span class="muted doc">{c.card.doc ?? 'system card'}</span>
                    </td>
                    <td class="r">{c.score !== null ? shortNum(c.score) : ''}</td>
                    <td class="muted">{c.asWritten}</td>
                    <td class="muted nowrap">{c.section ? (SECTION_NAMES[c.section] ?? c.section) : ''}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    {
      myClaims.length > 0 && (
        <section>
          <div class="sh">
            <h2>
              {myClaims.length === 1
                ? "One lab claim next to the leaderboard"
                : claimSum.labHigher + claimSum.labLower > 1
                  ? `The lab's number comes out ahead in ${claimSum.labHigher} of ${claimSum.labHigher + claimSum.labLower} pairs that differ`
                  : `${myClaims.length} lab claims next to the leaderboard`}
            </h2>
            <p>
              Each score a lab reported for its own model, beside the same model's best score {s.leaderboardBoard.length ? 'on the leaderboard' : 'from Epoch AI'}. Gaps mostly come from different harnesses, effort levels and task subsets.{claimSum.same > 0 && ` ${claimSum.same} of them match, which usually means one side copied the other.`} <a href="/claims/">Every benchmark</a>.
            </p>
          </div>
          <ClaimTable pairs={myClaims} benchmark={false} />
        </section>
      )
    }

    {
      changes.length > 0 && (
        <section>
          <div class="sh">
            <h2>{changes.length === 1 ? 'One logged change that moves scores' : `${changes.length} logged changes that move scores`}</h2>
            <p>Changes by the maintainers, so a score from before a change may not compare with one from after it. Newest first, each with the maintainers' own source. The list may be incomplete. <a href="/methodology/#changes">What we log</a>.</p>
          </div>
          <ol class="changes">
            {changes.map((c) => (
              <li>
                <div class="ch-h">
                  <span class="ch-k">{CHANGE[c.kind]}</span>
                  <span class="ch-d muted num">{changeDate(c.date)}</span>
                </div>
                <p>{c.text} <a href={c.url}>Source</a></p>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      (succ || pred.length > 0 || familyRows.length > 1) && (
        <section>
          <div class="sh">
            <h2>Versions</h2>
            {familyRows.length > 1 && (
              <p>
                We switch the top row to each new version when it comes out. Open it for one row per version. An
                old version stays in play while people still test it, so whoever first takes it past 85% gets
                credit for closing it out.
              </p>
            )}
          </div>
          {familyRows.length > 1 && (
            <ChartDownload subject={b.name} credit={sourcesCredit(familyRows)} name="versions" deck={`${figDeck} One row per version of the test.`} counts="Each version from the one source its own page leads with: its official leaderboard when that is current, else Epoch AI’s own runs, else labs’ own numbers. The top row switches to each new version when it comes out." leaves="Versions with too few scores to rank.">
              <ReignChart rows={familyRows} from={familyFrom} open />
            </ChartDownload>
          )}
          <div class="ver">
            {pred.map((p) => (
              <a href={`/benchmarks/${p.id}/`}>
                <span class="muted">Replaces</span> {p.name}
              </a>
            ))}
            {succ && (
              <a href={`/benchmarks/${succ.id}/`}>
                <span class="muted">Replaced by</span> {succ.name}
              </a>
            )}
          </div>
        </section>
      )
    }

    {
      siblings.length > 0 && (
        <section class="sibs">
          <div class="sh-row">
            <div class="sh">
              <h2>More in {catName}</h2>
            </div>
            <a class="more" href={`/categories/${cat}/`}>All {siblingsAll.length + 1} in {catName}</a>
          </div>
          <ul class="sib-list">
            {siblings.map((x) => {
              const xt = x.best ? modelById.get(x.best.model) : undefined;
              return (
                <li>
                  <a class="sib-n" href={`/benchmarks/${x.b.id}/`}>{x.b.name}</a>
                  <span class:list={['tag', `status-${x.status.replace(/ /g, '-')}`]}>
                    <span class="dot" />
                    <span class="sl">{STATUS[x.status]}</span>
                  </span>
                  {x.b.description && <span class="sib-d">{x.b.description}</span>}
                  {x.best && xt && (
                    <span class="sib-b">
                      <LabMark lab={xt.lab} size={14} />
                      <span>{xt.name}</span>
                      <b class="mono">{fmt(x.best.value, x.b.unit ?? '%')}</b>
                    </span>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      )
    }
  </div>
</Base>

