---
import Base from '../../layouts/Base.astro';
import ScoreChart from '../../components/ScoreChart.astro';
import BarBoard from '../../components/BarBoard.astro';
import Columns from '../../components/Columns.astro';
import CardTicks from '../../components/CardTicks.astro';
import ReignChart from '../../components/ReignChart.astro';
import { reignRow } from '../../lib/reigns.ts';
import { leaderRows } from '../../lib/leaders.ts';
import { effortView, usd } from '../../lib/effort.ts';
import EffortChart from '../../components/EffortChart.astro';
import { untested } from '../../lib/coverage.ts';
import ModelName from '../../components/ModelName.astro';
import LabMark from '../../components/LabMark.astro';
import { benchmarks, benchSummary, benchById, cards, AS_OF, modelById, LEADERBOARDS } from '../../lib/data.ts';
import { AREA_BY_ID, CATEGORY_NAMES, SUB_BY_ID, LEVEL_BY_ID, SCORING_BY_ID, FORMAT_BY_ID, SECTION_NAMES } from '../../lib/taxonomy.ts';
import { leaderLine, lifeLine, setAsOf } from '../../lib/findings.ts';
import { monthYear, fullDate, score as fmt, count, repoName, hostname } from '../../lib/format.ts';
import githubJson from '../../../data/github.json';

export function getStaticPaths() {
  return benchmarks.map((b) => ({ params: { id: b.id } }));
}

setAsOf(AS_OF);
const { id } = Astro.params;
const s = benchSummary(id!);
const b = s.b;
const unit = b.unit ?? '%';
const area = AREA_BY_ID.get(s.area)!;
const gh = (githubJson as Record<string, { stars?: number; archived?: boolean; license?: string | null; pushed?: string }>)[
  b.links?.repo ? repoName(b.links.repo) : ''
];
const STATUS: Record<string, string> = { 'in use': 'In use', fading: 'Fading', dropped: 'Dropped', 'system cards': 'Only in system cards', 'not in cards': 'Not in model cards' };
const WHY: Record<string, string> = { saturated: 'after it saturated', replaced: 'for a newer version', other: 'before it saturated' };
const ACCESS: Record<string, string> = {
  public: 'All tasks public',
  'public+private-holdout': 'Public tasks plus a private test set',
  private: 'Tasks kept private',
};
const succ = b.successor ? benchById.get(b.successor) : undefined;
const gap = untested(b.id);
const official = LEADERBOARDS[b.id];
const SRC: Record<string, string> = { leaderboard: 'on its own leaderboard', epoch: 'in Epoch AI data', card: 'in lab cards' };
const family = b.family ? benchmarks.filter((x) => x.family === b.family).sort((x, y) => (x.released ?? '').localeCompare(y.released ?? '')) : [];
const SHOW = 4;
// every run on the official board, by effort level and cost
const effort = effortView(b.id);
const runLabel = (r: { model: string; setting: string | null }) => `${modelById.get(r.model)?.name ?? r.model}${r.setting ? ` at ${r.setting}` : ''}`;
const costRatio = (k: number) => (Math.round(k) <= 2 ? 'about half the cost' : `${Math.round(k)} times less`);
const effortRuns = effort ? [...effort.all].sort((x, y) => y.value - x.value) : [];
// The reign chart starts in 2023, or at the release month for a benchmark that came out later
const opened = b.released ? `${b.released.slice(0, 7)}-01` : '';
const reignFrom = opened > '2023-01-01' ? opened : '2023-01-01';
const reignRows = (['leaderboard', 'epoch', 'card'] as const)
  .map((src) => reignRow(b.id, src))
  .filter((r): r is NonNullable<typeof r> => r !== null && r.reigns.some((g) => g.end > reignFrom));
const ROW_NAME = { leaderboard: 'Own leaderboard', epoch: 'Epoch AI runs', card: 'Lab claims' } as const;
const ROW_TEXT = { leaderboard: 'its own leaderboard', epoch: 'Epoch AI’s runs', card: 'the scores labs claim in their cards' } as const;
const reignNames = Object.fromEntries(reignRows.map((r) => [`${b.id}|${r.source}`, { name: ROW_NAME[r.source] }]));
const holders = reignRows[0] ? new Set(reignRows[0].reigns.filter((g) => g.end > reignFrom).map((g) => g.model)).size : 0;
const listText = (xs: string[]) => (xs.length < 3 ? xs.join(' and ') : `${xs.slice(0, -1).join(', ')} and ${xs.at(-1)}`);
// all versions of the family, each handing over to the next
const familyRows = family.length > 1 ? leaderRows(family.map((x) => x.id), 'best', family.length) : [];
const familyStart = familyRows.map((r) => r.reigns[0].start).sort()[0] ?? '';
const familyFrom = familyStart > '2023-01-01' ? `${familyStart.slice(0, 7)}-01` : '2023-01-01';
const pred = benchmarks.filter((x) => x.successor === b.id);
const both = [s.leaderboardBoard, s.epochBoard, s.cardBoard].filter((x) => x.length).length > 1;
const links = [
  b.links?.repo && { href: b.links.repo, label: gh?.stars !== undefined ? `${repoName(b.links.repo)}` : 'Code', note: gh?.stars !== undefined ? `${gh.stars.toLocaleString('en-US')} stars` : undefined },
  b.links?.paper && { href: b.links.paper, label: 'Paper' },
  b.links?.dataset && { href: b.links.dataset, label: 'Dataset' },
  b.links?.leaderboard && { href: b.links.leaderboard, label: 'Leaderboard' },
  b.links?.site && { href: b.links.site, label: hostname(b.links.site) },
].filter(Boolean) as { href: string; label: string; note?: string }[];
---

<Base title={b.name} description={b.description ?? `${b.name}: scores, leaderboard, and which model cards report it.`}>
  <div class="page">
    <header class="head">
      <h1>{b.name}</h1>
      {
        family.length > 1 && (
          <nav class="seg versions" aria-label="Versions">
            {family.map((v) => (
              <a href={`/benchmarks/${v.id}/`} aria-current={v.id === b.id ? 'page' : undefined}>
                {v.version ?? v.name}
                {v.released && <span class="vd"> {monthYear(v.released)}</span>}
              </a>
            ))}
          </nav>
        )
      }
      {b.description && <p class="lede">{b.description}</p>}
      {b.note && <p class="lede note">{b.note}</p>}
      <div class="facts">
        {b.org && <span>Made by <b>{b.org}</b></span>}
        {b.released && <span>Released <b>{monthYear(b.released)}</b></span>}
        <span><a href={`/categories/${b.category ?? 'other'}/`}>{CATEGORY_NAMES[b.category ?? 'other'] ?? area.name}</a>{b.subcategory && SUB_BY_ID.get(b.subcategory) && <>, {SUB_BY_ID.get(b.subcategory)!.name.toLowerCase()}</>}</span>
        {b.access && ACCESS[b.access] && <span>{ACCESS[b.access]}</span>}
      </div>
      {
        (b.level || b.scoring || b.format) && (
          <dl class="how">
            {b.level && LEVEL_BY_ID.get(b.level) && (
              <div>
                <dt>Level</dt>
                <dd>
                  <b>{LEVEL_BY_ID.get(b.level)!.name}</b>
                  <span>{LEVEL_BY_ID.get(b.level)!.who}</span>
                </dd>
              </div>
            )}
            {b.scoring && SCORING_BY_ID.get(b.scoring) && (
              <div>
                <dt>Scored</dt>
                <dd>
                  <b>{SCORING_BY_ID.get(b.scoring)!.name}</b>
                  <span>{SCORING_BY_ID.get(b.scoring)!.how}</span>
                </dd>
              </div>
            )}
            {b.format && FORMAT_BY_ID.get(b.format) && (
              <div>
                <dt>Answers</dt>
                <dd>
                  <b>{FORMAT_BY_ID.get(b.format)!.name}</b>
                  {FORMAT_BY_ID.get(b.format)!.note && <span>{FORMAT_BY_ID.get(b.format)!.note}</span>}
                </dd>
              </div>
            )}
          </dl>
        )
      }
      {
        links.length > 0 && (
          <div class="links">
            {links.map((l) => (
              <a href={l.href} rel="noopener">
                {l.label}
                {l.note && <span class="muted"> {l.note}</span>}
                <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                  <path d="M3 1h6v6M9 1 1 9" fill="none" stroke="currentColor" stroke-width="1.3" />
                </svg>
              </a>
            ))}
          </div>
        )
      }
    </header>

    {
      (s.board.length > 0 || s.cites.length > 0 || s.docCites.length > 0) && (
        <div class="stats">
          {s.best && (
            <div class="stat">
              <div class="v">{fmt(s.best.value, unit)}</div>
              <div class="l">
                Best score, by <a href={`/models/${s.best.model}/`}>{modelById.get(s.best.model)?.name}</a>
              </div>
            </div>
          )}
          {s.board.length > 0 && (
            <div class="stat">
              <div class="v">{s.board.length}</div>
              <div class="l">{`${s.board.length === 1 ? 'Model scored' : 'Models scored'} ${SRC[s.boardSource ?? 'card']}`}</div>
            </div>
          )}
          {s.cites.length > 0 && (
            <div class="stat">
              <div class="v">{s.cites.length}</div>
              <div class="l">{`${s.cites.length === 1 ? 'Launch post lists it' : 'Launch posts list it'}, from ${count(s.labs.length, 'lab')}`}</div>
            </div>
          )}
          {s.docCites.length > 0 && (
            <div class="stat">
              <div class="v">{s.docCites.length}</div>
              <div class="l">{`${s.docCites.length === 1 ? 'System card reports it' : 'System cards report it'}, from ${count(s.docLabs.length, 'lab')}`}</div>
            </div>
          )}
          <div class="stat">
            <div class="v">
              <span class:list={['tag big', `status-${s.status.replace(/ /g, '-')}`]}>
                <span class="dot" />
                {STATUS[s.status]}
              </span>
            </div>
            <div class="l">
              {s.why
                ? `Dropped ${WHY[s.why]}`
                : s.last
                  ? `Last in a launch post ${monthYear(s.last)}`
                  : s.docCites.length
                    ? `Last in a system card ${monthYear(s.docCites.at(-1)!.card.date)}`
                    : b.epoch
                      ? 'Tracked by Epoch AI'
                      : 'Not in a model card yet'}
            </div>
          </div>
        </div>
      )
    }

    {
      s.board.length > 0 && (
        <section class="views">
          <div class="sh-row">
            <div class="sh">
              <h2>{leaderLine(s, gap?.last)}</h2>
              <p>
                {s.boardSource === 'leaderboard' ? (
                  <>
                    Best score per model on the benchmark's <a href={official?.url}>own leaderboard</a>, read {fullDate(official?.retrieved)}. Each model keeps its best setting and harness.{effort && ' The next chart shows every setting.'}
                  </>
                ) : s.boardSource === 'epoch' ? (
                  'Best score per model in Epoch AI data. Each model keeps its best setting and harness.'
                ) : (
                  'Best score per model as labs report them in their own cards. Labs pick their own settings, so these compare less cleanly than independent runs.'
                )}
              </p>
            </div>
            <div class="seg" role="radiogroup" aria-label="View">
              <label><input type="radio" name="v-board" value="graph" checked />Bars</label>
              <label><input type="radio" name="v-board" value="table" />Table</label>
            </div>
          </div>
          {gap && (
            <div class="gap">
              <p>
                Newer models have not been {s.boardSource === 'card' ? 'reported here' : 'tested here'}. The newest model with a score came out in {monthYear(gap.last)}. Not yet {s.boardSource === 'card' ? 'reported' : 'tested'}, among the {gap.top} highest-ranked models on the capability index:
              </p>
              <ul>
                {gap.newer.slice(0, SHOW).map((m) => (
                  <li>
                    <ModelName id={m} size={15} />
                  </li>
                ))}
                {gap.missing.length > SHOW && <li class="more-n">and {gap.missing.length - SHOW} more</li>}
              </ul>
              {gap.claimed.length > 0 && <p class="claimed">{gap.claimed.length === 1 ? 'One of them reports' : `${gap.claimed.length} of them report`} a score in its own model card. Those claims appear in the chart below.</p>}
            </div>
          )}
          <div class="view-graph">
            {b.better === 'lower' ? (
              <BarBoard scores={s.board} unit={unit} limit={15} better={b.better} />
            ) : (
              <>
                <div class="only-wide"><Columns scores={s.board} unit={unit} limit={15} /></div>
                <div class="only-narrow"><BarBoard scores={s.board} unit={unit} limit={10} /></div>
              </>
            )}
          </div>
          <div class="view-table table-wrap">
            <table class="t">
              <thead>
                <tr><th>#</th><th>Model</th><th class="r">Score</th><th>Setting</th><th>Date</th><th>Source</th></tr>
              </thead>
              <tbody>
                {s.board.map((x, i) => (
                  <tr>
                    <td class="rank">{i + 1}</td>
                    <td><ModelName id={x.model} /></td>
                    <td class="r">{fmt(x.value, unit)}</td>
                    <td class="muted">{[x.setting, x.harness].filter((v) => v && v !== 'unknown').join(', ')}</td>
                    <td class="muted num">{monthYear(x.date)}</td>
                    <td class="muted">{x.source === 'leaderboard' ? 'Official leaderboard' : x.source === 'epoch' ? 'Epoch AI' : 'Model card'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {both && (
            <p class="also">
              {[
                s.boardSource !== 'leaderboard' && s.leaderboardBoard.length ? `The benchmark's own leaderboard has ${count(s.leaderboardBoard.length, 'model')}.` : '',
                s.boardSource !== 'epoch' && s.epochBoard.length ? `Epoch AI has scores for ${count(s.epochBoard.length, 'model')}.` : '',
                s.boardSource !== 'card' && s.cardBoard.length ? `Labs report scores for ${count(s.cardBoard.length, 'model')} in their cards.` : '',
              ]
                .filter(Boolean)
                .join(' ')}{' '}
              Both appear in the chart below.
            </p>
          )}
        </section>
      )
    }

    {
      effort && (
        <section class="views">
          <div class="sh-row">
            <div class="sh">
              <h2>
                {effort.mode === 'cost' && effort.top
                  ? effort.top.value >= Math.max(...effortRuns.map((r) => r.value))
                    ? `The best score, ${fmt(effort.top.value, unit)}, costs ${usd(effort.top.cost!)} a task`
                    : `Of runs with a cost, the best scores ${fmt(effort.top.value, unit)} for ${usd(effort.top.cost!)} a task`
                  : effort.gain !== undefined && effort.gain >= 1
                    ? `More effort adds a median ${Math.round(effort.gain)} ${unit === '%' ? 'points' : unit}`
                    : 'Scores at each effort level'}
              </h2>
              <p>
                {effort.mode === 'cost' ? (
                  <>
                    Each line joins one model's runs at its effort levels, from cheapest to most expensive. The step line is the cost frontier: no run scores higher for less money.
                    {effort.cheap && effort.top && ` ${runLabel(effort.cheap)} comes within ${(effort.top.value - effort.cheap.value).toFixed(1).replace(/\.0$/, '')}${unit === '%' ? ' points' : ''} of it for ${usd(effort.cheap.cost!)} a task, ${costRatio(effort.top.cost! / effort.cheap.cost!)}.`}
                    {' '}Costs are the board's own estimates, so they compare only within this benchmark.
                  </>
                ) : (
                  `Each row is one model at every effort level the board ran, from the lowest effort (light) to the highest (dark). The board does not report cost, so this shows what more effort buys, not what it costs.`
                )}
              </p>
            </div>
            <div class="seg" role="radiogroup" aria-label="View">
              <label><input type="radio" name="v-effort" value="graph" checked />Chart</label>
              <label><input type="radio" name="v-effort" value="table" />Table</label>
            </div>
          </div>
          <div class="view-graph">
            <EffortChart view={effort} label={`${b.name}: scores by effort level${effort.mode === 'cost' ? ' and cost per task' : ''}`} />
          </div>
          <div class="view-table table-wrap">
            <table class="t">
              <thead>
                <tr><th>Model</th><th>Effort</th><th>Harness</th><th class="r">Score</th><th class="r">Cost per task</th><th class="r">Output tokens</th></tr>
              </thead>
              <tbody>
                {effortRuns.map((r) => (
                  <tr>
                    <td><ModelName id={r.model} /></td>
                    <td class="muted">{r.setting ?? ''}</td>
                    <td class="muted">{r.harness ?? ''}</td>
                    <td class="r">{fmt(r.value, unit)}</td>
                    <td class="r muted">{r.cost !== null ? usd(r.cost) : ''}</td>
                    <td class="r muted">{r.tokens !== null ? r.tokens.toLocaleString('en-US') : ''}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    {
      reignRows.length > 0 && (
        <section>
          <div class="sh">
            <h2>
              {holders > 1
                ? `${holders} models have held number one since ${reignFrom === opened ? `its release in ${monthYear(opened)}` : '2023'}`
                : 'Number one over time'}
            </h2>
            <p>
              Each stretch is a model that had the best score, in its lab’s colour. The height is the score.
              {reignRows.length > 1 && ` From top to bottom, the rows use ${listText(reignRows.map((r) => ROW_TEXT[r.source]))}.`}
            </p>
          </div>
          <ReignChart rows={reignRows} names={reignNames} from={reignFrom} />
        </section>
      )
    }

    {
      s.nScores > 0 && (
        <section>
          <div class="sh">
            <h2>{s.saturatedAt ? `The best score passed ${85}% in ${monthYear(s.saturatedAt)}` : 'Scores over time'}</h2>
            <p>Each dot is one model's score, placed at the model's release date. The line follows the best score so far.</p>
          </div>
          <ScoreChart s={s} />
        </section>
      )
    }

    <section>
      <div class="sh">
        <h2>{lifeLine(s)}</h2>
        <p>
          {s.cites.length > 0
            ? 'Each tick is a launch post. Tall coloured ticks list this benchmark. Short grey ticks are launch posts from the same lab that leave it out.'
            : `The almanac tracks the headline results of ${cards.length} launch posts from ${new Set(cards.map((c) => c.lab)).size} labs. None of them list this benchmark.${s.docCites.length ? ' System cards do, below.' : ''}`}
        </p>
      </div>
      {s.cites.length > 0 && <CardTicks citing={new Set(s.cites.map((c) => c.card.id))} labs={s.labs} />}
      {
        s.cites.length > 0 && (
          <div class="table-wrap cites">
            <table class="t">
              <thead>
                <tr><th>Date</th><th>Launch post</th><th class="r">Score</th><th>As the post writes it</th></tr>
              </thead>
              <tbody>
                {s.cites.slice().reverse().map((c) => (
                  <tr>
                    <td class="muted num nowrap">{fullDate(c.card.date)}</td>
                    <td><a class="card-l" href={c.card.url ?? `/cards/#${c.card.id}`}><LabMark lab={c.card.lab} size={15} />{modelById.get(c.card.model)?.name}</a></td>
                    <td class="r">{c.score !== null ? c.score : ''}</td>
                    <td class="muted">{c.asWritten}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </section>

    {
      s.docCites.length > 0 && (
        <section>
          <div class="sh">
            <h2>
              {s.docCites.length === 1
                ? 'One system card reports it'
                : `${s.docCites.length} system cards report it, from ${count(s.docLabs.length, 'lab')}`}
            </h2>
            <p>
              System cards, model cards and technical reports are the long documents a lab publishes with a release. They report far more than the launch post, including safety and frontier-risk tests.
            </p>
          </div>
          <div class="table-wrap cites">
            <table class="t">
              <thead>
                <tr><th>Date</th><th>Document</th><th class="r">Score</th><th>As the document writes it</th><th>Section</th></tr>
              </thead>
              <tbody>
                {s.docCites.slice().reverse().map((c) => (
                  <tr>
                    <td class="muted num nowrap">{fullDate(c.card.date)}</td>
                    <td>
                      <a class="card-l" href={c.card.url ?? `/cards/#${c.card.id}`}>
                        <LabMark lab={c.card.lab} size={15} />
                        {modelById.get(c.card.model)?.name}
                        <span class="muted doc">{c.card.doc ?? 'system card'}</span>
                      </a>
                    </td>
                    <td class="r">{c.score !== null ? c.score : ''}</td>
                    <td class="muted">{c.asWritten}</td>
                    <td class="muted nowrap">{c.section ? (SECTION_NAMES[c.section] ?? c.section) : ''}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    {
      (succ || pred.length > 0 || familyRows.length > 1) && (
        <section>
          <div class="sh">
            <h2>Versions</h2>
            {familyRows.length > 1 && (
              <p>
                Each version keeps its own number one until the next version comes out. After that, its clock stops,
                so an old leader does not hold the top spot forever.
              </p>
            )}
          </div>
          {familyRows.length > 1 && <ReignChart rows={familyRows} from={familyFrom} />}
          <div class="ver">
            {pred.map((p) => (
              <a href={`/benchmarks/${p.id}/`}>
                <span class="muted">Replaces</span> {p.name}
              </a>
            ))}
            {succ && (
              <a href={`/benchmarks/${succ.id}/`}>
                <span class="muted">Replaced by</span> {succ.name}
              </a>
            )}
          </div>
        </section>
      )
    }
  </div>
</Base>

<style>
  .versions {
    margin-top: 18px;
    flex-wrap: wrap;
    max-width: 100%;
  }
  .vd {
    color: var(--ink-4);
    font-weight: 400;
  }
  @media (max-width: 640px) {
    .vd {
      display: none;
    }
  }
  .note {
    font-size: 16px;
    color: var(--ink-3);
    margin-top: 10px;
  }
  .how {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px 32px;
    margin: 28px 0 0;
    max-width: 980px;
  }
  .how dt {
    font-size: 12.5px;
    color: var(--ink-3);
  }
  .how dd {
    margin: 4px 0 0;
    font-size: 14px;
    line-height: 1.45;
  }
  .how dd b {
    display: block;
    font-weight: 500;
  }
  .how dd span {
    color: var(--ink-3);
    font-size: 13px;
  }
  @media (max-width: 720px) {
    .how {
      grid-template-columns: 1fr;
    }
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 14px;
    text-decoration: none;
    background: var(--panel);
    padding: 8px 12px;
    border-radius: 8px;
    transition: background-color 140ms ease;
  }
  .links a:hover {
    background: var(--line);
  }
  .links svg {
    color: var(--ink-3);
  }
  .big {
    font-size: 26px;
    color: var(--ink);
    gap: 12px;
  }
  .big .dot {
    width: 11px;
    height: 11px;
  }
  .status-in-use .dot {
    color: var(--status-good);
  }
