---
import { ECI_DECK, ECI_AXIS, SRI_DECK, RELEASE_AXIS, POOL_NOTES, CLOCK_NOTE } from '../lib/figure-text.ts';
import ChartDownload from '../components/ChartDownload.astro';
import { creditLine, sourcesCredit, LAUNCH_POSTS } from '../lib/credits.ts';
import Base from '../layouts/Base.astro';
import ModelCard from '../components/ModelCard.astro';
import MiniBoard from '../components/MiniBoard.astro';
import AreaShare from '../components/AreaShare.astro';
import Lifecycle from '../components/Lifecycle.astro';
import HeroArt from '../components/HeroArt.astro';
import AreaMark from '../components/AreaMark.astro';
import SearchBox from '../components/SearchBox.astro';
import { AREAS, areaOf } from '../lib/taxonomy.ts';
import ReignChart from '../components/ReignChart.astro';
import { mostReportedRows } from '../lib/leaders.ts';
import { POOL_LABEL } from '../lib/pools.ts';
import { allSummaries, benchmarks, cards, eciOrder, AS_OF, monthsBetween, SATURATED, benchById } from '../lib/data.ts';
import { humanDate } from '../lib/format.ts';
import Criteria from '../components/Criteria.astro';
import { REPO, SUBMIT_FORM } from '../lib/criteria.ts';
import { SITE_NAME, SITE_DESCRIPTION, CATALOG_ID } from '../lib/site.ts';
import discoveredJson from '../../data/discovered.json';

const all = allSummaries();
// the saturation claim counts established benchmarks only: five or more model cards
const est = all.filter((s) => s.cites.length >= 5);
const estDropped = est.filter((s) => s.status === 'dropped');
const estSat = estDropped.filter((s) => s.why === 'saturated').length;

// leaderboards to watch: labs headline them now and nobody has passed 85%
const watch = all
  .filter((s) => s.status === 'in use' && s.board.length >= 5 && (s.b.unit ?? '%') === '%' && (s.best?.value ?? 100) < SATURATED && s.b.better !== 'lower')
  .map((s) => ({ s, recent: s.cites.filter((c) => monthsBetween(c.card.date, AS_OF) < 6).length }))
  .sort((a, b) => b.recent - a.recent || b.s.board.length - a.s.board.length)
  .slice(0, 6)
  .map((x) => x.s);

// the ways to help, for the last section
const CONTRIBUTE = [
  { t: 'Suggest a benchmark', d: 'Send it through the submission form, with a link to its paper, code or leaderboard.', href: SUBMIT_FORM },
  { t: 'Add a score or fix a record', d: 'The Contribute page lists open tasks. Each one opens a form that names what’s missing.', href: '/contribute/' },
  { t: 'Point us at your results', d: 'If you made a benchmark, tell us where its results live and we’ll import them.', href: `${REPO}/issues/new?template=maintainer.yml` },
  { t: 'Send code', d: 'New leaderboard importers and fixes go straight to a pull request.', href: REPO },
];
const WORDS = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'];

// rise and retirement: the 36 benchmarks the most cards report
const life = all
  .filter((s) => s.cites.length >= 4)
  .sort((a, b) => b.cites.length - a.cites.length)
  .slice(0, 36)
  .map((s) => s.b.id);

interface Find {
  name: string;
  title: string;
  url: string;
  first: string;
  org?: string;
  decision: string;
}
// who held number one on the tests the most model releases reported over the last year
const crown = mostReportedRows(AS_OF);
// three views, as on /leaders/: each benchmark from the one source its page leads with (the default), every
// independent run, and every score with claims included
const crownViews = [
  { pool: 'headline', label: 'One source per benchmark', rows: crown.headline },
  { pool: 'independent', label: POOL_LABEL.independent, rows: crown.independent },
  { pool: 'all', label: POOL_LABEL.all, rows: crown.all },
] as const;
const crownRows = crown.headline;
// what the downloaded charts say about what they count
const crownFigure = (pool: string, rows: { source: string }[]) => ({
  credit: sourcesCredit(rows),
  name: `number-one-${pool}`,
  deckFrom: '@lede',
  counts: `One row per benchmark. Each colored stretch is the model with the best score at the time. ${POOL_NOTES[pool].counts}`,
  leaves: POOL_NOTES[pool].leaves,
});
const lifeFigure = {
  credit: creditLine([LAUNCH_POSTS]),
  name: 'benchmark-lifecycles',
  deckFrom: '@lede',
  counts: 'Every launch post that shows a score on each benchmark, one tick per post.',
  leaves: 'System cards and leaderboard scores.',
};
const topTest = crown.tests.length ? (benchById.get(crown.tests[0].fam)?.name ?? crown.tests[0].fam) : '';
const n = (v: number) => v.toLocaleString('en-US');
// the hero's area chips: how many benchmarks each area holds
const areaCounts = AREAS.filter((a) => a.id !== 'other').map((a) => ({ id: a.id, name: a.name, n: benchmarks.filter((b) => areaOf(b.category) === a.id).length }));
// the hero's pill: benchmarks added in the last 30 days, else the newest releases
const monthAgo = new Date(Date.parse(AS_OF) - 30 * 864e5).toISOString().slice(0, 10);
// newest additions first, then the ones labs already report, so the pill names benchmarks people know
const citesOf = new Map<string, number>();
for (const c of cards) for (const r of c.results) citesOf.set(r.benchmark, (citesOf.get(r.benchmark) ?? 0) + 1);
const byAdded = benchmarks
  .filter((b) => b.added && b.added >= monthAgo && b.access !== 'private')
  .sort((a, b) => b.added!.localeCompare(a.added!) || (citesOf.get(b.id) ?? 0) - (citesOf.get(a.id) ?? 0) || (b.released ?? '').localeCompare(a.released ?? ''));
const fresh = byAdded.length
  ? byAdded
  : benchmarks.filter((b) => b.released && b.released >= monthAgo.slice(0, 7) && b.access !== 'private').sort((a, b) => b.released!.localeCompare(a.released!));
const discovered = (discoveredJson as unknown as { items: Find[] }).items.filter((d) => d.decision === 'catalog').slice(0, 6);
// schema.org: the site, and the catalog every benchmark page's Dataset names as its home (CATALOG_ID)
const home = new URL('/', Astro.site).href;
const website = {
  '@type': 'WebSite',
  '@id': `${home}#website`,
  name: SITE_NAME,
  alternateName: new URL(home).hostname,
  url: home,
  description: SITE_DESCRIPTION,
  inLanguage: 'en',
};
const catalog = {
  '@type': 'DataCatalog',
  '@id': `${home}${CATALOG_ID}`,
  name: SITE_NAME,
  url: home,
  description: SITE_DESCRIPTION,
  inLanguage: 'en',
  isPartOf: { '@id': `${home}#website` },
  keywords: ['AI benchmarks', 'LLM leaderboards', 'model cards', 'AI evaluation'],
  dateModified: AS_OF,
};
---

<Base jsonLd={[website, catalog]} film="ridge">
  <div class="page">
    <header class="hero">
      <HeroArt />
      <div class="hero-in">
        {
          fresh.length > 0 && (
            <a class="pill" href="/new/">
              <span class="pill-k">New</span>
              <span class="pill-t">
                {fresh.slice(0, 2).map((b) => b.name).join(', ')}
                {fresh.length > 2 && ` and ${(fresh.length - 2).toLocaleString('en-US')} more`}
              </span>
              <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M5 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </a>
          )
        }
        <h1>Benchmark Almanac</h1>
        <p class="hero-lede">
          {SITE_DESCRIPTION}
        </p>
        <SearchBox id="search-list" main preload label="Search benchmarks" />
        <nav class="chips" aria-label="Benchmarks by area">
          {
            areaCounts.map((a) => (
              <a class="chip" href={`/benchmarks/?area=a:${a.id}`} data-area={a.id}>
                <AreaMark area={a.id} size={10} />
                {a.name}
                <span class="n num">{a.n}</span>
              </a>
            ))
          }
        </nav>
        <p class="art-key">Click on any of the benchmarks to open them!</p>
      </div>
    </header>

    <section>
      <div class="sh-row">
        <div class="sh">
          <h2>Catching the frontier</h2>
          <p>We rank models based on Epoch AI's Capabilities Index, an aggregate score from many benchmarks.</p>
        </div>
        <a class="more" href="/models/">All models</a>
      </div>
      <div class="grid3">
        {eciOrder.slice(0, 6).map((id) => <ModelCard id={id} />)}
      </div>
    </section>

    {
      crownRows.length > 0 && (
        <section class="pools">
          <div class="sh-row">
            <div class="sh">
              <h2>Who is dominating the leaderboards?</h2>
              <p>
                We track the {crown.tests.length} most-cited benchmarks in model releases in the past year. {topTest} was the most cited, featured in {n(crown.tests[0].n)} releases.
              </p>
            </div>
            <div class="crown-tools">
              <div class="seg" role="radiogroup" aria-label="Scores from">
                {crownViews.map((v, k) => (
                  <label>
                    <input type="radio" name="pool" value={v.pool} checked={k === 0} />
                    {v.label}
                  </label>
                ))}
              </div>
              <a class="more" href="/leaders/">Every category</a>
            </div>
          </div>
          {crownViews.map((v) => (
            <div class={`pool-${v.pool}`}>
              <ChartDownload {...crownFigure(v.pool, v.rows)}>
                <ReignChart rows={v.rows} levels={false} />
              </ChartDownload>
            </div>
          ))}
        </section>
      )
    }

    <section>
      <div class="sh-row">
        <div class="sh">
          <h2>Leaderboards to watch</h2>
          <p>Here are the {WORDS[watch.length] ?? watch.length} most popular benchmarks that haven't yet saturated (score &gt;{SATURATED}%).</p>
        </div>
        <a class="more" href="/benchmarks/?status=in-use">All benchmarks in use</a>
      </div>
      <div class="grid3 boards">
        {watch.map((s) => <MiniBoard s={s} />)}
      </div>
    </section>

    <section>
      <AreaShare heading pair title="What do labs feature the most?" more={{ href: '/cards/', label: 'All model cards' }} />
      <AreaShare heading pair catalog hidden title="What do new benchmarks test?" more={{ href: '/benchmarks/', label: 'All benchmarks' }} />
    </section>

    <section>
      <div class="sh">
        <h2>{estSat * 2 > estDropped.length ? 'Labs mostly drop a benchmark after it saturates' : 'Saturation is one reason labs drop a benchmark'}</h2>
        <p>
          {estDropped.length} benchmarks appeared in five or more launch posts and then went a year without one. Labs dropped {estSat} of them after the best score passed {SATURATED}%.
          Below are the {life.length} benchmarks launch posts list most often, in the order labs took them up. Each tick is a post.
        </p>
      </div>
      <ChartDownload {...lifeFigure}>
        <Lifecycle ids={life} />
      </ChartDownload>
    </section>

    {
      discovered.length > 0 && (
        <section>
          <div class="sh-row">
            <div class="sh">
              <h2>Found this week</h2>
              <p>New benchmarks our discovery job found in paper feeds, newsletters and registries. They're queued for the catalog.</p>
            </div>
            <a class="more" href="/new/">Everything new</a>
          </div>
          <ul class="new">
            {discovered.map((d) => (
              <li>
                <a href={d.url}>{d.name}</a>
                <span class="muted">{[d.org, `found ${humanDate(d.first)}`].filter(Boolean).join(', ')}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section id="what-gets-in">
      <div class="sh-row">
        <div class="sh">
          <h2>What gets in</h2>
          <p>We add a benchmark if anyone can run it again and it passes at least one of these four tests.</p>
        </div>
        <a class="more" href="/about/#cataloged">How we decide</a>
      </div>
      <Criteria />
      <p class="muted fine">Test sets made only for one paper’s own method, training datasets and renamed copies stay out. The <a href="/new/">New page</a> lists every find we left out, with the reason.</p>
    </section>

    <section id="contribute">
      <div class="sh-row">
        <div class="sh">
          <h2>How to contribute</h2>
          <p>The almanac is open source. Every change goes through GitHub, and a maintainer checks its source before it lands.</p>
        </div>
        <a class="more" href="/contribute/">Open tasks</a>
      </div>
      <ul class="ways">
        {CONTRIBUTE.map((w) => (
          <li>
            <a href={w.href}>{w.t}</a>
            <span>{w.d}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  /* the last section: the ways to help, two to a row like the four tests above it */
  .ways {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px 40px;
    margin: 20px 0 0;
    padding: 0;
  }
  .ways li {
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 16px 0 18px;
  }
  .ways a {
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
    text-underline-offset: 3px;
  }
  .ways span {
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.5;
  }
  .fine {
    margin: 0;
    font-size: 14px;
  }
  @media (max-width: 640px) {
    .ways {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* hero: a centered title over a drawing of the data, a search box and the eight areas */
  /* the drawing bleeds to the window edges, so main clips it sideways (clip, not hidden, keeps sticky and dropdowns working) */
  :global(main) {
    overflow-x: clip;
  }
  /* z-index 2 keeps the search suggestions over the sections below: their masked lab marks make layers of their own */
  .hero {
    position: relative;
    z-index: 2;
    isolation: isolate;
    padding: 56px 0 150px;
    text-align: center;
  }
  .hero-in {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero :global(.hero-art) {
    height: 58%;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    max-width: 100%;
    padding: 5px 12px 5px 5px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--panel-2);
    color: var(--ink-2);
    font-size: 13.5px;
    text-decoration: none;
    transition: background-color 140ms ease, border-color 140ms ease;
  }
  .pill:hover {
    background: var(--hover);
    border-color: var(--ink-4);
  }
  .pill-k {
    padding: 2px 9px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-size: 12px;
    font-weight: 500;
  }
  .pill-t {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .hero h1 {
    margin-top: 28px;
    max-width: 20ch;
    font-size: clamp(42px, 6.6vw, 84px);
    line-height: 0.98;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }
  .hero h1 em {
    font-style: italic;
  }
  .crown-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 22px;
  }
  .hero-lede {
    margin-top: 22px;
    max-width: 60ch;
    font-size: 18px;
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    max-width: 860px;
    margin-top: 22px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 13px 7px 11px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    color: var(--ink);
    font-size: 14px;
    text-decoration: none;
    transition: border-color 140ms ease, background-color 140ms ease;
  }
  .chip:hover,
  .chip:focus-visible {
    border-color: var(--ink-4);
  }
  .chip .n {
    color: var(--ink-3);
    font-size: 13px;
  }
  /* pointing at an area brings its lines forward in the drawing */
  .hero:has(.chip:hover, .chip:focus-visible) :global(.hero-art path) {
    stroke-opacity: 0.08;
  }
  .hero:has(.chip[data-area='knowledge']:is(:hover, :focus-visible)) :global(.hero-art path[data-a='knowledge']),
  .hero:has(.chip[data-area='reasoning']:is(:hover, :focus-visible)) :global(.hero-art path[data-a='reasoning']),
  .hero:has(.chip[data-area='code']:is(:hover, :focus-visible)) :global(.hero-art path[data-a='code']),
  .hero:has(.chip[data-area='agents']:is(:hover, :focus-visible)) :global(.hero-art path[data-a='agents']),
  .hero:has(.chip[data-area='work']:is(:hover, :focus-visible)) :global(.hero-art path[data-a='work']),
  .hero:has(.chip[data-area='multimodal']:is(:hover, :focus-visible)) :global(.hero-art path[data-a='multimodal']),
  .hero:has(.chip[data-area='safety']:is(:hover, :focus-visible)) :global(.hero-art path[data-a='safety']) {
    stroke-opacity: 0.85;
  }
  .hero-facts {
    justify-content: center;
    margin-top: 26px;
  }
  .art-key {
    position: absolute;
    bottom: -100px;
    right: 0;
    max-width: 34ch;
    color: var(--ink-3);
    font-size: 12px;
    line-height: 1.45;
    text-align: right;
  }
  @media (max-width: 720px) {
    .hero {
      padding: 32px 0 96px;
    }
    .hero h1 br {
      display: none;
    }
    .hero-lede {
      font-size: 16.5px;
    }
    .chip {
      font-size: 13.5px;
      padding: 6px 11px 6px 9px;
    }
    .art-key {
      position: static;
      margin-top: 20px;
      text-align: center;
    }
  }
  .grid3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .boards {
    gap: 56px 48px;
  }
  .more {
    font-size: 14px;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .new {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
  }
  .new li {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  @media (max-width: 1000px) {
    .grid3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 720px) {
    .grid3 {
      grid-template-columns: 1fr;
    }
  }
</style>
