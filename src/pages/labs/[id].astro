---
import { ECI_DECK, ECI_AXIS, SRI_DECK, RELEASE_AXIS, POOL_NOTES, CLOCK_NOTE } from '../../lib/figure-text.ts';
import ChartDownload from '../../components/ChartDownload.astro';
import { creditLine, ECI_CREDIT } from '../../lib/credits.ts';
import Base from '../../layouts/Base.astro';
import LabMark from '../../components/LabMark.astro';
import ModelCard from '../../components/ModelCard.astro';
import ModelName from '../../components/ModelName.astro';
import TimeScatter, { type Pt } from '../../components/TimeScatter.astro';
import AreaShare from '../../components/AreaShare.astro';
import Crumbs from '../../components/Crumbs.astro';
import Spark from '../../components/Spark.astro';
import { labs, featuredModels, labPages, models, cards, eciByModel, benchById } from '../../lib/data.ts';
import { monthYear, fullDate, yearFrac } from '../../lib/format.ts';
import { labColor } from '../../lib/palette.ts';
import { yearTicks, yearLines } from '../../lib/scale.ts';

export function getStaticPaths() {
  return labs.filter((l) => labPages.has(l.id)).map((l) => ({ params: { id: l.id } }));
}

const { id } = Astro.params;
const lab = labs.find((l) => l.id === id)!;
const ms = featuredModels.filter((m) => m.lab === id).sort((a, b) => (b.released ?? '').localeCompare(a.released ?? ''));
const cs = cards.filter((c) => c.lab === id);
const ranked = ms.filter((m) => eciByModel.has(m.id)).sort((a, b) => eciByModel.get(b.id)!.eci - eciByModel.get(a.id)!.eci);
const pts: Pt[] = models
  .filter((m) => eciByModel.has(m.id) && m.released)
  .map((m) => ({ date: m.released!, value: eciByModel.get(m.id)!.eci, model: m.id, source: 'epoch' as const }));
const mine = ms.map((m) => m.id);
// the lab's best index score over time: each release that beat its own earlier best
const bestRun: { date: string; value: number }[] = [];
for (const m of [...ranked].sort((a, b) => (a.released ?? '').localeCompare(b.released ?? ''))) {
  const v = eciByModel.get(m.id)!.eci;
  if (m.released && (!bestRun.length || v > bestRun.at(-1)!.value)) bestRun.push({ date: m.released, value: v });
}

// the benchmarks this lab's cards report, as rows of ticks over its cards
const counts = new Map<string, number>();
for (const c of cs) for (const r of c.results) counts.set(r.benchmark, (counts.get(r.benchmark) ?? 0) + 1);
const rows = [...counts.entries()]
  .filter(([, n]) => n >= 2)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 28)
  .map(([b]) => ({ b: benchById.get(b)!, on: new Set(cs.filter((c) => c.results.some((r) => r.benchmark === b)).map((c) => c.id)) }))
  .sort((a, b) => {
    const first = (x: typeof a) => cs.find((c) => x.on.has(c.id))!.date;
    return first(a).localeCompare(first(b));
  });
const t0 = cs.length ? yearFrac(cs[0].date) - 0.1 : 2023;
const t1 = cs.length ? yearFrac(cs.at(-1)!.date) + 0.1 : 2027;
const pos = (d: string) => `${(((yearFrac(d) - t0) / (t1 - t0)) * 100).toFixed(2)}%`;
const color = labColor(id);
const years = yearTicks(t0, t1);
const grid = `--yl:${yearLines(years.map((y) => pos(`${y}-01-01`)))}`;
---

<Base title={lab.name} description={`${lab.name}: its models, their scores, and what its model cards measure.`} film="index" crumbs={[{ href: '/labs/', label: 'Labs' }]}>
  <div class="page">
    <header class="head" style={`--lc:${color}`}>
      <Crumbs items={[{ href: '/labs/', label: 'Labs' }]} />
      <h1 class="with-mark"><LabMark lab={lab.id} size={44} />{lab.name}</h1>
      {
        ranked[0] && (
          <div class="mast">
            <span>Best on the Capabilities Index</span>
            <a href={`/models/${ranked[0].id}/`}>{ranked[0].name}</a>
            <b class="num">{eciByModel.get(ranked[0].id)!.eci.toFixed(1)}</b>
            {bestRun.length >= 2 && <Spark points={bestRun} unit="index" color={color} label={`${lab.name}'s best index score over time`} />}
          </div>
        )
      }
      <div class="facts">
        <span><b>{ms.length}</b> models</span>
        <span><b>{cs.length}</b> model cards read</span>
        {lab.url && <a href={lab.url}>{lab.url.replace(/^https?:\/\/(www\.)?/, '')}</a>}
      </div>
    </header>

    {
      ranked.length > 0 && (
        <section>
          <div class="sh">
            <h2>{lab.name}'s models against the field</h2>
            <p>Every model on the Epoch Capabilities Index by release date, with {lab.name}'s in color.</p>
          </div>
          <ChartDownload credit={creditLine([ECI_CREDIT])} deck={`${lab.name}’s models in color, against every other model on the index. ${ECI_DECK}`} yAxis={ECI_AXIS} xAxis={RELEASE_AXIS} counts="Every model with an Epoch Capabilities Index score, at its release date." leaves="Models Epoch AI hasn’t scored.">
          <TimeScatter points={pts} unit="index" label={`${lab.name} on the Epoch Capabilities Index`} highlight={mine} labelIds={ranked.slice(0, 8).map((m) => m.id)} legend={false} height={420} />
          </ChartDownload>
        </section>
      )
    }

    {
      ranked.length > 0 && (
        <section>
          <div class="sh">
            <h2>Its strongest models</h2>
          </div>
          <div class="cards">
            {ranked.slice(0, 6).map((m) => <ModelCard id={m.id} />)}
          </div>
        </section>
      )
    }

    {
      rows.length > 0 && (
        <section>
          <div class="sh">
            <h2>What its model cards measure</h2>
            <p>Tall ticks are {lab.name} model cards that list the benchmark in their headline table. Gray dots are cards that leave it out. Rows are the benchmarks the lab listed most, at least twice each, in the order it started using them.</p>
          </div>
          <div class="matrix" style={`--c:${color}`}>
            {rows.map(({ b, on }) => (
              <a class="mrow" href={`/benchmarks/${b.id}/`}>
                <span class="mname">{b.name}</span>
                <span class="mlane" style={grid}>
                  {cs.map((c) => (
                    <i class:list={{ on: on.has(c.id) }} style={`left:${pos(c.date)}`} />
                  ))}
                </span>
              </a>
            ))}
            <div class="mrow axis" aria-hidden="true">
              <span class="mname" />
              <span class="mlane">
                {years.map((y) => (
                  <span class="yr" style={`left:${pos(`${y}-01-01`)}`}>
                    {y}
                  </span>
                ))}
              </span>
            </div>
          </div>
          {cs.length >= 4 && (
            <div class="share">
              <AreaShare lab={id} height={300} />
            </div>
          )}
        </section>
      )
    }

    {
      cs.length > 0 && (
        <section>
          <div class="sh">
            <h2>Model cards</h2>
          </div>
          <div class="table-wrap">
            <table class="t" data-sort>
              <thead>
                <tr><th>Date</th><th>Model</th><th>Document</th><th class="r">Benchmarks</th></tr>
              </thead>
              <tbody>
                {cs.slice().reverse().map((c) => (
                  <tr>
                    <td class="muted num nowrap">{fullDate(c.date)}</td>
                    <td><ModelName id={c.model} /></td>
                    <td>{c.url ? <a href={c.url}>{c.title ?? 'Model card'}</a> : c.title}</td>
                    <td class="r">{c.results.length}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    <section>
      <div class="sh">
        <h2>Every {lab.name} model</h2>
      </div>
      <ul class="all">
        {
          ms.map((m) => (
            <li>
              <ModelName id={m.id} />
              <span class="muted num">{monthYear(m.released)}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  .with-mark {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  /* a lab's page carries its color: a one-color mark takes it, and so does the line of its best scores */
  .with-mark :global(.mask) {
    background: var(--lc);
  }
  .mast {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-top: 16px;
    font-size: 15px;
    color: var(--ink-3);
  }
  .mast a {
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
  }
  .mast a:hover {
    text-decoration: underline;
  }
  .mast b {
    font-weight: 500;
    color: var(--ink);
  }
  .mast :global(.spark) {
    margin-left: 10px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
  }
  .matrix {
    display: grid;
  }
  .mrow {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 16px;
    align-items: center;
    text-decoration: none;
    color: inherit;
    border-radius: 8px;
    transition: background-color 140ms ease;
  }
  a.mrow:hover {
    background: var(--hover);
  }
  .mname {
    font-size: 13.5px;
    padding-left: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mlane {
    position: relative;
    height: 22px;
    background: linear-gradient(var(--grid), var(--grid)) 0 50% / 100% 1px no-repeat, var(--yl);
  }
  .mlane i {
    position: absolute;
    top: 9px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--ink-4);
    opacity: 0.6;
  }
  .mlane i.on {
    top: 4px;
    width: 6px;
    height: 14px;
    margin-left: -3px;
    border-radius: 2px;
    background: var(--c);
    opacity: 1;
  }
  .axis .mlane {
    background: none;
    height: 24px;
    border-top: 1px solid var(--line);
  }
  .yr::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -9px;
    height: 5px;
    border-left: 1px solid var(--ink-4);
  }
  .yr {
    position: absolute;
    top: 8px;
    translate: -50% 0;
    font: 400 12px/1 var(--mono);
    color: var(--ink-3);
  }
  .share {
    margin-top: 56px;
  }
  .nowrap {
    white-space: nowrap;
  }
  .all {
    list-style: none;
    padding: 0;
    margin: 0;
    columns: 2 300px;
    column-gap: 48px;
  }
  .all li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 7px 0;
    break-inside: avoid;
    font-size: 14.5px;
  }
  @media (max-width: 720px) {
    .mrow {
      grid-template-columns: 110px 1fr;
      gap: 8px;
    }
    .mname {
      font-size: 12px;
    }
  }
</style>
