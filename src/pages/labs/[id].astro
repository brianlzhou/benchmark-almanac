---
import { ECI_DECK, ECI_AXIS, SRI_DECK, RELEASE_AXIS, POOL_NOTES, CLOCK_NOTE } from '../../lib/figure-text.ts';
import ChartDownload from '../../components/ChartDownload.astro';
import { creditLine, ECI_CREDIT, LAUNCH_POSTS } from '../../lib/credits.ts';
import Base from '../../layouts/Base.astro';
import LabMark from '../../components/LabMark.astro';
import ModelCard from '../../components/ModelCard.astro';
import ModelName from '../../components/ModelName.astro';
import TimeScatter, { type Pt } from '../../components/TimeScatter.astro';
import AreaShare from '../../components/AreaShare.astro';
import Crumbs from '../../components/Crumbs.astro';
import Spark from '../../components/Spark.astro';
import { labs, featuredModels, labPages, models, cards, systemCards, eciByModel, benchById } from '../../lib/data.ts';
import { monthYear, fullDate, yearFrac } from '../../lib/format.ts';
import { labColor } from '../../lib/palette.ts';
import { yearTicks, yearLines } from '../../lib/scale.ts';

export function getStaticPaths() {
  return labs.filter((l) => labPages.has(l.id)).map((l) => ({ params: { id: l.id } }));
}

const { id } = Astro.params;
const lab = labs.find((l) => l.id === id)!;
const ms = featuredModels.filter((m) => m.lab === id).sort((a, b) => (b.released ?? '').localeCompare(a.released ?? ''));
const cs = cards.filter((c) => c.lab === id);
const ranked = ms.filter((m) => eciByModel.has(m.id)).sort((a, b) => eciByModel.get(b.id)!.eci - eciByModel.get(a.id)!.eci);
const pts: Pt[] = models
  .filter((m) => eciByModel.has(m.id) && m.released)
  .map((m) => ({ date: m.released!, value: eciByModel.get(m.id)!.eci, model: m.id, source: 'epoch' as const }));
const mine = ms.map((m) => m.id);
// the lab's best index score over time: each release that beat its own earlier best
const bestRun: { date: string; value: number }[] = [];
for (const m of [...ranked].sort((a, b) => (a.released ?? '').localeCompare(b.released ?? ''))) {
  const v = eciByModel.get(m.id)!.eci;
  if (m.released && (!bestRun.length || v > bestRun.at(-1)!.value)) bestRun.push({ date: m.released, value: v });
}

// the benchmarks this lab reports most, as rows of ticks over its documents: launch posts, system cards and
// technical reports, or both. A pill on the page picks one.
type Doc = { key: string; date: string; results: { benchmark: string }[] };
const sys = systemCards.filter((c) => c.lab === id);
const docSets = [
  { id: 'posts', label: 'Launch posts', where: 'in its launch posts', credit: LAUNCH_POSTS, docs: cs.map((c) => ({ key: `p:${c.id}`, date: c.date, results: c.results })) },
  { id: 'docs', label: 'System cards', where: 'in its system cards and technical reports', credit: 'labs’ system cards and technical reports, read by Benchmark Almanac', docs: sys.map((c) => ({ key: `s:${c.id}`, date: c.date, results: c.results })) },
  { id: 'all', label: 'All reports', where: 'across all its launch posts and reports', credit: 'labs’ launch posts, system cards and technical reports, read by Benchmark Almanac', docs: [] as Doc[] },
];
docSets[2].docs = [...docSets[0].docs, ...docSets[1].docs];
const brag = docSets
  .map((set) => {
    const docs = [...set.docs].sort((a, b) => a.date.localeCompare(b.date));
    const counts = new Map<string, number>();
    for (const d of docs) for (const r of new Set(d.results.map((x) => x.benchmark))) counts.set(r, (counts.get(r) ?? 0) + 1);
    const rows = [...counts.entries()]
      .filter(([b, n]) => n >= 2 && benchById.has(b))
      .sort((a, b) => b[1] - a[1])
      .slice(0, 28)
      .map(([b]) => ({ b: benchById.get(b)!, on: new Set(docs.filter((d) => d.results.some((r) => r.benchmark === b)).map((d) => d.key)) }))
      .sort((a, b) => {
        const first = (x: typeof a) => docs.find((d) => x.on.has(d.key))!.date;
        return first(a).localeCompare(first(b));
      });
    const t0 = docs.length ? yearFrac(docs[0].date) - 0.1 : 2023;
    const t1 = docs.length ? yearFrac(docs.at(-1)!.date) + 0.1 : 2027;
    const pos = (d: string) => `${(((yearFrac(d) - t0) / (t1 - t0)) * 100).toFixed(2)}%`;
    const years = yearTicks(t0, t1);
    return { ...set, docs, rows, pos, years, grid: `--yl:${yearLines(years.map((y) => pos(`${y}-01-01`)))}`, cap: `Here are the ${rows.length} benchmarks ${lab.name} mentions most ${set.where}.` };
  })
  .filter((x) => x.rows.length > 0);
const bragCaps = JSON.stringify(Object.fromEntries(brag.map((x) => [x.id, x.cap])));
const color = labColor(id);
---

<Base title={lab.name} description={`${lab.name}'s AI models, their benchmark scores, and what its model cards report.`} film="index" crumbs={[{ href: '/labs/', label: 'Labs' }]}>
  <div class="page">
    <header class="head" style={`--lc:${color}`}>
      <Crumbs items={[{ href: '/labs/', label: 'Labs' }]} />
      <h1 class="with-mark"><LabMark lab={lab.id} size={44} />{lab.name}</h1>
      {
        ranked[0] && (
          <div class="mast">
            <span>Best on the Capabilities Index</span>
            <a href={`/models/${ranked[0].id}/`}>{ranked[0].name}</a>
            <b class="num">{eciByModel.get(ranked[0].id)!.eci.toFixed(1)}</b>
            {bestRun.length >= 2 && <Spark points={bestRun} unit="index" color={color} label={`${lab.name}'s best index score over time`} />}
          </div>
        )
      }
      <div class="facts">
        <span><b>{ms.length}</b> models</span>
        <span><b>{cs.length}</b> model cards read</span>
        {lab.url && <a href={lab.url}>{lab.url.replace(/^https?:\/\/(www\.)?/, '')}</a>}
      </div>
    </header>

    {
      ranked.length > 0 && (
        <section>
          <div class="sh">
            <h2>How does {lab.name} stack up?</h2>
            <p>Every model on Epoch AI's Capabilities Index by release date, with {lab.name}'s in color.</p>
          </div>
          <ChartDownload credit={creditLine([ECI_CREDIT])} deck={`${lab.name}’s models in color, against every other model on the index. ${ECI_DECK}`} yAxis={ECI_AXIS} xAxis={RELEASE_AXIS} counts="Every model with a Capabilities Index score, at its release date." leaves="Models Epoch AI hasn’t scored.">
          <TimeScatter points={pts} unit="index" label={`${lab.name} on the Epoch Capabilities Index`} highlight={mine} labelIds={ranked.slice(0, 8).map((m) => m.id)} legend={false} height={420} />
          </ChartDownload>
        </section>
      )
    }

    {
      ranked.length > 0 && (
        <section>
          <div class="sh">
            <h2>{lab.name}'s best models</h2>
          </div>
          <div class="cards">
            {ranked.slice(0, 6).map((m) => <ModelCard id={m.id} />)}
          </div>
        </section>
      )
    }

    {
      brag.length > 0 && (
        <section data-brag>
          <div class="sh-row">
            <div class="sh">
              <h2>What benchmarks does {lab.name} mention most?</h2>
              <p data-brag-cap data-caps={bragCaps}>{brag[0].cap}</p>
            </div>
            {brag.length > 1 && (
              <div class="seg" role="radiogroup" aria-label="Count benchmarks in">
                {brag.map((x, i) => (
                  <label>
                    <input type="radio" name="brag" value={x.id} checked={i === 0} />
                    {x.label}
                  </label>
                ))}
              </div>
            )}
          </div>
          {brag.map((x, i) => (
            <div data-brag-v={x.id} hidden={i > 0}>
              <ChartDownload credit={creditLine([x.credit])} name={`${lab.id}-${x.id}-benchmarks`} counts={`The benchmarks ${lab.name} reported at least twice, one row each, in the order it started using them. Each tall tick is a document that shows a score on the benchmark, and each gray dot is one that doesn't.`} leaves="Benchmarks the lab reported only once.">
                <div class="matrix" style={`--c:${color}`}>
                  {x.rows.map(({ b, on }) => (
                    <a class="mrow" href={`/benchmarks/${b.id}/`}>
                      <span class="mname">{b.name}</span>
                      <span class="mlane" style={x.grid}>
                        {x.docs.map((d) => (
                          <i class:list={{ on: on.has(d.key) }} style={`left:${x.pos(d.date)}`} />
                        ))}
                      </span>
                    </a>
                  ))}
                  <div class="mrow axis" aria-hidden="true">
                    <span class="mname" />
                    <span class="mlane">
                      {x.years.map((y) => (
                        <span class="yr" style={`left:${x.pos(`${y}-01-01`)}`}>
                          {y}
                        </span>
                      ))}
                    </span>
                  </div>
                </div>
              </ChartDownload>
            </div>
          ))}
          {cs.length >= 4 && (
            <div class="share">
              <AreaShare lab={id} height={300} />
            </div>
          )}
        </section>
      )
    }

    {
      cs.length > 0 && (
        <section>
          <div class="sh">
            <h2>Model cards</h2>
          </div>
          <div class="table-wrap">
            <table class="t" data-sort>
              <thead>
                <tr><th>Date</th><th>Model</th><th>Document</th><th class="r">Benchmarks</th></tr>
              </thead>
              <tbody>
                {cs.slice().reverse().map((c) => (
                  <tr>
                    <td class="muted num nowrap">{fullDate(c.date)}</td>
                    <td><ModelName id={c.model} /></td>
                    <td>{c.url ? <a href={c.url}>{c.title ?? 'Model card'}</a> : c.title}</td>
                    <td class="r">{c.results.length}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    <section>
      <div class="sh">
        <h2>Every {lab.name} model</h2>
      </div>
      <ul class="all">
        {
          ms.map((m) => (
            <li>
              <ModelName id={m.id} />
              <span class="muted num">{monthYear(m.released)}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<script>
  // the brag chart's pill: launch posts, system cards or all reports
  for (const sec of document.querySelectorAll<HTMLElement>('section[data-brag]')) {
    const cap = sec.querySelector<HTMLElement>('[data-brag-cap]');
    const caps = JSON.parse(cap?.dataset.caps ?? '{}') as Record<string, string>;
    sec.addEventListener('change', (e) => {
      const r = e.target as HTMLInputElement;
      if (r.name !== 'brag') return;
      if (cap) cap.textContent = caps[r.value] ?? '';
      for (const v of sec.querySelectorAll<HTMLElement>('[data-brag-v]')) v.hidden = v.dataset.bragV !== r.value;
    });
  }
</script>

<style>
  .with-mark {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  /* a lab's page carries its color: a one-color mark takes it, and so does the line of its best scores */
  .with-mark :global(.mask) {
    background: var(--lc);
  }
  .mast {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-top: 16px;
    font-size: 15px;
    color: var(--ink-3);
  }
  .mast a {
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
  }
  .mast a:hover {
    text-decoration: underline;
  }
  .mast b {
    font-weight: 500;
    color: var(--ink);
  }
  .mast :global(.spark) {
    margin-left: 10px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
  }
  .matrix {
    display: grid;
  }
  .mrow {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 16px;
    align-items: center;
    text-decoration: none;
    color: inherit;
    border-radius: 8px;
    transition: background-color 140ms ease;
  }
  a.mrow:hover {
    background: var(--hover);
  }
  .mname {
    font-size: 13.5px;
    padding-left: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mlane {
    position: relative;
    height: 22px;
    background: linear-gradient(var(--grid), var(--grid)) 0 50% / 100% 1px no-repeat, var(--yl);
  }
  .mlane i {
    position: absolute;
    top: 9px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--ink-4);
    opacity: 0.6;
  }
  .mlane i.on {
    top: 4px;
    width: 6px;
    height: 14px;
    margin-left: -3px;
    border-radius: 2px;
    background: var(--c);
    opacity: 1;
  }
  .axis .mlane {
    background: none;
    height: 24px;
    border-top: 1px solid var(--line);
  }
  .yr::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -9px;
    height: 5px;
    border-left: 1px solid var(--ink-4);
  }
  .yr {
    position: absolute;
    top: 8px;
    translate: -50% 0;
    font: 400 12px/1 var(--mono);
    color: var(--ink-3);
  }
  .share {
    margin-top: 56px;
  }
  .nowrap {
    white-space: nowrap;
  }
  .all {
    list-style: none;
    padding: 0;
    margin: 0;
    columns: 2 300px;
    column-gap: 48px;
  }
  .all li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 7px 0;
    break-inside: avoid;
    font-size: 14.5px;
  }
  @media (max-width: 720px) {
    .mrow {
      grid-template-columns: 110px 1fr;
      gap: 8px;
    }
    .mname {
      font-size: 12px;
    }
  }
</style>
