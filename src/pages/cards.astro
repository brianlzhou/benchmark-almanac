---
import Base from '../layouts/Base.astro';
import AreaShare from '../components/AreaShare.astro';
import LabMark from '../components/LabMark.astro';
import { cards, labById, modelById, benchById } from '../lib/data.ts';
import { fullDate } from '../lib/format.ts';
import { featuredIds } from '../lib/routes.ts';

// what each card added and dropped against the same lab's previous card of the same size
const prev = new Map<string, string[]>();
const rows = cards.map((c) => {
  const k = `${c.lab}|${c.tier === 'small' || c.tier === 'open-weights' ? 'small' : 'big'}`;
  const names = c.results.map((r) => r.benchmark);
  const p = prev.get(k);
  prev.set(k, names);
  return { c, added: p ? names.filter((n) => !p.includes(n)) : [], dropped: p ? p.filter((n) => !names.includes(n)) : [], first: !p };
});
rows.reverse();
const years = [...new Set(rows.map((r) => r.c.date.slice(0, 4)))];
const labCount = new Set(cards.map((c) => c.lab)).size;
---

<Base title="Model cards" description="Every lab model card the almanac reads, what each one reports, and what it added or dropped since the lab's previous card.">
  <div class="page">
    <header class="head">
      <h1>Model cards</h1>
      <p class="lede">
        The {cards.length} model cards, system cards and launch posts from {labCount} labs that the almanac reads, newest first. For each, the benchmarks in its headline table, and what changed from the same lab's previous card.
      </p>
    </header>

    <section>
      <div class="sh">
        <h2>What the cards measure</h2>
        <p>Share of headline benchmarks by area, every half year, across all {labCount} labs.</p>
      </div>
      <AreaShare />
    </section>

    {
      years.map((y) => (
        <section>
          <div class="sh">
            <h2>{y}</h2>
          </div>
          <ol class="cl">
            {rows
              .filter((r) => r.c.date.startsWith(y))
              .map(({ c, added, dropped, first }) => {
                const m = modelById.get(c.model);
                return (
                  <li id={c.id}>
                    <div class="when muted num">{fullDate(c.date)}</div>
                    <div class="what">
                      <div class="title">
                        <LabMark lab={c.lab} size={18} />
                        {featuredIds.has(c.model) ? <a href={`/models/${c.model}/`}>{m?.name}</a> : <span>{m?.name}</span>}
                        <span class="muted">{labById.get(c.lab)?.name}</span>
                        {c.url && (
                          <a class="doc" href={c.url}>
                            {c.title ?? 'Model card'}
                          </a>
                        )}
                      </div>
                      <ul class="chips">
                        {c.results.map((r) => (
                          <li class:list={{ add: !first && added.includes(r.benchmark) }}>
                            <a href={`/benchmarks/${r.benchmark}/`}>{benchById.get(r.benchmark)?.name}</a>
                          </li>
                        ))}
                      </ul>
                      {dropped.length > 0 && (
                        <p class="dropped">
                          Dropped since the last card:{' '}
                          {dropped.map((b, i) => (
                            <>
                              <a href={`/benchmarks/${b}/`}>{benchById.get(b)?.name}</a>
                              {i < dropped.length - 1 ? ', ' : ''}
                            </>
                          ))}
                        </p>
                      )}
                    </div>
                  </li>
                );
              })}
          </ol>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .cl {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 34px;
  }
  .cl > li {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 24px;
    scroll-margin-top: 90px;
  }
  .cl > li:target .title {
    background: var(--panel);
    border-radius: 8px;
  }
  .when {
    font-size: 13.5px;
    padding-top: 3px;
  }
  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-weight: 500;
  }
  .title a {
    text-decoration: none;
  }
  .doc {
    font-weight: 400;
    font-size: 13.5px;
    color: var(--ink-3);
    text-decoration: underline !important;
    text-decoration-color: var(--ink-4) !important;
  }
  .chips {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chips li {
    background: var(--panel);
    border-radius: 7px;
    padding: 5px 9px;
    font-size: 13px;
  }
  .chips li.add {
    box-shadow: inset 0 0 0 1px var(--status-good);
  }
  .chips a {
    text-decoration: none;
  }
  .dropped {
    margin-top: 10px;
    font-size: 13px;
    color: var(--ink-3);
  }
  @media (max-width: 720px) {
    .cl > li {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
