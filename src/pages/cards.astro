---
import Base from '../layouts/Base.astro';
import AreaShare from '../components/AreaShare.astro';
import LabMark from '../components/LabMark.astro';
import { cards, systemCards, labById, modelById, benchById } from '../lib/data.ts';
import { SECTION_NAMES, SECTION_ORDER } from '../lib/taxonomy.ts';
import { fullDate } from '../lib/format.ts';
import { featuredIds } from '../lib/routes.ts';

// what each card added and dropped against the same lab's previous card of the same size
const prev = new Map<string, string[]>();
const rows = cards.map((c) => {
  const k = `${c.lab}|${c.tier === 'small' || c.tier === 'open-weights' ? 'small' : 'big'}`;
  const names = c.results.map((r) => r.benchmark);
  const p = prev.get(k);
  prev.set(k, names);
  return { c, added: p ? names.filter((n) => !p.includes(n)) : [], dropped: p ? p.filter((n) => !names.includes(n)) : [], first: !p };
});
rows.reverse();
const years = [...new Set(rows.map((r) => r.c.date.slice(0, 4)))];
const labCount = new Set(cards.map((c) => c.lab)).size;
// the longer documents published with each launch post, and what they add to its headline results
const docsFor = (c: (typeof cards)[number]) => {
  const head = new Set(c.results.map((r) => r.benchmark));
  return systemCards
    .filter((d) => d.release === c.id)
    .map((d) => {
      const extra = d.results.filter((r) => !head.has(r.benchmark));
      const bySec = new Map<string, typeof extra>();
      for (const r of extra) bySec.set(r.section ?? 'other', [...(bySec.get(r.section ?? 'other') ?? []), r]);
      const rank = (k: string) => (SECTION_ORDER.includes(k) ? SECTION_ORDER.indexOf(k) : 99);
      return { d, extra, groups: [...bySec.entries()].sort(([a], [b]) => rank(a) - rank(b)) };
    });
};
---

<Base title="Model cards" description="Every lab model card the almanac reads, what each one reports, and what it added or dropped since the lab's previous card.">
  <div class="page">
    <header class="head">
      <h1>Model cards</h1>
      <p class="lede">
        The {cards.length} launch posts from {labCount} labs that the almanac reads, newest first. For each, the benchmarks in its headline results, and what changed from the same lab's previous post.{systemCards.length > 0 && ` Under each, the ${systemCards.length > 1 ? 'system cards, model cards and technical reports' : 'system card'} published with it, and the evaluations they add.`}
      </p>
    </header>

    <section>
      <div class="sh">
        <h2>What the cards measure</h2>
        <p>Share of headline benchmarks by area, every half year, across all {labCount} labs.</p>
      </div>
      <AreaShare />
    </section>

    {
      years.map((y) => (
        <section>
          <div class="sh">
            <h2>{y}</h2>
          </div>
          <ol class="cl">
            {rows
              .filter((r) => r.c.date.startsWith(y))
              .map(({ c, added, dropped, first }) => {
                const m = modelById.get(c.model);
                return (
                  <li id={c.id}>
                    <div class="when muted num">{fullDate(c.date)}</div>
                    <div class="what">
                      <div class="title">
                        <LabMark lab={c.lab} size={18} />
                        {featuredIds.has(c.model) ? <a href={`/models/${c.model}/`}>{m?.name}</a> : <span>{m?.name}</span>}
                        <span class="muted">{labById.get(c.lab)?.name}</span>
                        {c.url && (
                          <a class="doc" href={c.url}>
                            {c.title ?? 'Model card'}
                          </a>
                        )}
                      </div>
                      <ul class="chips">
                        {c.results.map((r) => (
                          <li class:list={{ add: !first && added.includes(r.benchmark) }}>
                            <a href={`/benchmarks/${r.benchmark}/`}>{benchById.get(r.benchmark)?.name}</a>
                          </li>
                        ))}
                      </ul>
                      {dropped.length > 0 && (
                        <p class="dropped">
                          Dropped since the last post:{' '}
                          {dropped.map((b, i) => (
                            <>
                              <a href={`/benchmarks/${b}/`}>{benchById.get(b)?.name}</a>
                              {i < dropped.length - 1 ? ', ' : ''}
                            </>
                          ))}
                        </p>
                      )}
                      {docsFor(c).map(({ d, extra, groups }) => (
                        <details class="sys">
                          <summary>
                            <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M3.5 2l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                            <span>
                              Its {d.doc ?? 'system card'} adds {extra.length} {extra.length === 1 ? 'evaluation' : 'evaluations'}
                            </span>
                            <span class="muted">{d.results.length} results in all</span>
                          </summary>
                          <div class="sys-b">
                            {d.url && <a class="doc" href={d.url}>{d.title ?? 'Read the document'}</a>}
                            {groups.map(([sec, rs]) => (
                              <div class="sec">
                                <h3>{SECTION_NAMES[sec] ?? sec}</h3>
                                <ul class="chips">
                                  {rs.map((r) => (
                                    <li>
                                      <a href={`/benchmarks/${r.benchmark}/`}>{benchById.get(r.benchmark)?.name ?? r.benchmark}</a>
                                    </li>
                                  ))}
                                </ul>
                              </div>
                            ))}
                          </div>
                        </details>
                      ))}
                    </div>
                  </li>
                );
              })}
          </ol>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .cl {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 34px;
  }
  .cl > li {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 24px;
    scroll-margin-top: 90px;
  }
  .cl > li:target .title {
    background: var(--panel);
    border-radius: 8px;
  }
  .when {
    font-size: 13.5px;
    padding-top: 3px;
  }
  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-weight: 500;
  }
  .title a {
    text-decoration: none;
  }
  .doc {
    font-weight: 400;
    font-size: 13.5px;
    color: var(--ink-3);
    text-decoration: underline !important;
    text-decoration-color: var(--ink-4) !important;
  }
  .chips {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chips li {
    background: var(--panel);
    border-radius: 7px;
    padding: 5px 9px;
    font-size: 13px;
  }
  .chips li.add {
    box-shadow: inset 0 0 0 1px var(--status-good);
  }
  .chips a {
    text-decoration: none;
  }
  .dropped {
    margin-top: 10px;
    font-size: 13px;
    color: var(--ink-3);
  }
  /* a launch post's system card, folded */
  .sys {
    margin-top: 12px;
  }
  .sys summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: -6px;
    padding: 4px 8px 4px 6px;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-2);
    cursor: pointer;
    list-style: none;
    transition: background-color 140ms ease;
  }
  .sys summary::-webkit-details-marker {
    display: none;
  }
  .sys summary:hover {
    background: var(--panel);
  }
  .sys summary svg {
    color: var(--ink-3);
    transition: transform 160ms cubic-bezier(0.2, 0, 0, 1);
  }
  .sys[open] summary svg {
    transform: rotate(90deg);
  }
  .sys summary .muted {
    font-weight: 400;
  }
  .sys-b {
    padding: 4px 0 0 18px;
  }
  .sec {
    margin-top: 12px;
  }
  .sec h3 {
    font: 500 12.5px/1.2 var(--sans);
    color: var(--ink-3);
    margin: 0;
  }
  .sec .chips {
    margin-top: 6px;
  }
  @media (prefers-reduced-motion: reduce) {
    .sys summary svg {
      transition: none;
    }
  }
  @media (max-width: 720px) {
    .cl > li {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
