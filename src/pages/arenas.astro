---
// Every arena and match league: the same areas, search and filters as the benchmarks table, for the tests
// that rank models against each other instead of against an answer key. An arena is a benchmark scored by
// votes (people pick the better of two answers) or by matches (models play each other), the rule behind
// the benchmarks page's "Arenas" chip, so the two pages count the same records.
import Base from '../layouts/Base.astro';
import LabMark from '../components/LabMark.astro';
import MiniBoard from '../components/MiniBoard.astro';
import Dropdown, { type Option } from '../components/Dropdown.astro';
import { allSummaries, modelById } from '../lib/data.ts';
import { AREAS, CATEGORY_NAMES, LEVELS, SUB_BY_ID, SUBCATEGORIES, RANKED_BY_PEOPLE_OR_MATCHES } from '../lib/taxonomy.ts';
import { score as fmt, monthYear } from '../lib/format.ts';
import { familyOf, nextVersion } from '../lib/reigns.ts';

const STATUS: Record<string, string> = { 'in use': 'In use', fading: 'Fading', dropped: 'Dropped', 'system cards': 'System cards only', 'not in cards': 'Not in cards' };
const RANKED: Record<string, { key: string; label: string; tip: string }> = {
  preference: { key: 'votes', label: 'Votes', tip: 'People see two answers to one prompt and pick the better one' },
  'head-to-head': { key: 'matches', label: 'Matches', tip: 'Models play each other in games or contests' },
};
// what the test set's access field says, in words that fit votes and games alike
const ACCESS: Record<string, string> = { public: 'public', 'public+private-holdout': 'public', private: 'private', unknown: 'unknown' };

const all = allSummaries().filter((s) => RANKED_BY_PEOPLE_OR_MATCHES.has(s.b.scoring ?? ''));
const byId = new Map(all.map((s) => [s.b.id, s]));
// one row per arena: a versioned family shows its newest version and links the earlier ones
const newest = (id: string) => familyOf(id).filter((v) => byId.has(v)).at(-1);
const rows = all
  .filter((s) => !s.b.family || newest(s.b.id) === s.b.id)
  .sort(
    (a, b) =>
      b.cites.length + b.docCites.length - (a.cites.length + a.docCites.length) ||
      b.board.length - a.board.length ||
      a.b.name.localeCompare(b.b.name),
  );
const inRows = (f: (s: (typeof rows)[number]) => boolean) => rows.filter(f).length;
const rankedCount = (k: string) => inRows((s) => RANKED[s.b.scoring!].key === k);
const withBoard = inRows((s) => s.board.length >= 3);
const areaCounts = AREAS.map((a) => ({
  a,
  n: inRows((s) => s.area === a.id),
  cats: a.categories.map((c) => ({ c, n: inRows((s) => s.b.category === c) })).filter((x) => x.n),
})).filter((x) => x.n);

// the area filter nests three deep: area, category, kind
const areaOptions: Option[] = [{ value: '', label: 'All areas' }];
for (const { a, n, cats } of areaCounts) {
  areaOptions.push({ value: `a:${a.id}`, label: a.name, depth: 0, count: n });
  for (const { c, n: k } of cats) {
    areaOptions.push({ value: `c:${c}`, label: CATEGORY_NAMES[c] ?? c, depth: 1, count: k });
    for (const sc of SUBCATEGORIES[c] ?? []) {
      const j = inRows((s) => s.b.subcategory === sc.id);
      if (j) areaOptions.push({ value: `s:${sc.id}`, label: sc.name, depth: 2, count: j });
    }
  }
}
const levelOptions: Option[] = [
  { value: '', label: 'Any level' },
  ...LEVELS.map((l) => ({ value: l.id, label: l.name, count: inRows((s) => s.b.level === l.id) })).filter((o) => o.count),
];
const statusOptions: Option[] = [
  { value: '', label: 'Any status' },
  { value: 'in-use', label: 'In use', count: inRows((s) => s.status === 'in use') },
  { value: 'fading', label: 'Fading', count: inRows((s) => s.status === 'fading') },
  { value: 'dropped', label: 'Dropped', count: inRows((s) => s.status === 'dropped') },
  { value: 'system-cards', label: 'Only in system cards', count: inRows((s) => s.status === 'system cards') },
  { value: 'not-in-cards', label: 'Not in model cards', count: inRows((s) => s.status === 'not in cards') },
].filter((o) => o.value === '' || o.count);
const dataOptions: Option[] = [
  { value: '', label: 'Any data access' },
  { value: 'public', label: 'Public prompts or games', count: inRows((s) => ACCESS[s.b.access ?? 'unknown'] === 'public') },
  { value: 'private', label: 'Kept private', count: inRows((s) => ACCESS[s.b.access ?? 'unknown'] === 'private') },
  { value: 'unknown', label: 'Not stated', count: inRows((s) => ACCESS[s.b.access ?? 'unknown'] === 'unknown') },
];
const codeOptions: Option[] = [
  { value: '', label: 'With or without code' },
  { value: 'yes', label: 'Public code', count: inRows((s) => !!s.b.links?.repo) },
];
// a family's earlier versions, newest first, so reading down goes back in time
const earlier = (id: string) =>
  familyOf(id)
    .filter((v) => byId.has(v))
    .slice(0, -1)
    .map((v) => byId.get(v)!)
    .reverse();
const vlabel = (v: string) => (/^\d+$/.test(v) ? `v${v}` : v);
const kindOf = (s: (typeof all)[number]) => (s.b.subcategory ? SUB_BY_ID.get(s.b.subcategory)?.name : undefined) ?? CATEGORY_NAMES[s.b.category ?? 'other'] ?? 'Other';
const boards = rows.filter((s) => s.board.length >= 3).sort((a, b) => b.board.length - a.board.length);
---

<Base title="Arenas" description="Every arena and match league in the almanac: what it ranks, who runs it, how it is judged, and which model leads it.">
  <div class="page ax">
    <header class="head">
      <h1>Arenas</h1>
      <p class="lede">
        {rows.length} arenas and match leagues rank models against each other instead of against an answer key. People vote between two answers, or models play each other in games and contests. Ratings move as new models join, so a score compares only within its own pool. Tests with fixed answers are on the <a href="/benchmarks/">benchmarks page</a>.
      </p>
      <div class="facts">
        <span><b>{rankedCount('votes')}</b> ranked by votes</span>
        <span><b>{rankedCount('matches')}</b> ranked by matches</span>
        <span><b>{inRows((s) => s.status === 'in use')}</b> in use</span>
        <span><b>{withBoard}</b> with a leaderboard here</span>
      </div>
    </header>

    <section class="catalogue">
      <nav class="areas" aria-label="Areas and categories">
        {
          areaCounts.map(({ a, n, cats }) => (
            <div class="area" style={`--a:var(--area-${a.id})`}>
              <a class="ah" href={`?area=a:${a.id}`} data-area-link={`a:${a.id}`}>
                <span class="sw" />
                <span class="an">{a.name}</span>
                <span class="ac num">{n}</span>
              </a>
              <div class="cats">
                {cats.map(({ c, n: k }) => (
                  <a href={`?area=c:${c}`} data-area-link={`c:${c}`}>
                    {CATEGORY_NAMES[c] ?? c}
                    <span class="cn num">{k}</span>
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </nav>

      <div class="filters" data-filter="arenas">
        <div class="seg methods" role="radiogroup" aria-label="How it is ranked">
          <label><input type="radio" name="ranked" value="" data-key="ranked" checked />All</label>
          <label title={RANKED.preference.tip}><input type="radio" name="ranked" value="votes" data-key="ranked" />Ranked by votes <span class="n">{rankedCount('votes')}</span></label>
          <label title={RANKED['head-to-head'].tip}><input type="radio" name="ranked" value="matches" data-key="ranked" />Ranked by matches <span class="n">{rankedCount('matches')}</span></label>
        </div>
        <div class="break" />
        <input class="field grow" type="search" placeholder="Search arenas, makers or models" aria-label="Search arenas" data-q />
        <Dropdown filterKey="area" label="Area" options={areaOptions} search wide />
        <Dropdown filterKey="level" label="Level" options={levelOptions} />
        <Dropdown filterKey="status" label="Status" options={statusOptions} />
        <Dropdown filterKey="data" label="Data" options={dataOptions} />
        <Dropdown filterKey="code" label="Code" options={codeOptions} />
        <span class="count muted" data-count>{rows.length} arenas</span>
      </div>

      <div class="table-wrap">
        <table class="t at" data-rows>
          <thead>
            <tr>
              <th>Arena</th>
              <th>Run by</th>
              <th>Kind</th>
              <th>Ranked by</th>
              <th>Status</th>
              <th>Leader</th>
              <th class="r two" title="Models with a score in the almanac">Models<br />rated</th>
              <th>Released</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((s) => {
                const top = s.best ? modelById.get(s.best.model) : undefined;
                const prev = s.b.family ? earlier(s.b.id) : [];
                const kind = kindOf(s);
                const group = prev.length ? s.b.family : undefined;
                const ranked = RANKED[s.b.scoring!];
                return (
                  <>
                    <tr
                      class:list={{ fam: !!group }}
                      data-group={group}
                      data-area={`a:${s.area} c:${s.b.category ?? 'other'}${s.b.subcategory ? ` s:${s.b.subcategory}` : ''}`}
                      data-level={s.b.level ?? ''}
                      data-ranked={ranked.key}
                      data-status={s.status.replace(/ /g, '-')}
                      data-data={ACCESS[s.b.access ?? 'unknown']}
                      data-code={s.b.links?.repo ? 'yes' : ''}
                      data-text={[...(s.b.aliases ?? []), ...prev.map((p) => p.b.name)].join(' ').toLowerCase() || undefined}
                    >
                      <td class="nm">
                        <a href={`/benchmarks/${s.b.id}/`}>{s.b.name}</a>
                        {group && s.b.version && !s.b.name.includes(s.b.version) && <span class="vtag">{vlabel(s.b.version)}</span>}
                        {s.b.description && <span class="desc">{s.b.description}</span>}
                        {group && (
                          <button type="button" class="vt" data-toggle={group} aria-expanded="false" aria-controls={prev.map((p) => `v-${p.b.id}`).join(' ')}>
                            <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M3.5 2l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                            {prev.length} earlier {prev.length === 1 ? 'version' : 'versions'}
                            <span class="vlist">{prev.map((p) => vlabel(p.b.version ?? p.b.name)).join(', ')}</span>
                          </button>
                        )}
                      </td>
                      <td class="org">{s.b.org}</td>
                      <td class="muted kind">{kind}</td>
                      <td class="muted nowrap" title={ranked.tip}>{ranked.label}</td>
                      <td class="nowrap">
                        <span class:list={['tag', `status-${s.status.replace(/ /g, '-')}`]}>
                          <span class="dot" />
                          <span class="sl">{STATUS[s.status]}</span>
                        </span>
                      </td>
                      <td class="best-c">
                        {s.best && top && (
                          <span class="best">
                            <LabMark lab={top.lab} size={14} />
                            <span class="bm">{top.name}</span>
                            <b class="num">{fmt(s.best.value, s.b.unit ?? '%')}</b>
                          </span>
                        )}
                      </td>
                      <td class="r num">{s.board.length || ''}</td>
                      <td class="muted num nowrap">{monthYear(s.b.released)}</td>
                    </tr>
                    {prev.map((p, i) => {
                      const ptop = p.best ? modelById.get(p.best.model) : undefined;
                      const next = nextVersion(p.b.id);
                      const pkind = kindOf(p);
                      const pranked = RANKED[p.b.scoring!];
                      return (
                        <tr class:list={['ver', { last: i === prev.length - 1 }]} id={`v-${p.b.id}`} data-parent={group} hidden>
                          <td class="nm">
                            <span class="tree" aria-hidden="true" />
                            <a href={`/benchmarks/${p.b.id}/`}>{p.b.name}</a>
                            {p.b.version && !p.b.name.includes(p.b.version) && <span class="vtag">{vlabel(p.b.version)}</span>}
                            {next && <span class="desc">Replaced in {monthYear(next.date)}</span>}
                          </td>
                          <td class="org">{p.b.org !== s.b.org ? p.b.org : ''}</td>
                          <td class="muted kind">{pkind !== kind ? pkind : ''}</td>
                          <td class="muted nowrap">{pranked.key !== ranked.key ? pranked.label : ''}</td>
                          <td class="nowrap">
                            <span class:list={['tag', `status-${p.status.replace(/ /g, '-')}`]}>
                              <span class="dot" />
                              <span class="sl">{STATUS[p.status]}</span>
                            </span>
                          </td>
                          <td class="best-c">
                            {p.best && ptop && (
                              <span class="best">
                                <LabMark lab={ptop.lab} size={14} />
                                <span class="bm">{ptop.name}</span>
                                <b class="num">{fmt(p.best.value, p.b.unit ?? '%')}</b>
                              </span>
                            )}
                          </td>
                          <td class="r num">{p.board.length || ''}</td>
                          <td class="muted num nowrap">{monthYear(p.b.released)}</td>
                        </tr>
                      );
                    })}
                  </>
                );
              })
            }
          </tbody>
        </table>
      </div>
    </section>

    {
      boards.length > 0 && (
        <section id="boards">
          <div class="sh">
            <h2>Arena leaderboards</h2>
            <p>The top five in the {Math.min(9, boards.length)} arenas that rate the most models in the almanac.</p>
          </div>
          <div class="grid3">
            {boards.slice(0, 9).map((s) => <MiniBoard s={s} />)}
          </div>
        </section>
      )
    }

    <section>
      <div class="sh">
        <h2>How an arena differs from a benchmark</h2>
      </div>
      <div class="table-wrap">
        <table class="t cmp">
          <thead>
            <tr><th /><th>Fixed answers</th><th>Arenas</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>What decides a score</td>
              <td>An answer key, unit tests, or a check of the final state</td>
              <td>Votes between two answers, or wins and losses in matches, turned into Elo-style ratings</td>
            </tr>
            <tr>
              <td>What it captures</td>
              <td>Whether the model gets a defined task right</td>
              <td>Taste, helpfulness, style and strategy, the things an answer key misses</td>
            </tr>
            <tr>
              <td>What can go wrong</td>
              <td>Leaked test sets, and saturation once the best score nears the ceiling</td>
              <td>Length and formatting win votes, and ratings shift as new models arrive</td>
            </tr>
            <tr>
              <td>How scores compare</td>
              <td>On an absolute scale, so 2023 and 2026 scores compare directly</td>
              <td>Relative to the other models in the pool at the time</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Base>

<script>
  import { wireFilter } from '../scripts/filter.ts';
  wireFilter('arenas');
  // the area and category links set the area filter in place, and a second click clears it
  const sel = document.querySelector<HTMLSelectElement>('.ax select[data-area]');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.ax [data-area-link]')];
  const mark = () => {
    for (const a of links) {
      if (sel && a.dataset.areaLink === sel.value) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    }
  };
  for (const a of links) {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      if (!sel) return;
      sel.value = sel.value === a.dataset.areaLink ? '' : a.dataset.areaLink!;
      sel.dispatchEvent(new Event('change'));
    });
  }
  sel?.addEventListener('change', mark);
  mark();
</script>

<style is:global>
  /* page styles under .ax, the same system as the benchmarks table (.bx) */
  .ax .areas {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin: 0 0 28px;
  }
  .ax .area {
    padding: 12px 14px 14px;
    border-radius: 10px;
    background: var(--panel);
  }
  .ax .ah {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    border-radius: 6px;
  }
  .ax .sw {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--a);
    flex: none;
  }
  .ax .an {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ax .ac {
    color: var(--ink-3);
    font-weight: 400;
  }
  .ax .cats {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 12px;
    margin-top: 8px;
    padding-left: 20px;
  }
  .ax .cats a {
    font-size: 13px;
    color: var(--ink-3);
    text-decoration: none;
  }
  .ax .cn {
    margin-left: 4px;
    color: var(--ink-4);
  }
  .ax .cats a:hover,
  .ax .ah:hover .an {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--ink-4);
  }
  /* the chosen area or category reads as selected */
  .ax .cats a[aria-current],
  .ax .ah[aria-current] .an {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }
  .ax .area:has(.ah[aria-current]) {
    box-shadow: inset 0 0 0 1px var(--a);
  }
  .ax .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-bottom: 20px;
  }
  .ax .methods .n {
    color: var(--ink-4);
    font-weight: 400;
    margin-left: 4px;
  }
  .ax .break {
    flex-basis: 100%;
    height: 0;
  }
  .ax .grow {
    flex: 1 1 240px;
  }
  .ax .count {
    font-size: 13px;
    margin-left: auto;
  }
  .ax .nm {
    min-width: 220px;
  }
  .ax .nm > a {
    font-weight: 500;
  }
  .ax .desc {
    display: block;
    margin-top: 3px;
    color: var(--ink-3);
    font-size: 13px;
    line-height: 1.4;
    max-width: 58ch;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ax .vtag {
    margin-left: 8px;
    padding: 2px 6px;
    border-radius: 5px;
    background: var(--panel);
    color: var(--ink-3);
    font: 500 11.5px/1 var(--mono);
    vertical-align: 1px;
  }
  /* the disclosure for a family's earlier versions */
  .ax .vt {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 6px 0 0 -4px;
    padding: 3px 8px 3px 4px;
    border: 0;
    border-radius: 6px;
    background: none;
    color: var(--ink-2);
    font: 500 12.5px/1.2 var(--sans);
    cursor: pointer;
    transition: background-color 140ms ease;
  }
  .ax .vt:hover {
    background: var(--panel);
  }
  .ax .vt:focus-visible {
    outline: 2px solid var(--ink-3);
    outline-offset: 1px;
  }
  .ax .vt svg {
    flex: none;
    color: var(--ink-3);
    transition: transform 160ms cubic-bezier(0.2, 0, 0, 1);
  }
  .ax .vt[aria-expanded='true'] svg {
    transform: rotate(90deg);
  }
  .ax .vlist {
    color: var(--ink-4);
    font-weight: 400;
  }
  .ax .vt[aria-expanded='true'] .vlist {
    display: none;
  }
  /* earlier versions sit under their family, joined by a tree line */
  .ax .at tr.ver td {
    padding-top: 8px;
    padding-bottom: 8px;
    border-top-color: transparent;
    font-size: 13.5px;
  }
  .ax .at tr.ver .nm {
    position: relative;
    padding-left: 30px;
  }
  .ax .at tr.ver .nm > a {
    font-weight: 400;
  }
  .ax .tree {
    position: absolute;
    left: 11px;
    top: 0;
    bottom: 0;
    width: 12px;
    border-left: 1px solid var(--ink-4);
  }
  .ax .tree::after {
    content: '';
    position: absolute;
    left: -1px;
    top: 50%;
    width: 12px;
    border-top: 1px solid var(--ink-4);
  }
  .ax tr.last .tree {
    bottom: 50%;
  }
  .ax tr.ver .desc {
    margin-top: 1px;
    font-size: 12.5px;
  }
  @media (prefers-reduced-motion: reduce) {
    .ax .vt svg {
      transition: none;
    }
  }
  .ax .org {
    font-size: 13.5px;
    color: var(--ink-2);
    min-width: 120px;
    max-width: 200px;
  }
  .ax .kind {
    min-width: 104px;
    font-size: 13.5px;
  }
  .ax .best-c {
    min-width: 176px;
  }
  .ax .best {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13.5px;
  }
  .ax .bm {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 140px;
  }
  .ax .best b {
    font-weight: 500;
    margin-left: auto;
  }
  .ax .nowrap {
    white-space: nowrap;
  }
  .ax .at th.two {
    white-space: normal;
    line-height: 1.25;
    vertical-align: bottom;
  }
  .ax .at td {
    padding-top: 11px;
    padding-bottom: 11px;
  }
  .ax .cmp td:first-child {
    color: var(--ink-3);
    width: 22%;
  }
  .ax .cmp td {
    vertical-align: top;
  }
  .ax .grid3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 56px 48px;
  }
  /* narrower windows drop the least needed columns first, so the table never scrolls sideways */
  @media (max-width: 1240px) {
    .ax .at th:nth-child(3),
    .ax .at td:nth-child(3) {
      display: none;
    }
  }
  @media (max-width: 1080px) {
    .ax .at th:nth-child(8),
    .ax .at td:nth-child(8) {
      display: none;
    }
    .ax .grid3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .ax .areas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .ax .at th:nth-child(2),
    .ax .at td:nth-child(2),
    .ax .at th:nth-child(4),
