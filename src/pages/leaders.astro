---
import { ECI_DECK, ECI_AXIS, SRI_DECK, RELEASE_AXIS, POOL_NOTES, CLOCK_NOTE } from '../lib/figure-text.ts';
import ChartDownload from '../components/ChartDownload.astro';
import { creditLine, ECI_CREDIT, POOL_CREDIT } from '../lib/credits.ts';
import Base from '../layouts/Base.astro';
import ReignChart from '../components/ReignChart.astro';
import CrownShare from '../components/CrownShare.astro';
import { benchmarks, labById, modelById, benchById, AS_OF } from '../lib/data.ts';
import LabMark from '../components/LabMark.astro';
import { monthYear } from '../lib/format.ts';
import { eciReigns, labShares, reignDays, contestedDays, clockStops, closeOuts, closeOutShares, CLOSE_LEVELS } from '../lib/reigns.ts';
import { featuredIds } from '../lib/routes.ts';
import ModelName from '../components/ModelName.astro';
import { score as fmt } from '../lib/format.ts';
import { leaderRows, currentRuns } from '../lib/leaders.ts';
import { AREAS, CATEGORY_NAMES, areaOf } from '../lib/taxonomy.ts';
import Dropdown from '../components/Dropdown.astro';
import { lowerLabel } from '../lib/format.ts';
import { labColor } from '../lib/palette.ts';

const eci = eciReigns();
const eciRows = eci ? [{ ...eci, reigns: eci.reigns.filter((g) => g.end >= '2023-01-01') }] : [];
const eciNow = eci?.reigns.at(-1);
const changes = eci ? eci.reigns.filter((g) => g.start >= '2023-01-01').length : 0;

// every category's chart, three ways: each benchmark from the one source its page leads with (the default, so
// this page and the benchmark pages agree), every independent run, and every score with claims included
type PoolSource = 'headline' | 'independent' | 'all';
// what the downloaded share charts say about what they count
const shareFigure = (src: PoolSource, n: number) => ({
  credit: POOL_CREDIT[src],
  name: `time-at-number-one-${src}`,
  deck: `Each lab’s share of the time its models held number one, across ${n} benchmarks with enough scores.`,
  counts: `${CLOCK_NOTE} ${POOL_NOTES[src].counts}`,
  leaves: POOL_NOTES[src].leaves,
});
const closedFigure = (src: PoolSource) => ({
  credit: POOL_CREDIT[src],
  name: `closed-out-${src}`,
  deck: 'Close-outs by lab since 2023.',
  counts: POOL_NOTES[src].counts,
  leaves: 'Benchmarks nobody has taken past 85%.',
});
const POOL_TEXT: Record<PoolSource, { label: string; within: string; short: string }> = {
  headline: { label: 'One source per benchmark', within: 'using one source per benchmark', short: 'one source per benchmark' },
  independent: { label: 'All independent runs', within: 'using independent runs only', short: 'independent runs only' },
  all: { label: 'Include claimed scores', within: 'with claimed scores included', short: 'claimed scores included' },
};
function view(source: PoolSource) {
  const cats = AREAS.flatMap((a) => a.categories.map((c) => ({ a, c })))
    .map(({ a, c }) => {
      const ids = benchmarks.filter((b) => b.category === c).map((b) => b.id);
      const rows = leaderRows(ids, source);
      return { a, c, rows, shares: labShares(rows, '2023-01-01') };
    })
    .filter((x) => x.rows.length);
  // a family whose versions sit in different categories comes along with each of them (leaderRows keeps
  // versions together), so the rows across categories hold each benchmark once
  const allRows = [...new Map(cats.flatMap((x) => x.rows).map((r) => [r.benchmark, r])).values()];
  const overall = labShares(allRows, '2023-01-01');
  // the longest contested runs at number one since 2023: each ends where it ended, or where the clock stopped
  const runs = allRows
    .flatMap((r) =>
      r.reigns.map((g) => {
        const stop = clockStops(r);
        return { g, b: r.benchmark, months: contestedDays(g, r) / 30.4, start: g.start < '2023-01-01' ? '2023-01-01' : g.start, end: g.end < stop ? g.end : stop };
      }),
    )
    .filter((x) => x.months > 0)
    .sort((a, b) => b.months - a.months)
    .slice(0, 8);
  // close-outs: the model that took each benchmark past 85%, and past each threshold a reader can pick
  const closed = closeOuts(allRows);
  const closedAt = CLOSE_LEVELS.map((t) => closeOuts(allRows, '2023-01-01', t));
  // runs still going today on the tests labs report most: the default view of the runs section
  const now = currentRuns(AS_OF, source);
  return { source, cats, allRows, overall, lead: overall[0], runs, now: { ...now, runs: now.runs.slice(0, 8) }, closed, closedBy: closeOutShares(allRows), closedAt };
}
const views = [view('headline'), view('independent'), view('all')];
// the close-out chart redraws in the page for each threshold and area, from a compact list per view: each
// close-out as [benchmark, model, date, score], with the benchmarks and models listed once. Hidden copies of
// each lab's chart block, key entry and model name give the script the pieces to build from.
const coLabs = [...new Set(views.flatMap((v) => v.closedAt.flat().map((c) => c.lab ?? 'other')))];
const coModelOf = new Map(views.flatMap((v) => v.closedAt.flat().map((c) => [c.lab ?? 'other', c.model] as const)));
function coJson(lists: ReturnType<typeof closeOuts>[]) {
  const bs: [string, string, string][] = [];
  const ms: [string, string, string, string, number][] = [];
  const bi = new Map<string, number>();
  const mi = new Map<string, number>();
  const rows = lists.map((list) =>
    list.map((c) => {
      if (!bi.has(c.benchmark)) bi.set(c.benchmark, bs.push([c.benchmark, benchById.get(c.benchmark)?.name ?? c.benchmark, areaOf(benchById.get(c.benchmark)?.category)]) - 1);
      if (!mi.has(c.model)) {
        const m = modelById.get(c.model);
        mi.set(c.model, ms.push([c.model, m?.name ?? c.model, m?.version ?? '', c.lab ?? 'other', featuredIds.has(c.model) ? 1 : 0]) - 1);
      }
      return [bi.get(c.benchmark)!, mi.get(c.model)!, c.date, c.value];
    }),
  );
  return JSON.stringify({ levels: CLOSE_LEVELS, rows, benches: bs, models: ms, labs: Object.fromEntries(coLabs.map((l) => [l, labById.get(l)?.name ?? 'Other labs'])), areas: Object.fromEntries(AREAS.map((a) => [a.id, lowerLabel(a.name)])) }).replace(/</g, '\\u003c');
}
const pct = (v: number) => `${Math.round(v * 100)}%`;
const span = (months: number) => (months < 1 ? 'under a month' : `${Math.round(months)} ${Math.round(months) === 1 ? 'month' : 'months'}`);
const longest = eci?.reigns.filter((g) => g.start >= '2023-01-01').sort((a, b) => reignDays(b) - reignDays(a))[0];
---

<Base title="Leaders" description="Which model has held the top score on each AI benchmark since 2023, and for how long." film="reigns">
  <div class="page pools">
    <header class="head">
      <h1>Leaders</h1>
      <p class="lede">We track which model held the best score on every benchmark since 2023, and for how long. A model keeps the top spot until another one beats it.</p>
      <div class="pool-switch">
        <div class="seg" role="radiogroup" aria-label="Scores from">
          {views.map((v, k) => (
            <label>
              <input type="radio" name="pool" value={v.source} checked={k === 0} />
              {POOL_TEXT[v.source].label}
            </label>
          ))}
        </div>
        <script is:inline>
          // before the page below paints: a link with ?pool= picks that pool, so nothing jumps
          (function () {
            var box = document.currentScript.parentElement;
            var q = new URLSearchParams(location.search).get('pool');
            var pick = (q === 'independent' || q === 'all') && box.querySelector('input[name="pool"][value="' + q + '"]');
            if (pick) pick.checked = true;
            box.addEventListener('change', function (e) {
              var u = new URL(location.href);
              if (e.target.value === 'headline') u.searchParams.delete('pool');
              else u.searchParams.set('pool', e.target.value);
              history.replaceState(history.state, '', u);
            });
          })();
        </script>
      </div>
      <p class="pool-note">
        By default, each benchmark uses one source: its official leaderboard when that’s current, then Epoch AI’s own runs, then labs’ own numbers. Scores Epoch AI collected from lab reports count as claims.
      </p>
    </header>

    {
      eciRows.length > 0 && eciNow && (
        <section>
          <div class="sh">
            <h2>Who’s at the frontier?</h2>
            <p>
              The top spot on Epoch AI’s Capabilities Index has changed hands {changes === 1 ? 'once' : `${changes} times`} since 2023. {modelById.get(eciNow.model)?.name} from {labById.get(eciNow.lab ?? '')?.name} holds it now.
              {longest && ` ${modelById.get(longest.model)?.name} had the longest run at the top, which was ${Math.round(reignDays(longest) / 30.4)} ${Math.round(reignDays(longest) / 30.4) === 1 ? 'month' : 'months'}.`}
            </p>
          </div>
          <ChartDownload credit={creditLine([ECI_CREDIT])} name="capability-index-number-one" deck={ECI_DECK} counts="Every model on Epoch AI’s Capabilities Index, dated by release. Each colored stretch is the model with the highest score at the time." leaves="Models without an index score.">
            <ReignChart rows={eciRows} names={{ eci: { name: 'Capabilities Index', href: '/models/' } }} from="2023-01-01" />
          </ChartDownload>
        </section>
      )
    }

    {
      views.map((v) => {
        const { lead, overall, allRows, runs, now, closed, closedBy, cats, closedAt } = v;
        // the close-out line; the page script writes the same words for other thresholds and areas
        const coLine = `We call a benchmark saturated once a model scores past 85% on it, and that model gets the close-out. ${labById.get(closedBy[0]?.lab ?? '')?.name ?? 'Other labs'} closed out ${closedBy[0]?.count ?? 0} of ${closed.length} benchmarks, the most of any lab.`;
        const nowTop = now.runs[0];
        const everTop = runs[0];
        return (
          <div class={`pool-${v.source}`}><div class="view">
          {
            lead && (
              <section>
                <div class="sh">
                  <h2>Which lab leads most often?</h2>
                  <p>
                    {labById.get(lead.lab)?.name} held the top spot {pct(lead.share)} of the time across {allRows.length} benchmarks with at least three scores from two or more labs, {POOL_TEXT[v.source].within}. If a benchmark goes 45 days without a new score from another lab, we stop counting until one arrives. We stop for good once a model passes 85%.
                  </p>
                </div>
                <ChartDownload {...shareFigure(v.source, allRows.length)}>
                  <CrownShare shares={overall} />
                </ChartDownload>
              </section>
            )
          }

          {
            (runs.length > 0 || now.runs.length > 0) && (
              <section class="rn">
                <div class="sh-row">
                  <div class="sh rn-now">
                    <h2>Who’s held on the longest?</h2>
                    <p>
                      {nowTop ? `${modelById.get(nowTop.g.model)?.name} has held number one on ${benchById.get(nowTop.b)?.name} for ${span(nowTop.months)}, the longest run going today. ` : 'None of the most popular benchmarks has a run going today. '}We cover the {now.tests} benchmarks most cited in model releases this past year, {POOL_TEXT[v.source].within}, and skip versions nobody has tested in six weeks.
                    </p>
                  </div>
                  <div class="sh rn-ever">
                    <h2>Who’s held on the longest?</h2>
                    <p>{everTop ? `${modelById.get(everTop.g.model)?.name} held number one on ${benchById.get(everTop.b)?.name} for ${span(everTop.months)}, the longest run since 2023. ` : ''}We count only contested time, using {POOL_TEXT[v.source].short}.</p>
                  </div>
                  <div class="seg" role="radiogroup" aria-label="Which runs">
                    <label><input type="radio" name={`runs-${v.source}`} value="now" checked />Popular now</label>
                    <label><input type="radio" name={`runs-${v.source}`} value="ever" />All time</label>
                  </div>
                </div>
                <ol class="runs rn-now">
                  {now.runs.map(({ g, b, months, start }) => (
                    <li>
                      <span class="rm num">{months < 1 ? '<1' : Math.round(months)}<small>{months < 1.5 ? ' month' : ' months'}</small></span>
                      <span class="rw">
                        <LabMark lab={g.lab} size={16} />
                        <b>{modelById.get(g.model)?.name}</b> on <a href={`/benchmarks/${b}/`}>{benchById.get(b)?.name}</a>
                      </span>
                      <span class="rd muted">{monthYear(start)} to now</span>
                    </li>
                  ))}
                </ol>
                <ol class="runs rn-ever">
                  {runs.map(({ g, b, months, start, end }) => (
                    <li>
                      <span class="rm num">{Math.round(months)}<small>{Math.round(months) === 1 ? ' month' : ' months'}</small></span>
                      <span class="rw">
                        <LabMark lab={g.lab} size={16} />
                        <b>{modelById.get(g.model)?.name}</b> on <a href={`/benchmarks/${b}/`}>{benchById.get(b)?.name}</a>
                      </span>
                      <span class="rd muted">
                        {monthYear(start)} to {end >= AS_OF ? 'now' : monthYear(end)}
                      </span>
                    </li>
                  ))}
                </ol>
              </section>
            )
          }

          {
            closed.length > 0 && (
              <section data-co>
                <div class="sh-row">
                  <div class="sh">
                    <h2>Who finishes benchmarks off?</h2>
                    <p data-co-cap>{coLine}</p>
                  </div>
                  <div class="co-tools">
                    <div class="seg" role="radiogroup" aria-label="Saturated at">
                      {CLOSE_LEVELS.map((t, i) => (
                        <label>
                          <input type="radio" name={`co-t-${v.source}`} value={t} checked={i === 0} />
                          {t}%
                        </label>
                      ))}
                    </div>
                    <Dropdown filterKey={`co-${v.source}`} label="Area" options={[{ value: '', label: 'All areas' }, ...AREAS.filter((a) => closedAt.flat().some((c) => areaOf(benchById.get(c.benchmark)?.category) === a.id)).map((a) => ({ value: a.id, label: a.name }))]} />
                  </div>
                </div>
                <ChartDownload {...closedFigure(v.source)}>
                  <CrownShare shares={closedBy} what="Benchmarks closed out since 2023" />
                </ChartDownload>
                <div class="table-wrap closed">
                  <table class="t" data-sort>
                    <thead>
                      <tr><th>Date</th><th>Benchmark</th><th>Closed out by</th><th class="r">Score</th></tr>
                    </thead>
                    <tbody>
                      {closed.map((c) => (
                        <tr>
                          <td class="muted num nowrap">{monthYear(c.date)}</td>
                          <td><a href={`/benchmarks/${c.benchmark}/`}>{benchById.get(c.benchmark)?.name}</a></td>
                          <td><ModelName id={c.model} /></td>
                          <td class="r">{fmt(c.value, '%')}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <script type="application/json" is:inline data-co-json set:html={coJson(closedAt)} />
              </section>
            )
          }

          <section>
            <div class="sh">
              <h2>By category</h2>
              <p>Each category’s time at number one, split by lab. Click one to see its benchmarks.</p>
            </div>
            <div class="cats">
              {
                cats.map(({ c, rows, shares }) => (
                  <a class="cat" href={`/categories/${c}/`}>
                    <span class="cn">{CATEGORY_NAMES[c] ?? c}</span>
                    <span class="mini" aria-hidden="true">
                      {shares
                        .filter((s) => s.share >= 0.01)
                        .map((s) => (
                          <i style={`flex:${s.share};background:${labColor(s.lab)}`} data-tn={labById.get(s.lab)?.name ?? 'Other labs'} data-tv={pct(s.share)} />
                        ))}
                    </span>
                    <span class="cl muted">
                      {labById.get(shares[0]?.lab ?? '')?.name ?? 'Other labs'} {pct(shares[0]?.share ?? 0)}
                    </span>
                    <span class="cm muted">{`${rows.length} ${rows.length === 1 ? 'benchmark' : 'benchmarks'}`}</span>
                  </a>
                ))
              }
            </div>
          </section>
          </div></div>
        );
      })
    }
  </div>
  <div hidden data-co-bank>
    <CrownShare shares={coLabs.map((l) => ({ lab: l, share: 1 / coLabs.length, count: 0 }))} />
    {coLabs.map((l) => <span data-mn-lab={l}><ModelName id={coModelOf.get(l)!} /></span>)}
  </div>
</Base>

<script>
  // the close-out threshold and Area filter: the line under the title, the chart and the table follow the choice.
  // The chart and the rows are built from hidden copies of each lab's pieces (data-co-bank), so they keep the
  // components' own styles.
  import { monthYear, score } from '../lib/format.ts';
  type CoData = { levels: number[]; rows: [number, number, string, number][][]; benches: [string, string, string][]; models: [string, string, string, string, number][]; labs: Record<string, string>; areas: Record<string, string> };
  const bank = document.querySelector<HTMLElement>('[data-co-bank]');
  for (const sec of document.querySelectorAll<HTMLElement>('section[data-co]')) {
    const data = JSON.parse(sec.querySelector('[data-co-json]')?.textContent ?? 'null') as CoData | null;
    const pick = sec.querySelector<HTMLSelectElement>('.dd select');
    const cap = sec.querySelector<HTMLElement>('[data-co-cap]');
    const wrap = sec.querySelector<HTMLElement>('.cdl');
    const bar = sec.querySelector<HTMLElement>('.cs .bar');
    const key = sec.querySelector<HTMLElement>('.cs .key');
    const table = sec.querySelector<HTMLTableElement>('table');
    const tbody = table?.tBodies[0];
    const rowTpl = tbody?.rows[0]?.cloneNode(true) as HTMLTableRowElement | undefined;
    const inTpl = bar?.querySelector('.in')?.cloneNode(true) as HTMLElement | undefined;
    if (!data || !bank || !bar || !key || !tbody || !rowTpl) continue;
    const draw = () => {
      const t = Number(sec.querySelector<HTMLInputElement>('input[type="radio"]:checked')?.value ?? data.levels[0]);
      const a = pick?.value ?? '';
      const list = (data.rows[data.levels.indexOf(t)] ?? []).filter((r) => !a || data.benches[r[0]][2] === a);
      const per = new Map<string, number>();
      for (const r of list) per.set(data.models[r[1]][3], (per.get(data.models[r[1]][3]) ?? 0) + 1);
      const tops = [...per.entries()].sort((x, y) => y[1] - x[1]);
      const n = list.length;
      // the bar and its key
      bar.replaceChildren(
        ...tops.map(([lab, c]) => {
          const blk = bank.querySelector(`.blk[data-lab="${lab}"]`)!.cloneNode(true) as HTMLElement;
          blk.style.flex = String(c / n);
          blk.dataset.tv = String(c);
          blk.replaceChildren();
          if (c / n >= 0.06 && inTpl) {
            const i = inTpl.cloneNode(true) as HTMLElement;
            i.textContent = String(c);
            blk.append(i);
          }
          return blk;
        }),
      );
      bar.setAttribute('aria-label', tops.map(([lab, c]) => `${data.labs[lab]} ${c}`).join(', '));
      key.replaceChildren(
        ...tops.map(([lab, c]) => {
          const tag = bank.querySelector(`.tag[data-lab="${lab}"]`)!.cloneNode(true) as HTMLElement;
          const num = tag.querySelector('.num');
          if (num) num.textContent = String(c);
          return tag;
        }),
      );
      // the line under the title
      if (cap)
        cap.textContent = n
          ? `We call a benchmark saturated once a model scores past ${t}% on it, and that model gets the close-out. ${data.labs[tops[0][0]]} closed out ${tops[0][1]} of ${n}${a ? ` ${data.areas[a]}` : ''} benchmarks, the most of any lab.`
          : `No ${a ? `${data.areas[a]} ` : ''}benchmark has passed ${t}% since 2023.`;
      if (wrap) wrap.dataset.leaves = `Benchmarks nobody has taken past ${t}%.`;
      // the table
      tbody.replaceChildren(
        ...list.map(([bi, mi, date, value]) => {
          const tr = rowTpl.cloneNode(true) as HTMLTableRowElement;
          const [bid, bname] = data.benches[bi];
          const [mid, mname, mver, lab, linked] = data.models[mi];
          tr.cells[0].textContent = monthYear(date);
          const ba = tr.cells[1].querySelector('a');
          if (ba) {
            ba.href = `/benchmarks/${bid}/`;
            ba.textContent = bname;
          }
          const mn = bank.querySelector(`[data-mn-lab="${lab}"] .mn`)!.cloneNode(true) as HTMLElement;
          if (linked) mn.setAttribute('href', `/models/${mid}/`);
          else mn.removeAttribute('href');
          const nm = mn.querySelector('.mn-n');
          if (nm) nm.textContent = mname;
          const x = mn.querySelector('.mn-x');
          if (x) x.textContent = mver ? ` ${mver}` : '';
          else if (mver && nm) nm.textContent = `${mname} ${mver}`;
          tr.cells[2].replaceChildren(mn);
          tr.cells[3].textContent = score(value, '%');
          return tr;
        }),
      );
      table?.dispatchEvent(new Event('sort:refresh'));
    };
    pick?.addEventListener('change', draw);
    sec.addEventListener('change', (e) => {
      if ((e.target as HTMLInputElement).type === 'radio') draw();
    });
  }
</script>

<style>
  .pool-note {
    margin: 12px 0 0;
    max-width: 68ch;
    font-size: 14px;
    color: var(--ink-3);
  }
  /* each score view holds a run of sections: it sits apart from the section before it */
  .view {
    margin-top: 104px;
  }
  @media (max-width: 720px) {
    .view {
      margin-top: 72px;
    }
  }
  .closed {
    margin-top: 32px;
  }
  .nowrap {
    white-space: nowrap;
  }
  /* Popular now / All time: radios inside the section pick which list and header show */
  .rn .rn-ever {
    display: none;
  }
  .rn:has(input[value='ever']:checked) .rn-now {
    display: none;
  }
  .rn:has(input[value='ever']:checked) .rn-ever {
    display: block;
  }
  .rn:has(input[value='ever']:checked) ol.rn-ever {
    display: grid;
  }
  .rn .seg {
    flex: none;
  }
  .runs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
  }
  .runs li {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr) auto;
    gap: 16px;
    align-items: baseline;
  }
  .rm {
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .rm small {
    font-size: 13px;
    font-weight: 400;
    color: var(--ink-3);
    letter-spacing: 0;
  }
  .rw {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .rw b {
    font-weight: 500;
  }
  .rd {
    font-size: 13px;
    white-space: nowrap;
  }
  .cats {
    display: grid;
  }
  .cat {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr) 170px 150px;
    gap: 18px;
    align-items: center;
    padding: 11px 6px;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: background-color 140ms ease;
  }
  .cat:hover {
    background: var(--hover);
  }
  .cn {
    font-weight: 500;
    font-size: 14.5px;
  }
  .mini {
    display: flex;
    gap: 2px;
    height: 12px;
  }
  .mini i {
    border-radius: 3px;
    min-width: 2px;
  }
  .cl,
  .cm {
    font-size: 13px;
    white-space: nowrap;
  }
  @media (max-width: 720px) {
    .runs li {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
  @media (max-width: 900px) {
