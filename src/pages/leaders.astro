---
import Base from '../layouts/Base.astro';
import ReignChart from '../components/ReignChart.astro';
import CrownShare from '../components/CrownShare.astro';
import { benchmarks, labById, modelById, benchById, AS_OF } from '../lib/data.ts';
import LabMark from '../components/LabMark.astro';
import { monthYear } from '../lib/format.ts';
import { eciReigns, labShares, reignDays, contestedDays, clockStops, closeOuts, closeOutShares } from '../lib/reigns.ts';
import ModelName from '../components/ModelName.astro';
import { score as fmt } from '../lib/format.ts';
import { leaderRows } from '../lib/leaders.ts';
import { AREAS, CATEGORY_NAMES } from '../lib/taxonomy.ts';
import { labColor } from '../lib/palette.ts';

const eci = eciReigns();
const eciRows = eci ? [{ ...eci, reigns: eci.reigns.filter((g) => g.end >= '2023-01-01') }] : [];
const eciNow = eci?.reigns.at(-1);
const changes = eci ? eci.reigns.filter((g) => g.start >= '2023-01-01').length : 0;

// every category's chart, from independent runs where they exist
const cats = AREAS.flatMap((a) => a.categories.map((c) => ({ a, c })))
  .map(({ a, c }) => {
    const ids = benchmarks.filter((b) => b.category === c).map((b) => b.id);
    const rows = leaderRows(ids, 'best');
    return { a, c, rows, src: rows.every((r) => r.source === 'card') ? 'card' : 'epoch', shares: labShares(rows, '2023-01-01') };
  })
  .filter((x) => x.rows.length);
const allRows = cats.flatMap((x) => x.rows.filter((r) => r.source === 'epoch'));
const overall = labShares(allRows, '2023-01-01');
const lead = overall[0];
const pct = (v: number) => `${Math.round(v * 100)}%`;
// the longest contested runs at number one since 2023: each ends where it ended, or where the clock stopped
const runs = allRows
  .flatMap((r) =>
    r.reigns.map((g) => {
      const stop = clockStops(r);
      return { g, b: r.benchmark, months: contestedDays(g, r) / 30.4, start: g.start < '2023-01-01' ? '2023-01-01' : g.start, end: g.end < stop ? g.end : stop };
    }),
  )
  .filter((x) => x.months > 0)
  .sort((a, b) => b.months - a.months)
  .slice(0, 8);

// close-outs: the model that took each benchmark past 85%
const closeRows = cats.flatMap((x) => x.rows);
const closed = closeOuts(closeRows);
const closedBy = closeOutShares(closeRows);
const longest = eci?.reigns.filter((g) => g.start >= '2023-01-01').sort((a, b) => reignDays(b) - reignDays(a))[0];
---

<Base title="Leaders" description="Which model held the top score on each benchmark at each point in time, and which lab it came from.">
  <div class="page">
    <header class="head">
      <h1>Who held number one</h1>
      <p class="lede">
        For each benchmark with enough scores, we track which model had the best score at every point since 2023, and which lab made it. A model takes the top spot on the day its score beats every earlier one. It holds the spot until another model beats it. Ties leave the holder in place.
      </p>
    </header>

    {
      eciRows.length > 0 && eciNow && (
        <section>
          <div class="sh">
            <h2>The top spot on the capability index has changed hands {changes === 1 ? 'once' : `${changes} times`} since 2023</h2>
            <p>
              {modelById.get(eciNow.model)?.name}, from {labById.get(eciNow.lab ?? '')?.name}, holds it now.
              {longest && ` The longest run at the top since 2023 lasted ${Math.round(reignDays(longest) / 30.4)} months.`}
            </p>
          </div>
          <ReignChart rows={eciRows} names={{ eci: { name: 'Capabilities Index', href: '/models/' } }} from="2023-01-01" />
        </section>
      )
    }

    {
      lead && (
        <section>
          <div class="sh">
            <h2>
              {labById.get(lead.lab)?.name} held number one {pct(lead.share)} of the contested time
            </h2>
            <p>
              Across the {allRows.length} benchmarks with independent runs, the share of days each lab’s model had the best score. A benchmark’s clock stops when its best score passes 85%, when a new version replaces it, or after the newest model tested. A saturated test or one nobody runs any more no longer counts.
            </p>
          </div>
          <CrownShare shares={overall} />
        </section>
      )
    }

    {
      runs.length > 0 && (
        <section>
          <div class="sh">
            <h2>The longest runs at the top</h2>
            <p>The longest stretches one model held the best independent score, counted from January 2023 and only while the benchmark was contested.</p>
          </div>
          <ol class="runs">
            {runs.map(({ g, b, months, start, end }) => (
              <li>
                <span class="rm num">{Math.round(months)}<small> months</small></span>
                <span class="rw">
                  <LabMark lab={g.lab} size={16} />
                  <b>{modelById.get(g.model)?.name}</b> on <a href={`/benchmarks/${b}/`}>{benchById.get(b)?.name}</a>
                </span>
                <span class="rd muted">
                  {monthYear(start)} to {end >= AS_OF ? 'now' : monthYear(end)}
                </span>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      closed.length > 0 && (
        <section>
          <div class="sh">
            <h2>
              {labById.get(closedBy[0].lab)?.name ?? 'Other labs'} closed out {closedBy[0].count} of {closed.length} benchmarks
            </h2>
            <p>
              A close-out goes to the model that first took a benchmark past 85%. It is counted apart from time at number one, so a lab gets credit for finishing a test without holding it forever.
            </p>
          </div>
          <CrownShare shares={closedBy} what="Benchmarks closed out since 2023" />
          <div class="table-wrap closed">
            <table class="t">
              <thead>
                <tr><th>Date</th><th>Benchmark</th><th>Closed out by</th><th class="r">Score</th></tr>
              </thead>
              <tbody>
                {closed.map((c) => (
                  <tr>
                    <td class="muted num nowrap">{monthYear(c.date)}</td>
                    <td><a href={`/benchmarks/${c.benchmark}/`}>{benchById.get(c.benchmark)?.name}</a>{c.source === 'card' && <span class="muted"> lab claim</span>}</td>
                    <td><ModelName id={c.model} /></td>
                    <td class="r">{fmt(c.value, '%')}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    <section>
      <div class="sh">
        <h2>By category</h2>
        <p>Each bar splits a category’s time at number one by lab. Open a category for its benchmarks, row by row.</p>
      </div>
      <div class="cats">
        {
          cats.map(({ c, rows, src, shares }) => (
            <a class="cat" href={`/categories/${c}/`}>
              <span class="cn">{CATEGORY_NAMES[c] ?? c}</span>
              <span class="mini" aria-hidden="true">
                {shares
                  .filter((s) => s.share >= 0.01)
                  .map((s) => (
                    <i style={`flex:${s.share};background:${labColor(s.lab)}`} data-tn={labById.get(s.lab)?.name ?? 'Other labs'} data-tv={pct(s.share)} />
                  ))}
              </span>
              <span class="cl muted">
                {labById.get(shares[0]?.lab ?? '')?.name ?? 'Other labs'} {pct(shares[0]?.share ?? 0)}
              </span>
              <span class="cm muted">{`${rows.length} ${rows.length === 1 ? 'benchmark' : 'benchmarks'}${src === 'card' ? ', lab claims' : ''}`}</span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</Base>

<style>
  .closed {
    margin-top: 32px;
  }
  .nowrap {
    white-space: nowrap;
  }
  .runs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
  }
  .runs li {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr) auto;
    gap: 16px;
    align-items: baseline;
  }
  .rm {
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .rm small {
    font-size: 13px;
    font-weight: 400;
    color: var(--ink-3);
    letter-spacing: 0;
  }
  .rw {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .rw b {
    font-weight: 500;
  }
  .rd {
    font-size: 13px;
    white-space: nowrap;
  }
  .cats {
    display: grid;
  }
  .cat {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr) 170px 150px;
    gap: 18px;
    align-items: center;
    padding: 11px 6px;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: background-color 140ms ease;
  }
  .cat:hover {
    background: var(--hover);
  }
  .cn {
    font-weight: 500;
    font-size: 14.5px;
  }
  .mini {
    display: flex;
    gap: 2px;
    height: 12px;
  }
  .mini i {
    border-radius: 3px;
    min-width: 2px;
  }
  .cl,
  .cm {
    font-size: 13px;
    white-space: nowrap;
  }
  @media (max-width: 720px) {
    .runs li {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
  @media (max-width: 900px) {
    .cat {
      grid-template-columns: 1fr auto;
      gap: 6px 12px;
    }
    .mini {
      grid-column: 1 / -1;
      order: 3;
    }
    .cm {
      display: none;
    }
  }
</style>
