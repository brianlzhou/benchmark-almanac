{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/benchmarks/factscore-precision/",
      "destination": "/benchmarks/factscore/",
      "permanent": true
    },
    {
      "source": "/benchmarks/programbench-almost/",
      "destination": "/benchmarks/programbench/",
      "permanent": true
    },
    {
      "source": "/benchmarks/programbench-tests-passed/",
      "destination": "/benchmarks/programbench/",
      "permanent": true
    },
    {
      "source": "/reporting/",
      "destination": "/insights/reporting/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "benchmarks.brianzhou.org"
        }
      ],
      "destination": "https://www.benchmarkalmanac.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/data/almanac.db",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.sqlite3"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/data/almanac.db.gz",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/gzip"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/og/(.*)\\.mp4",
      "headers": [
        {
          "key": "Content-Type",
          "value": "video/mp4"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/og/(.*)\\.png",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
